#!/usr/bin/env bash
# claude-session — interactive picker for resuming named Claude Code sessions.
#
# Bound to `cl`. Auto-discovers every session you've /renamed (no registry to
# maintain — name a session and it shows up), marks which are live in tmux, and
# on select cd's into that session's dir and attaches/launches it in a persistent
# tmux session with --dangerously-skip-permissions. A "new claude here" entry
# starts a fresh session in the current directory.
#
# Usage:
#   claude-session            # picker (fzf if available, numbered menu otherwise)
#   claude-session <name>     # launch that named session directly
#   claude-session new "Name" [dir|-d]  # create a fully-named session in one step
#                             #   (no /rename); dir = $PWD, -d uses $CL_DEFAULT_DIR
#   claude-session --list     # print discovered sessions
#   claude-session stop       # snapshot live sessions, kill them, and close their
#                             #   iTerm tabs (--keep-tabs to leave tabs open; asks
#                             #   before killing any mid-task, leaving those open).
#                             #   Covers cmux-native sessions too: their claude
#                             #   processes are killed and surfaces closed.
#   claude-session start      # relaunch every session from the last stop
#                             #   (reattach if live, else resume by session id).
#                             #   In cmux: opens one workspace per session.
#   claude-session restore    # restore state.json from the newest history
#                             #   snapshot (add --list to pick; then run start)

PROJECTS="$HOME/.claude/projects"
STATE="$HOME/.config/claude-session/state.json"
# Rotating history of past state files — a safety net against a failed `cl start`
# (which deletes STATE) or a corrupted write. Newest STATE_HISTORY_KEEP kept.
STATE_HISTORY_DIR="$HOME/.config/claude-session/history"
STATE_HISTORY_KEEP=10

# name<TAB>sid<TAB>cwd<TAB>epoch  — newest transcript per *current* name
discover() {
  # custom-title is the record /rename writes; it covers every named session.
  # (The older agent-name record exists only for a subset, so grepping it
  # silently dropped half the sessions — including the most-used ones.)
  grep -rl '"customTitle"' "$PROJECTS"/*/*.jsonl 2>/dev/null \
    | xargs ls -t 2>/dev/null \
    | while IFS= read -r f; do
        name=$(grep -oE '"customTitle":"[^"]+"' "$f" 2>/dev/null | tail -1 | sed 's/.*"customTitle":"//; s/"$//')
        [ -n "$name" ] || continue
        sid=$(basename "$f" .jsonl)
        cwd=$(grep -m1 -oE '"cwd":"[^"]*"' "$f" 2>/dev/null | sed 's/.*"cwd":"//; s/"$//')
        [ -d "$cwd" ] || continue   # drop sessions whose working dir no longer exists
        epoch=$(stat -f %m "$f" 2>/dev/null || echo 0)
        printf '%s\t%s\t%s\t%s\n' "$name" "$sid" "$cwd" "$epoch"
      done \
    | awk -F'\t' '!seen[$1]++'
}

reltime() {
  local now diff; now=$(date +%s); diff=$(( now - ${1:-0} ))
  if   [ "$diff" -lt 3600 ];  then echo "$((diff/60))m ago"
  elif [ "$diff" -lt 86400 ]; then echo "$((diff/3600))h ago"
  else echo "$((diff/86400))d ago"; fi
}

tmux_name() { printf '%s' "$1" | tr ' .:/' '____'; }

# in_cmux: this shell is hosted by a cmux pane (cmux exports surface/workspace
# ids into every terminal it spawns). In cmux mode cl skips tmux entirely —
# cmux's Claude integration owns persistence/restore (quit cmux = save; relaunch
# = resume by session id), so wrapping claude in tmux would only hide it from
# cmux's lifecycle badges, Feed, and restore.
in_cmux() { [ -n "${CMUX_SURFACE_ID:-}" ] || [ -n "${CMUX_WORKSPACE_ID:-}" ]; }

# in_iterm: this shell is hosted by iTerm2 itself. Distinct from iterm_running:
# "iTerm is open somewhere" is the wrong gate for OPENING tabs — with cmux in
# the picture it would open tabs in a terminal the user isn't looking at.
# (iterm_running stays correct for CLOSING previously-tagged iTerm tabs.)
in_iterm() { ! in_cmux && [ "${TERM_PROGRAM:-}" = "iTerm.app" ]; }

# session_pid <sid>: pid of a live claude already running this session, if any.
# Guards cmux mode against double --resume of one session (two processes on the
# same transcript) — the hazard tmux's attach-don't-duplicate used to prevent.
session_pid() { pgrep -f "(-resume|-session-id) $1" 2>/dev/null | head -1; }

# Server-global tmux setup applied idempotently before each launch (exec
# replaces this process, so it can't run after): terminal titles track the
# session name, and Ctrl-Z is swallowed unless the pane runs a shell. Claude
# Code can't disable its Ctrl-Z suspend, and a suspended claude in a cl pane
# has no parent shell to `fg` from (recovery requires kill -CONT). Shells still
# get Ctrl-Z so job control works in normal panes. Applied here rather than
# ~/.tmux.conf so cl is self-contained on any machine.
tmux_setup() {
  command -v tmux >/dev/null 2>&1 || return 0
  tmux start-server 2>/dev/null
  tmux set -g set-titles on 2>/dev/null
  tmux set -g set-titles-string "#S" 2>/dev/null
  tmux bind-key -n C-z if-shell -F '#{m:*sh,#{pane_current_command}}' 'send-keys C-z' '' 2>/dev/null
}

# iterm_running: true when iTerm2 is actually running. Env vars are unreliable
# (TERM_PROGRAM is clobbered to "tmux" inside a client), so ask the OS instead.
iterm_running() {
  command -v osascript >/dev/null 2>&1 || return 1
  osascript -e 'tell application "System Events" to (name of processes) contains "iTerm2"' \
    2>/dev/null | grep -q true
}

# tag_iterm_session <tmux_name>: mark the CURRENT iTerm session with a user
# variable (user.clSession) via the OSC 1337 SetUserVar escape, so `cl stop` can
# later find and close this exact tab. Emitted before tmux takes over the tty.
# Harmless in non-iTerm terminals — they ignore the unknown escape sequence.
tag_iterm_session() {
  local b64; b64=$(printf '%s' "$1" | base64 | tr -d '\n')
  printf '\033]1337;SetUserVar=clSession=%s\007' "$b64"
}

# close_iterm_tab <tmux_name>: close the iTerm tab tagged with
# user.clSession == <tmux_name>. Skips the session running this command so
# `cl stop` never yanks closed its own terminal. Best-effort; no-op if the tab
# isn't found or iTerm can't be scripted. Collects matches first, then closes,
# to avoid mutating the tab collection mid-iteration.
close_iterm_tab() {
  local esc="$1"
  esc="${esc//\\/\\\\}"; esc="${esc//\"/\\\"}"
  osascript >/dev/null 2>&1 <<OSA
tell application "iTerm"
  set curId to -1
  try
    set curId to id of current session of current tab of current window
  end try
  set toClose to {}
  repeat with w in windows
    repeat with tb in tabs of w
      repeat with s in sessions of tb
        try
          set varVal to ""
          tell s to set varVal to (variable named "user.clSession")
          if varVal is "${esc}" and (id of s) is not curId then set end of toClose to s
        end try
      end repeat
    end repeat
  end repeat
  repeat with s in toClose
    try
      close s
    end try
  end repeat
end tell
OSA
}

launch_session() { # name sid cwd
  local name="$1" sid="$2" cwd="$3" t pid
  t=$(tmux_name "$name"); [ -d "$cwd" ] || cwd="$HOME"
  if in_cmux; then
    pid=$(session_pid "$sid")
    if [ -n "$pid" ]; then
      echo "\"$name\" is already running (pid $pid) — switch to its tab instead of resuming it twice." >&2
      exit 1
    fi
    cmux rename-tab "$name" >/dev/null 2>&1
    cd "$cwd" || exit 1; exec claude --resume "$sid" --dangerously-skip-permissions
  fi
  if command -v tmux >/dev/null 2>&1; then
    in_iterm && tag_iterm_session "$t"   # so `cl stop` can close this tab later
    tmux_setup
    exec tmux new-session -A -s "$t" -c "$cwd" "claude --resume $sid --dangerously-skip-permissions"
  else
    cd "$cwd" || exit 1; exec claude --resume "$sid" --dangerously-skip-permissions
  fi
}

launch_new() { # cwd
  local cwd="$1" t; [ -d "$cwd" ] || cwd="$PWD"
  if in_cmux; then
    cd "$cwd" || exit 1; exec claude --dangerously-skip-permissions
  fi
  t="claude-$(basename "$cwd")"
  if command -v tmux >/dev/null 2>&1; then
    tmux_setup
    exec tmux new-session -A -s "$t" -c "$cwd" "claude --dangerously-skip-permissions"
  else
    cd "$cwd" || exit 1; exec claude --dangerously-skip-permissions
  fi
}

# launch_named <name> <cwd>: create + attach a fully-named session via
# `claude --name` (sets the title at launch). The interactive create path shared
# by `cl new` and the picker's "new" entry.
launch_named() { # name cwd
  local name="$1" cwd="$2" t qname
  [ -d "$cwd" ] || cwd="$HOME"
  if in_cmux; then
    cmux rename-tab "$name" >/dev/null 2>&1
    cd "$cwd" || exit 1; exec claude --name "$name" --dangerously-skip-permissions
  fi
  t=$(tmux_name "$name"); qname=$(printf '%q' "$name")
  if command -v tmux >/dev/null 2>&1; then
    in_iterm && tag_iterm_session "$t"
    tmux_setup
    exec tmux new-session -A -s "$t" -c "$cwd" "claude --name $qname --dangerously-skip-permissions"
  else
    cd "$cwd" || exit 1; exec claude --name "$name" --dangerously-skip-permissions
  fi
}

# do_new: create a NEW, fully-named session in one step — no /rename → exit →
# re-pick dance. `claude --name` sets the session's customTitle AT LAUNCH, so
# discover(), the picker, and `cl start` all find it immediately.
#   cl new "Session Name"        → launch in $PWD (default: where you are)
#   cl new "Session Name" -d      → launch in $CL_DEFAULT_DIR (your main repo)
#   cl new "Session Name" <dir>   → launch in that explicit dir
# Interactive → create + attach. No TTY (script / a Claude Bash call) → create
# detached and print how to attach, so the caller isn't left hanging.
do_new() {
  local name="${1:-}" arg="${2:-}" cwd
  [ -n "$name" ] || { echo 'usage: cl new "Session Name" [dir | -d]' >&2; exit 1; }
  case "$arg" in
    -d|--default)
      cwd="${CL_DEFAULT_DIR:-}"
      [ -n "$cwd" ] || { echo "claude-session: -d given but CL_DEFAULT_DIR is not set (export it in your shell rc)" >&2; exit 1; }
      ;;
    "")  cwd="$PWD" ;;
    *)   cwd="$arg" ;;
  esac
  [ -d "$cwd" ] || { echo "claude-session: no such directory: $cwd" >&2; exit 1; }

  local t qname
  t=$(tmux_name "$name")
  qname=$(printf '%q' "$name")   # safe to embed in the tmux command string

  if in_cmux; then
    if [ -t 1 ] && [ -t 0 ]; then
      launch_named "$name" "$cwd"
    else
      # no TTY (script / Claude Bash call): open a fresh cmux workspace so the
      # caller isn't blocked, mirroring the detached-tmux path below.
      cmux new-workspace --name "$name" --cwd "$cwd" \
          --command "claude --name $qname --dangerously-skip-permissions" >/dev/null \
        && echo "created cmux workspace '$name' in $cwd"
    fi
    exit 0
  fi

  if ! command -v tmux >/dev/null 2>&1; then
    cd "$cwd" || exit 1
    exec claude --name "$name" --dangerously-skip-permissions
  fi

  if [ -t 1 ] && [ -t 0 ]; then
    # interactive: create + attach, like the picker
    launch_named "$name" "$cwd"
  else
    # no TTY (script / Claude Bash call): create detached so the caller isn't
    # blocked on an attach — attach later with `cl "<name>"`.
    tmux_setup
    if tmux has-session -t "=${t}" 2>/dev/null; then
      echo "session '$name' already exists — attach with: cl \"$name\""
    else
      tmux new-session -d -s "$t" -c "$cwd" "claude --name $qname --dangerously-skip-permissions" \
        && echo "created '$name' in $cwd — attach with: cl \"$name\""
    fi
  fi
}

# --- start/stop support -----------------------------------------------------
# These mirror the picker's style ([ ] tests, exec-to-tmux) on purpose so the
# script reads as one piece. session_busy uses the `caffeinate` wake-lock that
# `claude` spawns while working: claude's TUI uses the alternate screen buffer,
# so `tmux capture-pane` returns nothing and process state is the only reliable
# external signal. The signal is conservative — caffeinate's timeout lingers a
# few minutes after work ends — so stop errs toward asking, never silent-killing.

# claude_busy <pid>: 0 (true) if that claude process looks mid-task — a
# caffeinate child, or CPU over ~15%. Works on any claude pid (tmux pane or
# cmux pane); the terminal doesn't matter, only the process tree does.
claude_busy() {
  local pid="$1" kid cmd cpu
  [ -n "$pid" ] || return 1
  for kid in $(pgrep -P "$pid" 2>/dev/null); do
    cmd=$(ps -o command= -p "$kid" 2>/dev/null)
    case "$cmd" in *caffeinate*) return 0 ;; esac
  done
  cpu=$(ps -o %cpu= -p "$pid" 2>/dev/null | tr -d ' ')
  # Integer compare on the whole-number part; >=15% CPU counts as working.
  [ "${cpu%%.*}" -ge 15 ] 2>/dev/null && return 0
  return 1
}

# session_busy <tmux_session_name>: tmux flavor of claude_busy — the pane's
# root process IS the claude (tmux runs it as the pane command).
session_busy() {
  local ppid
  ppid=$(tmux list-panes -t "=${1}" -F '#{pane_pid}' 2>/dev/null | head -1)
  claude_busy "$ppid"
}

# close_cmux_surface <sid>: best-effort close of the cmux surface hosting this
# session, looked up in cmux's own session store. Only meaningful (and only
# authorized on the socket) when running inside cmux; silently a no-op
# otherwise. Called after the claude is dead, so the surface holds a bare shell.
close_cmux_surface() {
  in_cmux || return 0
  command -v jq >/dev/null 2>&1 || return 0
  local sfc
  sfc=$(jq -r --arg sid "$1" '.sessions[$sid].surfaceId // empty'         "$HOME/.cmuxterm/claude-hook-sessions.json" 2>/dev/null)
  [ -n "$sfc" ] && cmux close-surface --surface "$sfc" >/dev/null 2>&1
  return 0
}

# archive_state: bank a copy of the current STATE into STATE_HISTORY_DIR under a
# timestamped name, then prune to the newest STATE_HISTORY_KEEP. Only well-formed
# JSON is archived, so the history stays a set of known-good snapshots to restore
# from if the live STATE is lost (failed start) or corrupted. Best-effort: any
# failure here must never break stop/start, so it always returns 0.
archive_state() {
  [ -r "$STATE" ] || return 0
  command -v jq >/dev/null 2>&1 && ! jq empty "$STATE" 2>/dev/null && return 0
  mkdir -p "$STATE_HISTORY_DIR" 2>/dev/null || return 0
  local stamp dest n=1
  stamp=$(date +%Y%m%d-%H%M%S)
  dest="$STATE_HISTORY_DIR/state-$stamp.json"
  # Same-second archives (e.g. rapid stop/start) must not clobber each other.
  while [ -e "$dest" ]; do dest="$STATE_HISTORY_DIR/state-$stamp-$n.json"; n=$((n+1)); done
  cp "$STATE" "$dest" 2>/dev/null || return 0
  # Prune oldest beyond the keep count (newest-first, drop the tail).
  ls -1t "$STATE_HISTORY_DIR"/state-*.json 2>/dev/null \
    | tail -n +$((STATE_HISTORY_KEEP + 1)) \
    | while IFS= read -r old; do rm -f "$old"; done
  return 0
}

# save_state: record the currently-live sessions into STATE as JSON, UNIONed
# with whatever STATE already held (keyed by name; the fresh entry wins on a
# collision so session ids stay current). Union — not overwrite — because
# `cl stop` is meant to be re-run to catch sessions left running mid-task: by
# the second run those killed earlier are no longer live, and an overwrite
# would drop them from the saved set. `cl start` clears STATE once consumed,
# so a clean stop→start cycle never accumulates stale entries.
save_state() {
  mkdir -p "$(dirname "$STATE")" || { echo "claude-session: cannot create state dir" >&2; return 1; }

  # Build a JSON array of the sessions live in tmux right now.
  local live first=1
  live="$(
    printf '['
    discover | while IFS=$'\t' read -r name sid cwd epoch; do
      tmux has-session -t "$(tmux_name "$name")" 2>/dev/null || [ -n "$(session_pid "$sid")" ] || continue
      [ "$first" -eq 1 ] && first=0 || printf ','
      jq -nc --arg name "$name" --arg sid "$sid" --arg cwd "$cwd" \
        '{name:$name, sid:$sid, cwd:$cwd}'
    done
    printf ']'
  )"

  # Union with any prior STATE: concat, group by name, keep the last (fresh)
  # entry per name. Prior file is treated as empty if missing/unparseable.
  local prior="[]"
  [ -r "$STATE" ] && prior="$(jq -c '.' "$STATE" 2>/dev/null || printf '[]')"
  local tmp="$STATE.tmp.$$"
  if printf '%s\n%s\n' "$prior" "$live" \
      | jq -s 'add | group_by(.name) | map(.[-1])' > "$tmp" 2>/dev/null; then
    mv "$tmp" "$STATE"
    archive_state   # bank this known-good snapshot into the rotating history
  else
    rm -f "$tmp"
    echo "claude-session: failed to write state" >&2
    return 1
  fi
}

# do_stop: snapshot live sessions, then kill them — but ask before killing any
# that look mid-task, and leave those running. Re-run `cl stop` to catch them
# once they go idle.
do_stop() {
  command -v jq >/dev/null 2>&1 || { echo "claude-session: stop needs jq (brew install jq)" >&2; exit 1; }
  local keep_tabs=0
  [ "${1:-}" = "--keep-tabs" ] && keep_tabs=1
  if ! tmux list-sessions >/dev/null 2>&1 && ! in_cmux; then
    echo "claude-session: no tmux server running — nothing to stop" >&2
    exit 0
  fi

  # Also close each killed session's iTerm tab, unless opted out or not in iTerm.
  local close_tabs=0
  [ "$keep_tabs" = "0" ] && iterm_running && close_tabs=1

  save_state || exit 1
  local count; count=$(jq 'length' "$STATE" 2>/dev/null || echo 0)
  printf 'saved %s session(s) to %s\n\n' "$count" "$STATE"

  local name t ans pid
  discover | while IFS=$'\t' read -r name sid cwd epoch; do
    t=$(tmux_name "$name")
    if tmux has-session -t "=${t}" 2>/dev/null; then
      if session_busy "$t"; then
        printf '⏳ "%s" looks mid-task. Kill it anyway? [y/N] ' "$name" >&2
        read -r ans </dev/tty
        case "$ans" in
          y|Y)  tmux kill-session -t "=${t}" 2>/dev/null \
                  && { printf '   killed %s\n' "$name" >&2; [ "$close_tabs" = "1" ] && close_iterm_tab "$t"; } ;;
          *)    printf '   left %s running — re-run cl stop later to close it\n' "$name" >&2 ;;
        esac
      else
        tmux kill-session -t "=${t}" 2>/dev/null \
          && { printf '✓ killed %s\n' "$name" >&2; [ "$close_tabs" = "1" ] && close_iterm_tab "$t"; }
      fi
      continue
    fi
    # No tmux session — a cmux-native (or bare) claude: kill the process
    # itself. SIGTERM is a clean shutdown (SessionEnd hooks fire), then the
    # hosting surface (now a bare shell) is closed best-effort.
    pid=$(session_pid "$sid"); [ -n "$pid" ] || continue
    # Safety: a claude whose PARENT is a tmux server belongs to tmux — if we
    # can't see that server (different socket/user context), it is not ours
    # to process-kill. This branch only ever touches cmux/bare claudes.
    # (Learned the hard way 2026-07-31: a hidden tmux server let this branch
    # sweep 10 live tmux-hosted sessions.)
    case "$(ps -o command= -p "$(ps -o ppid= -p "$pid" | tr -d ' ')" 2>/dev/null)" in
      *tmux*) printf '⚠ skipping %s — owned by a tmux server not visible here\n' "$name" >&2; continue ;;
    esac
    if claude_busy "$pid"; then
      printf '⏳ "%s" looks mid-task (pid %s). Kill it anyway? [y/N] ' "$name" "$pid" >&2
      read -r ans </dev/tty
      case "$ans" in
        y|Y)  kill "$pid" 2>/dev/null \
                && { printf '   killed %s\n' "$name" >&2; close_cmux_surface "$sid"; } ;;
        *)    printf '   left %s running — re-run cl stop later to close it\n' "$name" >&2 ;;
      esac
    else
      kill "$pid" 2>/dev/null \
        && { printf '✓ killed %s\n' "$name" >&2; close_cmux_surface "$sid"; }
    fi
  done
  printf '\nstate saved. Run cl start to bring these back.\n' >&2
}

# open_iterm_tabs <name>...: open one real iTerm tab per name, each running
# `cl <name>` (which attaches that session's tmux). Mirrors the manual flow —
# ⌘T, `cl`, pick the session — but creates ALL tabs in a SINGLE osascript
# invocation (one AppleScript session for the whole set) instead of one process
# per tab, which is markedly faster for a large working set. Returns non-zero if
# the AppleScript fails (not in iTerm, automation denied) so the caller can fall
# back to printing commands.
open_iterm_tabs() {
  local name esc script
  script='tell application "iTerm"
  tell current window
'
  for name in "$@"; do
    # Escape backslashes then double-quotes for embedding in the AppleScript string.
    esc="${name//\\/\\\\}"; esc="${esc//\"/\\\"}"
    script+='    create tab with default profile
    tell current session to write text "cl \"'"$esc"'\""
'
  done
  script+='  end tell
end tell'
  osascript >/dev/null 2>&1 <<OSA
$script
OSA
}

# do_start: bring back every session in STATE the way they were launched by
# hand — one real iTerm tab each, tmux-backed via `cl <name>`. First it ensures
# each session's tmux exists (detached), then opens a tab per session. Falls
# back to printing the `cl <name>` commands when not in iTerm or osascript fails.
do_start() {
  command -v jq >/dev/null 2>&1 || { echo "claude-session: start needs jq (brew install jq)" >&2; exit 1; }
  [ -r "$STATE" ] || { echo "claude-session: no saved state ($STATE) — run 'cl stop' first" >&2; exit 1; }

  local n; n=$(jq 'length' "$STATE" 2>/dev/null || echo 0)
  [ "$n" -gt 0 ] || { echo "claude-session: saved state is empty" >&2; exit 1; }

  if in_cmux; then
    # cmux mode: one workspace per saved session, claude resumed tmux-free so
    # cmux's integration owns it. --focus false so eight restores don't fight
    # over focus. Live sessions (either kind) are left alone.
    local name sid cwd i=0
    while IFS=$'\t' read -r name sid cwd; do
      if [ -n "$(session_pid "$sid")" ] \
         || { command -v tmux >/dev/null 2>&1 && tmux has-session -t "=$(tmux_name "$name")" 2>/dev/null; }; then
        printf '● %s already live\n' "$name"
      else
        [ -d "$cwd" ] || cwd="$HOME"
        cmux new-workspace --name "$name" --cwd "$cwd" --focus false \
            --command "claude --resume $sid --dangerously-skip-permissions" >/dev/null \
          && { printf '✓ opened %s  (%s)\n' "$name" "$cwd"; i=$((i+1)); }
      fi
    done < <(jq -r '.[] | [.name, .sid, .cwd] | @tsv' "$STATE")
    archive_state
    rm -f "$STATE"
    printf '\nopened %s cmux workspace(s).\n' "$i"
    exit 0
  fi

  # 1. Ensure each session's tmux exists (detached). `cl <name>` in each tab
  #    then attaches it. Creating here (not relying on the tab) means a failed
  #    tab still leaves a recoverable session. launch_session execs, so we
  #    replicate its create-detached form (incl. tmux_setup).
  command -v tmux >/dev/null 2>&1 && tmux_setup
  local name sid cwd t i=0
  while IFS=$'\t' read -r name sid cwd; do
    t=$(tmux_name "$name")
    [ -d "$cwd" ] || cwd="$HOME"
    if tmux has-session -t "=${t}" 2>/dev/null; then
      printf '● %s already live\n' "$name"
    else
      tmux new-session -d -s "$t" -c "$cwd" "claude --resume $sid --dangerously-skip-permissions" \
        && printf '✓ prepared %s  (%s)\n' "$name" "$cwd"
    fi
    i=$((i+1))
  done < <(jq -r '.[] | [.name, .sid, .cwd] | @tsv' "$STATE")

  # 2. Open a real iTerm tab per session (or fall back to printing commands).
  #    Read names into an array first so the STATE file can be cleared safely.
  local -a names=()
  while IFS= read -r name; do names+=("$name"); done < <(jq -r '.[].name' "$STATE")

  # Snapshot consumed: archive a copy first (so a failed relaunch never loses the
  # list — restore from STATE_HISTORY_DIR), then clear for the next clean cycle.
  archive_state
  rm -f "$STATE"

  # Open tabs only when THIS shell is iTerm-hosted (in_iterm). Inside a tmux
  # pane TERM_PROGRAM reads "tmux", so in_iterm is false there — cl start then
  # degrades to printing the commands instead of guessing a terminal to target.
  local have_iterm=0
  in_iterm && have_iterm=1
  if [ "$have_iterm" = "1" ] && open_iterm_tabs "${names[@]}"; then
    printf '\nopened %s iTerm tab(s).\n' "${#names[@]}"
  else
    if [ "$have_iterm" = "1" ]; then
      printf '\n%s session(s) prepared, but the iTerm tab-open failed — run these manually:\n' "$i" >&2
    else
      printf '\n%s session(s) prepared. Not in iTerm (or no osascript) — open a tab and run:\n' "$i"
    fi
    for name in "${names[@]}"; do printf '  cl "%s"\n' "$name"; done
  fi
}

# do_restore: copy a snapshot from STATE_HISTORY_DIR back to STATE so the next
# `cl start` can bring the sessions back. No argument → newest snapshot; --list →
# print available snapshots (newest first) with session count + age; a path or
# bare filename → that specific snapshot. Any existing STATE is archived first, so
# restore is itself lossless. Corrupt snapshots are refused.
do_restore() {
  command -v jq >/dev/null 2>&1 || { echo "claude-session: restore needs jq (brew install jq)" >&2; exit 1; }

  if [ "${1:-}" = "--list" ]; then
    local any=0 f n age
    while IFS= read -r f; do
      any=1
      n=$(jq 'length' "$f" 2>/dev/null || echo '?')
      age=$(reltime "$(stat -f %m "$f" 2>/dev/null || echo 0)")
      printf '%-8s %3s session(s)   %s\n' "$age" "$n" "$f"
    done < <(ls -1t "$STATE_HISTORY_DIR"/state-*.json 2>/dev/null)
    [ "$any" = "1" ] || echo "claude-session: no snapshots in $STATE_HISTORY_DIR" >&2
    return 0
  fi

  # Choose the snapshot: explicit arg (full path or bare filename) or the newest.
  local snap
  if [ -n "${1:-}" ]; then
    if   [ -r "$1" ];                        then snap="$1"
    elif [ -r "$STATE_HISTORY_DIR/$1" ];     then snap="$STATE_HISTORY_DIR/$1"
    else echo "claude-session: no such snapshot '$1' (try: cl restore --list)" >&2; exit 1; fi
  else
    snap=$(ls -1t "$STATE_HISTORY_DIR"/state-*.json 2>/dev/null | head -1)
    [ -n "$snap" ] || { echo "claude-session: no snapshots to restore in $STATE_HISTORY_DIR" >&2; exit 1; }
  fi

  jq empty "$snap" 2>/dev/null || { echo "claude-session: snapshot is not valid JSON: $snap" >&2; exit 1; }

  archive_state   # preserve any current STATE before overwriting — restore is lossless
  mkdir -p "$(dirname "$STATE")" || { echo "claude-session: cannot create state dir" >&2; exit 1; }
  cp "$snap" "$STATE" || { echo "claude-session: failed to write $STATE" >&2; exit 1; }

  local count; count=$(jq 'length' "$STATE" 2>/dev/null || echo '?')
  printf 'restored %s session(s) from %s\n' "$count" "$snap"
  printf 'run cl start to bring them back.\n'
}

# fzf rows: "<display>\tNAME\tSID\tCWD"  (display shown; rest carried for the action)
rows() {
  printf '＋ new claude here  ·  %s\tNEW\t\t%s\n' "$PWD" "$PWD"
  discover | while IFS=$'\t' read -r name sid cwd epoch; do
    if tmux has-session -t "$(tmux_name "$name")" 2>/dev/null || [ -n "$(session_pid "$sid")" ]; then dot="●"; else dot="○"; fi
    printf '%s %-22s %-8s %s\t%s\t%s\t%s\n' "$dot" "$name" "$(reltime "$epoch")" "$cwd" "$name" "$sid" "$cwd"
  done
}

case "${1:-}" in
  new)     shift; do_new "$@"; exit 0 ;;
  stop)    do_stop "${2:-}"; exit 0 ;;
  start)   do_start; exit 0 ;;
  restore) do_restore "${2:-}"; exit 0 ;;
  --list)
    printf '%-2s %-22s %-8s %s\n' '' NAME 'ACTIVE' DIR
    discover | while IFS=$'\t' read -r name sid cwd epoch; do
      if tmux has-session -t "$(tmux_name "$name")" 2>/dev/null || [ -n "$(session_pid "$sid")" ]; then dot='●'; else dot='○'; fi
      printf '%-2s %-22s %-8s %s\n' "$dot" "$name" "$(reltime "$epoch")" "$cwd"
    done
    exit 0 ;;
  -h|--help) sed -n '2,22p' "$0"; exit 0 ;;
  '') : ;;  # fall through to picker
  *)
    # direct launch by name
    match=$(discover | awk -F'\t' -v n="$1" '$1==n{print; exit}')
    if [ -n "$match" ]; then
      IFS=$'\t' read -r name sid cwd _ <<EOF
$match
EOF
      launch_session "$name" "$sid" "$cwd"
    elif command -v tmux >/dev/null 2>&1 && tmux has-session -t "=$(tmux_name "$1")" 2>/dev/null; then
      # Live tmux session exists but its customTitle isn't in the transcript yet
      # (e.g. a fresh `cl new` before its first message) — attach it directly.
      t=$(tmux_name "$1"); in_iterm && tag_iterm_session "$t"; tmux_setup
      exec tmux new-session -A -s "$t"
    else
      echo "claude-session: no session named '$1' (try --list)" >&2; exit 1
    fi
    ;;
esac

# ---- picker ----
if command -v fzf >/dev/null 2>&1; then
  picked=$(rows | fzf --ansi --delimiter='\t' --with-nth=1 --height=45% --reverse \
            --prompt='claude session ❯ ' \
            --header='● live in tmux   ○ resume      enter: open') || exit 0
  [ -n "$picked" ] || exit 0
else
  echo "Pick a session:" >&2
  IFS=$'\n'; i=0; menu=$(rows)
  for line in $menu; do i=$((i+1)); printf '%2d) %s\n' "$i" "${line%%$'\t'*}" >&2; done
  printf 'number ❯ ' >&2; read -r choice
  picked=$(printf '%s\n' $menu | sed -n "${choice}p")
  [ -n "$picked" ] || exit 0
fi

name=$(printf '%s' "$picked" | cut -f2)
sid=$(printf '%s' "$picked" | cut -f3)
cwd=$(printf '%s' "$picked" | cut -f4)
if [ "$name" = "NEW" ]; then
  printf 'name for the new session (blank = unnamed) ❯ ' >&2
  read -r newname </dev/tty
  if [ -n "$newname" ]; then launch_named "$newname" "$cwd"; else launch_new "$cwd"; fi
else
  launch_session "$name" "$sid" "$cwd"
fi
