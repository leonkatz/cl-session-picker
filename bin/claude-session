#!/usr/bin/env bash
# claude-session — interactive picker for resuming named Claude Code and
# Codex CLI sessions.
#
# Bound to `cl`. Auto-discovers every session you've /renamed (no registry to
# maintain — name a session and it shows up), marks which are live, and on
# select cd's into that session's dir and launches or resumes it. A "new … here"
# entry starts a fresh session in the current directory. Claude launches with
# --dangerously-skip-permissions; Codex launches with its own configured
# defaults (add flags via CL_CODEX_ARGS).
#
# Where the agent runs:
#   in iTerm2  — as the tab's own process, NOT inside tmux, so iTerm's Claude
#                Code integration (job-name triggers, status hooks) can see it.
#                Trade-off: no detach — closing the tab ends the session, and
#                Ctrl-Z suspends the agent (no tmux keybind to swallow it).
#                Recovery is `cl <name>`, which resumes by session id.
#                CL_TMUX=1 restores the old tmux wrapping instead.
#   elsewhere  — inside tmux when available (detach/reattach is the only
#                persistence there), otherwise directly.
#
# Usage:
#   claude-session            # picker (fzf if available, numbered menu otherwise)
#   claude-session <name>     # launch that named session directly
#   claude-session --codex <name>   # same, when a name exists for both agents
#   claude-session model      # list the model remembered per agent + session
#   claude-session model [--codex|--claude] <name> <model-id>
#                             #   start that session with this model. The agent
#                             #   is inferred when the name is unique, and the
#                             #   command refuses an ambiguous one, like `cl <name>`.
#   claude-session model <name> -            # forget it (back to the agent default)
#   claude-session new "Name" [dir|-d]  # create a fully-named session in one step
#                             #   (no /rename); dir = $PWD, -d uses $CL_DEFAULT_DIR
#   claude-session new [--model <id>] "Name" [dir|-d]   # …and remember a model
#   claude-session new --codex "Name" [dir|-d]  # fresh codex; the name labels
#                             #   the tab only until you /rename inside codex
#   claude-session --list     # print discovered sessions (--codex/--claude to filter)
#   claude-session stop       # ask each Claude session for a handoff (written to
#                             #   <handoff dir>/<Name>.md, or a local fallback if
#                             #   that is unreachable), then snapshot live
#                             #   sessions, kill them, and close their iTerm tabs.
#                             #   A session whose handoff never lands is still
#                             #   STOPPED -- it just resumes instead of rotating,
#                             #   and says so. --require-handoff (--rotate) fails
#                             #   closed instead and exits non-zero if anything is
#                             #   left running. --keep-tabs leaves tabs open;
#                             #   --no-handoff skips the request AND clears any
#                             #   pending handoff, so the session really does come
#                             #   back as-is; --dry-run prints what would happen.
#                             #   Every session is asked at once; each round
#                             #   waits one shared CL_HANDOFF_TIMEOUT window
#                             #   (180s) for all of them, and CL_HANDOFF_BUDGET
#                             #   (300s) bounds the waiting across rounds. Asks
#                             #   before killing anything still mid-task.
#   claude-session handoff    # write THIS session's handoff by hand, from inside
#                             #   it — the way out when a pane can't be reached.
#                             #   Pipe the text in, or run it bare to be told
#                             #   where to write. --path prints just the path.
#   claude-session mode       # each session's RESTART MODE — what `cl stop` and
#                             #   `cl start` do with it: compact-resume (the
#                             #   default: compact, stop, resume with a first
#                             #   prompt), handoff, fresh, or resume. See
#                             #   docs/restart-modes.md. `mode "Name" <mode>`
#                             #   sets one, `mode "Name"` shows it, `mode "Name"
#                             #   clear` un-sets it, `mode --default <mode>`.
#                             #   `mode --codex "Name" fresh|resume` for a
#                             #   Codex session (resume unless set).
#   claude-session rotate     # the older spelling of the same setting:
#                             #   on = handoff, off = resume.
#                             #   `rotate` / `rotate status` reports it (run
#                             #   INSIDE a session and it leads with that one);
#                             #   `rotate off` / `rotate on` set the default;
#                             #   `rotate off "Name"` overrides one session and
#                             #   `rotate clear "Name"` un-overrides it.
#                             #   Precedence: a stop flag, then CL_ROTATE, then
#                             #   the stored setting, then compact-resume.
#                             #   `rotate stats` summarises the per-stop log
#                             #   (~/.config/claude-session/rotation-log.tsv) by
#                             #   week: how many stops ran each way, how much
#                             #   work was in them, and the median context being
#                             #   carried — so a change in spend can be
#                             #   attributed rather than guessed at. Turning
#                             #   rotation off skips the handoff REQUEST too,
#                             #   which is itself a call per session, so both
#                             #   sides of the trade are measured.
#                             #   The HANDOFF column in `cl` / `cl --list` shows
#                             #   each session's setting, with ↻ when a complete
#                             #   handoff is already waiting.
#   claude-session start      # relaunch every session from the last stop, each as
#                             #   the agent it was saved under. Rotation is a CLAUDE
#                             #   mechanism: a Codex row resumes as itself, or, in
#                             #   fresh mode, as a new thread under its name.
#                             #   Per Claude session: a COMPLETE unconsumed handoff means
#                             #   START FRESH under the same name, seeded with it.
#                             #   No handoff -- or one with no valid marker on its
#                             #   last line, which means it was cut off mid-write
#                             #   -- resumes by id instead, and the unusable file
#                             #   is filed under incomplete/. A handoff is spent
#                             #   only once a replacement is really running
#                             #   (claim -> commit, or roll back on refusal); a
#                             #   session whose launch is refused keeps its row
#                             #   and the command exits non-zero. Skips any
#                             #   already live.
#   claude-session start --fresh "Name" [--dry-run]
#                             # hand off + retire ONE named session, then launch
#                             #   a NEW claude under the SAME name/dir whose first
#                             #   message tells it to read the handoff and
#                             #   continue. The old
#                             #   session id is kept (recovery command printed +
#                             #   logged) — nothing is lost, only re-read once.
#                             #   Claude only. Use it to rotate ONE live session
#                             #   without stopping anything else; plain
#                             #   `cl start` is what rotates a whole working set.
#
# stop/start cover Codex sessions THIS TOOL LAUNCHED, and nothing else: for
# Codex an argv match is not a sound handle (app-server daemon, Desktop app,
# --remote clients, and an npm launcher whose wrapper and native child both
# match), so only the launch registry — a pid cl recorded with a start token —
# is accepted on the kill path. Anything else is reported and left alone.
#
#   claude-session restore    # restore state.json from the newest history
#                             #   snapshot (add --list to pick; then run start)
#
# `cl --help` prints the curated text in print_help, not this header: the header
# is for maintainers and explains WHY; help says what to type.

PROJECTS="$HOME/.claude/projects"
# Codex CLI storage. Both files are private implementation details of the Codex
# CLI (observed at 0.150.0), not a supported API — discover_codex() is the one
# place that knows their shape, so a layout change breaks exactly one function.
CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
CODEX_INDEX="$CODEX_HOME/session_index.jsonl"
CODEX_SESSIONS="$CODEX_HOME/sessions"
STATE="$HOME/.config/claude-session/state.json"
# Rotating history of past state files — a safety net against a failed `cl start`
# (which deletes STATE) or a corrupted write. Newest STATE_HISTORY_KEEP kept.
STATE_HISTORY_DIR="$HOME/.config/claude-session/history"

# Remembered model per session, as {"<agent>": {"<name>": "<model-id>"}}.
#
# Keyed by AGENT AND NAME, because that is the session identity everywhere else
# in this tool — tmux names, the launch registry, the picker's rows. Keying on
# the name alone crossed that boundary: with a Claude session and a Codex
# session both called "API", `cl --claude API` unambiguously selects the Claude
# one and would still have picked up a model set for the Codex one, launching
# `claude --model <a-codex-model>`. An agent-qualified launch must not be
# corrupted by a preference the store could not qualify.
#
# A file of its own rather than a field in state.json, for two reasons. The
# state file is a snapshot of what was live at the last `cl stop` — it is
# consumed and deleted by `cl start`, and rebuilt from discovery, so a
# preference stored in it would be erased by the next cycle. And a model can be
# chosen for a session that does not exist yet (`cl new --model`), which has no
# state record to attach to. Keyed by name because that is what the user types
# and what survives a session being stopped, restored, or resumed under a new
# transcript id.
MODELS="$HOME/.config/claude-session/models.json"
STATE_HISTORY_KEEP=10

# Whether `cl stop` asks for handoffs: a global default plus optional per-session
# overrides. Separate from MODELS because it answers a different question (what
# should happen to this session) and is written on a different cadence.
#
#   { "default": "on", "sessions": { "claude": { "Review": "off" } } }
#
# It exists to be TOGGLED for measurement: rotation trades a cost (one handoff
# request per session, per stop) against a saving (every later call carries a
# seeded context instead of a long transcript). Which wins is an empirical
# question about how someone actually works, so the tool has to be able to run
# both ways and record which way it ran.
ROTATE="$HOME/.config/claude-session/rotate.json"
# One appended line per `cl stop`. The point is to make a spend difference
# explainable rather than coincidental, so it records the CONTEXT SIZES at stop
# time — the per-call multiplier rotation actually reduces — not just a count.
ROTATION_LOG="$HOME/.config/claude-session/rotation-log.tsv"

# --- handoff / fresh-start config --------------------------------------------
# Where handoffs are written. Local state by default, because that is the only
# location this tool can assume exists on someone else's machine. Point
# CL_HANDOFF_DIR at a synced folder (a notes tree, a shared drive) if you want
# handoffs to follow you between machines — that is exactly why the fallback
# below exists: a synced directory can be slow to appear, partially hydrated,
# or briefly absent, and every path is resolved through handoff_root(), which
# falls back and SAYS SO rather than silently writing nowhere durable.
CL_HANDOFF_DIR="${CL_HANDOFF_DIR:-$HOME/.local/state/claude-session/handoff}"
CL_HANDOFF_FALLBACK_BASE="${CL_HANDOFF_FALLBACK_BASE:-$HOME/.local/state/claude-session/handoff-fallback}"
# The instruction typed into the pane. The default below asks for a handoff and
# nothing else; anything beyond that — which notes to tidy, which task list,
# house rules about what may be archived — is YOUR workflow, not this tool's,
# so it belongs in a file you own rather than in a shared script.
CL_HANDOFF_PROMPT_FILE="${CL_HANDOFF_PROMPT_FILE:-$HOME/.config/claude-session/handoff-prompt.txt}"
# The first message a fresh session receives (cl start --fresh). Same reasoning.
CL_RESUME_PROMPT_FILE="${CL_RESUME_PROMPT_FILE:-$HOME/.config/claude-session/resume-prompt.txt}"
# How long `cl stop` waits for requested handoffs to land before falling back to
# a plain stop. SHARED: the asks go out together and this window covers all of
# them at once, so it is wall clock for the whole round rather than per session.
# That is why it can afford to be generous — 180s is three minutes for every
# session simultaneously, where the serial version gave each of nineteen 45s and
# never reached thirteen of them. A real handoff on an idle session measured
# ~35s end to end (2026-10-07); the rest of the window is for a session that has
# to finish what it is doing first, since a queued ask only comes due then.
CL_HANDOFF_TIMEOUT="${CL_HANDOFF_TIMEOUT:-180}"
# How many ROUNDS of asking before giving up. A round asks every session that
# has not answered yet and is not visibly busy, then waits one shared window, so
# the worst case is ROUNDS × TIMEOUT for the whole stop rather than per session.
# A session that is mid-task may not read the first request; re-sending gives it
# another chance, but one that is merely still WORKING is never re-asked — see
# handoff_target_busy.
CL_HANDOFF_ATTEMPTS="${CL_HANDOFF_ATTEMPTS:-3}"
# WALL CLOCK FOR THE WAITING, across every round — not for the whole phase.
#
# The distinction is deliberate and was corrected after review (Codex, PR #19,
# 2026-10-13): dispatch is NOT charged against this. Twelve real iTerm sends
# measure about 10s, so a 3s budget can still take ~13s end to end.
#
# Dispatch is outside the bound ON PURPOSE. Asking every session is the entire
# point of the broadcast; cutting dispatch short when a budget expires would
# reintroduce exactly the fault this replaced — sessions that are never asked at
# all. What a runaway dispatch must not do is hang the stop, and that is
# CL_HANDOFF_SEND_TIMEOUT's job rather than this one's.
#
# So the worst case is roughly (sessions × SEND_TIMEOUT) + BUDGET, and both
# halves are bounded.
CL_HANDOFF_BUDGET="${CL_HANDOFF_BUDGET:-300}"
# How long any ONE send may take before it is killed. Bounds the dispatch pass:
# osascript waits on iTerm which waits on a GUI, and tmux waits on its server —
# either can wedge, and an unbounded send is a `cl stop` that
# never returns. Generous, because a busy GUI is slow but not stuck.
CL_HANDOFF_SEND_TIMEOUT="${CL_HANDOFF_SEND_TIMEOUT:-20}"
# Record of session names started fresh, with the OLD session id, so a fresh
# start is never a dead end — the prior conversation stays resumable even
# though its name now points at the new session.
FRESH_HISTORY="$HOME/.config/claude-session/fresh-history.json"

# handoff_root: echoes the directory to write handoffs into for this
# run, preferring the configured handoff dir and falling back to a local one when
# that is not there (or is not writable — a File Provider dataless dir can
# stat fine and fail every open(), a failure mode seen in practice with more
# than one sync client). Prints a one-line notice on stderr when it falls
# back, so the fallback is never silent.
_CL_HANDOFF_ROOT=""
# _ensure_session_dirs <base>: create the store, then CONFIRM it really is a
# directory. `mkdir -p`'s own exit status does not prove that — it can report
# success against a path component that is actually a plain FILE, and a
# regular file sitting at the configured path was silently accepted as a
# usable root until this check existed.
#
# Handoffs land directly in CL_HANDOFF_DIR, so the variable means what its
# name says. The one piece of structure this tool imposes beneath it is
# `consumed/`, where used handoffs are moved (see consume_handoff). Point
# CL_HANDOFF_DIR at a subfolder if you are aiming it into a shared notes tree.
_ensure_session_dirs() {
  mkdir -p "$1" 2>/dev/null
  [ -d "$1" ]
}

# handoff_root: the store — CL_HANDOFF_DIR when usable, else
# CL_HANDOFF_FALLBACK_BASE. Returns NON-ZERO (and prints nothing to stdout)
# only in the — expected to be rare — case where NEITHER can be made usable;
# callers (request_handoff, do_start) must check this rather than assume a root
# was resolved.
# usable_root <dir>: can we actually WRITE here? Both candidates get the same
# question. The fallback used to get only `[ -d ]`, so an existing but
# unwritable or dataless fallback was accepted, the prompt was sent toward a
# path that could never be written, and the caller waited out its whole
# timeout — the exact File Provider failure the primary probe exists to catch,
# unhandled on the path taken precisely when the primary has already failed.
usable_root() {
  local base="$1" probe
  mkdir -p "$base" 2>/dev/null || return 1
  [ -d "$base" ] || return 1
  probe="$base/.cl-write-probe.$$"
  ( printf '' > "$probe" ) 2>/dev/null || return 1
  rm -f "$probe" 2>/dev/null
  return 0
}

handoff_root() {
  [ -n "$_CL_HANDOFF_ROOT" ] && { printf '%s\n' "$_CL_HANDOFF_ROOT"; return 0; }
  if usable_root "$CL_HANDOFF_DIR"; then
    _CL_HANDOFF_ROOT="$CL_HANDOFF_DIR"; printf '%s\n' "$CL_HANDOFF_DIR"; return 0
  fi
  echo "claude-session: handoff dir unusable at $CL_HANDOFF_DIR — using fallback $CL_HANDOFF_FALLBACK_BASE" >&2
  if usable_root "$CL_HANDOFF_FALLBACK_BASE"; then
    _CL_HANDOFF_ROOT="$CL_HANDOFF_FALLBACK_BASE"; printf '%s\n' "$CL_HANDOFF_FALLBACK_BASE"; return 0
  fi
  echo "claude-session: fallback $CL_HANDOFF_FALLBACK_BASE is also unusable — no durable handoff location available" >&2
  return 1
}

# Path helpers all take the RESOLVED ROOT as their first argument, not the
# display name alone — round 2 of Codex review found that round 1's fix
# (having each helper call `handoff_root` itself) was incomplete: every real
# call site still invoked a helper through `$(...)`, which is a SUBSHELL, so
# `handoff_root`'s memoization was set there and lost the instant that
# subshell exited. Two helpers called moments apart could each resolve a
# DIFFERENT root if reachability changed in between, so a write and its
# handoff could land in different trees, or a fresh replacement could be told
# to read a third resolution. The fix that actually holds: resolve the root
# EXACTLY ONCE per operation, in the CALLING function, via a direct
# (non-substitution) `handoff_root >/dev/null` call — then thread that one
# value through every path built for that operation. These helpers are now
# pure functions of (root, name); they never call handoff_root themselves.
handoff_path() { printf '%s/%s.md' "$1" "$(name_component "$2")"; }

# ---------------------------------------------------------------------------
# Handoff lifecycle. The invariant the whole feature rests on:
#
#   AT MOST ONE UNCONSUMED HANDOFF PER SESSION.
#
# So the mere PRESENCE of <root>/<Name>.md means "written, and not yet used" —
# no mtime comparison, no staleness heuristic, no second source of truth to
# drift from the files. `cl start` consumes what it uses; `cl stop` sweeps a
# superseded leftover before asking for a new one. Everything consumed moves
# to <root>/consumed/ rather than being deleted, so a rotation that turns out
# badly is still recoverable from the file that produced it.
CONSUMED_SUBDIR="consumed"
INCOMPLETE_SUBDIR="incomplete"

# A handoff says how it was produced, in a trailing marker:
#
#   <!-- cl:clho:… -->      written in answer to a stop request (carries that
#                           request's nonce, which is how the stop confirms it)
#   <!-- cl:manual:<ts> --> written by hand via `cl handoff`
#
# The distinction is what lets a manual handoff serve as the escape hatch for
# an unreachable pane: a nonce handoff found sitting unconsumed has already
# been superseded (a skipped stop, a crash between rotate and consume) and is
# swept, but a manual one is an ANSWER and is honoured instead.
MANUAL_MARKER_PREFIX='<!-- cl:manual:'

# handoff_marker <file>: the payload of the marker on the file's LAST non-empty
# line, or nothing. Terminal position is the whole point — it is what makes the
# marker a COMPLETENESS signal and not just a label.
#
# A handoff is written temp-file-then-rename, so a complete one appears whole.
# But an agent that writes straight to the target and is killed mid-write
# leaves a real, readable, TRUNCATED file: plausible prose cut off
# mid-sentence, with no marker, because the marker is written last. Presence
# alone cannot tell that apart from a good handoff, and a replacement session
# seeded from one continues from a lie. (Reproduced 2026-09-25: a file ending
# "...currently ha" rotated a session.) A partially-synced file from a shared
# store fails the same way.
#
# Matching the last line also fixes the reverse error: a genuine handoff whose
# PROSE quotes or discusses a marker was previously classified by that mention.
handoff_marker() {
  local last payload
  [ -f "$1" ] || return 1
  last=$(grep -v '^[[:space:]]*$' -- "$1" 2>/dev/null | tail -1)
  case "$last" in
    '<!-- cl:'*' -->') payload=${last#'<!-- cl:'}; payload=${payload%' -->'} ;;
    *) return 1 ;;
  esac
  case "$payload" in
    manual:?*)                     printf '%s' "$payload" ;;
    clho:*[0-9]:*[0-9]:*[0-9]:*[0-9]) printf '%s' "$payload" ;;
    *) return 1 ;;
  esac
}

# A handoff is USABLE only if it carries a well-formed terminal marker. This is
# what the one-unconsumed-handoff invariant actually keys on: presence AND
# completeness, never presence alone.
handoff_is_complete() { handoff_marker "$1" >/dev/null 2>&1; }

# marker_sid <file>: the session id stamped into a manual marker
# (`manual:<ts>:<sid>`), or nothing. Manual handoffs written before this was
# added carry no sid and are accepted for any occupant — they predate the
# check, and refusing them would be a silent regression for existing files.
#
# What it defends: a `cl handoff` that began writing BEFORE a start claimed the
# active handoff finishes its rename AFTERWARDS, dropping a handoff for the
# PREVIOUS occupant of the name into the now-empty active path. The next start
# would rotate the replacement from its predecessor's notes.
# The sid is separated by '@', NOT ':' — an ISO-8601 timestamp is full of
# colons, so "everything after the last colon" read `00Z` out of a marker that
# carried no sid at all and reported it as a foreign session.
marker_sid() {
  local m; m=$(handoff_marker "$1" 2>/dev/null) || return 1
  case "$m" in manual:*@?*) printf '%s' "${m##*@}" ;; *) return 1 ;; esac
}
handoff_is_manual()   { case "$(handoff_marker "$1" 2>/dev/null)" in manual:?*) return 0 ;; *) return 1 ;; esac; }

# consume_handoff <root> <name> [reason]: move this session's unconsumed
# handoff into <root>/consumed/. Prints the new path on STDOUT so it composes
# with the caller that needs to read the file afterwards.
#
#   0  consumed — the path it moved to is on stdout
#   1  there was nothing to consume
#   2  a handoff is there but could NOT be moved
#
# 2 is kept distinct from 0 on purpose. A caller must not rotate off a handoff
# it failed to clear: the file would still be sitting there next time and the
# session would rotate again, forever, off an ever-staler file. Declining to
# rotate degrades to a plain resume, which loses nothing.
# The two moves this file needs have DIFFERENT atomicity requirements, and one
# primitive cannot serve both. Getting that wrong let two claimers each take the
# same handoff and report success.
#
#   claiming    source is the shared ACTIVE path, which other writers can replace.
#               Must be atomic FROM THE SOURCE: exactly one caller may win.
#   rolling back  source is our own private claim path, which nobody else can
#               touch. Must be atomic AT THE DESTINATION: never overwrite a newer
#               handoff published while the claim was out.
#
# `mv` is atomic from the source — a second rename of the same source fails,
# because the first removed it — but it OVERWRITES its destination.
# `ln` refuses an existing destination but is not a move at all: the unlink that
# follows is a separate step, so two callers can both link the same source to
# different destinations and both then "succeed" at removing it (`rm -f` reports
# success on an already-absent path). Worse, unlinking BY PATHNAME can remove a
# newer file that replaced the source in between — destroying the newer handoff
# while reporting the older one claimed.

# _link_noclobber <src> <dest>: link src to dest, refusing if dest exists, then
# unlink src. ONLY safe where src is private to this process — see above.
#   0  moved   1  dest already existed   2  linked but src could not be removed
_link_noclobber() {
  ln "$1" "$2" 2>/dev/null || return 1
  rm -f "$1" 2>/dev/null || return 2
  return 0
}

# _reserve_and_move <src> <dest>: claim src exclusively into dest.
#
# Two steps, each atomic, in the order that makes both properties hold:
#   1. create dest exclusively (`set -C` makes `>` fail if it exists), so this
#      move can never overwrite another writer's file;
#   2. `mv` src onto our own reservation, which is atomic from the source — so if
#      another claimer already took src, this rename fails and that claimer won.
# The reservation is released on failure so a lost race leaves no empty file.
#
#   0  claimed   1  dest was taken   2  src was gone (someone else won), or error
_reserve_and_move() {
  ( set -C; : > "$2" ) 2>/dev/null || return 1
  if mv "$1" "$2" 2>/dev/null; then return 0; fi
  rm -f "$2" 2>/dev/null
  return 2
}

# _archive_move <root> <subdir> <name> <src>: move src into <root>/<subdir>
# under a unique name, printing where it went.
#
# Uniqueness comes from a successful atomic creation, not from hoping two
# timestamps-plus-randoms never coincide. The previous version composed a name
# from time, pid and two $RANDOM draws and called that "unique by construction";
# it is not — $RANDOM is finite, pids are reused, and the subsequent `mv` would
# overwrite. Drawing again on collision is what actually guarantees it.
_archive_move() {
  local root="$1" subdir="$2" name="$3" src="$4" base stamp cand tries=0 rc
  mkdir -p "$root/$subdir" 2>/dev/null || return 2
  base=$(name_component "$name")
  stamp=$(date +%Y%m%d-%H%M%S 2>/dev/null || echo unknown)
  while [ "$tries" -lt 50 ]; do
    cand="$root/$subdir/$base-$stamp-$$$RANDOM$RANDOM.md"
    _reserve_and_move "$src" "$cand"; rc=$?
    case "$rc" in
      0) printf '%s' "$cand"; return 0 ;;
      1) tries=$((tries+1)); continue ;;   # name taken: draw another
      *) return 2 ;;                        # source gone: another claimer won
    esac
  done
  return 2
}

# quarantine_handoff <root> <name>: move an INCOMPLETE handoff out of the way.
# Not deleted — it is real work, and it is the evidence of what went wrong. Not
# left in place either: it would be re-examined and re-rejected on every future
# start while blocking nothing.
quarantine_handoff() {
  local root="$1" name="$2" why="${3:-}" hp dest
  hp=$(handoff_path "$root" "$name")
  [ -f "$hp" ] || return 1
  [ -n "$why" ] || why='INCOMPLETE (no completion marker on its last line) — most likely written straight to the file and cut off by the kill'
  if dest=$(_archive_move "$root" "$INCOMPLETE_SUBDIR" "$name" "$hp"); then
    printf '⚠ the handoff for "%s" is %s.\n' "$name" "$why" >&2
    printf '   Not rotating from it; resuming the session as it was. Moved to %s\n' "$dest" >&2
    return 0
  fi
  printf '⚠ the handoff for "%s" is unusable (%s) and could not be moved aside — not rotating; move or delete it by hand\n' "$name" "$why" >&2
  return 2
}

consume_handoff() {
  local root="$1" name="$2" reason="${3:-}" hp dest
  hp=$(handoff_path "$root" "$name")
  [ -f "$hp" ] || return 1
  if dest=$(_archive_move "$root" "$CONSUMED_SUBDIR" "$name" "$hp"); then
    printf 'ℹ consumed handoff for "%s"%s → %s\n' "$name" "${reason:+ ($reason)}" "$dest" >&2
    printf '%s\n' "$dest"
    return 0
  fi
  printf '⚠ could not move the handoff for "%s" out of %s — not rotating it (it would rotate again every start); move or delete it by hand\n' \
    "$name" "$hp" >&2
  return 2
}

# ---------------------------------------------------------------------------
# Claim / commit / rollback.
#
# Consuming a handoff is only safe once the replacement has actually been
# accepted. Moving it to consumed/ first and then launching means a launch that
# fails leaves the session with NO active handoff — and, once the restart list
# is cleared, no row either. That is not the "always falls back to a plain
# resume" floor this design claims; it is a hole in it.
#
# So the move happens in two steps. A CLAIM takes the handoff out of the active
# path (nothing else can rotate from it) while keeping it restorable. Only once
# the backend has accepted the launch is the claim COMMITTED to consumed/. If
# anything fails in between, it is ROLLED BACK to the active path and the
# session resumes as though nothing had been attempted.
#
# claim_handoff <root> <name> [expected-sid] -> prints the path the replacement
# should read; non-zero if there is nothing claimable.
#
# ONE move, straight to the handoff's PERMANENT home under consumed/. An
# earlier design moved it to .claims/ first and to consumed/ after the launch
# was accepted — but the replacement's first message had already been built
# from the .claims path, so committing renamed the file out from under a
# prompt that was already on its way to the agent. Every rotation told the new
# session to read a path that no longer existed. (Found by Codex review
# 20260925-1457; reproduced by recording the agent's argv.)
#
# So the pathname handed to another process is never renamed again. "Claiming"
# and "consuming" are the same move, and the only recovery is rollback — which
# is why rollback has to be careful (see below).
# _reject_claimed <root> <name> <archived> <why>: an archived generation that
# failed acceptance. It is already out of the active path, so it cannot be left
# there — it is moved to incomplete/ and reported, and consumed/ keeps its meaning
# of "a replacement actually started from this".
_reject_claimed() {
  local root="$1" name="$2" arch="$3" why="$4" moved
  if moved=$(_archive_move "$root" "$INCOMPLETE_SUBDIR" "$name" "$arch"); then
    printf '⚠ the handoff for "%s" is %s.\n' "$name" "$why" >&2
    printf '   Not rotating from it; resuming the session as it was. Moved to %s\n' "$name" >&2
    printf '   (%s)\n' "$moved" >&2
  else
    printf '⚠ the handoff for "%s" is %s, and could not be filed — it is at %s\n' "$name" "$why" "$arch" >&2
  fi
  return 0
}

# ACCEPTANCE HAPPENS AFTER THE MOVE, on the generation that actually won.
#
# Checking the active pathname and then moving it is a TOCTOU: a writer can
# atomically publish a different generation in between, and `_reserve_and_move`
# then correctly moves the NEW one while the caller's success was decided about
# the OLD one. The concrete failure is an unauthorized generation switch — a
# handoff validated as complete and stamped for sid-A, replaced by one stamped
# sid-B (or truncated, with no marker at all), and the replacement started from
# that instead. The foreign-session and completeness guards were both bypassable
# this way.
#
# So the rename establishes identity first, and every policy check runs against
# the stable archived path it returns. The pre-move check below is kept only to
# avoid a pointless move in the common case; it is not the acceptance boundary.
claim_handoff() {
  local root="$1" name="$2" want_sid="${3:-}" hp dest got_sid
  hp=$(handoff_path "$root" "$name")
  [ -f "$hp" ] || return 1
  # Cheap early exit, not authorization.
  if ! handoff_is_complete "$hp"; then
    quarantine_handoff "$root" "$name" >/dev/null
    return 1
  fi
  if ! dest=$(_archive_move "$root" "$CONSUMED_SUBDIR" "$name" "$hp"); then
    printf '⚠ could not claim the handoff for "%s" (%s) — not rotating it; resuming as-is\n' "$name" "$hp" >&2
    return 2
  fi
  # From here on, $dest is stable: nothing else can replace it.
  if ! handoff_is_complete "$dest"; then
    _reject_claimed "$root" "$name" "$dest" \
      'INCOMPLETE — it was replaced between validation and the claim, and the generation that arrived has no completion marker'
    return 1
  fi
  if [ -n "$want_sid" ] && got_sid=$(marker_sid "$dest") && [ "$got_sid" != "$want_sid" ]; then
    _reject_claimed "$root" "$name" "$dest" \
      "from a DIFFERENT session ($got_sid, not $want_sid) — a previous occupant of this name"
    return 1
  fi
  printf '%s' "$dest"
  return 0
}

# commit_claim <root> <name> <claim-path> [reason]: the replacement is running.
# The file is ALREADY at its permanent path, so this only records the fact —
# there is deliberately nothing left to move at the point another process holds
# the pathname.
commit_claim() {
  local name="$2" claim="$3" reason="${4:-}"
  printf 'ℹ consumed handoff for "%s"%s → %s\n' "$name" "${reason:+ ($reason)}" "$claim" >&2
}

# rollback_claim <root> <name> <claim-path>: the replacement never started, so
# put the handoff back where a future start will find it.
#
# ONLY if the active path is still free. While a claim is out, the old session
# (or `cl handoff`) can publish a NEWER handoff at the active path; moving the
# claim back on top of it would silently destroy the more recent answer. In
# that case the claim stays filed and says so.
rollback_claim() {
  local root="$1" name="$2" claim="$3" hp rc
  [ -f "$claim" ] || return 1
  hp=$(handoff_path "$root" "$name")
  # link-then-unlink is correct HERE and only here: the source is our own claim
  # path under consumed/, which no other writer can replace, so unlinking it by
  # pathname cannot remove someone else's file. What must not be overwritten is
  # the DESTINATION — a newer handoff published at the active path while this
  # claim was out — and a link that refuses an existing target is exactly that.
  _link_noclobber "$claim" "$hp"; rc=$?
  if [ "$rc" -eq 1 ]; then
    printf 'ℹ not restoring the handoff for "%s": a newer one is already there. The older one stays filed at %s\n' \
      "$name" "$claim" >&2
    return 0
  fi
  if [ "$rc" -eq 0 ]; then
    printf 'ℹ put the handoff for "%s" back — nothing was started, so nothing is spent\n' "$name" >&2
    return 0
  fi
  printf '⚠ could not restore the handoff for "%s" after a failed start — it is at %s\n' "$name" "$claim" >&2
  return 2
}

# plan_rotation <root> <name>: decide whether this session rotates on start,
# and if so consume its handoff and print the consumed path. Non-zero means
# "resume it as it was" — the safe direction, taken whenever there is no
# handoff, no store, or a handoff that could not be cleared.
plan_rotation() {
  local root="$1" name="$2" hp dest
  [ -n "$root" ] || return 1
  hp=$(handoff_path "$root" "$name")
  [ -f "$hp" ] || return 1
  # Same discipline as claim_handoff: the check below is an early exit, and the
  # acceptance check is on the archived generation. Validating the active path and
  # then consuming it let an incomplete replacement win in between and be rotated
  # from — the truncation case this whole guard exists for.
  if ! handoff_is_complete "$hp"; then
    quarantine_handoff "$root" "$name" >/dev/null
    return 1
  fi
  dest=$(consume_handoff "$root" "$name" "rotating on start") || return $?
  if ! handoff_is_complete "$dest"; then
    _reject_claimed "$root" "$name" "$dest" \
      'INCOMPLETE — it was replaced between validation and the claim, and the generation that arrived has no completion marker'
    return 1
  fi
  printf '%s' "$dest"
  return 0
}

# handoff_age_human <path>: "3 minutes"/"19 days" for a file, or "" if unknown.
# Used when a manual handoff is honoured — the age is the one thing that makes
# an old hand-written handoff obvious before it is acted on.
handoff_age_human() {
  local f="$1" mt now d
  mt=$(stat -f %m "$f" 2>/dev/null) || return 0
  now=$(date +%s 2>/dev/null || echo 0)
  d=$(( now - mt )); [ "$d" -lt 0 ] && d=0
  if   [ "$d" -lt 90 ];    then printf '%s seconds' "$d"
  elif [ "$d" -lt 5400 ];  then printf '%s minutes' "$(( d / 60 ))"
  elif [ "$d" -lt 172800 ]; then printf '%s hours'  "$(( d / 3600 ))"
  else                          printf '%s days'    "$(( d / 86400 ))"
  fi
}

# name_component <display-name> -> one safe, COLLISION-FREE path component.
#
# Round 1 stripped slashes and a leading dot; round 2 of Codex review found
# that lossy (found ".foo" and "_foo" both mapping to "_foo" — one session
# could then overwrite another's handoff) and found that it let raw
# control bytes (newline, CR, tab) straight through, which could re-open the
# early-submit/key-injection risk of typing into a pane if a name ever reached
# that path.
#
# Fixed with byte-wise percent-encoding, restricted to exactly the bytes that
# are unsafe here: '/' (path traversal), '%' (so the encoding is unambiguous
# to reverse), and C0 controls + DEL (0x00-0x1F, 0x7F — never let one of
# these reach a filesystem path or a downstream terminal/AppleScript
# argument as a raw byte). Every other byte, including multibyte UTF-8
# glyphs, passes through unchanged — handoff dir filenames tolerate those fine.
# This is injective (two different inputs can never encode to the same
# output): decoding is "scan for %XX, else literal", so nothing collides.
# A LITERAL leading dot in the encoded result can therefore only come from a
# literal leading dot in the input (encoding never manufactures one) — that
# case is still guarded (prefixed, not stripped, so ".foo" and "foo" stay
# distinct) to keep "." and ".." from reappearing as a bare component.
#
# Known, accepted residual gap: this does not defend against the handoff dir's
# filesystem applying Unicode normalization (e.g. APFS's HFS+-compatibility
# NFD folding) to two byte-distinct-but-canonically-equivalent names. Real
# session names come from a human typing `cl new "Name"`, where that
# collision is exceedingly unlikely; a fully normalization-safe scheme was
# judged not worth the complexity here.
name_component() {
  local n="$1" out="" c i hex
  for (( i=0; i<${#n}; i++ )); do
    c="${n:i:1}"
    case "$c" in
      /|%)
        printf -v c '%%%02X' "'$c"
        ;;
      *)
        # `'$c` (bash's char-to-ordinal syntax) is only meaningful for a
        # single-byte ASCII character; a multibyte UTF-8 glyph in `c` takes
        # this branch too but its ordinal value is always >= 0x80, so it
        # never matches the control-byte test below and passes through
        # unescaped, which is exactly what's wanted.
        printf -v hex '%d' "'$c" 2>/dev/null || hex=128
        if [ "$hex" -lt 32 ] || [ "$hex" -eq 127 ]; then
          printf -v c '%%%02X' "'$c"
        fi
        ;;
    esac
    out+="$c"
  done
  # A LEADING DOT must be ENCODED, not prefixed — prefixing broke
  # injectivity: ".foo" -> "_.foo" collided with a literal "_.foo" input
  # (found in Codex review round 3, 2026-09-23; round 2's fix collided
  # differently and was already fixed once). Encoding the dot itself keeps
  # the mapping reversible (a literal "%" is already escaped above, so
  # "%2E" cannot occur any other way) while still guaranteeing the output
  # never starts with "." — "." and ".." can't reappear as bare components.
  case "$out" in .*) out="%2E${out#.}" ;; esac
  [ -n "$out" ] || out="_"
  printf '%s' "$out"
}

# *_preview: read-only path resolution for --dry-run output ONLY. Real runs
# always go through handoff_root (which mkdir's + write-probes to catch a File
# Provider dataless directory) — a dry run must do neither (found in Codex
# review, 2026-09-23: the original request_handoff computed handoff_path,
# and therefore called handoff_root's mutating probe, before checking whether
# it was even a dry run). This never memoizes and never mkdir's; it only
# reports what a real run would most likely resolve to.
#
# Known gap, accepted: because it never mkdir's, a CL_HANDOFF_DIR that exists
# but whose `Sessions` subdirectory doesn't YET exist previews as unreachable
# even though a real run would happily create it and succeed. In practice
# this rarely bites — a handoff dir that has been used before already exists —
# but it means a --dry-run preview against a genuinely brand-new handoff dir
# path can undersell what a real run would do.
# Mirrors handoff_root's DECISION without mutating anything. A dry run cannot
# prove future creatability, but it must not assert the fallback for the most
# common first-use case either: a configured directory that does not exist yet,
# whose nearest existing ancestor is writable, is exactly what a real run
# creates and uses. Announcing the fallback there told a new user their
# configured path was unusable when it was about to work.
_creatable() {
  local d="$1"
  while [ -n "$d" ] && [ ! -e "$d" ]; do
    case "$d" in */*) d=${d%/*}; [ -z "$d" ] && d=/ ;; *) d=. ;; esac
  done
  [ -d "$d" ] && [ -w "$d" ]
}
handoff_root_preview() {
  if { [ -d "$CL_HANDOFF_DIR" ] && [ -w "$CL_HANDOFF_DIR" ]; } || _creatable "$CL_HANDOFF_DIR"; then
    printf '%s\n' "$CL_HANDOFF_DIR"
  else
    # Announce the fallback here too — logging is not a mutation, and a dry
    # run silently disagreeing with what a real run would say (and log) is
    # its own kind of surprise.
    echo "claude-session: handoff dir unusable at $CL_HANDOFF_DIR — using fallback $CL_HANDOFF_FALLBACK_BASE" >&2
    printf '%s\n' "$CL_HANDOFF_FALLBACK_BASE"
  fi
}
handoff_path_preview() { printf '%s/%s.md' "$(handoff_root_preview)" "$(name_component "$1")"; }

# Every discover* function emits:  name<TAB>sid<TAB>cwd<TAB>epoch<TAB>agent
# agent is "claude" or "codex". Consumers must read all five fields.

# Session ids are DATA read from disk and later spliced into command strings
# (tmux pane commands, eval'd exec lines). They are never trusted: a Claude id
# must look like a transcript basename, a Codex id must be a UUID. Anything
# else is dropped at discovery, so no later consumer has to think about it.
valid_claude_sid() { case "$1" in ''|*[!A-Za-z0-9._-]*) return 1 ;; esac; return 0; }
# A Codex id is a UUID: 8-4-4-4-12 hex groups. Checked by layout, not just
# length and alphabet — 36 hyphens is not a session id.
valid_codex_sid() {
  local a b c d e rest
  IFS=- read -r a b c d e rest <<CLSID
$1
CLSID
  [ -z "$rest" ] || return 1
  [ "${#a}" -eq 8 ] && [ "${#b}" -eq 4 ] && [ "${#c}" -eq 4 ] && [ "${#d}" -eq 4 ] && [ "${#e}" -eq 12 ] || return 1
  case "$a$b$c$d$e" in *[!0-9a-fA-F]*) return 1 ;; esac
  return 0
}

# discover_claude — newest transcript per *current* name
discover_claude() {
  # custom-title is the record /rename writes; it covers every named session.
  # (The older agent-name record exists only for a subset, so grepping it
  # silently dropped half the sessions — including the most-used ones.)
  grep -rl '"customTitle"' "$PROJECTS"/*/*.jsonl 2>/dev/null \
    | xargs ls -t 2>/dev/null \
    | while IFS= read -r f; do
        name=$(grep -oE '"customTitle":"[^"]+"' "$f" 2>/dev/null | tail -1 | sed 's/.*"customTitle":"//; s/"$//')
        [ -n "$name" ] || continue
        sid=$(basename "$f" .jsonl)
        valid_claude_sid "$sid" || continue
        cwd=$(grep -m1 -oE '"cwd":"[^"]*"' "$f" 2>/dev/null | sed 's/.*"cwd":"//; s/"$//')
        [ -d "$cwd" ] || continue   # drop sessions whose working dir no longer exists
        epoch=$(stat -f %m "$f" 2>/dev/null || echo 0)
        printf '%s\t%s\t%s\t%s\tclaude\n' "$name" "$sid" "$cwd" "$epoch"
      done \
    | awk -F'\t' '!seen[$1]++'
}

# discover_codex — named Codex CLI sessions (`/rename` inside codex).
#
# Codex has no registry of names either. Its rename index is an append-only
# JSONL of {id, thread_name, updated_at}; the LAST line per id is the current
# name (a session renamed three times has three lines). The working dir lives
# in the rollout transcript's first line (session_meta.cwd), and the rollout's
# mtime is the recency signal. Rollouts are searched ONLY under sessions/ —
# never all of CODEX_HOME — so `codex archive`d sessions (moved to
# archived_sessions/) drop out of the picker instead of resurfacing.
#
# Fails soft: a malformed index line is skipped, an index entry with no active
# rollout is skipped (archived or deleted — not an error). Only a layout we
# don't recognise at all gets a diagnostic, so an empty list is never silent
# when Codex is clearly installed but its storage has moved on.
discover_codex() {
  [ -r "$CODEX_INDEX" ] || return 0
  if [ ! -d "$CODEX_SESSIONS" ]; then
    echo "claude-session: $CODEX_INDEX exists but $CODEX_SESSIONS does not — unsupported Codex storage layout, skipping Codex sessions" >&2
    return 0
  fi
  awk '
    match($0, /"id":"[^"]+"/) {
      id = substr($0, RSTART + 6, RLENGTH - 7)
      if (match($0, /"thread_name":"[^"]*"/)) {
        nm = substr($0, RSTART + 15, RLENGTH - 16)
        if (nm != "") name[id] = nm
      }
    }
    END { for (id in name) printf "%s\t%s\n", id, name[id] }
  ' "$CODEX_INDEX" 2>/dev/null \
    | while IFS=$'\t' read -r sid name; do
        valid_codex_sid "$sid" || continue
        f=$(find "$CODEX_SESSIONS" -type f -name "rollout-*-${sid}.jsonl" 2>/dev/null | head -1)
        [ -n "$f" ] || continue   # no active rollout: archived or deleted
        cwd=$(head -1 "$f" 2>/dev/null | grep -oE '"cwd":"[^"]*"' | head -1 | sed 's/.*"cwd":"//; s/"$//')
        [ -d "$cwd" ] || continue
        epoch=$(stat -f %m "$f" 2>/dev/null || echo 0)
        printf '%s\t%s\t%s\t%s\tcodex\n' "$name" "$sid" "$cwd" "$epoch"
      done \
    | sort -t "$(printf '\t')" -k4,4nr | awk -F'\t' '!seen[$1]++'
}

# discover — both agents, newest first. Names are unique per agent (each
# source dedupes its own), but the SAME name may exist in both; that is left
# in so the direct-launch path can refuse it explicitly rather than pick one.
discover() {
  { discover_claude; discover_codex; } | sort -t "$(printf '\t')" -k4,4nr
}

reltime() {
  local now diff; now=$(date +%s); diff=$(( now - ${1:-0} ))
  if   [ "$diff" -lt 3600 ];  then echo "$((diff/60))m ago"
  elif [ "$diff" -lt 86400 ]; then echo "$((diff/3600))h ago"
  else echo "$((diff/86400))d ago"; fi
}

# tmux_name <name> [agent]: the tmux session identity. Codex sessions are
# prefixed so a Claude and a Codex session sharing a display name never share
# a tmux session — `tmux new-session -A` would otherwise silently attach to
# whichever agent got there first and drop the launch command on the floor.
tmux_name() {
  local base; base=$(printf '%s' "$1" | tr ' .:/' '____')
  case "${2:-claude}" in codex) printf 'codex_%s' "$base" ;; *) printf '%s' "$base" ;; esac
}

# in_iterm: this shell is hosted by iTerm2 itself. Distinct from iterm_running:
# "iTerm is open somewhere" is the wrong gate for OPENING tabs — it would open
# them in a terminal the user isn't looking at. (iterm_running stays correct for
# CLOSING previously-tagged iTerm tabs.)
in_iterm() { [ "${TERM_PROGRAM:-}" = "iTerm.app" ]; }

# use_tmux: should this launch be wrapped in tmux?
#
# NOT in iTerm, by default. iTerm2 ships a Claude Code integration whose
# profile triggers key on the tab's foreground job name, and whose status hooks
# locate the tab from the agent's tty. Wrapped in tmux the job is `tmux` and the
# tty is a tmux pty, so neither can find the tab — the integration silently does
# nothing. Running the agent as the tab's own process is what makes it work.
# CL_TMUX=1 opts back in, trading the integration for detach/reattach.
#
# Outside iTerm (Terminal.app, ssh, other emulators) nothing changes: tmux when
# it is available, because there detach/reattach is the only persistence there is.
use_tmux() {
  command -v tmux >/dev/null 2>&1 || return 1
  if in_iterm; then [ "${CL_TMUX:-0}" = "1" ]; else return 0; fi
}

# drop_cmux_env: strip every inherited CMUX_* before handing control to an
# agent. ALWAYS — there is no cmux host any more, so every launch is a non-cmux
# launch.
#
# ── WHY THIS SURVIVED REMOVING cmux ─────────────────────────────────────────
#
# It was never only a cmux-host feature; it protects the two hosts that remain.
# A tmux server first started under cmux keeps CMUX_* in its GLOBAL environment
# and hands them to every pane opened later — including panes opened from iTerm
# long after that cmux context died. cmux's own Claude hooks read those ids and
# dial a dead or wrong socket on every tool call. Removing the scrub along with
# the cmux branches regressed iTerm and tmux launches, which the first cut of
# this removal did; Codex's PR #21 review caught it.
#
# Removing cmux as a host makes the rule simpler, not unnecessary: the old code
# had to decide whether this shell was a live cmux pane before scrubbing, and
# now the answer is always no.
drop_cmux_env() {
  local v
  for v in $(env | sed -n 's/^\(CMUX_[A-Za-z0-9_]*\)=.*/\1/p'); do
    unset "$v" 2>/dev/null
  done
}

# claude_cmd / codex_cmd: the one place each agent's binary name lives, so the
# launch paths never spell it themselves. They once chose a cmux wrapper
# (`cmux claude-teams`); cmux support was removed 2026-10-20 — see DECISIONS.md.
claude_cmd() { printf 'claude'; }
codex_cmd()  { printf 'codex'; }

# Codex launch policy. cl adds NO approval/sandbox flag of its own: codex's
# configured defaults apply, exactly as if the user had typed `codex resume`.
# CL_CODEX_ARGS is purely additive and is TRUSTED SHELL SYNTAX — it is spliced
# into the tmux command string verbatim, so quote it as you would on a
# command line (e.g. CL_CODEX_ARGS='-m gpt-5 --approve-for-me'). It is placed
# BEFORE the subcommand (`codex <args> resume <id>`): these are top-level
# options, and some Codex builds reject them after `resume` while every build
# accepts them before it. `--remote` is unsupported here: discovery reads
# local storage, so resuming a locally found id on a remote app server is
# meaningless.
# (Claude's path keeps --dangerously-skip-permissions: that predates this
# design and is documented in DECISIONS.md rather than silently changed.)
codex_args() { printf '%s' "${CL_CODEX_ARGS:-}"; }

# --- per-session model -------------------------------------------------------
# A remembered model is spliced into shell command strings (tmux's command
# argument and the exec paths), so it is validated on the way
# IN and quoted on the way out. The charset allows what real model identifiers
# use — letters, digits, dot, underscore, hyphen, colon, slash, so both a plain
# id and a fully qualified cloud resource name pass — plus SQUARE BRACKETS, for
# the `opus[1m]` 1M-context variants the agent accepts.
#
# Brackets are the one admitted character class a shell WOULD act on (globbing),
# so they rely on the escaping at use time rather than on the charset. That is
# only sound because every consumer goes through model_flag, which applies
# `printf '%q'`, and every result lands in a command string that is evaluated —
# never passed as a literal argv element. Everything else a shell acts on is
# still refused outright.
#
# Refusing at set time means the stored file can never hold something dangerous;
# the quoting at use time is what makes brackets safe specifically. Two
# different guarantees, and the charset comment used to claim only the first.
valid_model() {
  case "$1" in
    '') return 1 ;;
    # `[` and `]` are allowed because `opus[1m]` is a real model spec the agent
    # accepts — the 1M-context variant — and refusing it meant that variant
    # could not be set per session at all. Confirmed working on a Bedrock-backed
    # machine, 2026-10-08.
    #
    # Safe because every consumer goes through model_flag, which applies
    # `printf '%q'`, and the result always lands in a shell command STRING that
    # tmux/sh then evaluates — there is no path that takes the escaped form
    # as a literal argv element. Widening this without that single choke point
    # would be a glob-injection.
    #
    # The ORDER in the bracket expression is load-bearing: `]` must come first
    # after the `!` to be literal, and `-` must come last. Verified against
    # shell metacharacters, spaces, quotes and globs rather than assumed — this
    # file has lost to `case` patterns before.
    *[!]A-Za-z0-9._:/[-]*) return 1 ;;
    *) return 0 ;;
  esac
}

# model_for <name> <agent>: the remembered model, or nothing.
model_for() {
  [ -r "$MODELS" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  local m
  m=$(jq -r --arg a "${2:-claude}" --arg n "$1" '.[$a][$n] // empty' "$MODELS" 2>/dev/null) || return 0
  # Re-validate on the way out: the file is user-editable, and a hand-edited
  # value must not reach a command line just because it is on disk.
  valid_model "$m" || { [ -n "$m" ] && printf 'claude-session: ignoring unsafe model for "%s" in %s\n' "$1" "$MODELS" >&2; return 0; }
  printf '%s' "$m"
}

# model_flag <agent> <model>: the flag pair that selects a model, quoted, with
# a leading space — or nothing when there is no model to apply.
model_flag() {
  local agent="$1" model="$2"
  [ -n "$model" ] || return 0
  case "$agent" in
    codex)
      # CL_CODEX_ARGS is trusted verbatim shell syntax the user controls. If it
      # already names a model, that is an explicit choice made later than this
      # one; adding a second flag would either conflict or silently win.
      # Codex parses with clap, which accepts -m VALUE, -mVALUE, --model VALUE
      # and --model=VALUE. Recognising only the space-separated forms let
      # CL_CODEX_ARGS='--model=x' through, and then BOTH options reached codex —
      # so the documented "explicit choice wins" rule silently did not hold.
      case " $(codex_args) " in
        *' -m '*|*' --model '*|*' --model='*|*' -m'[!' ']*)
          printf 'claude-session: CL_CODEX_ARGS already sets a model — leaving the remembered one unused\n' >&2
          return 0 ;;
      esac
      printf ' -m %s' "$(printf '%q' "$model")" ;;
    *) printf ' --model %s' "$(printf '%q' "$model")" ;;
  esac
}

# An atomic rename keeps the file from tearing; it does NOT stop two shells
# from each reading the same object, editing a different key, and the later
# rename dropping the earlier edit. The whole read-modify-write is serialised.
#
# Same ownership rule as the launch registry: the lock names its holder, and is
# reclaimed only on PROOF the holder is gone (its start token no longer
# matches), never on age.
# store_lock <file> / store_unlock <file>: the read-modify-write lock for a
# small JSON store under ~/.config/claude-session.
#
# Generalised from models_lock when the rotation store needed the same thing. It
# is deliberately ONE implementation rather than two: the reasoning below about
# never unlinking a stale lock is subtle, was got wrong once already, and a
# second copy is a second chance to get it wrong. models_lock/models_unlock
# remain as named wrappers so their call sites still read as being about models.
store_lock() {
  local lock="$1.lock" holder hpid me i=0
  # Fail closed on our own identity FIRST: a lock created from an empty token
  # publishes a weak "PID:" holder that the next writer reads as stale.
  me=$(claim_token)
  case "$me" in
    *:) echo "claude-session: cannot read this process's start time — refusing to update $1 unowned" >&2
        return 1 ;;
  esac
  while [ "$i" -lt 100 ]; do
    ln -s "$me" "$lock" 2>/dev/null && return 0
    holder=$(readlink "$lock" 2>/dev/null) || { i=$((i+1)); sleep 0.05; continue; }
    hpid=${holder%%:*}
    # A stale lock is NEVER unlinked automatically — the same rule, and the
    # same reason, as acquire_launch. Validating the symlink and then removing
    # its PATHNAME are two operations: between them another waiter can reclaim
    # and establish a live claim, and this delete would destroy THAT claim,
    # putting two writers inside the read-modify-write together. The start-token
    # proof authenticates the object read, not the object later unlinked, and
    # portable shell has no compare-and-swap to close the gap.
    #
    # I implemented the rejected pattern here while the analysis rejecting it
    # sat forty lines above (caught in review, 2026-09-21). Report it and let a
    # person clear it; a writer has to die inside a few-millisecond window to
    # leave one.
    case "$hpid" in
      ''|*[!0-9]*)
        echo "claude-session: $lock is malformed — clear it, then retry:" >&2
        echo "  rm -f $(printf '%q' "$lock")" >&2
        return 1 ;;
    esac
    if [ "$(start_token "$hpid")" != "${holder#*:}" ]; then
      echo "claude-session: a previous writer (pid $hpid) died holding the model lock — clear it, then retry:" >&2
      echo "  rm -f $(printf '%q' "$lock")" >&2
      return 1
    fi
    sleep 0.05
    i=$((i+1))
  done
  echo "claude-session: another process is updating $1 — try again" >&2
  return 1
}
# Releasing is safe where reclaiming is not: this unlinks only while the link
# still names US, so it cannot delete a successor's lock.
store_unlock() {
  local lock="$1.lock"
  [ "$(readlink "$lock" 2>/dev/null)" = "$(claim_token)" ] && rm -f "$lock"
  return 0
}

models_lock()   { store_lock   "$MODELS"; }
models_unlock() { store_unlock "$MODELS"; }
rotate_lock()   { store_lock   "$ROTATE"; }
rotate_unlock() { store_unlock "$ROTATE"; }

# --- rotation policy ---------------------------------------------------------
#
# "Will `cl stop` ask this session for a handoff?" Three layers, and they answer
# different questions, so they are kept apart rather than collapsed:
#
#   POLICY   what should happen        rotate.json / CL_ROTATE / a stop flag
#   STATE    what is waiting now       a complete unconsumed handoff on disk
#   ADVICE   what probably should      the context-size hint in `cl --list`
#
# Conflating policy with state is how a toggle becomes untrustworthy: a session
# can have rotation ON and nothing pending, or OFF with a handoff someone wrote
# by hand, and both are worth seeing.

# ── RESTART MODES ──────────────────────────────────────────────────────────
#
# What `cl stop` / `cl start` do with a Claude session (docs/restart-modes.md;
# a Codex session can be resume or fresh — see CODEX MODES below):
#
#   compact-resume  pre-compact request, /compact, stop; resume with a first prompt
#   handoff         ask for a handoff, stop; start fresh from it
#   fresh           stop with no handoff; start a NEW session under the name
#   resume          stop; resume as-is
#
# The store started life as an on/off toggle, and files written then must keep
# meaning exactly what they meant: "on" was the handoff rotation and "off" the
# plain resume. So both are read as aliases, forever. Only the BUILT-IN default
# — used when nothing is stored at all — is compact-resume.
CL_MODE_BUILTIN_DEFAULT="compact-resume"
_mode_normalize() {
  case "$1" in
    on|handoff)              printf 'handoff' ;;
    off|resume)              printf 'resume' ;;
    compact-resume|compact)  printf 'compact-resume' ;;
    fresh)                   printf 'fresh' ;;
    *) return 1 ;;
  esac
}
# The short form for narrow cells: compact-resume is 14 characters.
_mode_short() { case "$1" in compact-resume) printf 'compact' ;; *) printf '%s' "$1" ;; esac; }

# A stored value is one of the modes or one of the two legacy aliases. Anything
# else in the file is a hand edit, and is reported rather than guessed at — the
# same rule model_for follows.
_rotate_valid() { _mode_normalize "$1" >/dev/null 2>&1; }

rotate_default() {
  local v
  [ -r "$ROTATE" ] || { printf '%s' "$CL_MODE_BUILTIN_DEFAULT"; return 0; }
  command -v jq >/dev/null 2>&1 || { printf '%s' "$CL_MODE_BUILTIN_DEFAULT"; return 0; }
  v=$(jq -r '.default // empty' "$ROTATE" 2>/dev/null)
  if [ -n "$v" ] && ! _rotate_valid "$v"; then
    printf 'claude-session: ignoring unreadable default "%s" in %s — using the built-in default (%s)\n' \
      "$v" "$ROTATE" "$CL_MODE_BUILTIN_DEFAULT" >&2
    printf '%s' "$CL_MODE_BUILTIN_DEFAULT"; return 0
  fi
  [ -n "$v" ] || { printf '%s' "$CL_MODE_BUILTIN_DEFAULT"; return 0; }
  _mode_normalize "$v"
}

# rotate_for <name> [agent] -> compact-resume | handoff | fresh | resume | n/a
#
# n/a for Codex, and that is a fact about the mechanism rather than a setting:
# compaction and a handoff both need a Claude session acting on itself. A Codex
# session's own mode (resume or fresh) is codex_mode_for's answer, kept out of
# this one so no Claude pass can act on it.
rotate_for() {
  local name="$1" agent="${2:-claude}" v
  [ "$agent" = "claude" ] || { printf 'n/a'; return 0; }
  if [ -r "$ROTATE" ] && command -v jq >/dev/null 2>&1; then
    v=$(jq -r --arg a "$agent" --arg n "$name" '.sessions[$a][$n] // empty' "$ROTATE" 2>/dev/null)
    if [ -n "$v" ]; then
      if _rotate_valid "$v"; then _mode_normalize "$v"; return 0; fi
      printf 'claude-session: ignoring unreadable setting "%s" for "%s" in %s\n' "$v" "$name" "$ROTATE" >&2
    fi
  fi
  rotate_default
}

# Which layer decided, for `cl rotate status`. A week of measurements is
# ambiguous without it — "off" could be the experiment or a one-off override.
rotate_source() {
  local name="$1" agent="${2:-claude}" v
  if [ "$agent" != "claude" ]; then
    [ -n "$(_codex_mode_stored "$name")" ] && { printf 'session'; return 0; }
    printf 'default'; return 0
  fi
  if [ -r "$ROTATE" ] && command -v jq >/dev/null 2>&1; then
    v=$(jq -r --arg a "$agent" --arg n "$name" '.sessions[$a][$n] // empty' "$ROTATE" 2>/dev/null)
    _rotate_valid "$v" && { printf 'session'; return 0; }
  fi
  printf 'default'
}

# ── CODEX MODES ────────────────────────────────────────────────────────────
#
# A Codex session can be `resume` (the default) or `fresh`. The other two are
# Claude mechanisms — a compaction and a handoff both need the session to act
# on itself through a pane cl can type into and a transcript it can read — so
# they are refused for Codex rather than stored and ignored.
#
# Kept apart from rotate_for, which still answers n/a for Codex: everything the
# stop does with that answer (the handoff and compaction passes, the rotation
# log) is about those Claude mechanisms, and a Codex row must stay out of all
# of them. The Codex mode is read by its own callers only.
#
# There is no Codex default in the store: the stored default may be
# compact-resume, which a Codex session cannot do, and following it would make
# every Codex session's mode depend on a setting chosen for Claude ones.
CL_CODEX_MODE_BUILTIN_DEFAULT="resume"
_codex_mode_ok() { case "$1" in resume|fresh) return 0 ;; esac; return 1; }
# _codex_mode_stored <name> -> resume | fresh | (nothing): the stored value,
# only when it is one a Codex session can actually have.
_codex_mode_stored() {
  local v
  [ -r "$ROTATE" ] && command -v jq >/dev/null 2>&1 || return 0
  v=$(jq -r --arg n "$1" '.sessions.codex[$n] // empty' "$ROTATE" 2>/dev/null)
  [ -n "$v" ] || return 0
  v=$(_mode_normalize "$v") || return 0
  _codex_mode_ok "$v" && printf '%s' "$v"
  return 0
}
# codex_mode_for <name> -> resume | fresh. A stored value a Codex session cannot
# have (a hand edit) is reported and the default used, as rotate_for does.
codex_mode_for() {
  local v raw
  v=$(_codex_mode_stored "$1")
  if [ -z "$v" ] && [ -r "$ROTATE" ] && command -v jq >/dev/null 2>&1; then
    raw=$(jq -r --arg n "$1" '.sessions.codex[$n] // empty' "$ROTATE" 2>/dev/null)
    [ -n "$raw" ] && printf 'claude-session: ignoring setting "%s" for Codex session "%s" in %s (a Codex session can be resume or fresh)\n' \
      "$raw" "$1" "$ROTATE" >&2
  fi
  printf '%s' "${v:-$CL_CODEX_MODE_BUILTIN_DEFAULT}"
}
# codex_stop_mode <name> <no_handoff> <env_mode> -> resume | fresh: the mode a
# stop carries out for a Codex session, with the same precedence as the Claude
# one (stop_rotate_resolve). --no-handoff is "resume as-is" for every agent.
# --require-handoff has nothing to say to a Codex session, so it does not
# change one; neither does a CL_ROTATE that names a Claude-only mode.
codex_stop_mode() {
  [ "$2" = "1" ] && { printf 'resume'; return 0; }
  _codex_mode_ok "$3" && { printf '%s' "$3"; return 0; }
  codex_mode_for "$1"
}

# stop_rotate_resolve <name> <agent> <no_handoff> <require_handoff> <env_rotate>
#   -> sets _STOP_ROTATE (a mode, or n/a) and _STOP_ROTATE_SRC (flag|env|<stored>)
#
# --no-handoff is "stop now, resume as-is": it skips compaction too, because a
# compaction is minutes of model work and that flag is the fast stop.
#
# THE ONE precedence order for `cl stop`: an explicit flag outranks everything,
# then CL_ROTATE for a one-off, then the stored per-session setting.
#
# It is a function with globals rather than a $(subshell) because there are two
# values and a subshell cannot hand both back — the out-param-through-a-subshell
# trap this project has paid for before.
#
# It exists because do_stop now resolves this TWICE: once in the pre-pass that
# sizes the handoff budget, once per session in the loop. A second copy of the
# precedence would drift, and the first symptom was already visible — the
# pre-pass counted sessions whose rotation is OFF, so `cl stop` warned that a
# budget was too small for sessions it was never going to ask.
stop_rotate_resolve() {
  local name="$1" agent="$2" nh="$3" rh="$4" envr="$5"
  if [ "$agent" != "claude" ]; then _STOP_ROTATE="n/a"; _STOP_ROTATE_SRC=""; return 0; fi
  if [ "$nh" = "1" ]; then _STOP_ROTATE="resume";  _STOP_ROTATE_SRC="flag"; return 0; fi
  if [ "$rh" = "1" ]; then _STOP_ROTATE="handoff"; _STOP_ROTATE_SRC="flag"; return 0; fi
  if [ -n "$envr" ]; then _STOP_ROTATE="$envr"; _STOP_ROTATE_SRC="env"; return 0; fi
  _STOP_ROTATE=$(rotate_for "$name" "$agent")
  _STOP_ROTATE_SRC=$(rotate_source "$name" "$agent")
}

# rotate_env_value -> a mode | (nothing)
#
# The legacy spellings keep their meaning (1/on/yes = handoff, 0/off/no =
# resume), and a mode name is accepted as itself.
#
# The environment layer, validated in ONE place. It has to be separable from
# rotate_effective because the stop path needs to know whether the environment
# actually decided: an unparseable CL_ROTATE changes nothing, so recording it as
# the deciding layer would put a false provenance in the measurement log —
# behaviour right, record wrong. (Codex review, 2026-10-01.)
#
# Silent by design; do_stop warns once per invocation rather than once per
# session, which is why the complaint does not live here.
rotate_env_value() {
  case "${CL_ROTATE:-}" in
    0|off|no) printf 'resume' ;;
    1|on|yes) printf 'handoff' ;;
    compact-resume|compact|handoff|fresh|resume) _mode_normalize "$CL_ROTATE" ;;
  esac
  return 0
}
rotate_env_valid() { [ -n "$(rotate_env_value)" ]; }

# rotate_effective <name> <agent> -> a mode
# Adds the environment layer, for the stop path. A stop FLAG outranks all of
# this and is applied by do_stop itself, where the flag is in scope.
rotate_effective() {
  local name="$1" agent="${2:-claude}" v
  [ "$agent" = "claude" ] || { printf 'resume'; return 0; }
  v=$(rotate_env_value)
  [ -n "$v" ] && { printf '%s' "$v"; return 0; }
  rotate_for "$name" "$agent"
}

# rotate_write <mode|on|off|clear> [name] [agent]: update the store under its
# lock. Aliases are written as the mode they stand for, so the file speaks one
# vocabulary from here on.
rotate_write() {
  local what="$1" name="${2:-}" agent="${3:-claude}" tmp rc=0
  command -v jq >/dev/null 2>&1 || { echo "claude-session: jq is required to change rotation settings" >&2; return 1; }
  if [ "$what" != "clear" ]; then
    what=$(_mode_normalize "$what") || { echo "claude-session: not a mode: '$1' (compact-resume|handoff|fresh|resume)" >&2; return 1; }
  fi
  mkdir -p "$(dirname "$ROTATE")" 2>/dev/null || { echo "claude-session: cannot create $(dirname "$ROTATE")" >&2; return 1; }
  rotate_lock || return 1
  # NO default in the seed. A per-session write into a missing file used to
  # seed "default":"on", which silently pinned every OTHER session to handoff
  # the moment one override was set — and the built-in default is no longer on.
  [ -s "$ROTATE" ] || printf '{"sessions":{}}\n' > "$ROTATE" 2>/dev/null
  tmp="$ROTATE.tmp.$$"
  if [ -z "$name" ]; then
    jq --arg v "$what" '.default = $v | .sessions //= {}' "$ROTATE" > "$tmp" 2>/dev/null || rc=1
  elif [ "$what" = "clear" ]; then
    jq --arg a "$agent" --arg n "$name" 'if .sessions[$a] then .sessions[$a] |= del(.[$n]) else . end' "$ROTATE" > "$tmp" 2>/dev/null || rc=1
  else
    jq --arg a "$agent" --arg n "$name" --arg v "$what" '.sessions //= {} | .sessions[$a] //= {} | .sessions[$a][$n] = $v' "$ROTATE" > "$tmp" 2>/dev/null || rc=1
  fi
  if [ "$rc" -eq 0 ] && [ -s "$tmp" ]; then
    mv "$tmp" "$ROTATE" 2>/dev/null || rc=1
  else
    rc=1
  fi
  rm -f "$tmp" 2>/dev/null
  rotate_unlock
  [ "$rc" -eq 0 ] || echo "claude-session: could not update $ROTATE — nothing was changed" >&2
  return "$rc"
}

# rotation_log_append <mode> <source> <sessions> <handoffs> <resume_only> <kept>
#                     <paths> <reasons> <pre_tokens> <post_tokens> <ctx...>
#
# ONE ROW PER STOP, as before, so `rotate stats` keeps counting stops. The four
# per-session columns are comma lists in the same session order as each other
# (not as ctx_all, which is sorted): the path each session actually took, why,
# and the compaction's preTokens/postTokens (empty where nothing compacted).
# `mode` stays the mode ASKED; a fallback shows up in `paths`, never as a
# different mode, which is what keeps a fallback from making a week "mixed".
#
# ALWAYS returns 0. This is a measurement, and a measurement must never be able
# to stop you shutting your machine down — if the log cannot be written, say so
# once and carry on. (The inverse of the handoff rules, where failing closed
# protects a session; here failing closed would protect nothing and cost a stop.)
rotation_log_append() {
  local mode="$1" source="$2" sessions="$3" handoffs="$4" ronly="$5" kept="$6"
  local paths="$7" reasons="$8" pre_tokens="$9" post_tokens="${10}"
  shift 10
  local total=0 n=0 med=0 c sorted all=""
  for c in "$@"; do
    case "$c" in ''|*[!0-9]*) continue ;; esac
    total=$((total+c)); n=$((n+1))
  done
  if [ "$n" -gt 0 ]; then
    sorted=$(printf '%s\n' "$@" | grep -E '^[0-9]+$' | sort -n)
    # Median, not mean: one enormous session should not make a whole week look
    # expensive. On an EVEN count this takes the lower of the two middles — with
    # two sessions either is defensible, so the choice is stated here rather than
    # left as an accident of the arithmetic.
    med=$(printf '%s\n' "$sorted" | awk -v n="$n" 'NR==int((n+1)/2){print; exit}')
    med="${med:-0}"
    # Every session's context, comma-separated, so a WEEK's median can be a real
    # median rather than an average of per-stop medians. Those are different
    # numbers, and the average also weights a one-session stop exactly like a
    # ten-session one. Keeping the distribution is the only way the reported
    # statistic can be the one named. (Codex review, 2026-10-01.)
    all=$(printf '%s\n' "$sorted" | paste -sd, - 2>/dev/null)
  fi
  mkdir -p "$(dirname "$ROTATION_LOG")" 2>/dev/null || { _rotation_log_warn; return 0; }
  if [ ! -e "$ROTATION_LOG" ]; then
    printf '%s\n' "$_ROTATION_LOG_HEADER" \
      >> "$ROTATION_LOG" 2>/dev/null || { _rotation_log_warn; return 0; }
  else
    _rotation_log_migrate
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$mode" "$source" "$sessions" "$handoffs" "$ronly" "$kept" "$total" "$med" "$all" \
    "$paths" "$reasons" "$pre_tokens" "$post_tokens" \
    >> "$ROTATION_LOG" 2>/dev/null || _rotation_log_warn
  return 0
}
# Every header this tool has ever written, exactly. Migration matches against
# these and nothing else — see _rotation_log_migrate for why a pattern is not
# good enough. Add a line here when the columns change; never widen the match.
#   V0  the first release
#   V1  + ctx_all, so a week's median is a median of sessions
#   V2  + the path each session took, why, and the compaction's token figures
_ROTATION_LOG_HEADER_V0='timestamp	mode	source	sessions	handoffs	resume_only	kept	ctx_total	ctx_median'
_ROTATION_LOG_HEADER_V1='timestamp	mode	source	sessions	handoffs	resume_only	kept	ctx_total	ctx_median	ctx_all'
_ROTATION_LOG_HEADER_V2='timestamp	mode	source	sessions	handoffs	resume_only	kept	ctx_total	ctx_median	ctx_all	paths	reasons	pre_tokens	post_tokens'
_ROTATION_LOG_HEADER="$_ROTATION_LOG_HEADER_V2"
_rotation_log_warn() {
  printf 'claude-session: could not append to %s — this stop is not in the rotation log\n' "$ROTATION_LOG" >&2
}

# _rotation_log_migrate: bring an older header up to the current columns.
#
# `ctx_all` was added after the first release of this log, so a file written by
# the previous version has a nine-column header. Appending a ten-column row under
# it leaves a TSV that the built-in parser happens to read correctly but that is
# structurally mislabelled for a human or any other tool — the kind of file that
# is fine until someone trusts the header. (Codex review, 2026-10-01.)
#
# Migrating FORWARD is safe in a way that migrating rows would not be: an older
# row simply has no tenth field, which reads as an empty ctx_all, and that is
# exactly what rotate_stats already treats as "distribution unavailable, mark the
# week approximate". So the header gains a column and nothing is rewritten.
#
# ALWAYS returns 0: this runs on the stop path, and a log that cannot be migrated
# must still be appended to rather than costing the shutdown.
_rotation_log_migrate() {
  local first tmp
  [ -s "$ROTATION_LOG" ] || return 0
  first=$(head -1 "$ROTATION_LOG" 2>/dev/null) || return 0
  # EXACT matches only, against headers this tool has actually written.
  #
  # This was a `timestamp*` pattern, which is a destructive bug rather than a
  # loose check: a foreign or hand-maintained TSV whose first line began
  # "timestamp_ms<TAB>event" matched, and the whole line was then replaced with
  # this schema. The function's own comment promised not to touch a header it did
  # not write, and the code did not keep that promise — and the test only
  # exercised a first line that did not start with "timestamp" at all, so nothing
  # caught it. (Codex review, 2026-10-01.)
  #
  # V2 added four columns at the END, so an older row reads as empty in each of
  # them — "not recorded", which is true — and, as with ctx_all, only the header
  # has to change.
  local old_header
  case "$first" in
    "$_ROTATION_LOG_HEADER")    return 0 ;;   # already current
    "$_ROTATION_LOG_HEADER_V0"|"$_ROTATION_LOG_HEADER_V1") : ;;   # ours: migrate it
    *)                          return 0 ;;   # anything else is not ours
  esac
  old_header="$first"
  # Serialised, because this is the one read-modify-write on the log and two
  # stops could reach it together.
  if ! store_lock "$ROTATION_LOG" >/dev/null 2>&1; then
    _rotation_log_schema_warn "$old_header"; return 0
  fi
  # Re-read under the lock and repeat the WHOLE classification, not just the
  # already-migrated case. The reason to look again is that the pre-lock evidence
  # may no longer describe the file: between the first read and owning the lock,
  # anything could have replaced it — including with a header that is not ours.
  # Checking only "is it already current?" and otherwise proceeding meant a file
  # that had become foreign while we waited was replaced anyway, which is the
  # data loss the exact matching above exists to prevent, reintroduced through the
  # back door. (Codex review, 2026-10-01.)
  first=$(head -1 "$ROTATION_LOG" 2>/dev/null)
  case "$first" in
    "$_ROTATION_LOG_HEADER")    store_unlock "$ROTATION_LOG"; return 0 ;;
    "$_ROTATION_LOG_HEADER_V0"|"$_ROTATION_LOG_HEADER_V1") old_header="$first" ;;
    *)                          store_unlock "$ROTATION_LOG"; return 0 ;;
  esac
  tmp="$ROTATION_LOG.mig.$$"
  if ! { printf '%s\n' "$_ROTATION_LOG_HEADER"; tail -n +2 "$ROTATION_LOG"; } > "$tmp" 2>/dev/null \
     || [ ! -s "$tmp" ]; then
    rm -f "$tmp" 2>/dev/null; store_unlock "$ROTATION_LOG"; _rotation_log_schema_warn "$old_header"; return 0
  fi
  # A refused replacement used to be silent, which left exactly the mixed schema
  # this migration exists to prevent and said nothing about it. The stop must
  # continue; it does not have to continue quietly.
  if ! mv "$tmp" "$ROTATION_LOG" 2>/dev/null; then
    rm -f "$tmp" 2>/dev/null; store_unlock "$ROTATION_LOG"; _rotation_log_schema_warn "$old_header"; return 0
  fi
  store_unlock "$ROTATION_LOG"
  return 0
}
# Said whenever a row is about to be appended under a header that does not name
# all of its fields. Names the consequence and the fix, because "could not
# migrate" on its own tells someone nothing they can act on.
# _rotation_log_schema_warn <old-header>: the columns the old header lacks are
# exactly the current header's fields past its own count, since every version
# only ever appended.
_rotation_log_schema_warn() {
  local missing
  missing=$(printf '%s\n%s\n' "${1:-}" "$_ROTATION_LOG_HEADER" \
    | awk -F'\t' 'NR==1{n=NF; next} {s=""; for(i=n+1;i<=NF;i++) s=s (s==""?"":", ") $i; print s}')
  printf 'claude-session: could not update the column header in %s — the row just added has fields (%s) that the header does not name.\n' \
    "$ROTATION_LOG" "${missing:-unknown}" >&2
  printf '  The next cl stop retries; or fix it by hand, replacing the first line with:\n    %s\n' "$_ROTATION_LOG_HEADER" >&2
}

# _mode_set <mode> [name] [agent]: store a mode as the default (no name) or for
# one session, and say what it now means. Shared by `cl rotate on|off` and `cl
# mode`, so the two spellings cannot drift.
_mode_set() {
  local mode="$1" target="${2:-}" agent="${3:-claude}"
  if [ -z "$target" ]; then
    rotate_write "$mode" || return 1
    printf 'mode is now %s by default%s\n' "$mode" \
      "$( [ "$mode" = resume ] && printf ' — `cl stop` will not ask for handoffs' )"
  elif [ "$agent" = "codex" ]; then
    rotate_write "$mode" "$target" codex || return 1
    printf 'mode is now %s for Codex session "%s" (the Codex default is %s)\n' "$mode" "$target" "$CL_CODEX_MODE_BUILTIN_DEFAULT"
  else
    rotate_write "$mode" "$target" "$agent" || return 1
    printf 'mode is now %s for "%s" (overriding the default, which is %s)\n' "$mode" "$target" "$(rotate_default)"
  fi
  return 0
}

# _codex_mode_refuse <mode>: the one wording for a mode Codex cannot have.
_codex_mode_refuse() {
  printf 'claude-session: %s is a Claude-only mode — a Codex session can be resume or fresh\n' "$1" >&2
}

# do_mode: `cl mode` — the restart mode per session.
#
#   cl mode                       the same report as `cl rotate status`
#   cl mode <name>                that session's mode, and which layer decided
#   cl mode <name> <mode|clear>   set or un-set one session's mode
#   cl mode --default <mode>      set the default
#
# Modes: compact-resume (or compact), handoff, fresh, resume — and the legacy
# on/off, which mean handoff/resume. `--codex` names a Codex session, which
# can be resume or fresh; the Claude-only modes are refused for it, not stored
# and ignored, and so is --default (a Codex session's default is always resume).
do_mode() {
  local agent="claude" name="" mode=""
  while :; do
    case "${1:-}" in
      --codex)  agent="codex"; shift ;;
      --claude) agent="claude"; shift ;;
      --default)
        shift
        if [ "$agent" = "codex" ]; then
          echo "claude-session: there is no Codex default to set — a Codex session resumes unless it is set to fresh (cl mode --codex \"Name\" fresh)" >&2
          return 1
        fi
        [ -n "${1:-}" ] || { echo 'usage: cl mode --default <compact-resume|handoff|fresh|resume>' >&2; return 1; }
        _mode_normalize "$1" >/dev/null || { echo "claude-session: not a mode: '$1' (compact-resume|handoff|fresh|resume)" >&2; return 1; }
        _mode_set "$(_mode_normalize "$1")"; return $? ;;
      -h|--help)
        printf 'usage: cl mode [<name> [compact-resume|handoff|fresh|resume|clear]] | cl mode --default <mode>\n'
        printf '       cl mode --codex <name> [resume|fresh|clear]\n'
        return 0 ;;
      *) break ;;
    esac
  done
  name="${1:-}"; mode="${2:-}"
  [ -n "$name" ] || { do_rotate status; return $?; }
  if [ -z "$mode" ]; then
    if [ "$agent" = "codex" ]; then
      printf '"%s" [codex]: %s (%s)\n' "$name" "$(codex_mode_for "$name")" "$(rotate_source "$name" codex)"
    else
      printf '"%s": %s (%s)\n' "$name" "$(rotate_for "$name" "$agent")" "$(rotate_source "$name" "$agent")"
    fi
    return 0
  fi
  if [ "$mode" = "clear" ]; then
    rotate_write clear "$name" "$agent" || return 1
    if [ "$agent" = "codex" ]; then
      printf 'Codex session "%s" follows the Codex default again (%s)\n' "$name" "$CL_CODEX_MODE_BUILTIN_DEFAULT"
    else
      printf '"%s" follows the default again (%s)\n' "$name" "$(rotate_default)"
    fi
    return 0
  fi
  _mode_normalize "$mode" >/dev/null || { echo "claude-session: not a mode: '$mode' (compact-resume|handoff|fresh|resume)" >&2; return 1; }
  if [ "$agent" = "codex" ] && ! _codex_mode_ok "$(_mode_normalize "$mode")"; then
    _codex_mode_refuse "$(_mode_normalize "$mode")"; return 1
  fi
  _mode_set "$(_mode_normalize "$mode")" "$name" "$agent"
}

# do_rotate: read and change the policy, and summarise what the log says.
do_rotate() {
  local sub="${1:-status}" target agent="claude" v src
  case "$sub" in
    on|off)
      shift
      if [ -n "${1:-}" ]; then
        case "$1" in
          # `off` is resume, which a Codex session can have; `on` is a
          # handoff, which it cannot.
          --codex)
            if [ "$sub" = "on" ]; then
              echo "claude-session: rotation is a Claude mechanism — a Codex thread cannot write a handoff" >&2; return 1
            fi
            agent="codex"; shift
            [ -n "${1:-}" ] || { echo "claude-session: rotate off --codex needs a session name — there is no Codex default to set" >&2; return 1; } ;;
          --claude) shift ;;
        esac
      fi
      target="${1:-}"
      # The legacy toggle, kept as aliases: on = handoff, off = resume.
      _mode_set "$(_mode_normalize "$sub")" "$target" "$agent"
      return $? ;;
    clear)
      shift
      case "${1:-}" in --codex) agent="codex"; shift ;; --claude) shift ;; esac
      target="${1:-}"
      [ -n "$target" ] || { echo "claude-session: rotate clear needs a session name" >&2; return 1; }
      rotate_write clear "$target" "$agent" || return 1
      if [ "$agent" = "codex" ]; then
        printf 'Codex session "%s" follows the Codex default again (%s)\n' "$target" "$CL_CODEX_MODE_BUILTIN_DEFAULT"
      else
        printf '"%s" follows the default again (%s)\n' "$target" "$(rotate_default)"
      fi
      return 0 ;;
    stats) shift; rotate_stats "$@"; return $? ;;
    status) : ;;
    *) echo "claude-session: rotate: unknown argument '$sub' (on|off|clear|status|stats)" >&2; return 1 ;;
  esac

  # status. Inside a session, lead with THAT session: being able to ask "will I
  # be rotated?" from where you are is the point of CL_SESSION_NAME existing.
  if [ -n "${CL_SESSION_NAME:-}" ]; then
    v=$(rotate_for "$CL_SESSION_NAME"); src=$(rotate_source "$CL_SESSION_NAME")
    printf 'this session ("%s"): rotation %s (%s)\n' "$CL_SESSION_NAME" "$v" "$src"
    if handoff_root >/dev/null 2>&1 && handoff_is_complete "$(handoff_path "$_CL_HANDOFF_ROOT" "$CL_SESSION_NAME")"; then
      printf '  a complete handoff is waiting — `cl start` would start this one fresh from it\n'
    fi
    printf '\n'
  fi
  printf 'default: rotation %s\n' "$(rotate_default)"
  if [ -r "$ROTATE" ] && command -v jq >/dev/null 2>&1; then
    local line oa on ov shown=0
    # Validated HERE rather than in the listing. A hand-edited value has to be
    # reported somewhere, but a picker row is the wrong place: `cl` renders one
    # line per session and must not emit stray text into the chooser. status is
    # the diagnostic command, so it is the one that checks.
    while IFS=$'\t' read -r oa on ov; do
      [ -n "$on" ] || continue
      [ "$shown" = "0" ] && { printf 'per-session overrides:\n'; shown=1; }
      if [ "$oa" = "codex" ] && ! _codex_mode_ok "$(_mode_normalize "$ov" 2>/dev/null)"; then
        printf '  %s [%s]: ignoring setting "%s" — a Codex session can be resume or fresh, so it resumes\n' \
          "$on" "$oa" "$ov"
      elif _rotate_valid "$ov"; then
        printf '  %s [%s]: %s\n' "$on" "$oa" "$(_mode_normalize "$ov")"
      else
        printf '  %s [%s]: ignoring unreadable setting "%s" — follows the default (%s)\n' \
          "$on" "$oa" "$ov" "$(rotate_default)"
      fi
    done < <(jq -r '.sessions // {} | to_entries[] | .key as $a | .value | to_entries[] | "\($a)\t\(.key)\t\(.value)"' "$ROTATE" 2>/dev/null)
    if [ "$shown" = "1" ]; then
      printf '\nNote: overrides make a measurement week ambiguous — `cl rotate stats` marks those weeks.\n'
    else
      printf 'per-session overrides: none\n'
    fi
  fi
  [ -e "$ROTATION_LOG" ] && printf '\n%s stop(s) logged in %s — `cl rotate stats` summarises them\n' \
    "$(( $(wc -l < "$ROTATION_LOG" 2>/dev/null || echo 1) - 1 ))" "$ROTATION_LOG"
  return 0
}

# rotate_stats: aggregate the log by ISO week.
#
# Deliberately NOT a cost report: this tool cannot see money. It reports the
# mechanism — how many stops ran each way, how much work was in them, and the
# median context being carried — so a difference in a bill can be attributed
# instead of guessed at.
rotate_stats() {
  [ -r "$ROTATION_LOG" ] || { printf 'no rotation log yet (%s) — run a `cl stop` first\n' "$ROTATION_LOG"; return 0; }
  command -v awk >/dev/null 2>&1 || { echo "claude-session: awk is required for stats" >&2; return 1; }
  printf '%-14s %-16s %7s %9s %11s %10s\n' 'WEEK FROM' MODE CYCLES SESSIONS 'CTX MEDIAN' OVERRIDES
  # Weeks are grouped by the MONDAY they start on, computed exactly.
  #
  # The first version derived a week number from the day of the year, which put a
  # Mon-Fri run of stops into two different buckets whenever it straddled a
  # 7-day boundary that was not a Monday. For an A/B whose whole premise is
  # "compare this week against that week", a smeared boundary silently mixes the
  # two arms — the exact confound this report exists to rule out. So: civil date
  # -> day number -> back off to Monday, with no dependence on a date(1) whose
  # flags differ between BSD and GNU.
  awk -F'\t' '
    function days_from_civil(y, m, d,   era, yoe, doy, doe, yy) {
      yy = y - (m <= 2 ? 1 : 0)
      era = int((yy >= 0 ? yy : yy - 399) / 400)
      yoe = yy - era * 400
      doy = int((153 * (m + (m > 2 ? -3 : 9)) + 2) / 5) + d - 1
      doe = yoe * 365 + int(yoe/4) - int(yoe/100) + doy
      return era * 146097 + doe - 719468
    }
    function civil_from_days(z,   era, doe, yoe, y, doy, mp, d, m) {
      z += 719468
      era = int((z >= 0 ? z : z - 146096) / 146097)
      doe = z - era * 146097
      yoe = int((doe - int(doe/1460) + int(doe/36524) - int(doe/146096)) / 365)
      y = yoe + era * 400
      doy = doe - (365 * yoe + int(yoe/4) - int(yoe/100))
      mp = int((5 * doy + 2) / 153)
      d = doy - int((153 * mp + 2) / 5) + 1
      m = mp + (mp < 10 ? 3 : -9)
      y += (m <= 2)
      return sprintf("%04d-%02d-%02d", y, m, d)
    }
    NR==1 && $1=="timestamp" { next }
    $1 ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/ {
      mode=$2; src=$3; sess=$4+0; med=$9+0; allf=$10
      split(substr($1,1,10), p, "-")
      dn = days_from_civil(p[1]+0, p[2]+0, p[3]+0)
      # 1970-01-01 was a Thursday, so (dn+3)%7 is 0 on a Monday.
      key = civil_from_days(dn - ((dn % 7) + 3) % 7)
      cycles[key]++; sessions[key]+=sess
      # Accumulate EVERY session context for the week, so the figure printed is
      # the median of the sessions rather than an average of per-stop medians.
      if (allf != "") {
        cnt = split(allf, cs, ",")
        for (ci=1; ci<=cnt; ci++) if (cs[ci]+0 > 0) { ctx[key] = ctx[key] "," (cs[ci]+0) }
      } else if (med > 0) {
        # A row written before ctx_all existed. Its distribution is gone, so the
        # week is marked approximate rather than quietly reconstructed.
        ctx[key] = ctx[key] "," med; approx[key]="yes"
      }
      # A week is clean ONLY when the stored policy decided every row, uniformly.
      # Stated as "anything but default contaminates" rather than as a list of
      # contaminating sources, because an allowlist is a thing to forget to
      # update: `flag` was missing from one, and a week of flag-driven stops was
      # reported as a clean A/B sample while the raw log said otherwise. A new
      # source name added later is treated as suspect by default, which is the
      # safe direction for an experiment.
      #
      # That deliberately includes a VALID CL_ROTATE. It is documented as the
      # one-off layer; `cl rotate off` is the way to set an arm for a week. An
      # exported CL_ROTATE held for a week would in fact be a clean arm, but
      # nothing here can tell that from a value typed once, and guessing in the
      # optimistic direction is how a contaminated week gets believed.
      if (src != "default") ovr[key]="yes"
      # ── WHEN IS A WEEK "MIXED"? ──────────────────────────────────────────
      # Only when its arms are INTERLEAVED. Three things used to make, or would
      # have made, a week mixed without any experiment being muddled:
      #   * vocabulary: rows written before restart modes say on/off, which ARE
      #     handoff/resume, so they are normalised before comparing;
      #   * fallbacks: a row records the mode ASKED, and a session that fell
      #     back (no token -> handoff) is in the paths column, not here;
      #   * a default that changed once, mid-week — upgrading to the
      #     compact-resume default, or `cl mode --default` on a Wednesday. That
      #     is a clean before/after, shown as "A->B", not a contaminated sample.
      # A row that was itself mixed (sessions disagreed), or a week that went
      # back and forth, is still "mixed".
      if (mode=="on") mode="handoff"; else if (mode=="off") mode="resume"
      if (mode=="compact-resume") mode="compact"
      if (first[key]=="") { first[key]=mode; last[key]=mode; flips[key]=0 }
      else if (last[key]!=mode) { flips[key]++; last[key]=mode }
      if (mode=="mixed") hasmixed[key]="yes"
    }
    END {
      n=0; for (k in cycles) keys[n++]=k
      for (i=0;i<n;i++) for (j=i+1;j<n;j++) if (keys[i]>keys[j]) { t=keys[i];keys[i]=keys[j];keys[j]=t }
      for (i=0;i<n;i++) { k=keys[i]
        m = 0
        if (ctx[k] != "") {
          cn = split(substr(ctx[k],2), v, ",")
          # insertion sort: these are per-week session counts, not a data set
          for (a=2; a<=cn; a++) { x=v[a]+0; b=a-1; while (b>0 && v[b]+0>x) { v[b+1]=v[b]; b-- } v[b+1]=x }
          m = v[int((cn+1)/2)] + 0
        }
        if (hasmixed[k]=="yes" || flips[k] > 1) wm = "mixed"
        else if (flips[k] == 1) wm = first[k] "->" last[k]
        else wm = first[k]
        printf "%-14s %-16s %7d %9d %11s %10s\n", k, wm, cycles[k], sessions[k],
          (m>0 ? sprintf("%s%dk", (approx[k]=="yes" ? "~" : ""), int(m/1000)) : "-"),
          (ovr[k]=="yes" ? "yes" : "-")
      }
    }' "$ROTATION_LOG"
  printf '\nCTX MEDIAN is the median across every session stopped that week — the context each\n'
  printf 'had grown to, which is the per-call cost rotation removes. A ~ prefix means some\n'
  printf 'rows predate the per-session figures and only their own medians were available.\n'
  printf 'OVERRIDES=yes means per-session settings or a stop flag were in play that week, so\n'
  printf 'it is not a clean A/B sample. MODE A->B means the mode changed once that week (a\n'
  printf 'clean before/after); mixed means the modes were interleaved. on/off rows count as\n'
  printf 'handoff/resume. This reports the mechanism, not money.\n'
  return 0
}

# commit_pending_model <agent> <name>: store a model chosen on THIS command
# line, now that the backend has accepted the session.
#
# CL_PENDING_MODEL carries it from `cl new --model` through to whichever launch
# path actually creates something. It is deliberately not stored earlier: the
# paths below can still refuse (an existing owner, a claim that cannot be taken,
# a tmux session already at that name which is attached rather than created),
# and a preference recorded for a session that was never made is a lie the next
# launch acts on.
commit_pending_model() {
  [ -n "${CL_PENDING_MODEL:-}" ] || return 0
  set_model "${1:-claude}" "$2" "$CL_PENDING_MODEL" >/dev/null 2>&1 || return 0
  return 0
}

# set_model <agent> <name> <model|->: remember or forget. '-' clears.
set_model() {
  local agent="$1" name="$2" model="$3" tmp rc=0
  command -v jq >/dev/null 2>&1 || { echo "claude-session: model needs jq (brew install jq)" >&2; return 1; }
  [ -n "$name" ] || { echo "claude-session: model needs a session name" >&2; return 1; }
  [ "$model" = "-" ] || valid_model "$model" \
    || { echo "claude-session: refusing model \"$model\" — allowed: letters, digits, . _ - : / [ ]" >&2; return 1; }
  mkdir -p "$(dirname "$MODELS")" || { echo "claude-session: cannot create state dir" >&2; return 1; }
  models_lock || return 1
  [ -r "$MODELS" ] || printf '{}\n' > "$MODELS"
  if ! jq empty "$MODELS" 2>/dev/null; then
    echo "claude-session: $MODELS is not valid JSON — left unchanged" >&2
    models_unlock; return 1
  fi
  tmp="$MODELS.tmp.$$"
  if [ "$model" = "-" ]; then
    if jq --arg a "$agent" --arg n "$name" 'if (.[$a] | type) == "object" then (.[$a] |= del(.[$n])) else . end | with_entries(select((.value | length) > 0))' \
         "$MODELS" > "$tmp" 2>/dev/null; then
      mv "$tmp" "$MODELS"; printf 'forgot the model for %s "%s"\n' "$agent" "$name"
    else rc=1; fi
  else
    if jq --arg a "$agent" --arg n "$name" --arg m "$model" '.[$a] //= {} | .[$a][$n] = $m' \
         "$MODELS" > "$tmp" 2>/dev/null; then
      mv "$tmp" "$MODELS"; printf '%s "%s" will start with %s\n' "$agent" "$name" "$model"
    else rc=1; fi
  fi
  [ "$rc" -eq 0 ] || { rm -f "$tmp"; echo "claude-session: failed to update $MODELS" >&2; }
  models_unlock
  return "$rc"
}

# model_agent_for <name>: which agent a bare name means, or nothing when that
# cannot be answered. Mirrors `cl <name>`: infer when the name is unique among
# discovered sessions, refuse when it is held by both. Guessing here is exactly
# how a Codex model would end up on a Claude launch.
model_agent_for() {
  local matches
  matches=$(discover | awk -F'\t' -v n="$1" '$1==n {print $5}' | sort -u)
  case "$(printf '%s' "$matches" | grep -c .)" in
    1) printf '%s' "$matches" ;;
    *) return 1 ;;
  esac
}

# do_model: no args lists what is remembered; [--claude|--codex] <name>
# <model|-> sets or clears.
do_model() {
  local agent=""
  while :; do
    case "${1:-}" in
      --codex)  agent="codex";  shift ;;
      --claude) agent="claude"; shift ;;
      *) break ;;
    esac
  done

  if [ "$#" -eq 0 ]; then
    command -v jq >/dev/null 2>&1 || { echo "claude-session: model needs jq (brew install jq)" >&2; exit 1; }
    if [ ! -r "$MODELS" ] || [ "$(jq -r '[.[] | length] | add // 0' "$MODELS" 2>/dev/null || echo 0)" = "0" ]; then
      printf 'no session models remembered.\n  set one with: cl model [--codex] <name> <model-id>\n'
      return 0
    fi
    jq -r 'to_entries | sort_by(.key)[] as $a | $a.value | to_entries | sort_by(.key)[]
           | "  \($a.key)\t\(.key)\t\(.value)"' "$MODELS" 2>/dev/null \
      | while IFS=$'\t' read -r a n m; do printf '%-8s %-26s %s\n' "$a" "$n" "$m"; done
    return 0
  fi

  local name="$1" model="${2:-}"
  [ -n "$model" ] || { echo 'usage: cl model [--codex|--claude] <name> <model-id|->' >&2; return 1; }
  if [ -z "$agent" ]; then
    agent=$(model_agent_for "$name") || {
      echo "claude-session: '$name' exists for more than one agent (or none) — say which: cl model --claude \"$name\" …  or  cl model --codex \"$name\" …" >&2
      return 1
    }
  fi
  set_model "$agent" "$name" "$model"
}

# resume_cmd <agent> <sid>: the shell command string that resumes a session.
# Used verbatim as a tmux pane command; for exec paths the same words
# are re-split by the caller.
# A third argument supplies the session NAME, which is what a remembered model
# is keyed by; without it the command is built exactly as before.
# A fourth argument is a FIRST PROMPT (Claude only): claude takes a trailing
# positional as the first message and sends it on launch. It is how a session
# resumed after a compaction is told why it is back — passed as an argument,
# never typed, because typing races the TUI starting up. %q-quoted, as in
# fresh_cmd, because this string is evaluated by a shell.
resume_cmd() {
  local mf="" fp=""
  [ -n "${3:-}" ] && mf=$(model_flag "$1" "$(model_for "$3" "$1")")
  [ -n "${4:-}" ] && fp=" $(printf '%q' "$4")"
  case "$1" in
    codex) printf '%s %s resume %s%s%s' "$(codex_cmd)" "$(codex_args)" "$(printf '%q' "$2")" "$mf" "$fp" ;;
    *)     printf '%s --resume %s --dangerously-skip-permissions%s%s' "$(claude_cmd)" "$(printf '%q' "$2")" "$mf" "$fp" ;;
  esac
}

# The first message a session resumed after compaction receives. Yours to
# change, in a file, for the same reason as the handoff prompt.
CL_COMPACT_RESUME_PROMPT_FILE="${CL_COMPACT_RESUME_PROMPT_FILE:-$HOME/.config/claude-session/resume-after-compact-prompt.txt}"
build_compact_resume_prompt() {
  local tmpl
  if tmpl=$(read_prompt_file "$CL_COMPACT_RESUME_PROMPT_FILE"); then
    printf '%s' "$tmpl" | _prompt_flatten
    return 0
  fi
  printf 'You were stopped and restarted by cl after compacting your context. Carry on where you left off.'
}

# ── CODEX `fresh` (docs/restart-modes.md, "fresh, for Codex") ───────────────
#
# Launching a bare `codex` would give cl no thread id, and every ownership
# mechanism keys on one: registered_pid and tmux_owned would reject the new
# client, the next `cl stop` would call it stopped while it ran, and the
# coordination election would keep the old thread. So the new thread is made
# FIRST, through `codex app-server`, and the ordinary resume path then runs it
# by id like any other:
#
#   1. thread/start → the new id; thread/name/set to the session's name; the
#      name read back with thread/read, so a set that did not take is caught
#   2. `codex archive <old>` (on the tmux path, before anything re-arms), so
#      nothing can elect the old thread again (discovery reads sessions/ only,
#      and archive moves the rollout out of it)
#   3. the restart row moved onto the new id
#   4. the caller runs `codex resume <new> "<first prompt>"`, and the row is
#      settled only once that launch is verified as codex on the new id; the
#      first turn fires the repo's SessionStart hook, which elects it
#
# Every step is a phase of a persisted transaction — see THE FRESH
# TRANSACTION below for the phases, the claim that serialises them, and the
# one point (the archive) after which a retry only rolls forward.

# The first message of a fresh Codex thread. It exists because a turn is what
# fires SessionStart; the text itself is yours to change, in a file.
CL_CODEX_FRESH_PROMPT_FILE="${CL_CODEX_FRESH_PROMPT_FILE:-$HOME/.config/claude-session/codex-fresh-prompt.txt}"
build_codex_fresh_prompt() {
  local tmpl
  if tmpl=$(read_prompt_file "$CL_CODEX_FRESH_PROMPT_FILE"); then
    printf '%s' "$tmpl" | _prompt_flatten
    return 0
  fi
  printf 'cl started you as a new thread under this session'"'"'s name; the previous thread was archived. Say you are ready, then wait for instructions.'
}

# Each app-server request is bounded: a server that never answers must cost a
# start this many seconds and then a plain resume, never a hang.
CL_CODEX_RPC_TIMEOUT="${CL_CODEX_RPC_TIMEOUT:-20}"

# _crpc_open <cwd>: start `codex app-server` (JSON-RPC over stdio) with fd 7 as
# its stdin, through a FIFO, because each request depends on the last answer
# and bash 3.2 has no coproc. Sets _CRPC_DIR and _CRPC_PID.
#
# The FIFO is opened read-WRITE: that never blocks, and since this shell then
# holds a reader too, a server that dies early makes a write fail rather than
# raise SIGPIPE and take cl down with it. The server is started first so it
# does not inherit fd 7 — it would then never see EOF when this end closes.
# Its stdout and stderr go to files: inherited, they would keep a $( ) caller
# waiting for as long as the server lived.
_crpc_open() {
  _CRPC_DIR=$(mktemp -d "${TMPDIR:-/tmp}/clrpc.XXXXXX" 2>/dev/null) || return 1
  if ! mkfifo "$_CRPC_DIR/in" 2>/dev/null; then rm -rf "$_CRPC_DIR"; return 1; fi
  : > "$_CRPC_DIR/out"
  ( cd "$1" 2>/dev/null || cd / ; eval "exec $(codex_cmd) app-server" ) \
    < "$_CRPC_DIR/in" > "$_CRPC_DIR/out" 2> "$_CRPC_DIR/err" &
  _CRPC_PID=$!
  exec 7<>"$_CRPC_DIR/in"
}
# _crpc_send <json>: one message, one line.
_crpc_send() { printf '%s\n' "$1" >&7 2>/dev/null; }
# _crpc_call <id> <method> <params-json>: send a request and print its result.
# 1 on an error reply, a dead server, or no answer in CL_CODEX_RPC_TIMEOUT. The
# reason goes to a file, read back with _crpc_why: callers run this in $( ),
# where a variable set here would be lost with the subshell.
_crpc_why() { cat "$_CRPC_DIR/why" 2>/dev/null; }
_crpc_fail() { printf '%s' "$1" > "$_CRPC_DIR/why" 2>/dev/null; return 1; }
_crpc_call() {
  local id="$1" req line ticks=0 limit=$(( CL_CODEX_RPC_TIMEOUT * 10 ))
  rm -f "$_CRPC_DIR/why" 2>/dev/null
  req=$(jq -cn --argjson id "$id" --arg m "$2" --argjson p "$3" '{jsonrpc:"2.0", id:$id, method:$m, params:$p}') \
    || { _crpc_fail "could not build the $2 request"; return 1; }
  _crpc_send "$req" || { _crpc_fail "codex app-server is not accepting requests"; return 1; }
  while [ "$ticks" -lt "$limit" ]; do
    # Line by line with fromjson?, so a half-written last line is skipped
    # rather than failing the whole read. A REPLY has no method: the server
    # numbers its own requests to us independently, and one of those carrying
    # this id is not the answer to this request.
    line=$(jq -R -c --argjson id "$id" 'fromjson? | select(type == "object" and .id == $id and (has("method") | not))' \
             "$_CRPC_DIR/out" 2>/dev/null | head -1)
    if [ -n "$line" ]; then
      if printf '%s' "$line" | jq -e 'has("error")' >/dev/null 2>&1; then
        _crpc_fail "$2 failed: $(printf '%s' "$line" | jq -r '.error.message // .error' 2>/dev/null)"
        return 1
      fi
      printf '%s' "$line" | jq -c '.result // {}'
      return 0
    fi
    if ! kill -0 "$_CRPC_PID" 2>/dev/null; then
      _crpc_fail "codex app-server exited during $2$(head -c 300 "$_CRPC_DIR/err" 2>/dev/null | tr '\n' ' ' | sed 's/^./: &/')"
      return 1
    fi
    sleep 0.1; ticks=$((ticks+1))
  done
  _crpc_fail "no answer to $2 within ${CL_CODEX_RPC_TIMEOUT}s"
  return 1
}
# _crpc_close: EOF to the server, a moment to exit on its own, then TERM, then
# KILL — the escalation run_bounded uses. A bare `wait` after TERM alone hung
# `cl start` for good on a server that ignores TERM and outlives EOF; every
# wait here is bounded, so the one after KILL is only the reaping.
_crpc_close() {
  local w=0
  exec 7>&-
  if [ -n "${_CRPC_PID:-}" ]; then
    while kill -0 "$_CRPC_PID" 2>/dev/null && [ "$w" -lt 30 ]; do sleep 0.1; w=$((w+1)); done
    if kill -0 "$_CRPC_PID" 2>/dev/null; then
      kill -TERM "$_CRPC_PID" 2>/dev/null
      w=0
      while kill -0 "$_CRPC_PID" 2>/dev/null && [ "$w" -lt 20 ]; do sleep 0.1; w=$((w+1)); done
      kill -0 "$_CRPC_PID" 2>/dev/null && kill -KILL "$_CRPC_PID" 2>/dev/null
    fi
    wait "$_CRPC_PID" 2>/dev/null
  fi
  [ -n "${_CRPC_DIR:-}" ] && rm -rf "$_CRPC_DIR"
  _CRPC_PID=""; _CRPC_DIR=""
  return 0
}

# _codex_rollout_active <id>: the thread's rollout is under sessions/, which is
# exactly what discovery (and so the election's view of the name) reads.
_codex_rollout_active() {
  [ -n "$(find "$CODEX_SESSIONS" -type f -name "rollout-*-${1}.jsonl" 2>/dev/null | head -1)" ]
}
# _codex_archive / _codex_unarchive <id>: bounded, and judged by where the
# rollout ended up as well as by the exit code — "archived" means discovery can
# no longer see it.
_codex_archive() {
  run_bounded "$CL_CODEX_RPC_TIMEOUT" "$(agent_cmd_word codex)" archive "$1" >/dev/null 2>&1 || return 1
  ! _codex_rollout_active "$1"
}
# _codex_rollout_state <id> -> active | archived | missing: where the thread's
# rollout is, which is what "archived" means to discovery.
_codex_rollout_state() {
  if _codex_rollout_active "$1"; then printf 'active'
  elif [ -n "$(find "$CODEX_HOME/archived_sessions" -type f -name "rollout-*-${1}.jsonl" 2>/dev/null | head -1)" ]; then printf 'archived'
  else printf 'missing'; fi
}
_codex_unarchive() {
  run_bounded "$CL_CODEX_RPC_TIMEOUT" "$(agent_cmd_word codex)" unarchive "$1" >/dev/null 2>&1 || return 1
  _codex_rollout_active "$1"
}

# ── THE FRESH TRANSACTION ───────────────────────────────────────────────────
#
# Swapping a Codex session onto a new thread crosses boundaries that cannot be
# undone by a process that has died: a thread made, a thread named, the old one
# archived, the row moved. So each boundary is written down BEFORE it is
# crossed, in a transaction file per agent and name, and a later `cl start`
# that finds one carries THAT transaction on rather than starting another:
#
#   begun      old_sid recorded; no new thread yet
#   created    thread/start answered: new_sid recorded before anything else
#   named      the name set and read back, the new rollout visible
#   archived   the old thread archived; the recovery entry written
#   rewritten  the restart row moved onto new_sid (mode still fresh, with
#              fresh_pending = the cycle, so nothing reads it as finished)
#   launching  `codex resume <new>` handed to tmux or exec
#   (finished) the launch verified as codex on new_sid: the file is removed and
#              the row becomes mode resume
#
# Rollback exists only BEFORE `archived`: the old thread is still listed, so
# the new one is archived (discarded), the file removed, and the old thread
# resumed plainly. From `archived` on the transaction only rolls FORWARD — the
# new thread was named and checked before the old one was hidden, so a retry
# resumes it, and never plain-resumes an archived old thread. Unarchiving is
# never automatic; it is the printed way back (`codex unarchive <old>`).
#
# A crash between thread/start taking effect and `created` being written can
# leave a thread nobody saved the id of. A retry at `begun` never adopts one:
# a thread carrying this transaction's creation marker stops the run, named,
# for a person to settle (codex_fresh_advance). This is not exactly-once; it
# never guesses whose a thread is.
#
# The archive is judged by its postcondition (_codex_rollout_state), never by
# the command's exit status; an unreadable result stops as archive-uncertain.
#
# The whole sequence runs under a per-name claim (codex_txn_claim), taken
# before any thread is made and released once the row is settled, so a second
# `cl start` waits for it or refuses — it never runs a swap of its own.
CL_FRESH_DIR="$HOME/.config/claude-session/codex-fresh"
CL_FRESH_CLAIM_WAIT="${CL_FRESH_CLAIM_WAIT:-10}"
_txn_path() {
  local key
  key=$(printf 'codex\037%s' "$1" | shasum -a 256 2>/dev/null | cut -c1-40)
  [ -n "$key" ] || key=$(printf 'codex\037%s' "$1" | cksum | tr -d ' ')
  printf '%s/%s.json' "$CL_FRESH_DIR" "$key"
}
# _txn_get <name> <field>: one field of the pending transaction, or nothing.
_txn_get() { jq -r --arg f "$2" '.[$f] // empty' "$(_txn_path "$1")" 2>/dev/null; }
# _txn_put <name> <json-object>: merge fields in, atomically, and read the
# phase back — the proof is the file, not the exit codes on the way to it.
_txn_put() {
  local f cur tmp
  f=$(_txn_path "$1")
  mkdir -p "$CL_FRESH_DIR" 2>/dev/null || return 1
  cur=$(jq -c '.' "$f" 2>/dev/null) || cur='{}'
  [ -n "$cur" ] || cur='{}'
  tmp="$f.tmp.$$"
  jq -n --argjson cur "$cur" --argjson add "$2" '$cur + $add' > "$tmp" 2>/dev/null && [ -s "$tmp" ] \
    && mv "$tmp" "$f" 2>/dev/null || { rm -f "$tmp" 2>/dev/null; return 1; }
  [ "$(_txn_get "$1" phase)" = "$(printf '%s' "$2" | jq -r '.phase // empty')" ] \
    || [ -z "$(printf '%s' "$2" | jq -r '.phase // empty')" ]
}
_txn_drop() { rm -f "$(_txn_path "$1")" 2>/dev/null; }

# codex_txn_claim <name>: the per-name claim, waiting up to CL_FRESH_CLAIM_WAIT
# seconds for a live holder. A claim whose holder has died is refused, with
# instructions to check and clear exactly it (see below). Sets
# _TXN_LOCK/_TXN_MINE.
#
# EXCLUSION. The claim is a symlink created with `ln -sn`, which is atomic and
# fails if anything exists at the path. Anything at the path that is not a
# symlink (a directory, a file) is refused outright: `ln -s` onto a directory
# makes a link INSIDE it and reports success, which would let every caller in.
#
# AN ABANDONED CLAIM IS NOT TAKEN OVER. Every takeover protocol tried here
# reduced to compare-then-delete one level down, and a delete that lands after
# someone else's fresh claim removes a live claim. So a claim whose holder has
# died (a cl killed mid-replacement) makes the start refuse, printing the one
# command that clears it once you have checked no cl start is running for it.
# A refused start is the cost; two swaps at once is the thing it prevents.
codex_txn_claim() {
  local name="$1" lock mine holder hpid hstart ticks=0
  mkdir -p "$CL_FRESH_DIR" 2>/dev/null || { printf '⚠ "%s": cannot create %s — not replacing its thread\n' "$name" "$CL_FRESH_DIR" >&2; return 1; }
  lock="$(_txn_path "$name").lock"; mine=$(claim_token)
  while :; do
    if [ -e "$lock" ] && [ ! -L "$lock" ]; then
      printf '⚠ "%s": %s exists and is not a claim — refusing to replace its thread until it is removed\n' "$name" "$lock" >&2
      return 1
    fi
    ln -sn "$mine" "$lock" 2>/dev/null && [ "$(readlink "$lock" 2>/dev/null)" = "$mine" ] && break
    holder=$(readlink "$lock" 2>/dev/null)
    if [ "$holder" = "$mine" ]; then break; fi
    if [ -n "$holder" ]; then
      hpid=${holder%%:*}; hstart=${holder#*:}
      if [ "$(start_token "$hpid")" != "$hstart" ]; then
        # The instructions say how to check, then remove THIS claim only, and
        # only while it still names that same dead holder — never a blanket
        # delete of a lock that may by then be someone's live claim.
        printf '⚠ "%s": a cl start that is no longer running (pid %s) left its claim on this replacement — refusing.\n' "$name" "$hpid" >&2
        printf '  First check nothing is still working on it:\n' >&2
        printf '    ps -p %s -o lstart=,command=          # no output, or a different start time than %s\n' "$hpid" "$hstart" >&2
        printf '    pgrep -fl "claude-session.* start"     # no other cl start running\n' >&2
        printf '  Then remove exactly this claim, which the test below keeps to the dead holder, and re-run cl start:\n' >&2
        printf '    [ "$(readlink %s)" = %s ] && rm %s\n' "$(printf '%q' "$lock")" "$(printf '%q' "$holder")" "$(printf '%q' "$lock")" >&2
        return 1
      fi
    fi
    ticks=$((ticks+1))
    if [ "$ticks" -gt $(( CL_FRESH_CLAIM_WAIT * 10 )) ]; then
      printf '⏳ "%s": another cl start (pid %s) is replacing its thread — leaving it to that one\n' "$name" "${hpid:-?}" >&2
      return 1
    fi
    sleep 0.1
  done
  _TXN_LOCK="$lock"; _TXN_MINE="$mine"
  return 0
}
codex_txn_release() {
  [ -n "${_TXN_LOCK:-}" ] && [ "$(readlink "$_TXN_LOCK" 2>/dev/null)" = "$_TXN_MINE" ] && rm -f "$_TXN_LOCK" 2>/dev/null
  _TXN_LOCK=""; return 0
}
codex_txn_pending() { [ -n "$(_txn_get "$1" phase)" ]; }

# _codex_row_rewrite <name> <old-id> <new-id> <cycle>: move the restart row
# onto the new thread, under the row lock ack_state_row takes. Idempotent: a
# row already on the new id is rewritten the same way. The mode stays fresh,
# with fresh_pending naming the cycle — the row is not finished until the
# launch is verified (codex_fresh_finish). No row naming either id is not a
# failure: nothing then points at the thread about to be gone.
_codex_row_rewrite() {
  local name="$1" old="$2" new="$3" cycle="$4" tmp rc=0
  [ -f "$STATE" ] || return 0
  [ "$(jq --arg n "$name" --arg s "$old" --arg t "$new" '[.[] | select((.agent // "claude") == "codex" and .name == $n and (.sid == $s or .sid == $t))] | length' "$STATE" 2>/dev/null)" = "0" ] && return 0
  _state_row_lock "$name" || return 1
  tmp="$STATE.fresh.$$"
  if jq --arg n "$name" --arg s "$old" --arg new "$new" --arg c "$cycle" \
       'map(if (.agent // "claude") == "codex" and .name == $n and (.sid == $s or .sid == $new)
            then .sid = $new | .mode = "fresh" | .fresh_from = $s | .fresh_pending = $c else . end)' \
       "$STATE" > "$tmp" 2>/dev/null && [ -s "$tmp" ] && mv "$tmp" "$STATE" 2>/dev/null; then
    [ "$(jq --arg n "$name" --arg s "$new" '[.[] | select((.agent // "claude") == "codex" and .name == $n and .sid == $s)] | length' "$STATE" 2>/dev/null)" = "1" ] || rc=1
  else
    rc=1
  fi
  rm -f "$tmp" 2>/dev/null
  _state_row_unlock
  return "$rc"
}

# _codex_rollback <name> <old> [new]: before `archived` only. The old thread is
# still listed; the new one (if any) is archived so the two never share the
# name; the transaction is removed. The caller resumes <old> plainly.
_codex_rollback() {
  # The guard that makes a rollback a rollback: the old thread must still be
  # listed. Discarding the new one otherwise would leave neither.
  if [ "$(_codex_rollout_state "$2")" != "active" ]; then
    printf '⚠ "%s": not rolling back — its old thread %s is no longer listed; the replacement stays pending\n' "$1" "$2" >&2
    return 1
  fi
  [ -n "${3:-}" ] && _codex_fresh_discard "$1" "$3"
  _txn_drop "$1"
}

# _codex_marked_threads <marker> <cwd>: ids of threads in local storage whose
# rollout carries this transaction's creation marker. thread/start takes a
# client-supplied threadSource, and Codex writes it into the rollout's
# session_meta (thread_source) — verified against Codex 0.163.0 with a
# throwaway CODEX_HOME. Used to DETECT a possible stray from an interrupted
# run, never to adopt one: a field in a local file is not proof of whose
# creation call made the thread.
_codex_marked_threads() {
  local marker="$1" cwd="$2" f id
  [ -n "$marker" ] || return 0
  find "$CODEX_SESSIONS" -type f -name 'rollout-*.jsonl' 2>/dev/null | while IFS= read -r f; do
    [ "$(head -1 "$f" 2>/dev/null | jq -r '.payload.thread_source // empty' 2>/dev/null)" = "$marker" ] || continue
    [ "$(head -1 "$f" 2>/dev/null | jq -r '.payload.cwd // empty' 2>/dev/null)" = "$cwd" ] || continue
    id=$(basename "$f" .jsonl); id=${id: -36}
    valid_codex_sid "$id" && printf '%s\n' "$id"
  done
}

# _codex_name_new <name> <new> <cwd>: name the new thread and read the name
# back, through its own app-server. Used when a transaction resumes at
# `created`; the first pass names it on the connection that made it.
_codex_name_new() {
  local name="$1" new="$2" cwd="$3" res got why="" _prev_traps
  _NAME_WHY=""
  _prev_traps=$(trap -p INT TERM HUP)
  trap '_crpc_close; exit 130' INT TERM HUP
  if ! _crpc_open "$cwd"; then
    trap - INT TERM HUP; eval "$_prev_traps"
    _NAME_WHY="could not start codex app-server"; return 1
  fi
  if ! _crpc_call 1 initialize '{"clientInfo":{"name":"cl","version":"1"}}' >/dev/null; then why=$(_crpc_why)
  else
    _crpc_send '{"jsonrpc":"2.0","method":"initialized"}'
    if ! _crpc_call 2 thread/name/set "$(jq -cn --arg t "$new" --arg n "$name" '{threadId:$t, name:$n}')" >/dev/null; then why=$(_crpc_why)
    elif ! res=$(_crpc_call 3 thread/read "$(jq -cn --arg t "$new" '{threadId:$t}')"); then why=$(_crpc_why)
    else
      got=$(printf '%s' "$res" | jq -r '.thread.name // empty' 2>/dev/null)
      [ "$got" = "$name" ] || why="the new thread's name reads back as \"$got\", not \"$name\""
    fi
  fi
  _crpc_close
  trap - INT TERM HUP; eval "$_prev_traps"
  _NAME_WHY="$why"
  [ -z "$why" ]
}

# codex_fresh_advance <name> <row-sid> <cwd>: carry the transaction for <name>
# as far as `rewritten`, starting a new one if none is pending. The caller
# holds codex_txn_claim. Prints the id to launch, and returns
#   0  launch it as the new thread, with the first prompt
#   1  launch it plainly (nothing was replaced, or a rollback happened)
#   2  launch nothing; the row and the transaction stay for the next start
codex_fresh_advance() {
  local name="$1" rsid="$2" cwd="$3" phase old new cycle res got why="" _created_here=0
  command -v jq >/dev/null 2>&1 || { printf '⚠ "%s": a fresh Codex thread needs jq — resuming it plainly\n' "$name" >&2; printf '%s' "$rsid"; return 1; }
  phase=$(_txn_get "$name" phase); old=$(_txn_get "$name" old_sid); new=$(_txn_get "$name" new_sid)
  cycle=$(_txn_get "$name" cycle)
  if [ -n "$phase" ] && [ "$rsid" != "$old" ] && [ "$rsid" != "$new" ]; then
    printf '⚠ "%s": a pending replacement (%s → %s) does not match this row (%s) — leaving it, and resuming %s plainly\n' \
      "$name" "$old" "${new:-?}" "$rsid" "$rsid" >&2
    printf '%s' "$rsid"; return 1
  fi
  [ -n "$phase" ] && [ "$phase" != "begun" ] && printf 'ℹ "%s": carrying on its pending replacement (%s → %s, at %s)\n' "$name" "$old" "$new" "$phase" >&2

  # ── an unrecorded creation is never adopted ──
  # `begun` found on entry means a run died somewhere between writing it and
  # writing `created`: possibly after thread/start took effect but before the
  # new id was saved. Whose a thread is cannot be established from local
  # storage — not from its age, its cwd, being the only unnamed one, or even
  # the creation marker this transaction passes to thread/start (threadSource
  # = cl-fresh:<cycle>, which Codex 0.163 writes into the rollout). A field in
  # a local file is not evidence that this run's creation call made that
  # thread. So the marker is used only to DETECT: any thread carrying it stops
  # the run, naming it, and nothing is made, archived or launched. No marked
  # thread means creation starts over. Codex 0.163 writes no rollout for a
  # thread whose app-server exits before it is named (probed, throwaway
  # CODEX_HOME), so in practice the window leaves nothing behind; a Codex that
  # did persist one without the marker would get a second thread, never a
  # stolen one. This is not exactly-once.
  if [ "$phase" = "begun" ]; then
    local found nfound
    found=$(_codex_marked_threads "$(_txn_get "$name" marker)" "$cwd")
    nfound=$(printf '%s' "$found" | grep -c .)
    if [ "$nfound" -gt 0 ]; then
      printf '⚠ "%s": an interrupted replacement may have made thread(s) %s (they carry its creation marker) — stopping; cl does not adopt a thread it cannot prove it made. Nothing made, archived or launched.\n' \
        "$name" "$(printf '%s' "$found" | paste -sd, - | sed 's/,/, /g')" >&2
      printf '  Check each with `codex resume <id>`; archive the stray ones (`codex archive <id>`), then remove this replacement and re-run cl start:\n    rm %s\n' \
        "$(printf '%q' "$(_txn_path "$name")")" >&2
      printf '%s' "$old"; return 2
    fi
    phase=""
  fi

  if [ -z "$phase" ]; then
    old="${old:-$rsid}"
    valid_codex_sid "$old" || { printf '⚠ "%s": "%s" is not a Codex thread id — resuming it plainly\n' "$name" "$old" >&2; _txn_drop "$name"; printf '%s' "$old"; return 1; }
    # Never archive a thread something is still working.
    if [ -n "$(session_pid "$old" codex)" ] || [ -n "$(registered_pid "$name" codex "$old")" ]; then
      printf '⚠ "%s": its thread is still running here — not replacing it; resuming it plainly\n' "$name" >&2
      _txn_drop "$name"; printf '%s' "$old"; return 1
    fi
    if ! _codex_rollout_active "$old"; then
      printf '⚠ "%s": thread %s is not in %s (archived or moved?) — not replacing it\n' "$name" "$old" "$CODEX_SESSIONS" >&2
      _txn_drop "$name"; printf '%s' "$old"; return 1
    fi
    cycle="$(date +%s 2>/dev/null || echo 0)-$$-$RANDOM"
    if ! _txn_put "$name" "$(jq -cn --arg n "$name" --arg c "$cwd" --arg o "$old" --arg y "$cycle" \
           --argjson at "$(date +%s 2>/dev/null || echo 0)" \
           '{agent:"codex", name:$n, cwd:$c, old_sid:$o, new_sid:"", cycle:$y, begun_at:$at, marker:("cl-fresh:" + $y), phase:"begun"}')"; then
      printf '⚠ "%s": could not record the replacement in %s — not replacing it; resuming it plainly\n' "$name" "$CL_FRESH_DIR" >&2
      printf '%s' "$old"; return 1
    fi
    # ── create (and, on the same connection, name and read back) ──
    local _prev_traps; _prev_traps=$(trap -p INT TERM HUP)
    trap '_crpc_close; exit 130' INT TERM HUP
    if ! _crpc_open "$cwd"; then
      trap - INT TERM HUP; eval "$_prev_traps"
      printf '⚠ "%s": could not start codex app-server — resuming it plainly\n' "$name" >&2
      { _codex_rollback "$name" "$old" || { printf '%s' "$old"; return 2; }; }; printf '%s' "$old"; return 1
    fi
    new=""
    if ! res=$(_crpc_call 1 initialize '{"clientInfo":{"name":"cl","version":"1"}}'); then
      why=$(_crpc_why)
    else
      _crpc_send '{"jsonrpc":"2.0","method":"initialized"}'
      if ! res=$(_crpc_call 2 thread/start "$(jq -cn --arg c "$cwd" --arg m "$(_txn_get "$name" marker)" '{cwd:$c, threadSource:$m}')"); then
        why=$(_crpc_why)
      else
        new=$(printf '%s' "$res" | jq -r '.thread.id // empty' 2>/dev/null)
        if ! valid_codex_sid "$new"; then
          why="thread/start returned no thread id"; new=""
        elif ! _txn_put "$name" "$(jq -cn --arg t "$new" '{new_sid:$t, phase:"created"}')"; then
          why="could not record the new thread id in $CL_FRESH_DIR"
        elif ! _crpc_call 3 thread/name/set "$(jq -cn --arg t "$new" --arg n "$name" '{threadId:$t, name:$n}')" >/dev/null; then
          why=$(_crpc_why)
        elif ! res=$(_crpc_call 4 thread/read "$(jq -cn --arg t "$new" '{threadId:$t}')"); then
          why=$(_crpc_why)
        else
          got=$(printf '%s' "$res" | jq -r '.thread.name // empty' 2>/dev/null)
          [ "$got" = "$name" ] || why="the new thread's name reads back as \"$got\", not \"$name\""
        fi
      fi
    fi
    _crpc_close
    trap - INT TERM HUP; eval "$_prev_traps"
    phase="created"; _created_here=1
  fi
  if [ "$phase" = "created" ] && [ "$_created_here" != "1" ]; then
    if ! _codex_name_new "$name" "$new" "$cwd"; then why="${_NAME_WHY:-could not name the new thread}"; fi
  fi

  if [ "$phase" = "created" ]; then
    [ -z "$why" ] && [ -n "$new" ] && ! _codex_rollout_active "$new" && why="the new thread has no rollout in $CODEX_SESSIONS"
    if [ -z "$why" ] && ! _txn_put "$name" '{"phase":"named"}'; then why="could not record the named thread in $CL_FRESH_DIR"; fi
    if [ -n "$why" ]; then
      printf '⚠ "%s": could not make a fresh Codex thread (%s) — resuming it plainly\n' "$name" "$why" >&2
      { _codex_rollback "$name" "$old" "$new" || { printf '%s' "$new"; return 2; }; }; printf '%s' "$old"; return 1
    fi
    phase="named"
  fi

  if [ "$phase" = "named" ] || [ "$phase" = "archive-uncertain" ]; then
    # The archive is judged by its POSTCONDITION, never by the command's exit
    # status: a reply lost after the side effect (a timeout, a dropped
    # connection) reports failure for an archive that happened. So:
    #   still listed     it really did not happen — roll back (old untouched)
    #   archived         it happened, whatever was reported — roll forward
    #   neither          cannot tell — stop, keeping the transaction as
    #                    archive-uncertain; nothing is discarded or resumed
    # A crash between the archive and writing it down lands in "archived" on
    # the retry, without archiving anything twice.
    if [ "$(_codex_rollout_state "$old")" = "active" ]; then
      if [ -n "$(session_pid "$old" codex)" ] || [ -n "$(registered_pid "$name" codex "$old")" ]; then
        printf '⚠ "%s": its old thread is running again — not archiving it; resuming it plainly\n' "$name" >&2
        { _codex_rollback "$name" "$old" "$new" || { printf '%s' "$new"; return 2; }; }; printf '%s' "$old"; return 1
      fi
      _codex_archive "$old" >/dev/null 2>&1
    fi
    case "$(_codex_rollout_state "$old")" in
      archived) : ;;
      active)
        printf '⚠ "%s": could not archive its old thread %s — resuming it plainly\n' "$name" "$old" >&2
        { _codex_rollback "$name" "$old" "$new" || { printf '%s' "$new"; return 2; }; }; printf '%s' "$old"; return 1 ;;
      *)
        _txn_put "$name" '{"phase":"archive-uncertain"}' >/dev/null 2>&1
        printf '⚠ "%s": its old thread %s is neither listed nor archived — stopping here; nothing launched, nothing discarded. Check %s, then re-run cl start\n' \
          "$name" "$old" "$CODEX_HOME" >&2
        printf '%s' "$new"; return 2 ;;
    esac
    # The recovery entry is written the moment the old thread stops being
    # listed, so a crash after this still leaves the way back recorded.
    record_fresh_history "$name" "$old" "$cwd" codex
    _txn_put "$name" '{"phase":"archived"}' \
      || printf '⚠ "%s": could not record the archive in %s — a retry will see the old thread archived and carry on\n' "$name" "$CL_FRESH_DIR" >&2
    phase="archived"
  fi

  if [ "$phase" = "archived" ]; then
    if ! _codex_row_rewrite "$name" "$old" "$new" "$cycle" || ! _txn_put "$name" '{"phase":"rewritten"}'; then
      printf '⚠ "%s": could not move its restart row onto the new thread %s — nothing launched; re-run cl start to finish (the old thread %s is archived)\n' \
        "$name" "$new" "$old" >&2
      printf '%s' "$new"; return 2
    fi
    phase="rewritten"
  fi

  # rewritten | launching: the new thread is the one to run.
  printf '%s' "$new"; return 0
}

# codex_launch_verified <name> <new> -> 0 when the process running is codex on
# <new>, by the ownership rules retire_session trusts: a tmux session cl
# stamped for that SID with a `codex … resume <new>` process inside its pane,
# or cl's launch record for that name and SID (bare shape; exec keeps the pid
# and start time the record names). tmux has-session alone proves a pane, not
# an agent.
# proc_identity <pid>: the process's REAL identity, NUL-separated: its
# executable's path, then each argv element. Nothing (and 1) when it cannot be
# read.
#
# Not `ps`. `ps -o command=` is argv joined by spaces, so its words are not
# argv elements, and `exec -a 'claude --resume X' /bin/sleep` puts a whole
# "command line" in argv[0]; `ps -o comm=` follows exec -a too. The kernel
# knows better: libproc's proc_pidpath gives the image actually executing, and
# sysctl KERN_PROCARGS2 the argv with its real boundaries (on Linux,
# /proc/<pid>/exe and /proc/<pid>/cmdline). Read through python3 -I (isolated:
# no user site, no cwd on the path). Without python3 there is no answer, and a
# caller treats that as no evidence — failing closed.
_CL_PROC_IDENTITY_PY='import ctypes, ctypes.util, os, struct, sys
pid = int(sys.argv[1])
out = sys.stdout.buffer
if os.path.exists("/proc/%d/exe" % pid):
    exe = os.readlink("/proc/%d/exe" % pid).encode()
    with open("/proc/%d/cmdline" % pid, "rb") as fh:
        args = fh.read().split(b"\0")
    if args and args[-1] == b"":
        args.pop()
else:
    lp = ctypes.CDLL("/usr/lib/libproc.dylib")
    buf = ctypes.create_string_buffer(4096)
    if lp.proc_pidpath(pid, buf, 4096) <= 0:
        sys.exit(1)
    exe = buf.value
    libc = ctypes.CDLL(ctypes.util.find_library("c"))
    mib = (ctypes.c_int * 3)(1, 49, pid)
    size = ctypes.c_size_t(0)
    if libc.sysctl(mib, 3, None, ctypes.byref(size), None, 0) != 0:
        sys.exit(1)
    raw = ctypes.create_string_buffer(size.value)
    if libc.sysctl(mib, 3, raw, ctypes.byref(size), None, 0) != 0:
        sys.exit(1)
    raw = raw.raw[:size.value]
    argc = struct.unpack("i", raw[:4])[0]
    rest = raw[4:]
    rest = rest[rest.index(b"\0"):].lstrip(b"\0")
    args = rest.split(b"\0")[:argc]
    if len(args) != argc:
        sys.exit(1)
out.write(exe + b"\0")
for a in args:
    out.write(a + b"\0")'
proc_identity() {
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
  command -v python3 >/dev/null 2>&1 || return 1
  python3 -I -c "$_CL_PROC_IDENTITY_PY" "$1" 2>/dev/null
}

# _codex_argv_resumes <pid> <id>: the process IS Codex resuming <id>, by its
# real identity (proc_identity): the executable is named codex, or it is node
# whose argv[1] — the entry script, with no node options before it — resolves
# to the Codex launcher script (…/@openai/codex/bin/codex.js);
# and, as real argv elements after that, the first word past the options is
# `resume`, immediately followed by <id>. No python3, no identity: not Codex.
_codex_argv_resumes() {
  local pid="$1" new="$2" x exe base i n prev="" tok
  local -a f=() av=()
  local idf
  # Through a file, so the read's exit status is honoured: an answer printed
  # by a read that then failed is no answer.
  idf=$(mktemp "${TMPDIR:-/tmp}/clid.XXXXXX" 2>/dev/null) || return 1
  if ! proc_identity "$pid" > "$idf"; then rm -f "$idf"; return 1; fi
  while IFS= read -r -d '' x; do f+=("$x"); done < "$idf"
  rm -f "$idf"
  [ "${#f[@]}" -ge 2 ] || return 1
  exe="${f[0]}"; av=("${f[@]:1}"); n=${#av[@]}
  base=$(basename -- "$exe")
  case "$base" in
    codex) i=1 ;;
    node|nodejs)
      # The entry script must be argv[1] exactly: no node options before it,
      # and argv[1] not an option itself. Anything else lets node run other
      # code (`-e`, `-p`, `--require x`) with a codex.js-shaped path sitting
      # later in argv as mere data. A real shebang launcher runs as `node
      # <script> …` (the npm one as `node /opt/homebrew/bin/codex …`, a
      # symlink), so argv[1] is resolved and must be the Codex launcher.
      [ "$n" -ge 2 ] || return 1
      case "${av[1]}" in -*) return 1 ;; esac
      case "$(realpath "${av[1]}" 2>/dev/null)" in */@openai/codex/bin/codex.js) ;; *) return 1 ;; esac
      i=2 ;;
    *) return 1 ;;
  esac
  while [ "$i" -lt "$n" ]; do
    tok="${av[$i]}"; i=$((i+1))
    case "$tok" in
      resume) [ "$i" -lt "$n" ] && [ "${av[$i]}" = "$new" ]; return $? ;;
      --*=*) prev="" ;;
      -*) prev="$tok" ;;
      *)
        # A bare word is only allowed as the value of the option before it
        # (`-m gpt-5`, `-c key=value`); any other word is a subcommand that
        # is not `resume`.
        case "$prev" in -*) prev="" ;; *) return 1 ;; esac ;;
    esac
  done
  return 1
}

codex_launch_verified() {
  local name="$1" new="$2" t
  t=$(tmux_name "$name" codex)
  if command -v tmux >/dev/null 2>&1 && tmux has-session -t "=$t" 2>/dev/null; then
    tmux_owned "$t" codex "$new" && _codex_pane_runs "$t" "$new"
    return $?
  fi
  local rp; rp=$(registered_pid "$name" codex "$new")
  [ -n "$rp" ] && _codex_argv_resumes "$rp" "$new"
}
# _codex_pane_runs <tmux-session> <id>: a `codex … resume <id>` process is the
# pane's own process or descends from it.
_codex_pane_runs() {
  local t="$1" new="$2" pane p q i
  pane=$(tmux list-panes -t "=$t:" -F '#{pane_pid}' 2>/dev/null | head -1)
  [ -n "$pane" ] || return 1
  for p in $(pgrep -f "resume $new" 2>/dev/null); do
    _codex_argv_resumes "$p" "$new" || continue
    q="$p"; i=0
    while [ -n "$q" ] && [ "$q" != "0" ] && [ "$q" != "1" ] && [ "$i" -lt 20 ]; do
      [ "$q" = "$pane" ] && return 0
      q=$(ps -o ppid= -p "$q" 2>/dev/null | tr -d ' '); i=$((i+1))
    done
  done
  return 1
}

# codex_fresh_finish <name> <new>: the launch is verified. The row (if it is
# still there) becomes mode resume with fresh_pending cleared, and the
# transaction is removed. Caller holds the claim.
#
# The journal goes ONLY once the row transition is durable, or there is no row
# to move: a row left fresh/pending without its journal would read as a new
# fresh cycle to the next start. Non-zero, journal kept, otherwise — and the
# callers keep the row and report it.
codex_fresh_finish() {
  local name="$1" new="$2" tmp rc=0
  _codex_row_count() { jq --arg n "$name" --arg s "$new" "[.[] | select((.agent // \"claude\") == \"codex\" and .name == \$n and .sid == \$s $1)] | length" "$STATE" 2>/dev/null; }
  if [ -f "$STATE" ] && [ "$(_codex_row_count '')" != "0" ]; then
    _state_row_lock "$name" || { printf '⚠ "%s": could not settle its restart row — the replacement stays pending\n' "$name" >&2; return 1; }
    tmp="$STATE.finish.$$"
    if jq --arg n "$name" --arg s "$new" \
         'map(if (.agent // "claude") == "codex" and .name == $n and .sid == $s
              then .mode = "resume" | del(.fresh_pending) else . end)' "$STATE" > "$tmp" 2>/dev/null \
       && [ -s "$tmp" ] && mv "$tmp" "$STATE" 2>/dev/null; then
      # Read back: every row for this name and id is now resume, none pending.
      [ "$(_codex_row_count 'and (.mode != "resume" or has("fresh_pending"))')" = "0" ] || rc=1
    else
      rc=1
    fi
    rm -f "$tmp" 2>/dev/null
    _state_row_unlock
    if [ "$rc" != "0" ]; then
      printf '⚠ "%s": could not settle its restart row — the replacement stays pending\n' "$name" >&2
      return 1
    fi
  fi
  _txn_drop "$name"
}

# codex_coord_note <name> <new>: what a verified launch does NOT prove. With a
# coordination re-arm helper installed, a lane may be configured for this
# session, and accepting the new process says nothing about which thread the
# lane's election now names: that moves on the new thread's first
# SessionStart, which cl cannot observe. So it is reported as pending, never
# as done. Without the helper there is no lane to wait for, and nothing is said.
codex_coord_note() {
  local script="${CL_COORD_REARM:-$HOME/.claude/scripts/coord-rearm.sh}"
  [ -x "$script" ] || return 0
  printf '  ℹ coordination for "%s" is NOT verified by cl: a lane, if configured, elects %s only on that thread'"'"'s first SessionStart — confirm it with your coordination tooling\n' "$1" "$2"
}

# codex_fresh_settle <name> <sid>: a pending transaction whose new thread is
# already up and verified is finished; anything else is left as it is. Used
# where a start or a stop meets a session that is live.
codex_fresh_settle() {
  local name="$1" sid="$2"
  case "$(_txn_get "$name" phase)" in rewritten|launching) ;; *) return 1 ;; esac
  [ "$(_txn_get "$name" new_sid)" = "$sid" ] || return 1
  codex_txn_claim "$name" || return 1
  # A start that died between `tmux new-session` and stamping it left an
  # unstamped session. It is adopted only on the strongest evidence there is:
  # nothing has stamped it at all, the pending transaction names this exact new
  # id, and the pane itself runs `codex resume <that id>` — an id only this
  # transaction knew.
  local t; t=$(tmux_name "$name" codex)
  if command -v tmux >/dev/null 2>&1 && tmux has-session -t "=$t" 2>/dev/null \
     && [ -z "$(tmux show-option -qv -t "=$t:" "@cl_agent" 2>/dev/null)" ] && _codex_pane_runs "$t" "$sid"; then
    tmux_claim "$t" codex "$sid"
    printf 'ℹ "%s": adopting the tmux session its interrupted start launched on %s\n' "$name" "$sid" >&2
  fi
  if [ "$(_txn_get "$name" new_sid)" = "$sid" ] && codex_launch_verified "$name" "$sid" \
     && codex_fresh_finish "$name" "$sid"; then
    codex_txn_release; return 0
  fi
  codex_txn_release; return 1
}
# _codex_fresh_discard <name> <id>: archive a new thread that will not be used,
# so two threads never share the name — discovery is newest-wins, and an empty
# one would win.
_codex_fresh_discard() {
  _codex_archive "$2" \
    || printf '⚠ "%s": the unused new thread %s is still listed under this name — run: codex archive %s\n' "$1" "$2" "$2" >&2
}

# CL_SESSION_NAME tells `cl handoff`, run INSIDE a session, which session it is
# without being told. It reaches the agent two different ways, because the two
# launch shapes are genuinely different:
#
#   pane command  — tmux runs the command string in a NEW shell that does
#                   not inherit this one's environment, so the assignment has
#                   to be part of the string. That is env_prefix.
#   exec          — `exec VAR=x cmd` is not valid shell (exec would take the
#                   assignment as the command name), so those paths export it
#                   into this shell first; an export survives exec.
# env_prefix <name> [sid]: the assignments a pane command carries.
# CL_SESSION_ID is what `cl handoff` stamps into a hand-written handoff. It is
# passed explicitly because the alternative — looking the id up by display name
# — is not proof of anything: the name is stable across rotations, so after one
# the newest row for that name is the REPLACEMENT, and a predecessor still
# finishing its handoff would stamp its successor's id onto its own file and
# make a stale handoff look current. A fresh session has no id yet and stamps
# nothing, which is honest; a wrong id is worse than none.
env_prefix() {
  printf 'CL_SESSION_NAME=%s ' "$(printf '%q' "$1")"
  [ -n "${2:-}" ] && printf 'CL_SESSION_ID=%s ' "$(printf '%q' "$2")"
  return 0
}

# fresh_cmd <name> <initial_prompt>: the shell command string that starts a NEW
# claude registered under an EXISTING name, with the prompt as its first
# message. The twin of resume_cmd, and for the same reason: `cl start` has to
# put this into a detached tmux pane, where it cannot exec.
# launch_fresh builds its command from here too, so the two cannot drift.
# _agent_runnable: is the configured agent actually launchable? claude_cmd can
# be a wrapper with arguments, so only its first word is a command to resolve.
_agent_runnable() {
  local first; first=$(claude_cmd); first=${first%% *}
  [ -n "$first" ] || return 1
  command -v "$first" >/dev/null 2>&1
}

# An EMPTY prompt is the `fresh` restart mode: a new session with nothing to
# read. The positional is then left out entirely rather than passed as '' —
# an empty first message is not the same thing as none.
fresh_cmd() {
  if [ -z "${2:-}" ]; then
    printf '%s --name %s --dangerously-skip-permissions' "$(claude_cmd)" "$(printf '%q' "$1")"
    return 0
  fi
  printf '%s --name %s --dangerously-skip-permissions %s' \
    "$(claude_cmd)" "$(printf '%q' "$1")" "$(printf '%q' "$2")"
}

# session_pid <sid> [agent] [name]: pid of the local process running this
# session, if any. Guards the bare (non-tmux) path against double --resume of
# one session — two processes on the same transcript — the hazard tmux's
# attach-don't-duplicate prevents on the tmux path. `cl stop` also KILLS the
# pid this returns, so being wrong here is not a cosmetic error.
#
# ── FOR CLAUDE, THREE SOURCES, IN ORDER OF HOW MUCH THEY CAN BE TRUSTED ─────
#
# 1. cl's own launch record (registered_pid), bound to this name AND this sid.
#    Only it proves cl launched and owns the process. Both it and the registry
#    prove a pid is live; when a session is running twice (a manual duplicate
#    resume), only the launch record says which copy is cl's — the registry
#    would hand back whichever file the glob visits first.
# 2. Claude Code's OWN registry, ~/.claude/sessions/<pid>.json, which records
#    the real sessionId for every running session — proven by start time, so a
#    reused pid cannot pass. See claude_registry_pid. It answers for forks and
#    for `cl new` launches, whose launch records are not bound to a sid.
# 3. argv matching, `--resume <sid>`, as a fallback for a Claude Code too old
#    to keep a registry — and NEVER counting a `--fork-session` process.
#
# This used to be argv first, `pgrep … | head -1`, and that was wrong in a way
# that killed the wrong session. `claude --resume P --fork-session` runs a NEW
# session with its own id, but its argv still names the PARENT's id P. So the
# fork matched the parent; pgrep lists in ascending pid order; and on
# 2026-10-21 the fork (pid 595) sorted before the real parent (pid 42453).
# `cl stop` would have signalled the fork as if it were the parent — killing a
# session that was never asked for a handoff — and left the parent running,
# reported as stopped. The fork itself was invisible (its own id appears in no
# argv), so it was neither saved nor restored. Found by asking why a session
# the operator could see open was listed as not running.
#
# For codex this is a "matching local resume process" marker, NOT proof the
# thread is live or idle: Codex also runs threads through a shared app-server
# daemon, the Desktop app, and --remote clients, none of which show a `resume
# <sid>` argv here — and the npm launcher is a node wrapper plus a native
# child that BOTH match. So: a hit is a conservative reason to refuse a second
# launch; a miss proves nothing; and the pid must never be used as a kill target.
# --- launch registry ---------------------------------------------------------
# A session created by `cl new` runs `claude --name <name>`: its argv carries no
# session id, so an id match cannot find it. `tmux has-session` used to cover
# that; without tmux nothing did, and `cl stop` skipped the newest session while
# reporting the fleet saved.
#
# Matching the NAME inside ps output is not a safe answer: ps renders the
# command as text, so `--name Solo` is a substring of `--name Solo Two` and the
# wrong agent gets killed. Instead, record the pid at launch. `exec` keeps both
# the pid AND the process start time, so a record written by this shell just
# before exec still describes the agent that replaces it — and the start time
# makes pid reuse detectable. No command-text parsing anywhere.
#
# Only sessions this tool launched outside tmux are registered; that is exactly
# the set nothing else can identify. A record judged stale is left in place for
# the claim holder to overwrite — read paths never mutate one.
PID_DIR="$HOME/.config/claude-session/pids"

# The key is a digest of agent + the EXACT name. It deliberately does NOT reuse
# tmux_name's sanitiser, which maps `A B` and `A.B` to one identity.
# Under tmux that collision was harmless —
# `new-session -A` made colliding names share one session, so two owners could
# not exist. Bare, both launch, the second record overwrites the first, and a
# kill path then reads someone else's pid. The record also carries the agent
# and name so a mismatch can be caught even if a digest ever collided.
reg_file() { # name [agent]
  local key
  key=$(printf '%s\037%s' "${2:-claude}" "$1" | shasum -a 256 2>/dev/null | cut -c1-40)
  [ -n "$key" ] || key=$(printf '%s\037%s' "${2:-claude}" "$1" | cksum | tr -d ' ')
  printf '%s/%s' "$PID_DIR" "$key"
}

# Remove a record ONLY if it still describes the exact owner being retired —
# pid AND start token AND agent AND name — and only while holding that name's
# claim. `cl stop` kills a pid and then cleans up; a new launcher can acquire
# and register in between, and a replacement can even REUSE the dead pid, which
# is exactly why the record carries a start token. Comparing the number alone
# would delete that replacement's registration. If the claim cannot be taken,
# the record is left alone — a stale record is inert, a deleted live one is not.
#
# The caller must capture the token BEFORE killing: it cannot be read back out
# of a dead process.
clear_launch() { # name agent expected-pid expected-token
  # Five fields since the record binds the sid: `read` gives the remainder to
  # the LAST variable, so reading four made rname absorb "name<TAB>sid", the
  # ownership comparison never matched, and a retired record was left behind.
  local f lock me rpid rtok ragent rname rsid
  [ -n "${3:-}" ] && [ -n "${4:-}" ] || return 0
  f=$(reg_file "$1" "${2:-claude}"); lock="${f}.lock"
  [ -r "$f" ] || return 0
  # A real start token, not a placeholder: acquire_launch parses this target as
  # pid:token, so "cleanup" would make a LIVE cleanup holder look like a dead
  # one and tell the user to delete a perfectly valid lock.
  me=$(claim_token); case "$me" in *:) return 0 ;; esac
  ln -s "$me" "$lock" 2>/dev/null || return 0
  IFS=$(printf '\t') read -r rpid rtok ragent rname rsid < "$f" 2>/dev/null
  if [ "$rpid" = "$3" ] && [ "$rtok" = "$4" ] \
     && [ "$ragent" = "${2:-claude}" ] && [ "$rname" = "$1" ]; then
    rm -f "$f" 2>/dev/null
  fi
  rm -f "$lock" 2>/dev/null
  return 0
}

# start_token <pid>: the process's start time as one whitespace-free word, so
# it can live in a record field or a symlink target. Empty if the process is
# gone — callers treat empty as "cannot prove anything about this pid".
start_token() { ps -o lstart= -p "${1:-$$}" 2>/dev/null | tr -s ' ' | tr ' ' '_'; }

# claim_token: the lock symlink's target — `<pid>:<start token>`. Both holders
# of a claim (a launcher and a cleanup) MUST use this, because acquire_launch
# parses the target back into pid and token to decide whether the holder is
# still alive. A hand-written placeholder here made a running cleanup read as a
# dead holder and told the user to delete a valid lock; one definition removes
# the chance of the two drifting apart again.
claim_token() { printf '%s:%s' "$$" "$(start_token $$)"; }


# READ-ONLY on purpose. It used to delete records it judged stale, which is the
# same validate-then-unlink-a-pathname race as the claim lock: a launcher
# holding the lock can write a fresh record between the read and the delete,
# and the cleanup would then remove the NEW owner's registration, leaving that
# agent untracked and duplicable. A stale record is harmless — every reader
# validates before trusting, and acquire_launch overwrites it while holding the
# lock — so nothing here mutates.
registered_pid() { # name [agent] [expected-sid] -> live pid we launched, or nothing
  local f pid started ragent rname rsid now
  f=$(reg_file "$1" "${2:-claude}")
  [ -r "$f" ] || return 0
  IFS=$(printf '\t') read -r pid started ragent rname rsid < "$f" || return 0
  case "$pid" in ''|*[!0-9]*) return 0 ;; esac
  # A record must prove it is about THIS session before a kill path sees it.
  [ "$ragent" = "${2:-claude}" ] && [ "$rname" = "$1" ] || return 0
  # …and about this THREAD, when the caller knows which one it means. An
  # unbound record ("-", or one written before sids were recorded) can never
  # satisfy that, so it is not a stop handle.
  if [ -n "${3:-}" ]; then
    [ -n "$rsid" ] && [ "$rsid" != "-" ] && [ "$rsid" = "$3" ] || return 0
  fi
  now=$(start_token "$pid")
  # Gone, or the pid was recycled into a different process: the record is a
  # lie, so report nothing — but leave it for the lock holder to replace.
  [ -n "$now" ] && [ "$now" = "$started" ] && printf '%s\n' "$pid"
  return 0
}

# retire_process <pid> <token> <label>: signal EXACTLY the process identified
# by that pid+start-token pair, then wait for it to actually go.
#
# Revalidating at the destructive boundary is the point. `cl stop` may sit on a
# "kill it anyway?" prompt for as long as a person takes to answer; the original
# process can exit in that window and its pid be reused, and an unrevalidated
# `kill` would then signal a stranger. Prints nothing and returns 1 when the
# identity no longer matches — the caller reports it as "exited while deciding".
#
# Returns 0 when the process is confirmed gone, 2 when it was signalled but is
# still shutting down (SessionEnd hooks can take a moment). A caller must NOT
# retire the ownership record in that case: until the process is really gone,
# that record is the only thing stopping a second agent from launching.
# retire_process pid token [exit-wait-tries] [expected-command-substring]
#
# The token proves the pid was not recycled, but only to the resolution ps
# prints — and a launcher can exec something else without changing either pid
# or start time, so the record stays "valid" while naming a different program.
# When the caller knows what should be running, that is checked too, at the
# last moment before the signal.
retire_process() {
  local i=0 max="${3:-30}" want="${4:-}"
  [ -n "$1" ] && [ -n "$2" ] || return 1
  [ "$(start_token "$1")" = "$2" ] || return 1     # not the process we meant
  if [ -n "$want" ]; then
    case "$(ps -o command= -p "$1" 2>/dev/null)" in
      *"$want"*) ;;
      *) return 3 ;;                                # the pid is someone else now
    esac
  fi
  kill "$1" 2>/dev/null || return 1
  while [ "$(start_token "$1")" = "$2" ]; do
    i=$((i+1)); [ "$i" -gt "$max" ] && return 2
    sleep 0.1
  done
  return 0
}

# acquire_launch <name> <agent> [sid]: claim this session, or print the pid
# that already owns it and return 1.
#
# Atomic on purpose. A check followed by a write is not: two tabs running
# `cl <name>` together could both see nothing, both write, and both exec an
# agent on one transcript. `tmux new-session -A` used to be that arbiter; with
# no tmux we have to be it. mkdir is the atomic primitive — it either creates
# the directory or fails — so the check and the claim happen under it.
acquire_launch() {
  local f lock me holder hpid hstart tries=0 envfail=0 owner back
  me=$(start_token $$)
  # Without a start token the record could never be validated later, so there
  # is no safe way to own anything. Fail closed.
  [ -n "$me" ] || { echo "claude-session: cannot read this process's start time — refusing to launch unowned" >&2; return 2; }
  f=$(reg_file "$1" "${2:-claude}"); lock="${f}.lock"
  mkdir -p "$PID_DIR" 2>/dev/null || { echo "claude-session: cannot create $PID_DIR — refusing to launch a session the registry cannot track" >&2; return 2; }

  # The lock is a SYMLINK whose target names its owner. ln -s is atomic and
  # carries the identity in the same operation, so there is never a window
  # where the lock exists but its owner is unknown.
  # `ln -s target dir` creates the link INSIDE the directory and reports
  # success, so anything that is not a symlink sitting at the lock path would
  # hand us a lock we do not actually hold. Refuse rather than pretend.
  if [ -e "$lock" ] && [ ! -L "$lock" ]; then
    echo "claude-session: $lock exists and is not a claim lock — remove it, then retry" >&2
    return 2
  fi
  while ! ln -s "$(claim_token)" "$lock" 2>/dev/null; do
    holder=$(readlink "$lock" 2>/dev/null)
    if [ -z "$holder" ]; then
      # Either the lock vanished between our attempt and the read (retrying is
      # right), or links cannot be created here at all — in which case looping
      # would spin forever, so fail closed after a few tries.
      if [ ! -L "$lock" ] && [ ! -e "$lock" ]; then
        envfail=$((envfail+1))
        if [ "$envfail" -gt 5 ]; then
          echo "claude-session: cannot create the claim lock in $PID_DIR — refusing to launch untracked" >&2
          return 2
        fi
      fi
      sleep 0.1; continue
    fi
    hpid=${holder%%:*}; hstart=${holder#*:}
    # Reclaim ONLY on proof the holder is gone or its pid was recycled. Age is
    # not proof: a holder merely slow in ps/pgrep/IO would have its lock stolen
    # and two launchers would enter the critical section together.
    # A stale lock is NEVER unlinked automatically. Validating the symlink and
    # then `rm`-ing its pathname are two operations: between them another
    # waiter can reclaim and establish a live claim, and the delete would then
    # destroy THAT claim and let two launchers into the critical section. The
    # start-token proof authenticates the object read, not the object later
    # unlinked, and portable shell has no compare-and-swap to close that. So:
    # report it and let a person clear it. (A launcher has to die inside a
    # few-millisecond window to leave one, so this should be vanishingly rare.)
    case "$hpid" in
      ''|*[!0-9]*)
        echo "claude-session: $lock is malformed — clear it, then retry:" >&2
        echo "  rm -f $(printf '%q' "$lock")" >&2
        return 2 ;;
    esac
    if [ "$(start_token "$hpid")" != "$hstart" ]; then
      echo "claude-session: a previous launcher (pid $hpid) died holding the claim for \"$1\" — clear it, then retry:" >&2
      echo "  rm -f $(printf '%q' "$lock")" >&2
      return 2
    fi
    tries=$((tries+1))
    if [ "$tries" -gt "${CL_CLAIM_WAIT_TRIES:-100}" ]; then
      echo "claude-session: another launcher (pid $hpid) is still claiming \"$1\" — not launching; try again" >&2
      return 2
    fi
    sleep 0.1
  done

  owner=""
  [ -z "${3:-}" ] || owner=$(session_pid "$3" "${2:-claude}" "$1")
  [ -n "$owner" ] || owner=$(registered_pid "$1" "${2:-claude}")
  if [ -n "$owner" ]; then
    rm -f "$lock" 2>/dev/null
    printf '%s\n' "$owner"
    return 1
  fi
  # exec keeps this pid AND this start time, so the record describes the agent
  # that is about to replace this shell. Written, then read back: a record that
  # did not land means the session would be unidentifiable, which is the whole
  # failure this registry exists to prevent — so that fails closed too.
  # The SID is part of the record, not just an argument. Without it the record
  # proves only that SOME process was launched under this agent and name — and
  # names are not unique over time: a newer Codex thread with the same display
  # name wins discovery, so stop could signal the older thread's process while
  # save recorded the newer thread's id. Stopped process and restored transcript
  # would then be different sessions. "-" marks a launch with no id yet (a fresh
  # unnamed Codex thread); such a record is never accepted as a stop handle.
  if ! printf '%s\t%s\t%s\t%s\t%s\n' "$$" "$me" "${2:-claude}" "$1" "${3:--}" > "$f" 2>/dev/null; then
    rm -f "$f" "$lock" 2>/dev/null
    echo "claude-session: cannot write the ownership record in $PID_DIR — refusing to launch untracked" >&2
    return 2
  fi
  back=$(registered_pid "$1" "${2:-claude}")
  rm -f "$lock" 2>/dev/null
  if [ "$back" != "$$" ]; then
    rm -f "$f" 2>/dev/null
    echo "claude-session: the ownership record did not verify — refusing to launch untracked" >&2
    return 2
  fi
  return 0
}

# _state_row_lock <name>: take the restart-row lock for a rewrite of STATE,
# setting _ROW_LOCK and _ROW_LOCK_MINE. Split out of ack_state_row so the one
# other row rewrite that must not race it — a Codex `fresh` start moving a row
# onto its new thread — takes the same lock rather than a second one.
_state_row_lock() {
  local name="$1" lock mine tries=0 envfail=0 holder hpid hstart
  lock="${STATE}.acklock"
  mine=$(claim_token)
  if [ -e "$lock" ] && [ ! -L "$lock" ]; then
    printf 'claude-session: %s exists and is not a claim lock — remove it; until then "%s" stays in the restart list\n' "$lock" "$name" >&2
    return 1
  fi
  while ! ln -s "$mine" "$lock" 2>/dev/null; do
    holder=$(readlink "$lock" 2>/dev/null)
    if [ -z "$holder" ]; then
      # Either it vanished between the attempt and the read (retry), or links
      # cannot be made here at all — in which case looping would never end.
      if [ ! -L "$lock" ] && [ ! -e "$lock" ]; then
        envfail=$((envfail+1))
        if [ "$envfail" -gt 5 ]; then
          printf 'claude-session: cannot create %s — "%s" stays in the restart list\n' "$lock" "$name" >&2
          return 1
        fi
      fi
      sleep 0.05; continue
    fi
    hpid=${holder%%:*}; hstart=${holder#*:}
    case "$hpid" in
      ''|*[!0-9]*)
        printf 'claude-session: %s is malformed — clear it:\n  rm -f %s\n' "$lock" "$(printf '%q' "$lock")" >&2
        return 1 ;;
    esac
    # Reclaim only on proof the holder is gone. Age is not proof, and the
    # validate-then-unlink race is why a stale lock is reported, never broken:
    # between the check and the rm another waiter can establish a live claim,
    # and the delete would destroy THAT one.
    if [ "$(start_token "$hpid")" != "$hstart" ]; then
      printf 'claude-session: a process (pid %s) died holding %s — clear it:\n  rm -f %s\n' "$hpid" "$lock" "$(printf '%q' "$lock")" >&2
      return 1
    fi
    tries=$((tries+1))
    if [ "$tries" -gt "${CL_ACK_WAIT_TRIES:-100}" ]; then
      printf 'claude-session: another launch (pid %s) still holds %s — "%s" stays in the restart list\n' "$hpid" "$lock" "$name" >&2
      return 1
    fi
    sleep 0.05
  done

  _ROW_LOCK="$lock"; _ROW_LOCK_MINE="$mine"
  return 0
}
_state_row_unlock() {
  [ "$(readlink "$_ROW_LOCK" 2>/dev/null)" = "$_ROW_LOCK_MINE" ] && rm -f "$_ROW_LOCK" 2>/dev/null
  return 0
}

# ack_state_row <name> <agent> <sid>: remove this session's row from STATE, as
# the ACKNOWLEDGEMENT that a launch really happened.
#
# ── WHY THE CHILD DOES THIS AND NOT `cl start` ───────────────────────────────
#
# On the iTerm/no-tmux path `cl start` does not launch anything: it writes
# `cl "<name>"` into a new tab and that tab launches the agent. So the parent
# cannot know whether a launch succeeded — "AppleScript accepted the text" is
# not "an agent started" — and consuming the row there loses the session
# whenever a tab never runs.
#
# Keeping the row instead is not a fix on its own, which is the defect this
# function closes (found in Codex review, 2026-09-29). `cl start` also keeps the
# row for a session it skips as already live, so "keep it and let a later start
# sort it out" has no exit: skipping is another keep. The row would survive
# forever, turning a one-shot stop snapshot into a permanent desired-state list
# that resurrects sessions the user deliberately closed.
#
# The missing operation is an acknowledgement from the process that actually
# knows. acquire_launch granting ownership is that proof: it is the gate that
# refuses a second agent on one name, and this shell is about to exec the agent
# with the same pid and start time the record names. Rotation already commits
# its handoff claim at exactly this point, so state and handoff are acknowledged
# together, under the same rule.
#
# ── WHY IT LOCKS ─────────────────────────────────────────────────────────────
#
# `cl start` opens every tab at once, so N children reach this concurrently.
# Unserialised read-modify-write on one JSON file silently loses removals: two
# children each read the same array, each drop their own row, and the second
# write restores the first's. Same symlink-claim discipline as acquire_launch —
# atomic `ln -s` carrying the owner's identity, no automatic breaking of a lock
# whose holder is still alive, bounded waiting.
#
# Every failure leaves the row in place. A stale row costs one duplicate tab on
# the next start; deleting the wrong row costs a session.
ack_state_row() {
  local name="$1" agent="${2:-claude}" sid="${3:-}" lock mine tmp
  # Nothing to acknowledge: no snapshot, or no jq to rewrite it with. Neither is
  # an error — a launch outside a stop/start cycle has no row at all.
  [ -f "$STATE" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  # Without a thread id this cannot tell one GENERATION of a name from another,
  # and names are not unique over time. The row it would delete might belong to a
  # session that was never started, so it deletes nothing. (Codex review,
  # 2026-09-29 — see the sid qualification below.)
  case "$sid" in ''|'-') return 0 ;; esac
  _state_row_lock "$name" || return 1
  lock="$_ROW_LOCK"; mine="$_ROW_LOCK_MINE"

  tmp="$STATE.ack.$$"
  # Matched on agent AND name AND sid. Agent qualification alone stops a
  # cross-AGENT deletion but not a cross-GENERATION one, and that is a real race
  # rather than a tidiness point: `cl start` may write `cl "<name>"` into a tab
  # while the saved row names sid-old, a newer same-named thread can win
  # discovery before the tab runs, and the tab would then launch sid-new and
  # delete sid-old's row — a restart row destroyed for a session nobody started.
  # Requiring the sid makes that case a no-op, leaving the old row recoverable.
  if jq --arg n "$name" --arg a "$agent" --arg s "$sid" \
       '[ .[] | select( ((.agent // "claude") == $a and .name == $n and .sid == $s) | not ) ]' \
       "$STATE" > "$tmp" 2>/dev/null; then
    # An empty array is a consumed snapshot, not an empty list to keep: `cl
    # start` treats a missing STATE as "nothing to restore" and a present one as
    # a list to work through.
    if [ "$(jq 'length' "$tmp" 2>/dev/null || echo -1)" = "0" ]; then
      rm -f "$tmp" "$STATE" 2>/dev/null
    else
      mv "$tmp" "$STATE" 2>/dev/null || rm -f "$tmp"
    fi
  else
    rm -f "$tmp" 2>/dev/null
    printf 'claude-session: could not acknowledge "%s" in %s — it stays in the restart list, so a later cl start may open it again\n' "$name" "$STATE" >&2
  fi
  # Unlink only a lock that still names THIS owner. An unconditional rm would
  # delete a successor's lock if ours had been cleared or replaced meanwhile,
  # letting two acknowledgements into the critical section at once — the same
  # rule models_unlock follows.
  [ "$(readlink "$lock" 2>/dev/null)" = "$mine" ] && rm -f "$lock" 2>/dev/null
  return 0
}

# claude_registry_pid <sid>: the live pid Claude Code itself recorded as
# running this session, or nothing.
#
# Claude Code writes ~/.claude/sessions/<pid>.json for every running session,
# carrying `sessionId` and `procStart` — the process's own start time, which
# equals `ps -o lstart` in UTC exactly (verified 2026-10-21 against every live
# session). Requiring that match is what makes a hit PROOF: a file left behind
# by a dead session whose pid has since been reused by something else names a
# different start time and is rejected. Absence of the directory or of jq
# returns nothing, and session_pid falls back.
#
# This is an internal Claude Code file, not a documented interface — which is
# exactly why it is first in a chain rather than the only source, and why any
# shape it does not recognise yields nothing rather than a guess.
# sid_shape_ok <sid>: the one definition of a session id cl will look up. Shared
# by the lookup and by the placement test in unbound_owner_pid, so an id the
# lookup would refuse can never count as having placed a process.
sid_shape_ok() {
  case "$1" in ''|*[!0-9A-Za-z-]*) return 1 ;; esac
  return 0
}

claude_registry_pid() {
  local sid="$1" dir="${CL_CLAUDE_SESSIONS_DIR:-$HOME/.claude/sessions}" f pid want now
  [ -d "$dir" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  sid_shape_ok "$sid" || return 0
  for f in "$dir"/*.json; do
    [ -f "$f" ] || continue
    grep -qF "\"$sid\"" "$f" 2>/dev/null || continue
    pid=$(jq -r --arg s "$sid" 'select(.sessionId == $s) | .pid // empty' "$f" 2>/dev/null)
    case "$pid" in ''|*[!0-9]*) continue ;; esac
    want=$(jq -r '.procStart // empty' "$f" 2>/dev/null | tr -s ' ' | sed 's/^ //; s/ $//')
    [ -n "$want" ] || continue
    now=$(TZ=UTC ps -p "$pid" -o lstart= 2>/dev/null | tr -s ' ' | sed 's/^ //; s/ $//')
    [ -n "$now" ] && [ "$now" = "$want" ] && { printf '%s\n' "$pid"; return 0; }
  done
  return 0
}

# argv_resume_pid <sid>: a pid whose ARGUMENTS resume this session, excluding
# forks. The last-resort source — see session_pid.
argv_resume_pid() {
  local sid="$1" p
  for p in $(pgrep -f "(-resume|-session-id) $sid" 2>/dev/null); do
    # A fork's argv names the session it forked FROM, not the one it is.
    case "$(ps -p "$p" -o command= 2>/dev/null)" in
      *--fork-session*) continue ;;
    esac
    printf '%s\n' "$p"; return 0
  done
  return 0
}

# unbound_owner_pid <name>: a live claude process cl launched under this name
# that cannot be tied to any session id — or nothing.
#
# `cl new` writes its launch record before Claude has chosen an id, so the
# record is unbound ("-"), and session_pid rightly refuses it as proof of a
# given id. Without Claude's registry entry (an older Claude Code, or one not
# written yet) nothing else knows which id that process runs. It must then be
# reported as unresolved, not taken for "nothing live": treated as absent, stop
# skipped it, left it running, and still reported the fleet stopped. A process
# the registry DOES place is excluded — it is provably some other session.
unbound_owner_pid() {
  local f rsid pid dir="${CL_CLAUDE_SESSIONS_DIR:-$HOME/.claude/sessions}" want now rid
  f=$(reg_file "$1" claude)
  [ -r "$f" ] || return 0
  rsid=$(cut -f5 "$f" 2>/dev/null)
  case "$rsid" in ''|-) ;; *) return 0 ;; esac
  pid=$(registered_pid "$1" claude)
  [ -n "$pid" ] || return 0
  # Placed means a fresh entry that ALSO names a session claude_registry_pid
  # could look up: a file with only a start time, or an id of a shape the lookup
  # refuses (a reshaped registry, or one caught mid-write), places nothing. Both
  # fields come from one read so they cannot straddle a rewrite.
  if [ -f "$dir/$pid.json" ] && command -v jq >/dev/null 2>&1; then
    IFS=$(printf '\t') read -r rid want <<EOF_REG
$(jq -r 'if (.sessionId | type) == "string" then [.sessionId, (.procStart // "")] | @tsv else empty end' "$dir/$pid.json" 2>/dev/null)
EOF_REG
    want=$(printf '%s' "$want" | tr -s ' ' | sed 's/^ //; s/ $//')
    now=$(TZ=UTC ps -p "$pid" -o lstart= 2>/dev/null | tr -s ' ' | sed 's/^ //; s/ $//')
    sid_shape_ok "$rid" && [ -n "$want" ] && [ "$want" = "$now" ] && return 0
  fi
  printf '%s\n' "$pid"
}

session_pid() { # sid [agent] [name]
  local pid
  case "${2:-claude}" in
    codex) pgrep -f "codex.* resume $1( |\$)" 2>/dev/null | head -1 ;;
    *)
      pid=""
      [ -z "${3:-}" ] || pid=$(registered_pid "$3" claude "$1")
      [ -n "$pid" ] || pid=$(claude_registry_pid "$1")
      [ -n "$pid" ] || pid=$(argv_resume_pid "$1")
      printf '%s\n' "$pid"
      ;;
  esac
}

# Server-global tmux setup applied idempotently before each launch (exec
# replaces this process, so it can't run after): terminal titles track the
# session name, and Ctrl-Z is swallowed unless the pane runs a shell. Claude
# Code can't disable its Ctrl-Z suspend, and a suspended claude in a cl pane
# has no parent shell to `fg` from (recovery requires kill -CONT). Shells still
# get Ctrl-Z so job control works in normal panes. Applied here rather than
# ~/.tmux.conf so cl is self-contained on any machine.
# agent_hint <agent>: the substring a process running this agent must contain.
# Deliberately loose — it matches `claude` and `codex` however they were
# wrapped. It is a check that the pid is still the KIND of
# thing we launched, never a way to find a process.
agent_hint() { case "$1" in codex) printf 'codex' ;; *) printf 'claude' ;; esac; }

# surviving_children <hint> <pid-list>: those still alive and still this agent.
#
# Signalling the process cl launched does not prove the client is gone. The npm
# launcher is a node wrapper plus a native child; if the wrapper does not
# replace itself, SIGTERM removes the wrapper and the child keeps the
# transcript open. Reporting "killed" then hands back an untracked client.
# Children are captured BEFORE the kill — afterwards they are reparented and
# `pgrep -P` can no longer find them.
surviving_children() {
  local hint="$1" k out=""
  shift
  for k in "$@"; do
    kill -0 "$k" 2>/dev/null || continue
    case "$(ps -o command= -p "$k" 2>/dev/null)" in
      *"$hint"*) out="$out $k" ;;
    esac
  done
  printf '%s' "${out# }"
}

# tmux_start_and_attach <t> <cwd> <cmd> <agent> [sid]: create, stamp, attach.
#
# Split from the old single `new-session -A` so the ownership stamp is written
# by the same code path that creates the session — every creation site goes
# through here, so none can quietly skip it.
tmux_start_and_attach() { # t cwd cmd agent [sid] [display-name]
  local t="$1" cwd="$2" cmd="$3" agent="$4" sid="${5:--}"
  # `-A` is gone, and its absence is the point. It folded two outcomes into one
  # command: CREATE, or silently ATTACH whatever already sits at that name. The
  # helper then stamped the result as cl-owned either way — which manufactured
  # the very proof the stamp exists to provide, and a later `cl stop` would
  # accept it and kill an unrelated workload. A name collision is not ownership.
  #
  # So: an existing session is attached, never stamped, and never treated as
  # something this invocation made.
  if tmux has-session -t "=${t}" 2>/dev/null; then
    if tmux_owned "$t" "$agent" "$sid"; then
      exec tmux attach-session -t "=${t}"
    fi
    printf 'attaching the existing tmux session "%s" — cl did not create it, so it is not stamped as cl-owned%s\n' \
      "$t" "$( [ -n "${CL_PENDING_MODEL:-}" ] && printf ' and --model was not stored' )" >&2
    exec tmux attach-session -t "=${t}"
  fi
  if ! tmux new-session -d -s "$t" -c "$cwd" "$cmd"; then
    # Say what happened, and stop. Falling through to `attach-session` after a
    # failed create made tmux report "can't find session" — which describes the
    # consequence of the previous line rather than the problem, and looked like a
    # missing session rather than a refused creation. Nothing is stamped and
    # nothing is committed on this path either way.
    printf 'claude-session: tmux could not create "%s" — nothing was started%s\n' "$t" \
      "$( [ -n "${CL_PENDING_MODEL:-}" ] && printf ', and --model was not stored' )" >&2
    return 1
  fi
  tmux_claim "$t" "$agent" "$sid"
  commit_pending_model "$agent" "${6:-}"
  # `new-session -d` succeeding IS the proof this arm exists to establish, so a
  # restart row outstanding for this session is acknowledged here too.
  #
  # This matters for a mode transition, not just for tidiness: `cl start` may run
  # without tmux — delegating each launch to a tab and RETAINING the row, because
  # it cannot see acceptance — while the new interactive tab sources a shell
  # config that sets CL_TMUX=1 and so takes this path instead. The child then has
  # the proof the parent lacked, and without this call the row would never be
  # cleared, which is the permanent-desired-state bug all over again for that
  # combination. (Codex review, 2026-09-29.)
  #
  # An ordinary launch has no matching row and the pre-created `cl start` path
  # has already consumed its own, so this is a no-op in both.
  [ -n "${6:-}" ] && [ "${_CL_SKIP_ACK:-}" != "1" ] && ack_state_row "${6}" "$agent" "$sid"
  exec tmux attach-session -t "=${t}"
}

# tmux_claim <tmux-session> <agent> <sid>: stamp a session cl just created.
#
# A tmux session NAME is not proof cl created it: the name is derived from the
# display name, the derivation collides ("A B" and "A.B" map to one identity),
# and anything may already be sitting at it. A user option is proof — nothing
# but this function writes it.
#
# The target is "=name:", not "=name": set-option and show-option take a pane
# target, and tmux 3.x resolves a bare "=name" there as no session at all, so
# the stamp was never written or read and every cl session looked unowned.
tmux_claim() {
  tmux set-option -t "=$1:" "@cl_agent" "$2" >/dev/null 2>&1 || return 0
  tmux set-option -t "=$1:" "@cl_sid" "${3:--}" >/dev/null 2>&1 || return 0
  return 0
}

# tmux_owned <tmux-session> <agent> [sid]: did cl create this one, for this
# thread? Used on the KILL path only, where a wrong answer ends someone's work.
tmux_owned() {
  local a s2
  a=$(tmux show-option -qv -t "=$1:" "@cl_agent" 2>/dev/null)
  s2=$(tmux show-option -qv -t "=$1:" "@cl_sid" 2>/dev/null)
  [ "$a" = "$2" ] || return 1
  [ -n "${3:-}" ] || return 0
  [ -n "$s2" ] && [ "$s2" != "-" ] && [ "$s2" = "$3" ]
}

# agent_live <agent> <sid> <name>: is something already working this session?
#
# Used by `cl start` only, where the bias is deliberately the opposite of the
# kill path's: ANY sign of life means skip, because a false positive costs a
# session that has to be reopened by hand, while a false negative starts a
# SECOND client on one transcript. So this accepts signals that are not
# kill-safe — an argv match for codex among them — precisely because nothing
# here signals anything.
agent_live() {
  local agent="$1" sid="$2" name="$3"
  if command -v tmux >/dev/null 2>&1 && tmux has-session -t "=$(tmux_name "$name" "$agent")" 2>/dev/null; then
    return 0
  fi
  [ -n "$(session_pid "$sid" "$agent" "$name")" ] && return 0
  # Not proof of THIS session, but start's bias is to skip on any sign of life.
  [ "$agent" = "claude" ] && [ -n "$(unbound_owner_pid "$name")" ] && return 0
  # Qualified by sid like every other registry question: a live process for an
  # OLDER same-named thread must not suppress the restart of the saved one.
  [ "$agent" = "codex" ] && [ -n "$(registered_pid "$name" codex "$sid")" ] && return 0
  return 1
}

tmux_setup() {
  command -v tmux >/dev/null 2>&1 || return 0
  tmux start-server 2>/dev/null
  tmux set -g set-titles on 2>/dev/null
  tmux set -g set-titles-string "#S" 2>/dev/null
  tmux bind-key -n C-z if-shell -F '#{m:*sh,#{pane_current_command}}' 'send-keys C-z' '' 2>/dev/null
  # Terminal features the agent needs and tmux withholds by default: OSC
  # passthrough (notifications, progress) and extended keys (Shift+Enter).
  # These do NOT make the iTerm integration work under tmux — job-name
  # detection still sees `tmux` — they just make the opt-in path less degraded.
  tmux set -g allow-passthrough on 2>/dev/null
  tmux set -s extended-keys on 2>/dev/null
  tmux set -as terminal-features 'xterm*:extkeys' 2>/dev/null
  # The server outlives the cmux context that may have started it and keeps
  # CMUX_* in its GLOBAL environment, so every later pane would inherit them.
  # Unconditional now: no launch is a cmux launch. See drop_cmux_env.
  local _v
  for _v in $(tmux show-environment -g 2>/dev/null | sed -n 's/^\(CMUX_[A-Za-z0-9_]*\)=.*/\1/p'); do
    tmux set-environment -gu "$_v" 2>/dev/null
  done
}

# iterm_running: true when iTerm2 is actually running. Env vars are unreliable
# (TERM_PROGRAM is clobbered to "tmux" inside a client), so ask the OS instead.
iterm_running() {
  command -v osascript >/dev/null 2>&1 || return 1
  osascript -e 'tell application "System Events" to (name of processes) contains "iTerm2"' \
    2>/dev/null | grep -q true
}

# tag_iterm_session <tmux_name>: mark the CURRENT iTerm session with a user
# variable (user.clSession) via the OSC 1337 SetUserVar escape, so `cl stop` can
# later find and close this exact tab. Emitted before tmux takes over the tty.
# Harmless in non-iTerm terminals — they ignore the unknown escape sequence.
tag_iterm_session() {
  local b64; b64=$(printf '%s' "$1" | base64 | tr -d '\n')
  printf '\033]1337;SetUserVar=clSession=%s\007' "$b64"
}

# close_iterm_tab <tmux_name>: close the iTerm tab tagged with
# user.clSession == <tmux_name>. Skips the session running this command so
# `cl stop` never yanks closed its own terminal. Best-effort; no-op if the tab
# isn't found or iTerm can't be scripted. Collects matches first, then closes,
# to avoid mutating the tab collection mid-iteration.
close_iterm_tab() {
  local esc="$1"
  esc="${esc//\\/\\\\}"; esc="${esc//\"/\\\"}"
  osascript >/dev/null 2>&1 <<OSA
tell application "iTerm"
  set curId to -1
  try
    set curId to id of current session of current tab of current window
  end try
  set toClose to {}
  repeat with w in windows
    repeat with tb in tabs of w
      repeat with s in sessions of tb
        try
          set varVal to ""
          tell s to set varVal to (variable named "user.clSession")
          if varVal is "${esc}" and (id of s) is not curId then set end of toClose to s
        end try
      end repeat
    end repeat
  end repeat
  repeat with s in toClose
    try
      close s
    end try
  end repeat
end tell
OSA
}

launch_session() { # name sid cwd [agent] [first-prompt]
  local name="$1" sid="$2" cwd="$3" agent="${4:-claude}" t pid cmd
  t=$(tmux_name "$name" "$agent"); [ -d "$cwd" ] || cwd="$HOME"
  cmd=$(resume_cmd "$agent" "$sid" "$name" "${5:-}")
  # Covers the non-tmux exec path; the tmux path prefixes the command instead,
  # because the tmux server's own environment is whatever it was started with.
  export CL_SESSION_NAME="$name" CL_SESSION_ID="$sid"
  # `tmux new-session -A` attaches instead of duplicating; nothing does that
  # for us otherwise, so a second launch has to be refused here — the bare path
  # below uses the atomic claim, because there two tabs really can race.
  #
  # The iTerm tab is tagged in BOTH branches: `cl stop` closes tabs by that
  # user variable, and that has nothing to do with tmux.
  in_iterm && tag_iterm_session "$t"
  if use_tmux; then
    tmux_setup
    tmux_start_and_attach "$t" "$cwd" "$(env_prefix "$name" "$sid")$cmd" "$agent" "$sid" "$name" || exit 1
  else
    pid=$(acquire_launch "$name" "$agent" "$sid"); local arc=$?
    if [ "$arc" -eq 1 ]; then
      echo "\"$name\" already has a local process resuming it (pid $pid) — switch to its tab instead of resuming it twice." >&2
      exit 1
    elif [ "$arc" -ne 0 ]; then
      exit 1   # acquire_launch already said exactly what went wrong
    fi
    # Ownership granted, so this launch is real: acknowledge the restart row
    # before exec, which is the last moment any code here runs. The sid is the
    # one actually being resumed, so a row for a different generation of this
    # name is left alone.
    [ "${_CL_SKIP_ACK:-}" = "1" ] || ack_state_row "$name" "$agent" "$sid"
    drop_cmux_env; cd "$cwd" || exit 1; eval "exec $cmd"
  fi
}

launch_new() { # cwd [agent]
  local cwd="$1" agent="${2:-claude}" t cmd; [ -d "$cwd" ] || cwd="$PWD"
  case "$agent" in
    codex) cmd="$(codex_cmd) $(codex_args)" ;;
    *)     cmd="$(claude_cmd) --dangerously-skip-permissions" ;;
  esac
  t="$agent-$(basename "$cwd")"
  if use_tmux; then
    tmux_setup
    tmux_start_and_attach "$t" "$cwd" "$cmd" "$agent" "-" "" || exit 1
  else
    drop_cmux_env; cd "$cwd" || exit 1; eval "exec $cmd"
  fi
}

# launch_named <name> <cwd> [agent]: create + attach a fully-named session.
# The interactive create path shared by `cl new` and the picker's "new" entry.
#   claude: `claude --name` sets the title at launch, so discovery finds it
#           immediately.
#   codex:  there is NO launch-time name flag. The name labels the tmux
#           session only; the thread is unnamed (and invisible to
#           `cl --list`) until the user runs /rename inside codex. Said so
#           on screen rather than pretended.
# agent_cmd_word <agent>: the first word of the command that launches it —
# claude_cmd/codex_cmd can be wrappers with arguments, and only the first word is
# something to resolve.
agent_cmd_word() {
  local c
  case "$1" in codex) c=$(codex_cmd) ;; *) c=$(claude_cmd) ;; esac
  printf '%s' "${c%% *}"
}

# _agent_executable <agent>: is the configured agent launchable at all? The exec
# paths commit a model preference immediately before replacing themselves with
# the agent, so this is the last thing they can check on its behalf.
_agent_executable() {
  local w; w=$(agent_cmd_word "$1")
  [ -n "$w" ] || return 1
  command -v "$w" >/dev/null 2>&1
}

launch_named() { # name cwd [agent]
  local name="$1" cwd="$2" agent="${3:-claude}" t qname cmd mf
  [ -d "$cwd" ] || cwd="$HOME"
  export CL_SESSION_NAME="$name"
  qname=$(printf '%q' "$name")
  # CL_PENDING_MODEL is a model chosen on THIS command line that is not stored
  # yet. It is used for the launch either way; it is committed only where the
  # backend has accepted, below.
  if [ -n "${CL_PENDING_MODEL:-}" ]; then mf=$(model_flag "$agent" "$CL_PENDING_MODEL")
  else                                    mf=$(model_flag "$agent" "$(model_for "$name" "$agent")"); fi

  case "$agent" in
    codex)
      cmd="$(codex_cmd) $(codex_args)$mf"
      printf 'note: codex cannot be named at launch — run /rename %s inside codex so cl can find it.\n' "$qname" >&2
      ;;
    *) cmd="$(claude_cmd) --name $qname --dangerously-skip-permissions$mf" ;;
  esac
  # The exec paths below can never observe the agent running — they become it.
  # What they CAN establish is that every launcher-side refusal has passed and the
  # agent is actually executable, so that is what they check before committing,
  # and it is what the contract claims. An agent that fails after exec still
  # leaves a stored preference; closing that would need the agent to report back.
  if ! _agent_executable "$agent"; then
    printf 'claude-session: cannot run %s — nothing was started%s\n' "$(agent_cmd_word "$agent")" \
      "$( [ -n "${CL_PENDING_MODEL:-}" ] && printf ', and --model was not stored' )" >&2
    exit 1
  fi
  t=$(tmux_name "$name" "$agent")
  in_iterm && tag_iterm_session "$t"
  if use_tmux; then
    tmux_setup
    tmux_start_and_attach "$t" "$cwd" "$(env_prefix "$name")$cmd" "$agent" "-" "$name" || exit 1
  else
    local owner arc
    owner=$(acquire_launch "$name" "$agent"); arc=$?
    if [ "$arc" -eq 1 ]; then
      echo "\"$name\" is already running (pid $owner) — switch to its tab instead of starting it twice." >&2
      exit 1
    elif [ "$arc" -ne 0 ]; then
      exit 1
    fi
    cd "$cwd" || exit 1
    commit_pending_model "$agent" "$name"
    drop_cmux_env; eval "exec $cmd"
  fi
}

# launch_fresh <name> <cwd> <initial_prompt>: like launch_named, but for
# `cl start --fresh` — a NEW claude process registers under the SAME name (so
# cross-session SendMessage and `cl <name>` keep working), in the same dir,
# through the same wrapper/teams selection (claude_cmd), with one difference:
# its first message is the initial prompt, passed as claude's trailing
# positional argument (claude sends it immediately on launch, then stays
# interactive) — that's what makes this "read your handoff and continue"
# instead of a blank session. Codex is out of scope: fresh-start is defined
# in terms of the handoff file, and only Claude sessions write one (see
# request_handoff).
# Optional 4th/5th args: a store root and a CLAIMED handoff, rolled back if the
# launch is refused.
#
# HOW STRONG THIS EVIDENCE IS, honestly: on the exec paths the last thing this
# process does is replace itself with the agent, so it can never observe the
# agent running. The boundary it can defend is "launch ownership granted, the
# working directory and the agent binary check out, and exec was reached" —
# which is why those are preflighted below rather than assumed. A cwd that has
# gone, or an agent binary that is missing or not executable, used to spend the
# handoff on a launch that could not happen; those now roll back. An exec that
# fails after all of that still spends it, and no amount of checking here can
# close that without the replacement acknowledging back.
launch_fresh() {
  # old_sid (arg 6) is the RETIRING session's thread id — the one whose restart
  # row this launch replaces. A rotation starts a new transcript, so there is no
  # new sid to acknowledge with; the row being consumed is the old session's, and
  # naming it explicitly is what keeps a rotation from deleting the row of a
  # different generation of the same name.
  local name="$1" cwd="$2" prompt="$3" root="${4:-}" claim="${5:-}" old_sid="${6:-}" t cmd
  # A ROTATION must not silently relocate. Substituting $HOME for a missing cwd
  # and then "preflighting" the substitute is how the docs came to promise that a
  # vanished directory rolls back while the code started the replacement in $HOME
  # — pointing it at the wrong repository with a handoff about a different one.
  # A plain launch may still fall back; a rotation refuses.
  if [ ! -d "$cwd" ]; then
    if [ -n "$claim" ]; then
      rollback_claim "$root" "$name" "$claim"
      echo "claude-session: \"$name\" was rotating in $cwd, which no longer exists — not starting fresh somewhere else" >&2
      exit 1
    fi
    cwd="$HOME"
  fi
  cmd=$(fresh_cmd "$name" "$prompt")
  export CL_SESSION_NAME="$name"
  # Preflight what is knowable BEFORE the handoff is treated as spent.
  if ! _agent_runnable; then
    [ -n "$claim" ] && rollback_claim "$root" "$name" "$claim"
    echo "claude-session: cannot run the agent ($(claude_cmd)) — not starting fresh" >&2
    exit 1
  fi
  if ! cd "$cwd" 2>/dev/null; then
    [ -n "$claim" ] && rollback_claim "$root" "$name" "$claim"
    echo "claude-session: cannot enter $cwd — not starting fresh" >&2
    exit 1
  fi
  t=$(tmux_name "$name" claude)
  in_iterm && tag_iterm_session "$t"
  if use_tmux; then
    tmux_setup
    # CREATE, then attach — not `new-session -A`, which attaches to an existing
    # session of the same name and returns success WITHOUT running the fresh-agent
    # command. Committing before that answered meant a race-window collision, or
    # an outright failure, spent the handoff on a replacement that never started.
    # `new-session -d` fails if the name is taken, so its status distinguishes
    # "created" from "was already there".
    if ! tmux new-session -d -s "$t" -c "$cwd" "$(env_prefix "$name")$cmd" 2>/dev/null; then
      [ -n "$claim" ] && rollback_claim "$root" "$name" "$claim"
      echo "claude-session: a tmux session named \"$t\" already exists — not starting fresh over it" >&2
      exit 1
    fi
    [ -n "$claim" ] && commit_claim "$root" "$name" "$claim" "rotating now"
    exec tmux attach-session -t "=${t}"
  else
    # acquire_launch is the real gate on this path — it is what refuses a
    # second agent on one name. Commit only AFTER it grants ownership, and put
    # the handoff back if it refuses, so a rejected launch spends nothing.
    local owner arc
    owner=$(acquire_launch "$name" claude); arc=$?
    if [ "$arc" -eq 1 ]; then
      [ -n "$claim" ] && rollback_claim "$root" "$name" "$claim"
      echo "\"$name\" is already running (pid $owner) — switch to its tab instead of starting it twice." >&2
      exit 1
    elif [ "$arc" -ne 0 ]; then
      [ -n "$claim" ] && rollback_claim "$root" "$name" "$claim"
      exit 1
    fi
    [ -n "$claim" ] && commit_claim "$root" "$name" "$claim" "rotating now"
    # Same instant as the claim commit: the handoff and the restart row are two
    # records of one launch, so they are acknowledged on the same proof.
    ack_state_row "$name" claude "$old_sid"
    drop_cmux_env; eval "exec $cmd"
  fi
}

# do_new: create a NEW, fully-named session in one step — no /rename → exit →
# re-pick dance. `claude --name` sets the session's customTitle AT LAUNCH, so
# discover(), the picker, and `cl start` all find it immediately.
#   cl new "Session Name"        → launch in $PWD (default: where you are)
#   cl new "Session Name" -d      → launch in $CL_DEFAULT_DIR (your main repo)
#   cl new "Session Name" <dir>   → launch in that explicit dir
# Interactive → create + attach. No TTY (script / a Claude Bash call) → create
# detached and print how to attach, so the caller isn't left hanging.
do_new() {
  local agent="claude" model=""
  # Flags may lead in any order; --model is remembered for the NAME, so it also
  # applies to every later resume of the session, not just this launch.
  while :; do
    case "${1:-}" in
      --codex)  agent="codex";  shift ;;
      --claude) agent="claude"; shift ;;
      # No `|| true` on a parser state transition: with a trailing `--model`
      # there is nothing to shift, bash leaves the arguments untouched, and the
      # loop sees the same flag forever. Check first, fail with usage.
      --model)
        [ "$#" -ge 2 ] || { echo 'usage: cl new [--codex] [--model <model-id>] "Session Name" [dir | -d]' >&2; exit 1; }
        model="$2"; shift 2 ;;
      --model=*) model="${1#--model=}"; shift ;;
      *) break ;;
    esac
  done
  local name="${1:-}" arg="${2:-}" cwd
  [ -n "$name" ] || { echo 'usage: cl new [--codex] [--model <model-id>] "Session Name" [dir | -d]' >&2; exit 1; }
  # The model is validated here but NOT stored yet: everything below can still
  # refuse to create the session (no such directory, no CL_DEFAULT_DIR, no TTY
  # and no tmux). Persisting first left a preference behind for a session that
  # was never created — a half-done transaction presented as one step.
  if [ -n "$model" ]; then
    valid_model "$model" || { echo "claude-session: refusing model \"$model\" — allowed: letters, digits, . _ - : / [ ]" >&2; exit 1; }
  fi
  case "$arg" in
    -d|--default)
      cwd="${CL_DEFAULT_DIR:-}"
      [ -n "$cwd" ] || { echo "claude-session: -d given but CL_DEFAULT_DIR is not set (export it in your shell rc)" >&2; exit 1; }
      ;;
    "")  cwd="$PWD" ;;
    *)   cwd="$arg" ;;
  esac
  [ -d "$cwd" ] || { echo "claude-session: no such directory: $cwd" >&2; exit 1; }

  local t qname cmd mf
  t=$(tmux_name "$name" "$agent")
  qname=$(printf '%q' "$name")   # safe to embed in the tmux command string
  # A model given on this command line applies to THIS launch even though it is
  # not stored yet — storing happens only where a launch is actually attempted.
  if [ -n "$model" ]; then mf=$(model_flag "$agent" "$model")
  else                     mf=$(model_flag "$agent" "$(model_for "$name" "$agent")"); fi
  # remember_model: called at each point where creation is committed, so a run
  # that refuses to create anything leaves no preference behind.
  remember_model() { [ -n "$model" ] && set_model "$agent" "$name" "$model" >/dev/null; return 0; }
  # The interactive paths do not call this: they hand off to launch_named,
  # which can still refuse (an existing owner, a claim it cannot take) and which
  # attaches rather than creates when a tmux session is already there. It
  # persists for itself, after the last refusal and immediately before exec.
  export CL_PENDING_MODEL="$model"
  case "$agent" in
    codex) cmd="$(codex_cmd) $(codex_args)$mf"
           echo "note: codex cannot be named at launch — run /rename $qname inside codex so cl can find it." >&2 ;;
    *)     cmd="$(claude_cmd) --name $qname --dangerously-skip-permissions$mf" ;;
  esac

  if [ -t 1 ] && [ -t 0 ]; then
    # interactive: create + attach, like the picker
    launch_named "$name" "$cwd" "$agent"
  elif ! use_tmux; then
    # No TTY and nothing to detach into. Say so rather than exec a TTY-less
    # agent that will exit immediately and look like a silent failure.
    echo "claude-session: no TTY and not using tmux — cannot create '$name' detached." >&2
    echo "  run cl new from a terminal, or set CL_TMUX=1 to create it in tmux." >&2
    exit 1
  else
    # no TTY (script / Claude Bash call): create detached so the caller isn't
    # blocked on an attach — attach later with `cl "<name>"`.
    tmux_setup
    if tmux has-session -t "=${t}" 2>/dev/null; then
      echo "session '$name' already exists — attach with: cl \"$name\""
    else
      tmux new-session -d -s "$t" -c "$cwd" "$cmd" \
        && { remember_model; echo "created '$name' in $cwd — attach with: cl \"$name\""; }
    fi
  fi
}

# --- start/stop support -----------------------------------------------------
# These mirror the picker's style ([ ] tests, exec-to-tmux) on purpose so the
# script reads as one piece. session_busy uses the `caffeinate` wake-lock that
# `claude` spawns while working: claude's TUI uses the alternate screen buffer,
# so `tmux capture-pane` returns nothing and process state is the only reliable
# external signal. The signal is conservative — caffeinate's timeout lingers a
# few minutes after work ends — so stop errs toward asking, never silent-killing.

# claude_busy <pid>: 0 (true) if that claude process looks mid-task — a
# caffeinate child, or CPU over ~15%. Works on any claude pid (tmux pane or
# bare tab); the terminal doesn't matter, only the process tree does.
claude_busy() {
  local pid="$1" kid cmd cpu
  [ -n "$pid" ] || return 1
  for kid in $(pgrep -P "$pid" 2>/dev/null); do
    cmd=$(ps -o command= -p "$kid" 2>/dev/null)
    case "$cmd" in *caffeinate*) return 0 ;; esac
  done
  cpu=$(ps -o %cpu= -p "$pid" 2>/dev/null | tr -d ' ')
  # Integer compare on the whole-number part; >=15% CPU counts as working.
  [ "${cpu%%.*}" -ge 15 ] 2>/dev/null && return 0
  return 1
}

# session_busy <tmux_session_name>: tmux flavor of claude_busy — the pane's
# root process IS the claude (tmux runs it as the pane command).
session_busy() {
  local ppid
  ppid=$(tmux list-panes -t "=${1}" -F '#{pane_pid}' 2>/dev/null | head -1)
  claude_busy "$ppid"
}

# handoff_target_busy <tmux_name> <sid> <name>: is the session we are about to
# re-ask still mid-task? Terminal-agnostic, because the question is about the
# process, not the terminal: the pane's root process for a tmux session, else
# the pid cl recorded for this session.
#
# WHY request_handoff NEEDS THIS. A busy claude QUEUES typed input and runs it
# when it finishes — proven 2026-10-07 by injecting into a working session,
# which showed "Press up to edit queued messages" and executed nothing until
# the current task ended. cl saw no handoff file after 90s, concluded the ask
# had been lost, and typed it AGAIN. Three attempts left three copies stacked
# in one input box, and burned 246 of a 300s whole-stop budget on one session
# while 19 others were killed with no handoff at all.
#
# A retry is for an ask that did not land. It cannot help an agent that is
# simply still working, and it actively harms it.
handoff_target_busy() {
  local t="$1" sid="$2" name="$3" pid
  if [ -n "$t" ] && tmux has-session -t "=${t}" 2>/dev/null; then
    session_busy "$t"
    return $?
  fi
  pid=$(session_pid "$sid" claude "$name" 2>/dev/null)
  [ -n "$pid" ] || return 1
  claude_busy "$pid"
}

# retire_session <name> <sid> <tmux_name> <close_tabs> [agent]: kill the live
# session identified by these — tmux-hosted or bare — the ONE
# way, for every caller and BOTH agents. `do_stop`, `do_fresh_start` and the
# Codex stop path need this exact logic; it used to be duplicated, and the
# duplicate in `do_fresh_start` had silently dropped the hidden-tmux ownership
# guard below (reintroducing the cross-socket kill hazard `do_stop` was
# specifically hardened against on 2026-07-31) and the iTerm-tab cleanup on a
# successfully retired bare process. Found in Codex review, 2026-09-23 —
# extracted to one return-code-bearing implementation instead of maintaining a
# second safety-sensitive copy.
#
# The agent argument is what makes the Codex rules enforceable HERE rather than
# in each caller: for Codex neither a matching tmux name nor an argv match is a
# sound handle (app-server daemon, Desktop app, --remote clients, and an npm
# launcher whose wrapper and native child both match), so on that path only
# cl's own ownership stamp and launch registry are accepted. Anything else is
# reported and left alone.
#
# Returns:
#   0  retired — confirmed gone, or nothing was live to begin with
#   1  left running — the operator declined a "kill/retire anyway?" prompt
#   2  signalled but still shutting down, the kill itself failed, or a tmux
#      server cl cannot see owns it — ownership must NOT be treated as free
#      (a caller must not launch a replacement under this name)
#   3  left running — cl owns a live process under this name but cannot prove
#      which session it runs (see unbound_owner_pid); never killed as this one
#   4  not cl's to stop — a Codex thread run somewhere cl did not launch (an
#      unstamped tmux session, the Desktop app, a --remote client). Reported
#      and left alone; it is not a failure of THIS stop, which is why it has
#      its own code (counting it would fail every stop while the app is open)
#
# A sixth argument, 1, skips the "looks mid-task, kill it anyway?" prompt. Only
# the compact-resume stop passes it, and only once the transcript PROVES the
# session is idle since its compaction (see compact_idle): the busy signal
# lingers for minutes after a turn, so after a compaction it would ask about
# every session, while the transcript can say it is done.
retire_session() {
  local name="$1" sid="$2" t="$3" close_tabs="$4" agent="${5:-claude}" idle_proven="${6:-0}"
  local ans pid ptok rrc _ppid _pcomm hint kids surv
  hint=$(agent_hint "$agent")
  if tmux has-session -t "=${t}" 2>/dev/null; then
    # A matching tmux NAME is not authority to kill a Codex thread — only cl's
    # own ownership stamp is. Without it the session belongs to someone else,
    # or to a collision in the name derivation, and killing it would break the
    # exact promise this path advertises.
    if [ "$agent" = "codex" ] && ! tmux_owned "$t" codex "$sid"; then
      printf '⚠ leaving %s — a tmux session sits at %s but carries no cl ownership stamp for this thread; not cl'"'"'s to kill.\n' "$name" "$t" >&2
      # The foreign container is not cl's, but that does not prove nothing of
      # cl's is running for this thread: an exact launch record can name a bare
      # Codex process cl DID launch, colliding on the derived tmux name. Then
      # this is a stop that left cl's own process running, not a foreign one.
      if [ -n "$(registered_pid "$name" codex "$sid")" ]; then
        printf '⚠ …and cl'"'"'s own Codex process for %s is still running beside it — left for a retry; close the foreign tmux session first\n' "$name" >&2
        return 2
      fi
      return 4
    fi
    if [ "$idle_proven" != "1" ] && session_busy "$t"; then
      printf '⏳ "%s" looks mid-task. Kill it anyway? [y/N] ' "$name" >&2
      read -r ans </dev/tty
      case "$ans" in
        y|Y) : ;;
        *) printf '   left %s running — re-run later to retire it\n' "$name" >&2; return 1 ;;
      esac
    fi
    if tmux kill-session -t "=${t}" 2>/dev/null; then
      printf '✓ killed %s\n' "$name" >&2
      [ "$close_tabs" = "1" ] && close_iterm_tab "$t"
      return 0
    fi
    printf '⚠ tmux kill-session failed for "%s" — leaving it registered\n' "$name" >&2
    return 2
  fi

  # No tmux session — a bare agent: kill the process itself, the SAME way
  # do_stop always has (SIGTERM).
  #
  # The handle differs by agent, and for Codex it is deliberately narrower:
  # only a process THIS tool launched and still recognises. Everything else —
  # a thread opened in the Desktop app, served by the app-server daemon, or
  # attached over --remote — is reported and left alone rather than guessed
  # at, because an argv match there can name an unrelated process.
  if [ "$agent" = "codex" ]; then
    pid=$(registered_pid "$name" codex "$sid")
    if [ -z "$pid" ]; then
      # discover() lists every STORED Codex thread, not the running ones. A
      # warning per row would mean dozens of alarms about history that has no
      # process and no tab to close. Say something only when there is at least
      # weak evidence of a live client — an argv match is enough to justify a
      # warning, though never a kill.
      if [ -n "$(session_pid "$sid" codex "$name")" ]; then
        printf '⚠ leaving %s — something looks like it is running this Codex thread, but cl has no launch record for it and cannot identify the process safely. Close it in its own tab.\n' "$name" >&2
        return 4
      fi
      return 0   # nothing live — already retired
    fi
  else
    pid=$(session_pid "$sid" claude "$name")
    if [ -z "$pid" ]; then
      pid=$(unbound_owner_pid "$name")
      [ -n "$pid" ] || return 0   # nothing live — already retired
      printf '⚠ leaving %s — cl launched a process under this name (pid %s) but cannot prove it runs this session, so it is not killed. Close it in its own tab, or `kill %s` once you have checked.\n' "$name" "$pid" "$pid" >&2
      return 3
    fi
  fi

  # Captured now: a dead process has no start time to read back, and without
  # it cleanup cannot tell this owner from a replacement that reused the pid.
  ptok=$(start_token "$pid")
  # Captured before the signal: after it, these are reparented to launchd and
  # `pgrep -P "$pid"` returns nothing, so a surviving client would be invisible.
  kids=$(pgrep -P "$pid" 2>/dev/null | tr '\n' ' ')
  # Safety: a claude whose PARENT is a tmux server belongs to tmux — if we
  # can't see that server (different socket/user context), it is not ours to
  # process-kill. (Learned the hard way 2026-07-31: a hidden tmux server let
  # an earlier version of this branch sweep 10 live tmux-hosted sessions;
  # re-learned 2026-09-23 when a duplicated copy of this logic in
  # do_fresh_start had dropped the guard again.)
  _ppid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
  _pcomm=$(ps -o comm= -p "${_ppid:-0}" 2>/dev/null); _pcomm=${_pcomm##*/}
  case "$_pcomm" in
    tmux*) printf '⚠ skipping %s — owned by a tmux server not visible here\n' "$name" >&2; return 2 ;;
  esac

  if [ "$idle_proven" != "1" ] && claude_busy "$pid"; then
    printf '⏳ "%s" (pid %s) looks mid-task. Kill it anyway? [y/N] ' "$name" "$pid" >&2
    read -r ans </dev/tty
    case "$ans" in
      y|Y) : ;;
      *) printf '   left %s running — re-run later to retire it\n' "$name" >&2; return 1 ;;
    esac
  fi

  retire_process "$pid" "$ptok" 30 "$hint"; rrc=$?
  case "$rrc" in
    0) # Signalling the process cl launched does not prove the client is gone;
       # a surviving native child still holds the transcript open. Reporting
       # "killed" there would hand back an untracked client.
       surv=$(surviving_children "$hint" $kids)
       if [ -n "$surv" ]; then
         printf '⚠ signalled %s, but a child of it is still running (pid%s %s) — keeping ownership so a retry can finish it\n' \
           "$name" "$( [ "${surv# *}" = "$surv" ] && printf '' || printf 's')" "$surv" >&2
         return 2
       fi
       printf '✓ killed %s\n' "$name" >&2
       clear_launch "$name" "$agent" "$pid" "$ptok"
       [ "$close_tabs" = "1" ] && close_iterm_tab "$t"
       return 0 ;;
    2) printf '✓ signalled %s — still shutting down, leaving it registered\n' "$name" >&2
       [ "$close_tabs" = "1" ] && close_iterm_tab "$t"
       return 2 ;;
    3) # retire_process checked the command line BEFORE signalling: this pid is
       # running something else now, so our session is gone and nothing of ours
       # was signalled.
       printf '⚠ %s: pid %s is no longer running %s — not signalling it\n' "$name" "$pid" "$hint" >&2
       return 0 ;;
    *)
       # retire_process returns 1 for TWO different situations that must not
       # be treated alike: the identity no longer matching (the process is
       # already gone or was replaced — genuinely safe, nothing to kill), and
       # `kill` itself failing while the SAME process is still alive (not
       # safe at all — the original was never even signalled). Re-checking
       # identity here is what tells them apart; retire_process's own return
       # value alone doesn't. (Found in Codex review round 2, 2026-09-23: the
       # earlier version mapped every non-0/non-2 return to "exited, safe",
       # which reported a failed signal as a confirmed retirement and let
       # do_fresh_start launch a second agent under the same name.)
       if [ "$(start_token "$pid")" = "$ptok" ]; then
         printf '⚠ could not signal %s (pid %s) — it is still alive, leaving it registered\n' "$name" "$pid" >&2
         return 2
       fi
       printf '⚠ %s exited before it could be signalled\n' "$name" >&2
       return 0 ;;
  esac
}

# --- handoff (cl stop) -------------------------------------------------------
# Before a session is killed, ask IT to write its own handoff — it has the
# context; `cl` never does. The mechanism is "type into the
# pane", the same trust boundary `cl` already crosses for close_iterm_tab/
# open_iterm_tabs: a literal, single-line instruction (no embedded newlines, so
# there is no multi-line-paste/early-submit ambiguity across tmux/iTerm),
# sent as if a person typed it, then Enter. `cl` never reads the pane back
# (claude's TUI is on the alt-screen, same reason session_busy exists) — it
# polls for the handoff FILE to appear, which is the one observable outcome
# that matters.
#
# The prompt embeds no shell state, only the resolved path (handoff dir or
# fallback, already decided by handoff_root) — so what gets typed into the pane
# is exactly what a person would type.
#
# The handoff must be the LAST thing written, and the default prompt says so.
# `cl` has exactly one observable completion signal, so anything a custom
# prompt asks for in addition has to happen BEFORE the handoff lands, or a kill
# can arrive mid-edit. (An earlier version wrote the handoff first; its mtime
# then advanced before the rest of the work had started — which is also why
# completion is a per-request nonce rather than an mtime. See handoff_nonce.)
# --- prompt construction ------------------------------------------------------
#
# Two rules govern everything below.
#
# ONE LITERAL LINE. The text is typed into a live agent's pane. A newline
# submits it, a carriage return does too, and a tab is a real Tab keystroke. So every C0 control and DEL is folded to a space AFTER placeholder
# expansion — flattening only the template would miss a CRLF file (tr removes
# the LF and leaves the CR) and would not touch a session name or a configured
# path that carries one.
#
# SUBSTITUTED LITERALLY. Sequential ${var//} passes are not literal: each pass
# scans what the previous one inserted, so a session named "Review {{store}}"
# ends up carrying the store path, and a configured path containing {{nonce}}
# gets rewritten into the request nonce — the agent is then told to write
# somewhere other than the path being polled. Placeholders are therefore mapped
# to per-call random sentinels first, and only then replaced by values, so no
# inserted value is ever scanned as a template.
_prompt_flatten() { LC_ALL=C tr '\000-\037\177' '    ' ; }

_prompt_expand() { # template handoff nonce name store
  local tmpl="$1" hp="$2" nonce="$3" name="$4" store="$5" tag
  tag="clph$$${RANDOM}${RANDOM}"
  tmpl=${tmpl//\{\{handoff\}\}/${tag}H}
  tmpl=${tmpl//\{\{nonce\}\}/${tag}N}
  tmpl=${tmpl//\{\{name\}\}/${tag}A}
  tmpl=${tmpl//\{\{store\}\}/${tag}S}
  tmpl=${tmpl//${tag}H/$hp}
  tmpl=${tmpl//${tag}N/$nonce}
  tmpl=${tmpl//${tag}A/$name}
  tmpl=${tmpl//${tag}S/$store}
  printf '%s' "$tmpl" | _prompt_flatten
}

# read_prompt_file <path>: the template, or nothing when absent/unusable.
read_prompt_file() {
  local raw
  [ -r "$1" ] || return 1
  raw=$(cat "$1" 2>/dev/null) || return 1
  [ -n "${raw//[[:space:]]/}" ] || return 1
  printf '%s' "$raw"
}

# build_resume_prompt <handoff-path>: the first message a fresh session gets.
build_resume_prompt() {
  local hp="$1" tmpl
  if tmpl=$(read_prompt_file "$CL_RESUME_PROMPT_FILE"); then
    _prompt_expand "$tmpl" "$hp" "" "" ""
    return 0
  fi
  printf 'Read your handoff at "%s", then continue.' "$hp" | _prompt_flatten
}

build_handoff_prompt() { # root name nonce
  local root="$1" name="$2" nonce="$3" hp tmpl out
  hp=$(handoff_path "$root" "$name")

  # The built-in default asks for the handoff, the completion token, and
  # nothing else. An earlier version of this "generic" default still carried a
  # line-count target and a prescribed schema — which is a workflow, and made
  # the documentation false for anyone who installed it. What a handoff should
  # CONTAIN is in docs/handoff.md as an example override to copy, not here.
  if tmpl=$(read_prompt_file "$CL_HANDOFF_PROMPT_FILE"); then
    # A custom prompt that never asks for the token can never be confirmed:
    # the request would be sent, a perfectly good handoff might be written, and
    # every session would still wait out the full timeout. With several
    # sessions that is minutes lost to a mistake visible before sending. Warn
    # and use the built-in default instead — which keeps the promise that a
    # handoff problem never prevents a stop.
    case "$tmpl" in
      *'{{nonce}}'*)
        out=$(_prompt_expand "$tmpl" "$hp" "$nonce" "$name" "$root")
        printf '%s' "$out"
        return 0 ;;
      *)
        printf 'claude-session: %s has no {{nonce}} placeholder, so a handoff could never be confirmed — using the built-in default instead\n' \
          "$CL_HANDOFF_PROMPT_FILE" >&2 ;;
    esac
  fi

  printf 'Before you stop: write a handoff to "%s" — write it to a temp file and rename it into place, so a partial file is never visible at that path. The LAST line of the file must be exactly "<!-- cl:%s -->" with nothing after it. That line is how the caller tells a finished handoff from one cut off mid-write, so write it last, after everything else you intend to do. Once the rename completes, stop.' \
    "$hp" "$nonce" | _prompt_flatten
}

# ── THE INSTRUCTION GOES IN A FILE; ONLY A POINTER IS TYPED ─────────────────
#
# Typing the whole request lost its START in most iTerm-hosted sessions: on
# 2026-11-02..06 about fifteen of twenty-two sessions received only the tail —
# " is done. Once the rename completes, stop." — so the handoff path and the
# nonce, which come early, never arrived, and no handoff could be confirmed.
# iTerm is not the one dropping it: the same 550 characters written into a raw
# reader arrive whole. Into a Claude TUI they also arrived whole on every probe
# (fresh, large transcript, covered window, background tab), so the condition
# that truncates is not established; the two cases in one session's own
# transcript both followed a long idle (2.5 days and 21 hours).
#
# So the request no longer depends on a long line surviving. The full text is
# written to <store>/<Name>.request, and the line typed is short, with the path
# LAST, because what survives a lost start is the end. handoff_ask_seen then
# checks the transcript and the callers re-type once when it did not land.
handoff_request_path() { printf '%s/%s.request' "$1" "$(name_component "$2")"; }

# The pre-compact request (compact-resume mode) goes through exactly the same
# file-plus-pointer route, into <store>/<Name>.precompact.
precompact_request_path() { printf '%s/%s.precompact' "$1" "$(name_component "$2")"; }

# Optional workflow for the turn before a compaction ("update your session
# board", say). Yours, in a file; by default there is none.
CL_PRECOMPACT_PROMPT_FILE="${CL_PRECOMPACT_PROMPT_FILE:-$HOME/.config/claude-session/precompact-prompt.txt}"

# compact_nonce: the reply token for one pre-compact request.
compact_nonce() { printf 'cl-done:%s-%s-%s%s' "$$" "$(date +%s 2>/dev/null || echo 0)" "$RANDOM" "$RANDOM"; }

# build_precompact_prompt <root> <name> <token>: the full pre-compact request.
#
# It ALWAYS ends by asking for the exact token as the last thing written. That
# token is the only proof the turn has finished — the busy signal lingers for
# minutes, and the transcript alone cannot tell a pause from an end — so it
# cannot depend on there being a workflow. A custom file supplies only the
# workflow; the token sentence is appended whatever it says.
build_precompact_prompt() {
  local root="$1" name="$2" token="$3" tmpl work=""
  if tmpl=$(read_prompt_file "$CL_PRECOMPACT_PROMPT_FILE"); then
    work="$(_prompt_expand "$tmpl" "" "" "$name" "$root") "
  fi
  printf '%sThis session is about to be compacted and restarted by cl. When you have finished, end your turn with a plain reply whose last line is exactly %s and nothing after it, and run no tool after writing it.' \
    "$work" "$token" | _prompt_flatten
}

# build_handoff_ask <root> <name> <nonce> [precompact]: write the full request
# and print the line to type. If the file cannot be written the full request is
# typed as before, because a handoff problem must never prevent a stop. The
# fourth argument selects the pre-compact request instead of the handoff one;
# the route, the pointer shape and the delivery check are the same for both.
build_handoff_ask() {
  local root="$1" name="$2" nonce="$3" kind="${4:-handoff}" full rp tmp label
  if [ "$kind" = "precompact" ]; then
    full=$(build_precompact_prompt "$root" "$name" "$nonce")
    rp=$(precompact_request_path "$root" "$name"); label="pre-compact request"
  else
    full=$(build_handoff_prompt "$root" "$name" "$nonce")
    rp=$(handoff_request_path "$root" "$name"); label="handoff request"
  fi
  tmp="$rp.tmp.$$"
  if printf '%s\n' "$full" > "$tmp" 2>/dev/null && mv -f "$tmp" "$rp" 2>/dev/null; then
    printf 'cl stop: read and follow the %s in "%s"' "$label" "$rp" | _prompt_flatten
    return 0
  fi
  rm -f "$tmp" 2>/dev/null
  printf 'claude-session: could not write %s — typing the full request instead\n' "$rp" >&2
  printf '%s' "$full"
}

# transcript_mark <sid>: "<transcript>\t<size>" now, or nothing when there is no
# transcript (an unknown sid, or no jq). The byte offset is the "after this"
# every transcript check below is measured from.
transcript_mark() {
  local f sz
  command -v jq >/dev/null 2>&1 || return 0
  f=$(find "$PROJECTS" -mindepth 2 -maxdepth 2 -name "${1}.jsonl" 2>/dev/null | head -1)
  [ -n "$f" ] && [ -r "$f" ] || return 0
  sz=$(wc -c < "$f" 2>/dev/null | tr -d ' ')
  printf '%s\t%s' "$f" "${sz:-0}"
}

# handoff_ask_mark <sid>: transcript_mark before a send, or nothing when the
# delivery check is off.
handoff_ask_mark() {
  [ "${CL_HANDOFF_VERIFY:-5}" -gt 0 ] 2>/dev/null || return 0
  transcript_mark "$1"
}

# handoff_ask_seen <mark> <line>: 0 once the transcript, past the mark, holds a
# user turn or a queued message containing the WHOLE line. A truncated arrival
# contains only its tail, so it does not count. An empty mark means "cannot
# tell" and also returns 0: unverifiable is not the same as lost.
handoff_ask_seen() {
  local f="${1%%$'\t'*}" off="${1##*$'\t'}"
  [ -n "$1" ] || return 0
  tail -c +"$((off + 1))" "$f" 2>/dev/null \
    | jq -R -r 'fromjson? | select(.type == "user" or .type == "queue-operation")
        | (.message.content? // .content? // empty)
        | if type == "string" then . elif type == "array" then (map(.text? // empty) | join(" ")) else empty end' 2>/dev/null \
    | grep -qF -- "$2"
}

# handoff_ask_wait <seconds> <mark> <line>: poll handoff_ask_seen.
handoff_ask_wait() {
  local ticks=$(( $1 * 4 )) i=0
  while [ "$i" -le "$ticks" ]; do
    handoff_ask_seen "$2" "$3" && return 0
    sleep 0.25; i=$((i+1))
  done
  return 1
}
# Seconds to wait for a typed ask to show up in the transcript. An idle session
# records the turn in well under a second. 0 turns the check off.
CL_HANDOFF_VERIFY="${CL_HANDOFF_VERIFY:-5}"

# send_text_tmux <tmux_session> <text>: type literal text into a live tmux pane
# and press Enter, exactly as a person would. -l sends the text with no key
# translation, so it is safe for arbitrary punctuation (quotes, backslashes).
#
# The target MUST be "=<session>:" (trailing colon), not "=<session>" alone.
# `has-session`/`kill-session` accept the bare session form, but `send-keys`
# resolves its target to a PANE and a bare session name is ambiguous — proven
# against a real tmux 3.7c: `send-keys -t "=name"` fails "can't find pane"
# every time, `send-keys -t "=name:"` (session's active window) succeeds.
# (Found in Codex review, 2026-09-23 — the fake-tmux fixture in earlier local
# testing accepted any target, which is exactly why it didn't catch this.)
send_text_tmux() {
  tmux send-keys -t "=$1:" -l -- "$2" 2>/dev/null || return 1
  tmux send-keys -t "=$1:" Enter 2>/dev/null
}

# send_text_iterm <tag> <text>: type literal text into the iTerm session
# tagged user.clSession == <tag> (the same tag launch_session/launch_named set
# via tag_iterm_session). Best-effort: a session that was never tagged (started
# before this feature, or `cl new`'s detached-create path) cannot be reached
# this way and is reported as such by the caller, not here.
#
# ── TEXT AND RETURN ARE TWO CALLS, AND THE RETURN COMES AFTER A PAUSE ───────
#
# This was one `write text "..."`, described here as "types-and-Enters in one
# call", and it only ever submitted a SHORT line. Measured against a live
# Claude TUI in iTerm, 2026-10-09:
#
#   59 chars  + the terminator write text appends -> SUBMITS
#   343 chars + the same                          -> does NOT submit; the text
#                                                    sits in the input box
#   a second, bare LF onto that stuck text        -> still does not submit
#   a literal CR (ASCII 13) as its own write      -> submits immediately
#
# The handoff prompt is 430-566 characters, so it NEVER submitted through this
# path. That is the entirety of the reported fault — "the handoff request posted
# in the hub session but never submitted" — and a real `cl stop` across eleven
# iTerm-hosted sessions produced ZERO handoffs: every one asked, every one timed
# out, because no ask was ever submitted.
#
# ── WHAT THE FIX IS NOT ─────────────────────────────────────────────────────
#
# This block used to claim `write text` terminates the line with LF (0x0a) and
# that the fix was switching to CR. That is WRONG, and it matters, because
# somebody reading it would conclude the byte was the whole story and could
# collapse these two writes back into one while keeping a CR — reintroducing
# the fault. Measured at the pty with ICRNL cleared, 2026-10-13
# (tools/iterm-broadcast-probe.sh is what measured it):
#
#   write text "X" newline YES                      -> X 0x0d
#   write text "X" newline NO, then ASCII 13        -> X 0x0d
#
# BYTE-IDENTICAL. `newline YES` appends CR, not LF, so the one-call form was
# already sending CR and failed on a long line anyway. There are no
# bracketed-paste markers in either form either, even when the receiver enables
# paste mode — so that explanation is out too.
#
# The difference that remains is TIMING: the two-step puts 0.15s between the
# text and the terminator, so the CR arrives as its own input event after the
# TUI has digested a long wrapped line. WHY a same-burst CR is dropped there is
# not established — it is a TUI-side behaviour this code cannot see — but the
# separation is what empirically fixes it, and the 10-09 table also shows LF
# never submits even on its own, so the terminator stays a literal CR.
#
# Both halves are therefore load-bearing: CR because LF does not submit, and
# the pause because a long line needs the CR to arrive separately. The delay is
# the same reason send_text_tmux sends Enter as its own `send-keys` call.
#
# WHY IT WAS NOT CAUGHT EARLIER, since the lesson is the point: a tmux probe on
# 2026-10-08 sent 427 characters followed immediately by Enter and submitted
# correctly, and I concluded from it that the submit path was sound. It was —
# for tmux, which sends a real Enter key. The iTerm path went untested because
# testing it means typing into live sessions, and the untested path was the
# broken one. Two days of work on retry and budget behaviour sat downstream of
# an ask that could never arrive.
send_text_iterm() {
  local tag="$1" text="$2" etag etext found
  etag="${tag//\\/\\\\}"; etag="${etag//\"/\\\"}"
  etext="${text//\\/\\\\}"; etext="${etext//\"/\\\"}"
  found=$(osascript 2>/dev/null <<OSA
tell application "iTerm"
  set hit to missing value
  repeat with w in windows
    repeat with tb in tabs of w
      repeat with s in sessions of tb
        try
          if (variable named "user.clSession") of s is "${etag}" then set hit to s
        end try
      end repeat
    end repeat
  end repeat
  if hit is missing value then return "no"
  tell hit to write text "${etext}" newline NO
  delay 0.15
  tell hit to write text (ASCII character 13) newline NO
  return "yes"
end tell
OSA
)
  [ "$found" = "yes" ]
}

# run_bounded <seconds> <command...>: run it, kill it if it outlives the limit.
# 124 on timeout, otherwise the command's own status.
#
# macOS ships no coreutils `timeout`, and this cannot be left unbounded: every
# backend here talks to something that can wedge. `osascript` waits on iTerm,
# which waits on a GUI; `tmux send-keys` waits on a server. Codex's PR #19 review put it exactly right — one blocked backend
# could hold `cl stop` indefinitely, before any budget accounting began.
#
# `wait` on a killed child reports the signal, so the timeout status is returned
# explicitly rather than inferred from it.
#
# ── IT KILLS THE PROCESS GROUP, NOT JUST THE CHILD ──────────────────────────
#
# The first version killed `$!` only, and documented that as sufficient
# "because the backends here ARE the process being killed". That was WRONG, and
# Codex's PR #19 review proved it: every backend is a shell FUNCTION
# (send_text_tmux, send_text_iterm), so backgrounding it makes `$!` a
# SUBSHELL and the real osascript/tmux is its child. Killing the
# subshell left the backend running while this printed "killed it" — a false
# message, and an orphan that can go on holding a caller's pipe.
#
# Measured on bash 3.2, a function that backgrounds a sleep:
#   without set -m, kill -9 $!        -> grandchild ALIVE
#   with    set -m, kill -9 -- -$!    -> grandchild GONE
#
# `set -m` puts the job in its own process group, which is what makes the
# negative-pid kill reach the whole tree. Job control is restored to whatever it
# was: this runs inside a long-lived interactive-ish script, and leaving it on
# would change how every later background job is reaped.
run_bounded() {
  local limit="$1"; shift
  local ticks=$(( limit * 10 )) i=0 pid had_m=0
  case "$-" in *m*) had_m=1 ;; esac
  set -m
  # STDIN FROM /dev/null. With `set -m` the child is in its own process group,
  # so any attempt to READ the terminal earns it SIGTTIN and it stops — and this
  # would then wait out the whole timeout before killing a process that was
  # never going to finish. Measured: a child running `cat` returned 124 at the
  # limit instead of immediately. None of the callers need stdin, and EOF is the
  # honest answer for all of them.
  "$@" < /dev/null & pid=$!
  [ "$had_m" = "1" ] || set +m
  while [ "$i" -lt "$ticks" ]; do
    if ! kill -0 "$pid" 2>/dev/null; then
      wait "$pid"; return $?
    fi
    sleep 0.1; i=$((i+1))
  done
  # The GROUP: -pid. TERM first so a backend with a cleanup path can take it,
  # then KILL, because a wedged GUI call will not.
  kill -TERM -- -"$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null
  sleep 0.3
  kill -9 -- -"$pid" 2>/dev/null || kill -9 "$pid" 2>/dev/null
  wait "$pid" 2>/dev/null
  return 124
}

# handoff_send_once <name> <sid> <tmux_name> <prompt>: type the ask into the
# session, by whichever route reaches it. 0 if it went somewhere, 1 if there was
# no route at all.
#
# ONE place decides reachability, because two callers need the same answer about
# the same session: request_handoff (one session, waits for it) and `cl stop`'s
# broadcast (every session, waits for them together). When this lived inside
# request_handoff the broadcast could only have it by duplicating it, and a
# duplicated send path is one that drifts — the tmux target form alone took two
# review rounds to get right.
#
# The tmux branch deliberately does NOT fall through to iTerm when the send
# fails: a live tmux session that refuses send-keys is a broken pane, not an
# iTerm tab, and typing a handoff request into some other window is worse than
# reporting it unreachable.
handoff_send_once() {
  local name="$1" sid="$2" t="$3" prompt="$4" rc
  # EVERY route is bounded. A send that hangs is not a slow send, it is a stop
  # that never finishes, and the operator cannot tell the two apart from a dark
  # terminal. The timeout is reported per route so a wedged backend names itself.
  if [ -n "$t" ] && tmux has-session -t "=${t}" 2>/dev/null; then
    run_bounded "${CL_HANDOFF_SEND_TIMEOUT:-20}" send_text_tmux "$t" "$prompt"; rc=$?
    [ "$rc" = "124" ] && printf '⚠ the tmux send for "%s" was still running after %ss — killed it\n' "$name" "${CL_HANDOFF_SEND_TIMEOUT:-20}" >&2
    [ "$rc" = "0" ] && return 0
  else
    run_bounded "${CL_HANDOFF_SEND_TIMEOUT:-20}" send_text_iterm "$t" "$prompt"; rc=$?
    [ "$rc" = "124" ] && printf '⚠ the iTerm send for "%s" was still running after %ss — killed it\n' "$name" "${CL_HANDOFF_SEND_TIMEOUT:-20}" >&2
    [ "$rc" = "0" ] && return 0
  fi
  return 1
}

# handoff_ask_resend <name> <sid> <tmux_name> <line>: the ask did not show up
# in the transcript, so type it once more and print the new mark. Not into a
# session that is working: it queues typed input, so its ask may simply be
# waiting (see the re-ask rule in request_handoff). Returns 0 sent, 1 the pane
# became unreachable, 2 left alone because it is busy.
# An optional fifth argument names the ask in that message ("pre-compact").
handoff_ask_resend() {
  local mark
  handoff_target_busy "$3" "$2" "$1" && return 2
  printf '⚠ the %s ask to "%s" did not arrive whole — typing it again\n' "${5:-handoff}" "$1" >&2
  mark=$(handoff_ask_mark "$2")
  handoff_send_once "$1" "$2" "$3" "$4" || return 1
  printf '%s' "$mark"
}

# handoff_ask_retype <name> <sid> <tmux_name> <line>: resend, then wait for it.
# For ONE session; the broadcast resends all of them first and confirms them in
# one shared window instead (handoff_poll_marks). 1 only if unreachable.
handoff_ask_retype() {
  local mark rc
  mark=$(handoff_ask_resend "$@"); rc=$?
  [ "$rc" = "2" ] && return 0
  [ "$rc" = "0" ] || return 1
  handoff_ask_wait "$CL_HANDOFF_VERIFY" "$mark" "$4" && return 0
  printf '⚠ could not confirm that "%s" received the handoff ask — waiting for its handoff anyway\n' "$1" >&2
  return 0
}

# handoff_poll_marks: one shared CL_HANDOFF_VERIFY window over every pending
# session of do_stop's arrays (_n, _h_state, _h_mark, _h_line — read through
# bash's dynamic scope). A session whose line is seen has its mark cleared, so
# what is still marked afterwards is what never arrived whole. An optional
# argument names the state to poll (default "pending"), so the pre-compact asks
# are checked by this same loop rather than by a second copy of it.
handoff_poll_marks() {
  local t=0 unseen=1 i want="${1:-pending}"
  while [ "$unseen" -gt 0 ] && [ "$t" -le $(( CL_HANDOFF_VERIFY * 4 )) ]; do
    unseen=0
    for (( i=0; i<_n; i++ )); do
      [ "${_h_state[$i]}" = "$want" ] && [ -n "${_h_mark[$i]:-}" ] || continue
      if handoff_ask_seen "${_h_mark[$i]}" "${_h_line[$i]}"; then _h_mark[$i]=""; else unseen=$((unseen+1)); fi
    done
    [ "$unseen" -gt 0 ] && { sleep 0.25; t=$((t+1)); }
  done
  return 0
}

# handoff_send_checked <name> <sid> <tmux_name> <line>: handoff_send_once, then
# confirm the line arrived whole and re-type it once if it did not.
handoff_send_checked() {
  local mark
  mark=$(handoff_ask_mark "$2")
  handoff_send_once "$1" "$2" "$3" "$4" || return 1
  [ -n "$mark" ] || return 0
  handoff_ask_wait "$CL_HANDOFF_VERIFY" "$mark" "$4" && return 0
  handoff_ask_retype "$1" "$2" "$3" "$4"
}

# --- compact-resume: reading the transcript ----------------------------------
#
# cl cannot read a Claude pane (the TUI is on the alternate screen), so every
# step of a compaction is confirmed from the TRANSCRIPT, measured from a byte
# mark taken beforehand. Four questions, four functions, each narrow on purpose:
#
#   compact_token_seen     did the pre-compact turn FINISH?
#   compact_boundary_after did a compaction happen (optionally: a manual one)?
#   compact_output_after   did /compact report "Compacted"?
#   compact_idle           is the session at rest since its compaction?
#
# How long all of it may take, for every compacting session at once. Measured:
# 88-137s for ~1M -> 20k tokens, plus a pre-compact turn at ~1M context. Kept
# apart from CL_HANDOFF_BUDGET, so a stop's worst case is the sum of the two.
CL_COMPACT_TIMEOUT="${CL_COMPACT_TIMEOUT:-600}"

# _tail_records <mark>: the records written after the mark, one per line. A
# record that was half-written when the mark was taken is a fragment here and
# is dropped by `fromjson?`, which is the right answer: it predates the mark.
_tail_records() {
  local f="${1%%$'\t'*}" off="${1##*$'\t'}"
  [ -n "$1" ] && [ -r "$f" ] || return 1
  tail -c +"$((off + 1))" "$f" 2>/dev/null | jq -c -R 'fromjson? // empty' 2>/dev/null
}

# _mark_size <mark>: the transcript's size now.
_mark_size() { wc -c < "${1%%$'\t'*}" 2>/dev/null | tr -d ' '; }

# compact_token_seen <mark> <token>: 0 when the pre-compact turn has ended with
# the token.
#
# The match is deliberately narrow, because the cheap one is wrong: the request
# FILE contains the token, so the moment the session reads it, the token sits
# in a tool_result — a `user` record — and a plain search would "confirm" a turn
# that has only just begun. (That is why handoff_ask_seen, which matches user
# records, is not reused here.) So the token counts only:
#   * in an ASSISTANT TEXT block, after the mark;
#   * in the LAST conversation record (user/assistant — metadata records such
#     as system notes are not turns and do not move "last");
#   * with no tool_use after that text block, since a tool call means the turn
#     is still going.
# The caller adds the fourth condition: the size stable across two polls.
compact_token_seen() {
  _tail_records "$1" | jq -s -e --arg tok "$2" '
    map(select(.type == "user" or .type == "assistant")) | last
    | select(. != null and .type == "assistant")
    | (.message.content // [])
    | (if type == "string" then [{type: "text", text: .}] elif type == "array" then . else [] end)
    | to_entries
    | ([.[] | select(.value.type == "tool_use") | .key] | max) as $tu
    | ([.[] | select(.value.type == "text" and ((.value.text // "") | contains($tok))) | .key] | max) as $tx
    | $tx != null and ($tu == null or $tx > $tu)' >/dev/null 2>&1
}

# compact_boundary_after <mark> [trigger]: print "<uuid>|<trigger>|<pre>|<post>"
# for the LAST compact_boundary after the mark (only one with that trigger,
# when given). Non-zero when there is none. "|" and not a tab: a tab is IFS
# whitespace to `read`, so an empty uuid would shift every later field.
#
# The trigger matters both ways. A pre-compact turn at ~1M tokens can set off an
# AUTO compaction: counted as confirmation of /compact it would pass instantly,
# kill mid-compaction, or lead to compacting a 20k summary a second time. So
# after /compact only "manual" confirms, and an auto one before /compact means
# /compact is not typed at all.
compact_boundary_after() {
  local out
  out=$(_tail_records "$1" | jq -s -r --arg want "${2:-}" '
    map(select(.type == "system" and .subtype == "compact_boundary"
               and ($want == "" or ((.compactMetadata.trigger // "") == $want)))) | last
    | select(. != null)
    | [(.uuid // ""), (.compactMetadata.trigger // ""),
       ((.compactMetadata.preTokens // "") | tostring), ((.compactMetadata.postTokens // "") | tostring)]
    | join("|")' 2>/dev/null)
  [ -n "$out" ] || return 1
  printf '%s' "$out"
}

# "Compacted", as Claude Code actually records it: a USER record whose content
# is a STRING, the command's stdout wrapped in <local-command-stdout>, and the
# word itself styled with ANSI SGR escapes:
#   "<local-command-stdout>\u001b[2mCompacted (ctrl+o …)\u001b[22m</local-command-stdout>"
# A plain contains("<local-command-stdout>Compacted") never matches that. And
# it is anchored to the start of a string-content user record ONLY: a
# tool_result is array content, so a session that reads this script, or a
# transcript, after compacting cannot be taken for the command's own output.
_CL_JQ_COMPACTED='def compacted_output:
  .type == "user" and ((.message.content? // null) | type) == "string"
  and (.message.content | test("^<local-command-stdout>(\u001b\\[[0-9;]*m)*Compacted"));'

# compact_output_after <mark>: 0 when /compact has reported "Compacted" after
# the mark — the second accepted confirmation, for a version that writes the
# command's output but a boundary this check does not recognise.
compact_output_after() {
  _tail_records "$1" | jq -s -e "$_CL_JQ_COMPACTED"' map(select(compacted_output)) | length > 0' >/dev/null 2>&1
}

# compact_idle_record <mark> [token]: 0 when the session is at rest after its
# compaction, judged by the LAST CONVERSATION record (user/assistant) after the
# mark — exactly as compact_token_seen judges a turn's end.
#
# Not the last record of any kind: after a manual compaction Claude Code writes
# the Compacted output, then attachment records (the SessionStart:compact hook
# among them), then a batch of metadata (file-history-snapshot, last-prompt,
# custom-title, permission-mode…); a finished turn is followed by
# stop_hook_summary, turn_duration and more. A bare `last` lands on metadata,
# never passes, and sends every compacted session to the kill prompt — which,
# unattended, is answered "no" and fails the stop.
#
# Idle means that record is the Compacted output — or, with a token (a session
# that compacted on its own and then finished its turn), the assistant reply
# carrying it. Deliberately NOT any free-text mention of "SessionStart" and
# "compact": a tool_result can contain both, and matching it would skip the
# prompt for a session that is busy.
compact_idle_record() {
  _tail_records "$1" | jq -s -e --arg tok "${2:-}" "$_CL_JQ_COMPACTED"'
    map(select(.type == "user" or .type == "assistant")) | last | select(. != null)
    | compacted_output
      or ($tok != "" and .type == "assistant"
          and ([(.message.content // []) | if type == "array" then .[] else empty end
                | select(.type == "text") | (.text // "") | contains($tok)] | any))' >/dev/null 2>&1
}

# compact_preflight <sid> <boundary-uuid>: before `cl start` resumes a session
# with a first prompt, check it is still the session the stop compacted: the
# transcript exists, and its LAST boundary is the one recorded on the row.
# Anything else — gone, compacted again since, never compacted — is resumed
# plainly by the caller, never rotated: no handoff was asked for this cycle, so
# any handoff present predates it.
#
# grep first, then jq on the hits only: a transcript that needed compacting is
# tens of megabytes, and this runs once per session on every start.
compact_preflight() {
  local f last want="${2:-}"
  [ "$want" = "-" ] && want=""
  f=$(find "$PROJECTS" -mindepth 2 -maxdepth 2 -name "${1}.jsonl" 2>/dev/null | head -1)
  [ -n "$f" ] && [ -r "$f" ] || return 1
  last=$(grep -F '"compact_boundary"' "$f" 2>/dev/null \
    | jq -c 'select(.type == "system" and .subtype == "compact_boundary")' 2>/dev/null | tail -1)
  [ -n "$last" ] || return 1
  [ "$(printf '%s' "$last" | jq -r '.uuid // ""' 2>/dev/null)" = "$want" ]
}

# request_handoff <name> <sid> <cwd> <tmux_name> [--dry-run]: try to get the
# live session to write its own handoff before it dies. Returns:
#   0  a handoff is on disk for this session and is THIS run's — either its
#      nonce token was found (see handoff_nonce below) or a hand-written one
#      was already waiting (see handoff_is_manual)
#   1  could not even ask (no reachable pane, or no durable root at all —
#      logs why)
#   2  asked CL_HANDOFF_ATTEMPTS times, nothing landed (logs why)
#   3  dry run — nothing sent
#
# It does NOT consume what it finds: the handoff has to survive the stop so
# that the next `cl start` can rotate off it. Consuming is `do_start`'s job.
#
# A 1 or 2 is NOT a fallback to a plain stop any more. `cl stop` fails closed
# on it and leaves the session running — see do_stop.
#
# handoff_nonce: one fresh, unpredictable-enough token per request. A content
# hash (round 2's fix) is NOT a valid completion signal on its own — round 3
# of Codex review reproduced both directions of that: (a) a real, completed
# handoff whose content happens to be byte-identical to a stale one from an
# earlier rotation has an UNCHANGED hash, so a genuine success times out; (b)
# an unrelated write, or a File Provider reconciling mid-sync, changes the
# hash without this request's handoff having landed at all, so a false
# success is accepted while the agent may still be working. Requiring
# THIS run's nonce inside the file closes both: a real completion of THIS
# request always contains it, and nothing else ever could.
handoff_nonce() { printf 'clho:%s:%s:%s:%s' "$$" "$(date +%s 2>/dev/null || echo 0)" "$RANDOM" "$RANDOM"; }

# _CL_BUDGET_LEFT / _CL_SESSION_CAP: the bounds request_handoff waits within.
# Both default to -1, meaning unbounded, and NOTHING sets them any more: `cl
# stop` stopped dividing a budget between sessions when the asks became
# concurrent, and its only other caller is `cl start --fresh`, which handles one
# session and should give it the full attempts. They stay because they are
# request_handoff's contract with any future caller that does need a ceiling —
# and because -1 was itself a bug once: the subtraction used to run
# unconditionally and return on `<= 0`, so an uncapped caller quit after ONE
# attempt and CL_HANDOFF_ATTEMPTS did nothing.
_CL_BUDGET_LEFT="${_CL_BUDGET_LEFT:--1}"
_CL_SESSION_CAP="${_CL_SESSION_CAP:--1}"
request_handoff() {
  local name="$1" sid="$2" cwd="$3" t="$4" dry="${5:-}" prompt root hp nonce waited sent=0 vrc

  # Dry run: preview ONLY, via the read-only *_preview resolver — checked
  # before touching anything real. handoff_path (below) needs a resolved
  # root, and resolving it for real means mkdir + write-probe; a dry run must
  # do neither. (Found in Codex review, 2026-09-23 — the original order built
  # the real path first, so `cl stop --dry-run` could still create
  # handoff dir/fallback directories.)
  if [ "$dry" = "--dry-run" ]; then
    printf '[dry-run] would ask "%s" to write handoff to %s (via %s)\n' "$name" "$(handoff_path_preview "$name")" "$( [ -n "$t" ] && tmux has-session -t "=${t}" 2>/dev/null && echo tmux || echo iterm )" >&2
    return 3
  fi

  # Resolve the root EXACTLY ONCE here, via a direct (non-$()) call, and
  # thread it through both path constructions below AND leave it in
  # `_CL_HANDOFF_ROOT` for the caller to reuse afterward (do_fresh_start does,
  # for the launch prompt it builds once this returns) — see the path-helper
  # comment above for why a per-helper `$(handoff_root)` call doesn't achieve
  # this (Codex review round 2). handoff_root can fail outright (neither handoff dir
  # nor fallback usable, round 3) — that is exactly a "could not even ask"
  # case, checked explicitly rather than assumed.
  handoff_root >/dev/null; vrc=$?; root="$_CL_HANDOFF_ROOT"
  if [ "$vrc" -ne 0 ] || [ -z "$root" ]; then
    printf 'ℹ no durable location available to hand off "%s" (handoff dir and fallback both unusable) — plain stop\n' "$name" >&2
    return 1
  fi
  hp=$(handoff_path "$root" "$name")

  # A hand-written handoff is an ANSWER, not a leftover: it is how you satisfy
  # this requirement when the pane cannot be reached at all (`cl handoff`, run
  # inside the session). Honour it instead of asking. Its AGE is printed
  # prominently, because the one real hazard here is acting on something
  # written weeks ago and forgotten.
  if handoff_is_manual "$hp"; then
    printf '✓ using the handoff you wrote by hand for "%s" — written %s ago (%s)\n' \
      "$name" "$(handoff_age_human "$hp")" "$hp" >&2
    return 0
  fi

  # A prior handoff still sitting here is LEFT ALONE while we ask for a new
  # one. Sweeping it first destroyed a valid answer to buy nothing: nothing had
  # invalidated it until a newer handoff actually replaced it, and the wait
  # below cannot be fooled by it anyway, because the wait matches THIS
  # attempt's nonce in the terminal marker. The agent's temp-file-then-rename
  # replaces it atomically only when the new handoff is complete — so if every
  # attempt fails, the last known-good answer is still there.

  local attempt=1 spent=0
  while [ "$attempt" -le "$CL_HANDOFF_ATTEMPTS" ]; do
    # DO NOT RE-TYPE INTO A SESSION THAT IS STILL WORKING. A busy claude QUEUES
    # typed input and runs it when it finishes, so the first ask is not lost —
    # it is waiting its turn. Typing it again stacks a second copy in the same
    # input box and changes nothing about when the handoff lands. On 2026-10-07
    # that produced three stacked copies and spent 246s of a 300s stop budget
    # on one session. A retry answers "the ask did not land", which is a
    # different question from "the agent has not finished".
    #
    # Attempt 1 always sends, busy or not: queued is exactly where we want it.
    if [ "$attempt" -eq 1 ] || ! handoff_target_busy "$t" "$sid" "$name"; then
      # A FRESH nonce per attempt THAT ACTUALLY SENDS. Reusing one would let a
      # late answer to attempt 1 be counted as confirmation of attempt 3 —
      # the same stale-artifact confusion the nonce exists to prevent. The
      # no-resend path below deliberately keeps the nonce it is already
      # waiting on, because that is the request still in flight.
      nonce=$(handoff_nonce)
      prompt=$(build_handoff_ask "$root" "$name" "$nonce")
      sent=0

      handoff_send_checked "$name" "$sid" "$t" "$prompt" && sent=1

      # Unreachable is not a timing problem, so retrying cannot fix it — report
      # it as "could not even ask" on the first attempt rather than burning the
      # remaining attempts sending into nothing.
      if [ "$sent" != "1" ]; then
        printf 'ℹ no reachable pane to hand off "%s" (not tmux, not a tagged iTerm tab)\n' "$name" >&2
        return 1
      fi
    else
      printf '⏳ "%s" is still working — its handoff request is QUEUED, not lost; waiting without re-asking\n' "$name" >&2
    fi

    # Never wait past the stop-wide budget. Without this cap the wait is
    # attempts × timeout PER SESSION, which is how a working set turns a stop
    # into a coffee break.
    local this_wait="$CL_HANDOFF_TIMEOUT"
    # THIS SESSION'S OWN TOTAL, across every attempt — not per attempt, or
    # ATTEMPTS x cap would put the starvation straight back.
    if [ "$_CL_SESSION_CAP" -ge 0 ]; then
      local session_left=$(( _CL_SESSION_CAP - spent ))
      if [ "$session_left" -le 0 ]; then
        printf '⏭ "%s" has used its %ss share of this stop'"'"'s handoff budget — moving on so the others get theirs\n' \
          "$name" "$_CL_SESSION_CAP" >&2
        return 2
      fi
      [ "$this_wait" -gt "$session_left" ] && this_wait="$session_left"
    fi
    if [ "$_CL_BUDGET_LEFT" -ge 0 ] && [ "$this_wait" -gt "$_CL_BUDGET_LEFT" ]; then
      this_wait="$_CL_BUDGET_LEFT"
    fi
    if [ "$this_wait" -le 0 ]; then
      printf '⏭ handoff budget for this stop is spent — not waiting further for "%s"\n' "$name" >&2
      return 2
    fi
    printf '⏳ asked "%s" to write its handoff (attempt %s of %s) — waiting up to %ss for %s\n' \
      "$name" "$attempt" "$CL_HANDOFF_ATTEMPTS" "$this_wait" "$hp" >&2
    waited=0
    while [ "$waited" -lt "$this_wait" ]; do
      sleep 1; waited=$((waited+1))
      # THIS attempt's nonce, not just "any change" — see handoff_nonce's
      # comment for the two races a plain content hash still missed.
      # The nonce must be the file's terminal marker, not merely present
      # somewhere in it: that is what distinguishes a COMPLETE handoff from one
      # that was cut off after the agent happened to mention the token.
      if [ -e "$hp" ] && [ "$(handoff_marker "$hp" 2>/dev/null)" = "$nonce" ]; then
        if [ "$_CL_BUDGET_LEFT" -ge 0 ]; then
          _CL_BUDGET_LEFT=$(( _CL_BUDGET_LEFT - waited ))
          [ "$_CL_BUDGET_LEFT" -lt 0 ] && _CL_BUDGET_LEFT=0
        fi
        printf '✓ handoff written for "%s"\n' "$name" >&2
        rm -f "$(handoff_request_path "$root" "$name")" 2>/dev/null
        return 0
      fi
    done
    # GUARDED ON THE SENTINEL. -1 documents "unbounded", but this used to
    # subtract from it unconditionally and then return on `-le 0` — so an
    # uncapped caller quit after ONE attempt and CL_HANDOFF_ATTEMPTS did
    # nothing. do_stop always passes a real budget, which is why it stayed
    # hidden; the first test to drive request_handoff directly found it.
    if [ "$_CL_BUDGET_LEFT" -ge 0 ]; then
      _CL_BUDGET_LEFT=$(( _CL_BUDGET_LEFT - waited ))
      [ "$_CL_BUDGET_LEFT" -lt 0 ] && _CL_BUDGET_LEFT=0
    fi
    spent=$(( spent + waited ))
    printf '⚠ no handoff from "%s" after %ss\n' "$name" "$waited" >&2
    [ "$_CL_BUDGET_LEFT" -eq 0 ] && return 2
    attempt=$((attempt+1))
  done
  return 2
}

# archive_state: bank a copy of the current STATE into STATE_HISTORY_DIR under a
# timestamped name, then prune to the newest STATE_HISTORY_KEEP. Only well-formed
# JSON is archived, so the history stays a set of known-good snapshots to restore
# from if the live STATE is lost (failed start) or corrupted. Best-effort: any
# failure here must never break stop/start, so it always returns 0.
archive_state() {
  [ -r "$STATE" ] || return 0
  command -v jq >/dev/null 2>&1 && ! jq empty "$STATE" 2>/dev/null && return 0
  mkdir -p "$STATE_HISTORY_DIR" 2>/dev/null || return 0
  local stamp dest n=1
  stamp=$(date +%Y%m%d-%H%M%S)
  dest="$STATE_HISTORY_DIR/state-$stamp.json"
  # Same-second archives (e.g. rapid stop/start) must not clobber each other.
  while [ -e "$dest" ]; do dest="$STATE_HISTORY_DIR/state-$stamp-$n.json"; n=$((n+1)); done
  cp "$STATE" "$dest" 2>/dev/null || return 0
  # Prune oldest beyond the keep count (newest-first, drop the tail).
  ls -1t "$STATE_HISTORY_DIR"/state-*.json 2>/dev/null \
    | tail -n +$((STATE_HISTORY_KEEP + 1)) \
    | while IFS= read -r old; do rm -f "$old"; done
  return 0
}

# save_state: record the currently-live sessions into STATE as JSON, UNIONed
# with whatever STATE already held (keyed by name; the fresh entry wins on a
# collision so session ids stay current). Union — not overwrite — because
# `cl stop` is meant to be re-run to catch sessions left running mid-task: by
# the second run those killed earlier are no longer live, and an overwrite
# would drop them from the saved set. `cl start` clears STATE once consumed,
# so a clean stop→start cycle never accumulates stale entries.
# session_is_live <name> <sid> <agent>: 0 if this session is running now, by the
# rule that decides whether `cl stop` SAVES it. One definition, because two
# places need it — save_state (what comes back on `cl start`) and do_stop (who is
# asked for a handoff, counted, and retired) — and if they ever disagreed, a stop
# could ask for a handoff from a session it was not going to save, or fail to
# ask one it was.
#
#   claude: its tmux session exists, session_pid finds its process, or cl owns
#           a live process under this name that it cannot tie to any session
#           (unbound_owner_pid) — that one is kept and reported, never dropped.
#   codex:  a tmux session cl provably owns, or cl's own launch record. Never a
#           name match alone — that saved an unstamped collision as if cl had
#           launched it, which stop then (correctly) refused to kill.
session_is_live() {
  local name="$1" sid="$2" agent="$3"
  if [ "$agent" = "claude" ]; then
    tmux has-session -t "$(tmux_name "$name" claude)" 2>/dev/null && return 0
    [ -n "$(session_pid "$sid" claude "$name")" ] && return 0
    [ -n "$(unbound_owner_pid "$name")" ]
    return $?
  elif [ "$agent" = "codex" ]; then
    if tmux has-session -t "$(tmux_name "$name" codex)" 2>/dev/null \
       && tmux_owned "$(tmux_name "$name" codex)" codex "$sid"; then
      return 0
    fi
    [ -n "$(registered_pid "$name" codex "$sid")" ]
    return $?
  fi
  return 1
}

save_state() {
  mkdir -p "$(dirname "$STATE")" || { echo "claude-session: cannot create state dir" >&2; return 1; }

  # Build a JSON array of the sessions live in tmux right now.
  local live first=1
  live="$(
    printf '['
    # What counts as "live" differs by agent, and the difference is the whole
    # safety argument for Codex support.
    #
    #   claude: an argv match (`--resume <sid>`) is a sound handle — one process
    #           per transcript, and stop verifies the start token before
    #           signalling.
    #   codex:  an argv match is NOT. Codex also runs threads through a shared
    #           app-server daemon, the Desktop app and --remote clients, none of
    #           which carry `resume <sid>` in argv, and the npm launcher is a
    #           node wrapper plus a native child that BOTH match. So the only
    #           sound handle is the launch registry: a pid cl itself recorded,
    #           with a start token, under this exact agent and name.
    #
    # A Codex thread running somewhere cl did not launch is therefore not saved.
    # Recording it would mean `cl start` later resuming a thread that is already
    # open elsewhere — two clients on one transcript, which is the thing the
    # duplicate-launch refusal exists to prevent.
    discover | while IFS=$'\t' read -r name sid cwd epoch agent; do
      # if/elif, not case: this runs inside a command substitution, and bash
      # mis-parses a `case` whose arms carry nested $( ) there — it fails at
      # PARSE time, so the whole state write dies rather than one row.
      # The rule lives in session_is_live, shared with the planning pass of
      # do_stop. (No apostrophes in here: this is inside $( ), where bash 3.2
      # tries to pair quotes even in comments.)
      session_is_live "$name" "$sid" "$agent" || continue
      [ "$first" -eq 1 ] && first=0 || printf ','
      jq -nc --arg name "$name" --arg sid "$sid" --arg cwd "$cwd" --arg agent "$agent" \
        '{name:$name, sid:$sid, cwd:$cwd, agent:$agent}'
    done
    printf ']'
  )"

  # Union with any prior STATE: concat, group by name, keep the last (fresh)
  # entry per name. Prior file is treated as empty if missing/unparseable.
  local prior="[]"
  [ -r "$STATE" ] && prior="$(jq -c '.' "$STATE" 2>/dev/null || printf '[]')"
  local tmp="$STATE.tmp.$$"
  # Grouped by AGENT AND NAME. Grouping on the name alone silently dropped a
  # row when a Claude and a Codex session shared one — and since stop kills
  # both, start could then restore only one of them.
  if printf '%s\n%s\n' "$prior" "$live" \
      | jq -s 'add | group_by([(.agent // "claude"), .name]) | map(.[-1])' > "$tmp" 2>/dev/null; then
    mv "$tmp" "$STATE"
    archive_state   # bank this known-good snapshot into the rotating history
  else
    rm -f "$tmp"
    echo "claude-session: failed to write state" >&2
    return 1
  fi
}

# _c_fallback <i> <reason> <message>: a compacting session that will be asked
# for a handoff instead. It then goes through the handoff phase like any other
# handoff session — including honouring a handoff written by hand.
_c_fallback() {
  _h_rot[$1]="handoff"; _h_state[$1]="idle"; _h_cstate[$1]=""; _h_mark[$1]=""; _h_why[$1]="$2"
  _c_clear_request "$1"
  printf '%s\n' "$3" >&2
}

# _c_clear_request <i>: the pre-compact request has been answered one way or
# the other, so its file goes, as a handoff request's does once it lands.
_c_clear_request() {
  [ -n "$_CL_STOP_ROOT" ] && rm -f "$(precompact_request_path "$_CL_STOP_ROOT" "${_h_name[$1]}")" 2>/dev/null
  return 0
}

# _c_compacted <i> <boundary-tsv> <reason>: record a confirmed compaction.
_c_compacted() {
  local b_id b_trig b_pre b_post
  IFS='|' read -r b_id b_trig b_pre b_post <<< "$2"
  _h_cstate[$1]="compacted"; _h_state[$1]="cdone"; _h_taken[$1]="compact-resume"; _h_why[$1]="$3"
  _h_cbid[$1]="$b_id"; _h_cpre[$1]="$b_pre"; _h_cpost[$1]="$b_post"
  _c_clear_request "$1"
}

# _stop_compact_phase: steps 2-5 of compact-resume for every compacting session
# of do_stop's arrays at once (read and written through bash's dynamic scope,
# as handoff_poll_marks does).
#
# Every outcome is one of the spec's fallback table, and nothing else:
#   compacted          -> stop it; resume with a first prompt
#   a boundary before /compact -> /compact skipped; treated as compacted
#   no token in time   -> skip /compact; fall back to a handoff
#   no MANUAL boundary in time after /compact -> resume as-is. NOT a handoff:
#                         an ask would queue behind the compaction and be
#                         written from the 20k summary.
# Two more the table leaves open, decided here: a session with no transcript to
# watch, or no pane to type into, falls back to a handoff — the one route that
# can still be answered without the pane (`cl handoff` by hand) — and one whose
# /compact could not be typed after the token resumes as-is.
_stop_compact_phase() {
  local i c_count=0 c_pending=0 tok prompt m rrc resent=0 deadline now sz b
  for (( i=0; i<_n; i++ )); do
    [ "${_h_rot[$i]}" = "compact-resume" ] && c_count=$((c_count+1))
  done
  [ "$c_count" -gt 0 ] || return 0

  # The same announcement shape as the handoff broadcast, said up front: how
  # many will be asked, and how long the phase may take. A dry run says how
  # many WOULD be asked, and promises no wait.
  if [ -n "$dry_run" ]; then
    printf '⏳ asking %s session(s) to finish up, then /compact (dry run: nothing is sent, nothing is waited for)\n' "$c_count" >&2
  else
    printf '⏳ asking %s session(s) to finish up, then /compact, all at once — up to %ss\n' "$c_count" "$CL_COMPACT_TIMEOUT" >&2
  fi
  if [ -n "$dry_run" ]; then
    for (( i=0; i<_n; i++ )); do
      [ "${_h_rot[$i]}" = "compact-resume" ] || continue
      printf '[dry-run] would ask "%s" to finish its pre-compact request, type /compact once it replies, and stop it once compacted (up to %ss)\n' \
        "${_h_name[$i]}" "$CL_COMPACT_TIMEOUT" >&2
    done
    return 0
  fi

  # ── step 1 and 2: baseline, then the pre-compact request ──
  for (( i=0; i<_n; i++ )); do
    [ "${_h_rot[$i]}" = "compact-resume" ] || continue
    if [ -z "$_CL_STOP_ROOT" ]; then
      _c_fallback "$i" "no-store" "ℹ no durable location for the pre-compact request of \"${_h_name[$i]}\" — treating it as a handoff session"
      continue
    fi
    _h_cbase[$i]=$(transcript_mark "${_h_sid[$i]}")
    if [ -z "${_h_cbase[$i]}" ]; then
      _c_fallback "$i" "no-transcript" "ℹ no transcript to watch for \"${_h_name[$i]}\", so a compaction could not be confirmed — asking it for a handoff instead"
      continue
    fi
    tok=$(compact_nonce); _h_ctok[$i]="$tok"
    prompt=$(build_handoff_ask "$_CL_STOP_ROOT" "${_h_name[$i]}" "$tok" precompact)
    _h_mark[$i]=$(handoff_ask_mark "${_h_sid[$i]}"); _h_line[$i]="$prompt"
    if handoff_send_once "${_h_name[$i]}" "${_h_sid[$i]}" "${_h_tmux[$i]}" "$prompt"; then
      _h_state[$i]="cask"; _h_cstate[$i]="await_token"; c_pending=$((c_pending+1))
      printf '  → asked "%s" to finish up before /compact\n' "${_h_name[$i]}" >&2
    else
      _c_fallback "$i" "unreachable" "ℹ no reachable pane to compact \"${_h_name[$i]}\" (not tmux, not a tagged iTerm tab) — treating it as a handoff session"
    fi
  done

  # ── did each pre-compact ask arrive whole? The same check as the handoff asks ──
  if [ "$c_pending" -gt 0 ]; then
    handoff_poll_marks cask
    for (( i=0; i<_n; i++ )); do
      [ "${_h_state[$i]}" = "cask" ] && [ -n "${_h_mark[$i]:-}" ] || continue
      m=$(handoff_ask_resend "${_h_name[$i]}" "${_h_sid[$i]}" "${_h_tmux[$i]}" "${_h_line[$i]}" "pre-compact"); rrc=$?
      case "$rrc" in
        0) _h_mark[$i]="$m"; resent=$((resent+1)) ;;
        1) c_pending=$((c_pending-1))
           _c_fallback "$i" "unreachable" "ℹ \"${_h_name[$i]}\" became unreachable before it could compact — treating it as a handoff session" ;;
        *) _h_mark[$i]="" ;;   # busy: queued, not lost
      esac
    done
    if [ "$resent" -gt 0 ]; then
      handoff_poll_marks cask
      for (( i=0; i<_n; i++ )); do
        [ "${_h_state[$i]}" = "cask" ] && [ -n "${_h_mark[$i]:-}" ] || continue
        printf '⚠ could not confirm that "%s" received the pre-compact ask — waiting for its reply anyway\n' "${_h_name[$i]}" >&2
        _h_mark[$i]=""
      done
    fi
  fi

  # ── steps 3-5: one shared wait ──
  # The window starts AFTER dispatch, as the handoff budget does: asking every
  # session is the point, and a slow dispatch is bounded by the send timeout.
  deadline=$(( $(date +%s) + CL_COMPACT_TIMEOUT ))
  while [ "$c_pending" -gt 0 ]; do
    now=$(date +%s); [ "$now" -lt "$deadline" ] || break
    for (( i=0; i<_n; i++ )); do
      [ "${_h_state[$i]}" = "cask" ] || continue
      case "${_h_cstate[$i]}" in
        await_token)
          # A boundary since the baseline, BEFORE /compact: the goal is already
          # met, so /compact is never typed — compacting a 20k summary again is
          # the hazard. The turn is still let finish (the token is still the
          # proof it ended), so it is not killed mid-turn.
          if [ "${_h_cauto[$i]}" != "1" ] && b=$(compact_boundary_after "${_h_cbase[$i]}"); then
            _h_cauto[$i]=1
            IFS='|' read -r _h_cbid[$i] _ _h_cpre[$i] _h_cpost[$i] <<< "$b"
            printf 'ℹ "%s" compacted on its own before /compact — not compacting it again\n' "${_h_name[$i]}" >&2
          fi
          sz=$(_mark_size "${_h_cbase[$i]}")
          if compact_token_seen "${_h_cbase[$i]}" "${_h_ctok[$i]}" && [ "$sz" = "${_h_clastsz[$i]}" ]; then
            if [ "${_h_cauto[$i]}" = "1" ]; then
              _c_compacted "$i" "$(compact_boundary_after "${_h_cbase[$i]}")" "boundary-before-compact"
              c_pending=$((c_pending-1))
              printf '✓ "%s" finished its pre-compact turn, already compacted\n' "${_h_name[$i]}" >&2
            else
              # Step 4: /compact, ONCE, with no busy gate — claude_busy stays
              # true for minutes after a turn, and the token already proves the
              # turn ended. The mark is taken just before typing.
              _h_cmark[$i]=$(transcript_mark "${_h_sid[$i]}")
              if handoff_send_once "${_h_name[$i]}" "${_h_sid[$i]}" "${_h_tmux[$i]}" "/compact"; then
                _h_cstate[$i]="await_boundary"
                printf '  → "%s" replied; typed /compact\n' "${_h_name[$i]}" >&2
              else
                _h_cstate[$i]="resume"; _h_state[$i]="cdone"; _h_taken[$i]="resume"; _h_why[$i]="compact-unsent"
                _c_clear_request "$i"
                c_pending=$((c_pending-1))
                printf '⚠ could not type /compact into "%s" — it will resume as-is\n' "${_h_name[$i]}" >&2
              fi
            fi
          fi
          _h_clastsz[$i]="$sz"
          ;;
        await_boundary)
          # Step 5: only a MANUAL boundary after the mark confirms, or the
          # "Compacted" output. An auto one here is not this /compact.
          if b=$(compact_boundary_after "${_h_cmark[$i]}" manual); then
            _c_compacted "$i" "$b" "ok"
          elif compact_output_after "${_h_cmark[$i]}"; then
            _c_compacted "$i" "$(compact_boundary_after "${_h_cmark[$i]}" manual || compact_boundary_after "${_h_cmark[$i]}")" "ok"
          fi
          if [ "${_h_cstate[$i]}" = "compacted" ]; then
            c_pending=$((c_pending-1))
            printf '✓ "%s" compacted%s\n' "${_h_name[$i]}" \
              "$( [ -n "${_h_cpre[$i]}" ] && printf ' (%s → %s tokens)' "${_h_cpre[$i]}" "${_h_cpost[$i]:-?}" )" >&2
          fi
          ;;
      esac
    done
    [ "$c_pending" -gt 0 ] && sleep 1
  done

  # ── what the window left unfinished ──
  for (( i=0; i<_n; i++ )); do
    [ "${_h_state[$i]}" = "cask" ] || continue
    case "${_h_cstate[$i]}" in
      await_token)
        if [ "${_h_cauto[$i]}" = "1" ]; then
          # Compacted already; only the turn's end was never confirmed, so it
          # is not proven at rest and the ordinary mid-task prompt applies.
          _c_compacted "$i" "$(compact_boundary_after "${_h_cbase[$i]}")" "boundary-no-token"
        else
          _c_fallback "$i" "no-token" "⚠ no cl-done reply from \"${_h_name[$i]}\" within ${CL_COMPACT_TIMEOUT}s — not compacting it; asking it for a handoff instead"
        fi ;;
      await_boundary)
        _h_cstate[$i]="resume"; _h_state[$i]="cdone"; _h_taken[$i]="resume"; _h_why[$i]="no-boundary"
        _c_clear_request "$i"
        printf '⚠ "%s" did not confirm a compaction within %ss of /compact — it will resume as-is (a handoff now would queue behind the compaction)\n' \
          "${_h_name[$i]}" "$CL_COMPACT_TIMEOUT" >&2 ;;
    esac
  done
  return 0
}

# mark_row_modes <lines of agent\tname\tmode\tboundary>: record on each SAVED
# ROW the mode this stop actually carried out, and for compact-resume the uuid
# of the boundary it confirmed (which `cl start` preflights against).
#
# Matched by agent AND name. mark_resume_only matches by name alone, which is
# harmless for a flag a Codex row ignores, but a mode is read by `cl start` for
# whichever row it lands on, and a Claude session's mode must not end up on a
# Codex thread that shares its name.
mark_row_modes() {
  local lines="$1" tmp
  [ -n "${lines//[[:space:]]/}" ] || return 0
  [ -r "$STATE" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  tmp="$STATE.mode.$$"
  if printf '%s' "$lines" | sed '/^$/d' \
      | jq -R -s --slurpfile all "$STATE" '
          split("\n") | map(select(length > 0) | split("\t")
            | {agent: .[0], name: .[1], mode: .[2], boundary: (if (.[3] // "-") == "-" then "" else .[3] end)}) as $m
          | $all[0] | map(. as $r
              | ([$m[] | select(.agent == ($r.agent // "claude") and .name == $r.name)] | last) as $hit
              | if $hit == null then .
                else .mode = $hit.mode
                  | if $hit.mode == "compact-resume" then .compact_boundary = $hit.boundary else del(.compact_boundary) end
                end)' \
        > "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
    mv "$tmp" "$STATE" 2>/dev/null || rm -f "$tmp"
  else
    rm -f "$tmp"
    printf '⚠ could not record each session'"'"'s restart mode on the saved rows — `cl start` will fall back to the older rules\n' >&2
  fi
}

# do_stop: snapshot live sessions, then kill them — but ask before killing any
# that look mid-task, and leave those running. Re-run `cl stop` to catch them
# once they go idle.
do_stop() {
  local keep_tabs=0 no_handoff=0 dry_run="" require_handoff=0
  # Flags are order-independent — `cl stop --no-handoff --keep-tabs` and
  # `cl stop --keep-tabs --no-handoff` must do the same thing.
  local arg
  for arg in "$@"; do
    case "$arg" in
      --keep-tabs)  keep_tabs=1 ;;
      --no-handoff) no_handoff=1 ;;
      # Fail closed, for when rotation is the POINT of the stop rather than a
      # bonus. Not the default: `cl stop` is what you run before a reboot, and
      # the session least able to answer a handoff request is the wedged one
      # you most need stopped.
      --require-handoff|--rotate) require_handoff=1 ;;
      --dry-run)    dry_run="--dry-run" ;;
      -h|--help)    print_stop_help; exit 0 ;;
      *) echo "claude-session: stop: unrecognised flag '$arg' (cl stop --help)" >&2; exit 1 ;;
    esac
  done
  # AFTER the flags: help must answer before any runtime prerequisite does.
  command -v jq >/dev/null 2>&1 || { echo "claude-session: stop needs jq (brew install jq)" >&2; exit 1; }
  # No precondition here. "No tmux server" stopped meaning "nothing to stop"
  # the moment sessions began running without tmux, and every cheap substitute
  # (is any process named claude alive?) fails the same way: it cannot know
  # every launch shape, and its failure direction is the unsafe one — report
  # success having saved nothing and stopped nothing. Session discovery is the
  # only thing that actually knows, so let it decide.

  # Also close each killed session's iTerm tab, unless opted out or not in iTerm.
  local close_tabs=0
  [ "$keep_tabs" = "0" ] && iterm_running && close_tabs=1

  # A dry run must leave no trace — no state.json, no history snapshot — so a
  # real `cl stop` afterwards still behaves like the first one.
  if [ -n "$dry_run" ]; then
    printf '[dry-run] would snapshot live sessions to %s (not written)\n\n' "$STATE" >&2
  else
    save_state || exit 1
    local count; count=$(jq 'length' "$STATE" 2>/dev/null || echo 0)
    printf 'saved %s session(s) to %s\n\n' "$count" "$STATE"
  fi

  local name t hrc rrc kept=0 nohandoff=0 kept_names="" resume_only="" unresolved_names="" left_names=""
  # Rotation accounting for the log. `sess_rotate` is decided PER SESSION, since
  # the stored policy can carry per-session overrides, so the mode recorded for
  # the whole stop is "mixed" when they disagreed — a week containing a mixed
  # stop is not a clean A/B sample and `cl rotate stats` says so.
  local sess_rotate sess_src log_mode="" log_src="" n_sessions=0 n_handoffs=0 n_ronly=0 ctxs=""
  # Validated ONCE for the whole stop, not once per session: the complaint is
  # about the environment, not about any particular session, and repeating it per
  # row would bury the sessions it sits between.
  local env_rotate; env_rotate=$(rotate_env_value)
  if [ -n "${CL_ROTATE:-}" ] && [ -z "$env_rotate" ]; then
    printf 'claude-session: ignoring CL_ROTATE="%s" (expected 0/1, on/off, no/yes, or a mode: compact-resume, handoff, fresh, resume) — using the stored setting\n' "$CL_ROTATE" >&2
  fi
  # The serial stop divided one budget BETWEEN sessions; this one shares a
  # window between them, so a per-session floor has nothing left to describe.
  # Said out loud rather than ignored, because silently dropping a variable
  # somebody exported is how a machine quietly stops behaving as configured.
  if [ -n "${CL_HANDOFF_MIN_SHARE:-}" ]; then
    printf 'claude-session: CL_HANDOFF_MIN_SHARE=%s no longer applies — handoffs are now asked in parallel, so every session gets the whole CL_HANDOFF_TIMEOUT window (%ss)\n' \
      "$CL_HANDOFF_MIN_SHARE" "$CL_HANDOFF_TIMEOUT" >&2
  fi
  # Resolved once for the whole stop so --no-handoff can clear a stale handoff
  # without every session re-resolving the store in a subshell.
  _CL_STOP_ROOT=""
  if [ -z "$dry_run" ]; then handoff_root >/dev/null && _CL_STOP_ROOT="$_CL_HANDOFF_ROOT"; fi

  # ── WHY THIS IS THREE PASSES AND NOT ONE LOOP ───────────────────────────────
  #
  # It used to be one loop: ask a session, WAIT for it, kill it, next. Waiting is
  # the expensive part and it was serial, so the cost of a stop was
  # `sessions × share` in wall clock while each session's share was
  # `budget / sessions` — both numbers moving the wrong way as sessions
  # accumulate. On 2026-10-07, nineteen sessions over a 300s budget came to 15s
  # each, floored to 45s, which exhausted the budget after six; the other twelve
  # were never asked at all. Raising the budget to give all nineteen a real
  # window would have meant 19 × 90s = 28 minutes of a human watching a terminal.
  #
  # Sending is cheap and writing is concurrent, so the asks go out together and
  # the waits overlap:
  #
  #   1. PLAN      — resolve every session's rotation policy. Nothing sent.
  #   2. BROADCAST — ask every eligible session, in one pass, no waiting.
  #   3. WAIT      — ONE shared window, polling all of them.
  #   4. CONFIRM   — check which files actually landed, then close.
  #
  # Nineteen sessions now cost roughly `sends + one window`, and every one of
  # them gets the FULL window instead of a nineteenth of the budget. It also
  # fixes the busy case properly: a queued ask has the whole window to come due
  # instead of burning a 45s share while the agent finishes something else.
  #
  # Nothing is killed before pass 4, so a Ctrl-C during the wait loses no
  # session — the old shape had already killed everyone asked before it.

  # `discover | while` would run the loop in a SUBSHELL, so nothing it counted
  # could be reported afterwards. Read from a process substitution instead —
  # the kept tally below is the whole point of failing closed: a stop that
  # silently leaves three sessions running is no better than one that silently
  # kills them unhandoffed.
  local _rows; _rows="$(discover)"

  # ── PASS 1: PLAN ────────────────────────────────────────────────────────────
  # One slot per session, carrying everything the later passes need. Parallel
  # indexed arrays rather than one associative array because macOS ships bash
  # 3.2, which has no `declare -A`.
  local -a _h_name _h_sid _h_cwd _h_tmux _h_agent _h_rot _h_state _h_path _h_nonce _h_mark _h_line
  # The compact-resume slots, and the outcome every session ends with:
  #   _h_taken  the path actually taken (compact-resume|handoff|fresh|resume|kept)
  #   _h_why    a short reason code for the log
  #   _h_cbase  the baseline transcript mark (PASS 1's "byte size")
  #   _h_ctok   this cycle's cl-done token
  #   _h_cstate await_token | await_boundary | compacted | resume
  #   _h_cauto  1 once a boundary appeared before /compact was typed
  #   _h_cmark  the mark taken just before typing /compact
  #   _h_clastsz the size seen on the previous poll (the stability check)
  #   _h_cbid/_h_cpre/_h_cpost  the confirming boundary's uuid and token figures
  #   _h_cidle  1 once the transcript proves the session at rest since then
  local -a _h_taken _h_why _h_cbase _h_ctok _h_cstate _h_cauto _h_cmark _h_clastsz _h_cbid _h_cpre _h_cpost _h_cidle
  # _h_cmode  a Codex session's mode for this stop (resume|fresh); empty for
  #           Claude, whose mode is _h_rot. Kept apart so a Codex row stays out
  #           of every handoff, compaction and log decision _h_rot drives.
  local -a _h_cmode
  # SEPARATE COUNTERS, because one number cannot answer three questions and the
  # transcript was mixing them (Codex, PR #19): _eligible is every rotation-on
  # session, _manual those already answered by hand, _to_ask what will actually
  # be dispatched, _sent what was, and _done what landed during THIS run.
  local _n=0 i _eligible=0 _manual=0 _to_ask=0 _sent=0 sid cwd epoch agent
  local _notlive=""
  while IFS=$'\t' read -r name sid cwd epoch agent; do
    case "$agent" in claude|codex) ;; *) continue ;; esac
    # ONLY SESSIONS THAT ARE RUNNING. Discovery lists every transcript, live or
    # not, and this used to plan for all of them: a session closed weeks ago was
    # "asked" for a handoff it could not write, counted in "asking N", retired
    # as a no-op and logged as stopped in the rotation stats — while
    # save_state, by the same rule, never saved it, so it would not have come
    # back anyway. One rule decides both now (session_is_live), so a stop asks
    # exactly the sessions it is going to save.
    #
    # Except a Codex thread with any TRACE of a client — a tmux session at its
    # name, or a process matching its id. That is not proof cl owns it (so it is
    # not saved), but retire_session must still see it, because that is what says
    # "left it — not cl's to kill" instead of letting a running thread pass
    # unremarked. Codex rows are never asked for a handoff, so planning one asks
    # nothing.
    if ! session_is_live "$name" "$sid" "$agent"; then
      if [ "$agent" = "codex" ] && { tmux has-session -t "=$(tmux_name "$name" codex)" 2>/dev/null \
           || [ -n "$(session_pid "$sid" codex "$name")" ]; }; then
        :
      else
        # Named for Claude only. Discovery lists EVERY stored Codex thread, and
        # naming dozens of dormant ones on each stop is the noise retire_session
        # was written to avoid.
        [ "$agent" = "claude" ] && _notlive="${_notlive}${_notlive:+, }${name}"
        continue
      fi
    fi
    # Resolve the policy for THIS session. A flag on the command outranks
    # everything, because it is the most explicit thing the operator can say;
    # below that, CL_ROTATE for a one-off, then the stored setting.
    stop_rotate_resolve "$name" "$agent" "$no_handoff" "$require_handoff" "$env_rotate"
    # A fresh replacement launched by an earlier start and running verified is
    # finished before this stop records anything, so its transaction cannot
    # outlive the cycle it belonged to.
    [ "$agent" = "codex" ] && [ -z "$dry_run" ] && codex_fresh_settle "$name" "$sid" 2>/dev/null
    _h_name[$_n]="$name"; _h_sid[$_n]="$sid"; _h_cwd[$_n]="$cwd"
    _h_tmux[$_n]="$(tmux_name "$name" "$agent")"; _h_agent[$_n]="$agent"
    _h_rot[$_n]="$_STOP_ROTATE"
    _h_state[$_n]="idle"; _h_path[$_n]=""; _h_nonce[$_n]=""
    # SOURCE is tracked per session, independently of mode. Folding it into the
    # mode comparison hid the case this exists to catch: with the default on and
    # one session explicitly overridden to on, every effective mode is "on", so
    # the row recorded whichever source happened to come first in discovery
    # order — and a week containing a deliberate override was reported as a
    # clean A/B sample. (Codex review, 2026-10-01.)
    if [ "$_STOP_ROTATE" != "n/a" ]; then
      n_sessions=$((n_sessions+1))
      if [ -z "$log_src" ]; then log_src="$_STOP_ROTATE_SRC"
      elif [ "$log_src" != "$_STOP_ROTATE_SRC" ]; then log_src="mixed"; fi
      if [ -z "$log_mode" ]; then log_mode="$_STOP_ROTATE"
      elif [ "$log_mode" != "$_STOP_ROTATE" ]; then log_mode="mixed"; fi
    fi
    _h_taken[$_n]=""; _h_why[$_n]=""; _h_cbase[$_n]=""; _h_ctok[$_n]=""; _h_cstate[$_n]=""
    _h_cauto[$_n]=0; _h_cmark[$_n]=""; _h_clastsz[$_n]=""; _h_cbid[$_n]=""; _h_cpre[$_n]=""; _h_cpost[$_n]=""
    _h_cidle[$_n]=0
    _h_cmode[$_n]=""
    [ "$agent" = "codex" ] && _h_cmode[$_n]=$(codex_stop_mode "$name" "$no_handoff" "$env_rotate")
    _n=$((_n+1))
  done <<< "$_rows"
  # Said once, so a session the operator expected back is not a silent surprise.
  [ -n "$_notlive" ] && printf 'not running, so left as they are (reopen with `cl "<name>"`): %s\n\n' "$_notlive" >&2

  # ── PASS C: COMPACT (compact-resume sessions) ───────────────────────────────
  # Spec steps 2-5 of docs/restart-modes.md, for every compacting session at
  # once under ONE CL_COMPACT_TIMEOUT window. It runs BEFORE the handoff
  # broadcast because one of its outcomes — no token in time — is a fallback to
  # a handoff, and those sessions then join that broadcast like any other.
  _stop_compact_phase

  # A HAND-WRITTEN HANDOFF IS ALREADY AN ANSWER, and it is discovered HERE —
  # after the compact phase, so a session that fell back to a handoff is counted
  # too, and before any handoff is asked for, so the count announced below is
  # true. It is how you satisfy this when the pane cannot be reached at all
  # (`cl handoff`, run inside the session). Its AGE is printed prominently,
  # because the one real hazard is acting on something written weeks ago and
  # forgotten.
  for (( i=0; i<_n; i++ )); do
    [ "${_h_rot[$i]}" = "handoff" ] || continue
    _eligible=$(( _eligible + 1 ))
    if [ -z "$dry_run" ] && [ -n "$_CL_STOP_ROOT" ]; then
      _h_path[$i]="$(handoff_path "$_CL_STOP_ROOT" "${_h_name[$i]}")"
      if handoff_is_manual "${_h_path[$i]}"; then
        printf '✓ using the handoff you wrote by hand for "%s" — written %s ago (%s)\n' \
          "${_h_name[$i]}" "$(handoff_age_human "${_h_path[$i]}")" "${_h_path[$i]}" >&2
        _h_state[$i]="manual"; _manual=$(( _manual + 1 ))
      fi
    fi
  done
  _to_ask=$(( _eligible - _manual ))

  # ── PASS 2: BROADCAST ───────────────────────────────────────────────────────
  local _pending=0 _done=0 nonce prompt _announce=0
  # Explicit rather than `a || b && c`: bash gives || and && equal precedence and
  # parses left to right, so that form means (a || b) && c — which happened to
  # be right here and would stop being right the moment anyone added a clause.
  _announce=0
  if [ -n "$dry_run" ]; then
    [ "$_eligible" -gt 0 ] && _announce=1
  else
    [ "$_to_ask" -gt 0 ] && _announce=1
  fi
  if [ "$_announce" = "1" ]; then
    # SAID UP FRONT, which is the whole point. The number that matters now is
    # how long the stop may take, not how thin each session's slice is.
    # Deliberately NOT the words "waiting up to": that phrase belongs to the
    # round line below and nowhere else, so "how many waits did this stop do?"
    # stays answerable from the transcript — by a reader and by the tests.
    printf '⏳ asking %s session(s) for a handoff, all at once — then ONE shared window of up to %ss\n' \
      "$( [ -n "$dry_run" ] && echo "$_eligible" || echo "$_to_ask" )" "$CL_HANDOFF_TIMEOUT" >&2
    # Counted but NOT asked, said separately rather than folded into the number
    # above — "asking 12" when three were already answered by hand is a
    # transcript that misleads the next reader.
    [ "$_manual" -gt 0 ] && printf '   (%s more already answered by hand, not asked)\n' "$_manual" >&2
    if [ -z "$dry_run" ] && [ -z "$_CL_STOP_ROOT" ]; then
      printf 'ℹ no durable location available to hand off (handoff dir and fallback both unusable) — plain stop for all %s\n' \
        "$_eligible" >&2
    fi
  fi
  for (( i=0; i<_n; i++ )); do
    [ "${_h_rot[$i]}" = "handoff" ] || continue
    if [ -n "$dry_run" ]; then
      # Preview ONLY, via the read-only resolver: resolving the real root means
      # mkdir + a write probe, and a dry run must do neither. (Found in Codex
      # review, 2026-09-23 — the original order built the real path first, so
      # `cl stop --dry-run` could still create handoff directories.)
      printf '[dry-run] would ask "%s" to write handoff to %s (via %s)\n' \
        "${_h_name[$i]}" "$(handoff_path_preview "${_h_name[$i]}")" \
        "$( [ -n "${_h_tmux[$i]}" ] && tmux has-session -t "=${_h_tmux[$i]}" 2>/dev/null && echo tmux || echo iterm )" >&2
      continue
    fi
    if [ -z "$_CL_STOP_ROOT" ]; then _h_state[$i]="unreachable"; continue; fi
    # Already answered by hand — found and reported during planning.
    [ "${_h_state[$i]}" = "manual" ] && continue
    # A prior handoff still sitting here is LEFT ALONE while we ask for a new
    # one. Sweeping it first destroyed a valid answer to buy nothing: the wait
    # below cannot be fooled by it, because it matches THIS attempt's nonce in
    # the terminal marker, and the agent's temp-file-then-rename replaces it
    # atomically only when the new handoff is complete — so if every attempt
    # fails, the last known-good answer is still there.
    nonce="$(handoff_nonce)"
    prompt="$(build_handoff_ask "$_CL_STOP_ROOT" "${_h_name[$i]}" "$nonce")"
    _h_mark[$i]="$(handoff_ask_mark "${_h_sid[$i]}")"; _h_line[$i]="$prompt"
    if handoff_send_once "${_h_name[$i]}" "${_h_sid[$i]}" "${_h_tmux[$i]}" "$prompt"; then
      _h_nonce[$i]="$nonce"; _h_state[$i]="pending"; _pending=$((_pending+1)); _sent=$((_sent+1))
      printf '  → asked "%s" for %s\n' "${_h_name[$i]}" "${_h_path[$i]}" >&2
    else
      # Unreachable is not a timing problem, so retrying cannot fix it — report
      # it as "could not even ask" rather than re-sending into nothing.
      printf 'ℹ no reachable pane to hand off "%s" (not tmux, not a tagged iTerm tab)\n' \
        "${_h_name[$i]}" >&2
      _h_state[$i]="unreachable"
    fi
  done

  # ── PASS 2b: DID EACH ASK ARRIVE WHOLE? ─────────────────────────────────────
  # Checked after the whole dispatch rather than per send, so the check costs
  # one short shared window instead of one per session. See build_handoff_ask.
  # The retypes are confirmed together too: per-session confirmation cost one
  # window per unseen session, outside the budget (Codex review, PR #26).
  if [ -z "$dry_run" ] && [ "$_pending" -gt 0 ]; then
    handoff_poll_marks
    local _resent=0 _m _rrc
    for (( i=0; i<_n; i++ )); do
      [ "${_h_state[$i]}" = "pending" ] && [ -n "${_h_mark[$i]:-}" ] || continue
      _m=$(handoff_ask_resend "${_h_name[$i]}" "${_h_sid[$i]}" "${_h_tmux[$i]}" "${_h_line[$i]}"); _rrc=$?
      case "$_rrc" in
        0) _h_mark[$i]="$_m"; _resent=$((_resent+1)) ;;
        1) printf 'ℹ "%s" became unreachable before its handoff landed\n' "${_h_name[$i]}" >&2
           _h_state[$i]="unreachable"; _pending=$((_pending-1)); _h_mark[$i]="" ;;
        *) _h_mark[$i]="" ;;   # busy: its ask is queued, not lost
      esac
    done
    if [ "$_resent" -gt 0 ]; then
      handoff_poll_marks
      for (( i=0; i<_n; i++ )); do
        [ "${_h_state[$i]}" = "pending" ] && [ -n "${_h_mark[$i]:-}" ] || continue
        printf '⚠ could not confirm that "%s" received the handoff ask — waiting for its handoff anyway\n' "${_h_name[$i]}" >&2
        _h_mark[$i]=""
      done
    fi
  fi

  # ── PASS 3: ONE SHARED WAIT ─────────────────────────────────────────────────
  # The budget is now wall clock for the whole handoff phase rather than a pool
  # divided between sessions, which is both the simplification and the fix.
  local round=1 budget_left="$CL_HANDOFF_BUDGET" window elapsed nextnote waiting_names
  while [ "$_pending" -gt 0 ] && [ "$round" -le "$CL_HANDOFF_ATTEMPTS" ]; do
    window="$CL_HANDOFF_TIMEOUT"
    [ "$window" -gt "$budget_left" ] && window="$budget_left"
    if [ "$window" -le 0 ]; then
      printf '⏭ the %ss handoff budget for this stop is spent — not waiting further for %s session(s); they will resume as-is\n' \
        "$CL_HANDOFF_BUDGET" "$_pending" >&2
      break
    fi
    printf '⏳ waiting up to %ss for %s handoff(s) — round %s of %s\n' \
      "$window" "$_pending" "$round" "$CL_HANDOFF_ATTEMPTS" >&2
    elapsed=0; nextnote=30
    while [ "$elapsed" -lt "$window" ] && [ "$_pending" -gt 0 ]; do
      sleep 1; elapsed=$((elapsed+1))
      for (( i=0; i<_n; i++ )); do
        [ "${_h_state[$i]}" = "pending" ] || continue
        # THIS attempt's nonce, not just "any change" — see handoff_nonce's
        # comment for the two races a plain content hash still missed. The nonce
        # must be the file's terminal MARKER, not merely present somewhere in
        # it: that is what distinguishes a COMPLETE handoff from one cut off
        # after the agent happened to mention the token.
        if [ -e "${_h_path[$i]}" ] && [ "$(handoff_marker "${_h_path[$i]}" 2>/dev/null)" = "${_h_nonce[$i]}" ]; then
          _h_state[$i]="done"; _done=$((_done+1)); _pending=$((_pending-1))
          rm -f "$(handoff_request_path "$_CL_STOP_ROOT" "${_h_name[$i]}")" 2>/dev/null
          printf '✓ handoff written for "%s" (%s of %s, %ss in)\n' \
            "${_h_name[$i]}" "$_done" "$_sent" "$elapsed" >&2
        fi
      done
      # Progress, so a multi-minute wait is legible rather than a dead prompt.
      if [ "$elapsed" -ge "$nextnote" ] && [ "$_pending" -gt 0 ]; then
        waiting_names=""
        for (( i=0; i<_n; i++ )); do
          [ "${_h_state[$i]}" = "pending" ] || continue
          waiting_names="${waiting_names}${waiting_names:+, }${_h_name[$i]}"
        done
        printf '   … %ss in, still writing: %s\n' "$elapsed" "$waiting_names" >&2
        nextnote=$((nextnote+30))
      fi
    done
    budget_left=$((budget_left - elapsed))
    [ "$budget_left" -lt 0 ] && budget_left=0
    round=$((round+1))
    # A further round is for an ask that did not LAND. It cannot help an agent
    # that is simply still working, and it actively harms it: a busy claude
    # QUEUES typed input and runs it when it finishes — proven 2026-10-07 by
    # injecting into a working session, which showed "Press up to edit queued
    # messages" and executed nothing until the current task ended. Re-typing
    # stacked three copies in one input box and changed nothing about when the
    # handoff landed.
    if [ "$_pending" -gt 0 ] && [ "$round" -le "$CL_HANDOFF_ATTEMPTS" ] && [ "$budget_left" -gt 0 ]; then
      for (( i=0; i<_n; i++ )); do
        [ "${_h_state[$i]}" = "pending" ] || continue
        if handoff_target_busy "${_h_tmux[$i]}" "${_h_sid[$i]}" "${_h_name[$i]}"; then
          printf '⏳ "%s" is still working — its handoff request is QUEUED, not lost; waiting without re-asking\n' \
            "${_h_name[$i]}" >&2
          continue
        fi
        # A FRESH nonce per attempt THAT ACTUALLY SENDS. Reusing one would let a
        # late answer to round 1 be counted as confirmation of round 3 — the
        # same stale-artifact confusion the nonce exists to prevent. The
        # no-resend path above deliberately keeps the nonce it is already
        # waiting on, because that is the request still in flight.
        nonce="$(handoff_nonce)"
        prompt="$(build_handoff_ask "$_CL_STOP_ROOT" "${_h_name[$i]}" "$nonce")"
        if handoff_send_checked "${_h_name[$i]}" "${_h_sid[$i]}" "${_h_tmux[$i]}" "$prompt"; then
          _h_nonce[$i]="$nonce"
          printf '  → re-asked "%s" (round %s)\n' "${_h_name[$i]}" "$round" >&2
        else
          printf 'ℹ "%s" became unreachable before its handoff landed\n' "${_h_name[$i]}" >&2
          _h_state[$i]="unreachable"; _pending=$((_pending-1))
        fi
      done
    fi
  done
  # Anything still pending ran out of rounds or budget.
  for (( i=0; i<_n; i++ )); do
    if [ "${_h_state[$i]}" = "pending" ]; then
      _h_state[$i]="timeout"
      printf '⚠ no handoff from "%s" after %s round(s)\n' "${_h_name[$i]}" "$((round-1))" >&2
      _pending=$((_pending-1))
    fi
  done
  # The denominator is what was ASKED, not what was eligible: mixing in manual
  # answers and unreachable panes made "N of N landed" unreadable.
  if [ "$_eligible" -gt 0 ] && [ -z "$dry_run" ]; then
    printf '\n%s of %s asked handoff(s) landed' "$_done" "$_sent" >&2
    [ "$_manual" -gt 0 ] && printf '; %s already answered by hand' "$_manual" >&2
    _unreach_n=0
    for (( i=0; i<_n; i++ )); do
      [ "${_h_state[$i]}" = "unreachable" ] && _unreach_n=$(( _unreach_n + 1 ))
    done
    [ "$_unreach_n" -gt 0 ] && printf '; %s unreachable' "$_unreach_n" >&2
    printf '.\n' >&2
  fi

  # ── PASS C2: IS EACH COMPACTED SESSION AT REST? ─────────────────────────────
  # Spec step 6. Checked here, right before the kills rather than when the
  # compaction was confirmed, because the handoff phase may have taken minutes
  # since. One shared pause for the size-stability half, not one per session.
  if [ -z "$dry_run" ]; then
    local -a _c_sz1=()
    local _c_any=0
    for (( i=0; i<_n; i++ )); do
      [ "${_h_taken[$i]}" = "compact-resume" ] || continue
      _c_sz1[$i]=$(_mark_size "${_h_cbase[$i]}"); _c_any=1
    done
    if [ "$_c_any" = "1" ]; then
      sleep "${CL_COMPACT_IDLE_POLL:-1}"
      for (( i=0; i<_n; i++ )); do
        [ "${_h_taken[$i]}" = "compact-resume" ] || continue
        [ "$(_mark_size "${_h_cbase[$i]}")" = "${_c_sz1[$i]}" ] || continue
        # A session that compacted on its own is at rest once its turn has
        # ended with the token; one that ran /compact, once "Compacted" (or the
        # compaction's SessionStart hook) is the last thing it wrote.
        if [ "${_h_cauto[$i]}" = "1" ]; then
          compact_idle_record "${_h_cbase[$i]}" "${_h_ctok[$i]}" && _h_cidle[$i]=1
        else
          compact_idle_record "${_h_cmark[$i]}" && _h_cidle[$i]=1
        fi
      done
    fi
  fi

  # ── PASS 4: CONFIRM, THEN CLOSE ─────────────────────────────────────────────
  local sid_i _unreach_n mode_rows="" log_paths="" log_whys="" log_pre="" log_post="" _idle _lp_sep=""
  # _log_session <i>: append one session to the log's per-session lists. An
  # empty figure stays an empty field — never dropped — so position N in every
  # list is the same session.
  _log_session() {
    log_paths="${log_paths}${_lp_sep}${_h_taken[$1]}"; log_whys="${log_whys}${_lp_sep}${_h_why[$1]}"
    log_pre="${log_pre}${_lp_sep}${_h_cpre[$1]}"; log_post="${log_post}${_lp_sep}${_h_cpost[$1]}"
    _lp_sep=","
  }
  for (( i=0; i<_n; i++ )); do
    name="${_h_name[$i]}"; sid_i="${_h_sid[$i]}"; t="${_h_tmux[$i]}"
    agent="${_h_agent[$i]}"; sess_rotate="${_h_rot[$i]}"; _idle=0
    if [ -n "$dry_run" ]; then
      if [ "$agent" = "codex" ]; then
        printf '[dry-run] would evaluate and, if not left running, kill "%s" (codex, mode %s)\n' "$name" "${_h_cmode[$i]}" >&2
      else
        printf '[dry-run] would evaluate and, if not left running, kill "%s" (rotation %s)\n' "$name" "$sess_rotate" >&2
      fi
      continue
    fi
    if [ "$sess_rotate" != "n/a" ]; then
      # Read BEFORE the session is killed: afterwards the transcript stops
      # growing, but this is the figure that matters — what this session had
      # grown to, i.e. what each further call would have carried on a resume.
      # After a compaction it is still the PRE-compaction figure (no call has
      # run since), which is why the log takes pre/postTokens from the boundary.
      ctxs="$ctxs $(context_size "$sid_i" "$agent")"
    fi
    # Rotation is a Claude mechanism: a Codex row is stopped and resumed as
    # itself, so it skips the whole handoff block rather than being asked for
    # something it has no way to produce.
    #
    # EVERY mode is named here. This used to be `n/a | off | else`, and with the
    # vocabulary widened an unmapped value would have fallen into the handoff
    # branch and been reported as a failed handoff.
    case "$sess_rotate" in
      n/a) : ;;
      resume|fresh|compact-resume)
        # A skip has to be DURABLE, not inferred from absence. An earlier
        # handoff may still be sitting there from a previous cycle, and leaving
        # it would make the next `cl start` rotate — the exact opposite of what
        # every one of these modes promises. Clear it so the promise is true.
        if [ -n "$_CL_STOP_ROOT" ] && [ -f "$(handoff_path "$_CL_STOP_ROOT" "$name")" ]; then
          consume_handoff "$_CL_STOP_ROOT" "$name" "this session's mode is $sess_rotate, so it does not rotate" >/dev/null
        fi
        if [ "$sess_rotate" = "fresh" ]; then
          _h_taken[$i]="fresh"; [ -n "${_h_why[$i]}" ] || _h_why[$i]="ok"
        else
          # Recorded on the row as well, so a clear that failed cannot quietly
          # turn an explicit skip back into a rotation. A compacted session is
          # resume-only too: it comes back by --resume, with a first prompt.
          resume_only="${resume_only}${name}"$'\n'
          n_ronly=$((n_ronly+1))
          [ -n "${_h_taken[$i]}" ] || _h_taken[$i]="resume"
          [ -n "${_h_why[$i]}" ] || _h_why[$i]="ok"
          [ "${_h_taken[$i]}" = "compact-resume" ] && [ "${_h_cidle[$i]}" = "1" ] && _idle=1
        fi
        ;;
      handoff)
      # The handoff is an OPTIMISATION and the plain resume is the floor, so a
      # failed handoff is loud, not fatal: `cl stop` still stops. Refusing
      # instead would redefine the one command you run before a reboot, and
      # would refuse hardest on the wedged session you most need gone.
      # `--require-handoff` opts into the strict behaviour.
      case "${_h_state[$i]}" in
        done|manual) hrc=0 ;;
        unreachable) hrc=1 ;;
        *)           hrc=2 ;;
      esac
      local _why_h
      case "${_h_state[$i]}" in
        done) _why_h="ok" ;; manual) _why_h="manual" ;; unreachable) _why_h="unreachable" ;; *) _why_h="no-handoff" ;;
      esac
      # A fallback from compact-resume keeps its first reason in front.
      _h_why[$i]="${_h_why[$i]:+${_h_why[$i]}+}${_why_h}"
      if [ "$hrc" -ne 0 ]; then
        if [ "$require_handoff" = "1" ]; then
          printf '✋ leaving "%s" running — --require-handoff was given and no handoff arrived.\n' "$name" >&2
          printf '   · run `cl handoff` INSIDE that session, then `cl stop` again\n' >&2
          printf '   · or plain `cl stop` to stop it and resume it as-is next time\n' >&2
          kept=$((kept+1)); kept_names="${kept_names}${name}"$'\n'
          _h_taken[$i]="kept"
          _log_session "$i"
          continue
        fi
        printf '⚠ no handoff from "%s" — stopping it anyway; `cl start` will RESUME it, not rotate it\n' "$name" >&2
        # And make that true: any OLDER handoff still sitting there would
        # otherwise be rotated from on the next start, contradicting the line
        # just printed.
        resume_only="${resume_only}${name}"$'\n'
        nohandoff=$((nohandoff+1)); n_ronly=$((n_ronly+1))
        _h_taken[$i]="resume"
      else
        n_handoffs=$((n_handoffs+1))
        _h_taken[$i]="handoff"
      fi
      ;;
      *)
        # Unreachable while _mode_normalize is the only way a mode gets here;
        # said out loud rather than guessed at if that ever stops being true.
        printf '⚠ "%s" has an unknown mode "%s" — stopping it and resuming it as-is\n' "$name" "$sess_rotate" >&2
        resume_only="${resume_only}${name}"$'\n'; n_ronly=$((n_ronly+1))
        _h_taken[$i]="resume"; _h_why[$i]="unknown-mode"
        ;;
    esac
    # The mode actually carried out goes on the saved row, by agent AND name,
    # so `cl start` does what this stop did rather than re-deriving it.
    # (A session left running is not recorded: its stop carried nothing out.)
    if [ "$agent" = "claude" ] && [ "${_h_taken[$i]}" != "kept" ]; then
      mode_rows="${mode_rows}${agent}"$'\t'"${name}"$'\t'"${_h_taken[$i]}"$'\t'"${_h_cbid[$i]:--}"$'\n'
    elif [ "$agent" = "codex" ] && [ -n "${_h_cmode[$i]}" ]; then
      mode_rows="${mode_rows}${agent}"$'\t'"${name}"$'\t'"${_h_cmode[$i]}"$'\t-\n'
    fi
    [ "$sess_rotate" != "n/a" ] && _log_session "$i"
    # retire_session covers both branches (tmux-hosted and bare process)
    # with the busy-check-and-prompt, tab/surface cleanup, the hidden-tmux
    # ownership guard, and the Codex ownership rules — do_stop just runs it and
    # collects what it left. Anything cl manages that is still running when
    # stop returns — a declined busy session, a slow or failed shutdown, an
    # owner cl cannot tie to a session — fails the stop, so a script can trust
    # exit 0 to mean "everything cl manages is stopped" (owner decision, 2026-11-03).
    # Code 4 is the one exception: not cl's to stop, so not this stop's failure.
    # $_idle is 1 only for a compacted session the transcript shows at rest —
    # the one case where the mid-task prompt would be asking about nothing.
    rrc=0; retire_session "$name" "$sid_i" "$t" "$close_tabs" "$agent" "$_idle" || rrc=$?
    case "$rrc" in
      3)   unresolved_names="${unresolved_names}${name}"$'\n' ;;
      1|2) left_names="${left_names}${name}"$'\n' ;;
    esac
    # Said here, at the moment it becomes true, because a fresh Codex session
    # does not come back as the thread that was just stopped.
    if [ "$rrc" = "0" ] && [ "${_h_cmode[$i]}" = "fresh" ]; then
      printf '✦ "%s" (codex) is fresh: `cl start` begins a new thread under its name and archives this one\n' "$name" >&2
    fi
  done

  [ -n "$dry_run" ] && return 0
  mark_resume_only "$resume_only"
  mark_row_modes "$mode_rows"
  # Logged whatever happened, including a stop that rotated nothing: a week of
  # "off" cycles is half the measurement, and a gap in the log would read as a
  # week with no work rather than a week without rotation.
  # The `|| :` is deliberate belt-and-braces, not noise. rotation_log_append
  # already always returns 0, but this line sits inside the function whose exit
  # status IS `cl stop`'s, so if it ever became the last statement a non-zero
  # return would tell a shutdown script the stop had failed. Two independent
  # guards, because the cost of this one being wrong is a machine that will not
  # shut down cleanly over a log file.
  { [ "$n_sessions" -gt 0 ] && rotation_log_append \
      "${log_mode:-resume}" "${log_src:-default}" "$n_sessions" "$n_handoffs" "$n_ronly" "$kept" \
      "$log_paths" "$log_whys" "$log_pre" "$log_post" $ctxs; } || :
  printf '\nstate saved. Run cl start to bring these back.\n' >&2
  if [ "$nohandoff" -gt 0 ]; then
    printf '\n%s session(s) stopped WITHOUT a handoff — `cl start` will resume those as they were\n' "$nohandoff" >&2
    printf 'rather than rotating them. Use `cl stop --require-handoff` if rotation is the point.\n' >&2
  fi
  if [ -n "$left_names" ]; then
    printf '\nleft running — declined, still shutting down, or could not be stopped:\n' >&2
    printf '%s' "$left_names" | sed '/^$/d; s/^/  · /' >&2
    printf 'They are in the saved state; re-run `cl stop` to retire them.\n' >&2
  fi
  if [ -n "$unresolved_names" ]; then
    printf '\nleft running — cl owns these but cannot prove which session each runs:\n' >&2
    printf '%s' "$unresolved_names" | sed '/^$/d; s/^/  · /' >&2
    printf 'They are in the saved state; close them by hand before `cl start`.\n' >&2
  fi
  if [ "$kept" -gt 0 ]; then
    printf '\n%s session(s) left running for want of a handoff:\n' "$kept" >&2
    printf '%s' "$kept_names" | sed '/^$/d; s/^/  · /' >&2
    printf 'They are in the saved state either way, so `cl start` brings them back.\n' >&2
    # Non-zero: a stop that did not stop everything must not look successful to
    # a script, a shutdown hook, or a glance at the exit status.
    return 1
  fi
  [ -z "$unresolved_names" ] && [ -z "$left_names" ]
}

# open_iterm_tabs <shell-command>...: open one real iTerm tab per command.
# Mirrors the manual flow — ⌘T, `cl`, pick the session — but creates ALL tabs
# in a SINGLE osascript invocation (one AppleScript session for the whole set)
# instead of one process per tab, which is markedly faster for a large working
# set. Returns non-zero if the AppleScript fails (not in iTerm, automation
# denied) so the caller can fall back to printing the commands.
#
# Takes whole COMMANDS rather than names: a rotating session's tab has to carry
# `--rotate-from <path>`, and rebuilding that here from a name would mean this
# function re-deciding something do_start already decided.
#
# That puts the AGENT FLAG on the caller too, and it is not optional: `cl
# <name>` refuses a name held by both agents, so a Codex session must be
# reopened as `cl --codex <name>` or the tab fails with an ambiguity error
# instead of starting anything. tab_cmd() below is the one place that decides.
open_iterm_tabs() {
  local cmd esc script
  script='tell application "iTerm"
  tell current window
'
  for cmd in "$@"; do
    # Escape backslashes then double-quotes for embedding in the AppleScript string.
    esc="${cmd//\\/\\\\}"; esc="${esc//\"/\\\"}"
    script+='    create tab with default profile
    tell current session to write text "'"$esc"'"
'
  done
  script+='  end tell
end tell'
  osascript >/dev/null 2>&1 <<OSA
$script
OSA
}

# mark_resume_only <newline-separated names>: record on the SAVED ROW that this
# session must come back by resuming, not rotating.
#
# Inferring the decision from "is there a handoff file?" is not good enough. Two
# cases break it: a stop whose handoff request failed can still leave an OLDER
# complete handoff sitting there, so the next start rotates from notes that
# predate everything the session did since — while `cl stop` has already printed
# that it would resume; and `--no-handoff`'s attempt to clear a pending handoff
# can itself fail, leaving the file and silently reversing an explicit choice.
#
# The row is the durable answer either way, so a clear that fails cannot change
# what happens next.
mark_resume_only() {
  local names="$1" tmp
  [ -n "${names//[[:space:]]/}" ] || return 0
  [ -r "$STATE" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  tmp="$STATE.mark.$$"
  if printf '%s' "$names" | sed '/^$/d' \
      | jq -R -s --slurpfile all "$STATE" \
          'split("\n") | map(select(length>0)) as $n
           | $all[0] | map(if (.name as $x | $n | index($x)) then .resume_only = true else . end)' \
        > "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
    mv "$tmp" "$STATE" 2>/dev/null || rm -f "$tmp"
  else
    rm -f "$tmp"
    printf '⚠ could not record resume-only on the saved rows — `cl start` may rotate a session that should resume\n' >&2
  fi
}

# tab_cmd <agent> <name>: the `cl …` command a restored session's tab runs.
#
# The agent flag is not cosmetic: `cl <name>` REFUSES a name held by both
# agents, so a Codex session reopened as a bare name fails with an ambiguity
# error instead of starting anything. One place decides it, because do_start
# builds this string on four different paths.
#
# Literal double quotes rather than %q: this text is re-escaped for AppleScript
# by open_iterm_tabs and is also printed verbatim as a copy-paste fallback, and
# `cl "My Name"` is what a human would type.
tab_cmd() {
  case "$1" in
    codex) printf 'cl --codex "%s"' "$2" ;;
    *)     printf 'cl "%s"' "$2" ;;
  esac
}

# rearm_coordination_lanes: after a start, ask the coordination watcher to
# re-elect itself. ALWAYS returns 0 — see below.
#
# ── WHY A START HAS TO DO THIS ──────────────────────────────────────────────
#
# A coordination watcher is elected by an agent's SessionStart hook, and
# SessionStart fires on a TURN, not on TUI resume. So `cl start` brings the
# session back and the watcher stays dead until somebody happens to type into
# it. On 2026-10-07 that cost two days: eighteen review requests queued behind a
# lane that reported a current heartbeat and the right directory, because the
# watcher had died at a reboot and nothing re-elected it. The next instance
# would be a week off, where "it looked fine" is discovered on return.
#
# ── WHY IT CANNOT FAIL A START ──────────────────────────────────────────────
#
# `cl start` is the command you run to get your work back. A start that refuses,
# or exits non-zero, because a background helper did not arm is worse than a
# start that says so and carries on — the sessions are the point and the watcher
# is an optimisation on top. So every path here returns 0, and the only
# consequence of trouble is a message.
#
# A SOFT dependency in both directions: this script is public and standalone,
# while the coordination watcher lives in a private repo, so its absence is the
# normal case and is silent. "No lanes declared" is silent too — most machines
# do not coordinate, and a warning that fires for everyone is one nobody reads.
#
# Bounded, because re-arming waits for a heartbeat per lane to prove the watcher
# is really running its loop, and an unbounded helper would turn `cl start` into
# something you cannot predict the length of.
rearm_coordination_lanes() {
  local script="${CL_COORD_REARM:-$HOME/.claude/scripts/coord-rearm.sh}"
  [ -x "$script" ] || return 0
  local tmp rc
  tmp="$(mktemp -t clrearm 2>/dev/null)" || return 0
  run_bounded "${CL_COORD_REARM_TIMEOUT:-90}" bash "$script" > "$tmp" 2>&1
  rc=$?
  if [ "$rc" = "124" ]; then
    printf '\n⚠ coordination re-arm timed out after %ss — your sessions are fine; run it yourself:\n    %s\n' \
      "${CL_COORD_REARM_TIMEOUT:-90}" "$script" >&2
  elif [ "$rc" = "0" ]; then
    # Only the verified lines: the helper is chatty about plumbing identifiers
    # that are deliberately not this session's, and repeating them here invites
    # exactly the confusion its own output warns about.
    if grep -q 'verified:' "$tmp" 2>/dev/null; then
      printf '\ncoordination lanes re-armed:\n'
      sed -n 's/^ *verified: /  ✓ /p' "$tmp"
    fi
  elif grep -q 'no lanes declared' "$tmp" 2>/dev/null; then
    : # this machine does not coordinate; nothing to say
  else
    printf '\n⚠ coordination re-arm reported a problem. Your sessions are fine; the lane is not:\n' >&2
    sed 's/^/  /' "$tmp" >&2
  fi
  rm -f "$tmp"
  return 0
}

# do_start: bring back every session in STATE — one real iTerm tab each,
# tmux-backed via `cl <name>`. First it ensures each session's tmux exists
# (detached), then opens a tab per session. Falls back to printing the commands
# when not in iTerm or osascript fails.
#
# ROTATION. Per session, the presence of an unconsumed handoff decides how it
# comes back:
#
#   handoff present  → consume it, start a NEW claude under the same name, and
#                      hand it the file as its first message. The expensive
#                      transcript is retired; the name, dir and reachability
#                      are not. The old session id goes to FRESH_HISTORY, so
#                      this is never a dead end.
#   no handoff       → `--resume <sid>`, exactly as before.
#
# That second line is what makes a failed or skipped handoff safe: `cl stop
# --no-handoff`, a session that could not be reached, a crash — all of them
# simply leave no file, and the session comes back whole. Rotation is the
# optimisation; resuming is the floor.
do_start() {
  command -v jq >/dev/null 2>&1 || { echo "claude-session: start needs jq (brew install jq)" >&2; exit 1; }
  [ -r "$STATE" ] || { echo "claude-session: no saved state ($STATE) — run 'cl stop' first" >&2; exit 1; }

  local n; n=$(jq 'length' "$STATE" 2>/dev/null || echo 0)
  [ "$n" -gt 0 ] || { echo "claude-session: saved state is empty" >&2; exit 1; }

  # Resolve the store ONCE for the whole run, the same discipline
  # request_handoff follows: a per-session $(handoff_root) would resolve in a
  # subshell and could pick a different root for two sessions started seconds
  # apart. An unusable store is not fatal here — it only means no session can
  # rotate, and every one of them still resumes.
  local root=""
  # stdout only — handoff_root's "falling back to…" notice belongs on screen
  # here as much as it does during a stop.
  handoff_root >/dev/null && root="$_CL_HANDOFF_ROOT"
  [ -n "$root" ] || echo "claude-session: no usable handoff store — resuming every session as-is (no rotation)" >&2

  # 1. Ensure each session's tmux exists (detached). `cl <name>` in each tab
  #    then attaches it. Creating here (not relying on the tab) means a failed
  #    tab still leaves a recoverable session. launch_session execs, so we
  #    replicate its create-detached form (incl. tmux_setup).
  use_tmux && tmux_setup
  # One pass, not two. The tab command is no longer always `cl <name>` — a
  # rotating session that has no tmux pane to pre-create has to carry its
  # consumed handoff through to the tab, and a Codex row has to carry --codex —
  # so the command is built in the same place those are decided, rather than
  # reconstructed from the name later. (It also means STATE is read once.)
  local name sid cwd agent ronly rmode rbid t i=0 claim cmd rsid_env kept="" cfresh ccompact cxfresh cxclaim cxrc osid nsid
  local -a tab_cmds=() _cr_t=() _cr_name=() _cr_sid=() _cr_cwd=()
  while IFS=$'\t' read -r name sid cwd agent ronly rmode rbid; do
    agent="${agent:-claude}"
    t=$(tmux_name "$name" "$agent")
    [ -d "$cwd" ] || cwd="$HOME"
    i=$((i+1))
    if ! use_tmux; then
      # Without tmux there is nothing to pre-create: each tab's `cl <name>`
      # execs the agent itself. Live ones get no tab — `cl stop` leaves busy
      # sessions running on purpose, and a tab for one would start a SECOND
      # agent on the same transcript. The row is kept so the next start picks
      # it up once it really is gone.
      if agent_live "$agent" "$sid" "$name"; then
        # The tab of an earlier start launched this fresh thread; now it can
        # be checked, and the replacement finished.
        if [ "$agent" = "codex" ] && codex_fresh_settle "$name" "$sid"; then
          printf '✓ %s is running on its new Codex thread %s\n' "$name" "$sid"
          codex_coord_note "$name" "$sid"
          continue
        fi
        printf '● %s already live\n' "$name"
        kept="${kept}${agent}"$'\t'"${name}"$'\n'
        continue
      fi
      # The launch happens in ANOTHER PROCESS here — the tab — so this one
      # cannot claim the handoff. "AppleScript accepted the text" is not "an
      # agent started"; consuming here would spend the handoff on a tab that
      # may never run. The tab command names the ACTIVE handoff and the child
      # claims it after acquire_launch grants ownership (see launch_fresh).
      #
      # The row is kept for every session a tab was opened for. That is
      # self-correcting: if the tab worked, the session is live and the next
      # `cl start` skips it; if it did not, the row and the handoff are both
      # still there and a re-run does the right thing.
      if [ "$agent" != "claude" ] && { [ "$rmode" = "fresh" ] || codex_txn_pending "$name"; }; then
        # The tab makes the new thread, as it does the launch: if the tab never
        # runs, nothing was archived and the row still names the old thread.
        # The old id travels with it, so a tab that runs late, after the name
        # has moved on, does not replace a thread nobody stopped.
        tab_cmds+=("$(tab_cmd "$agent" "$name") --restart-mode fresh $(printf '%q' "$sid")")
        printf '✦ %s will start as a new Codex thread\n' "$name"
      elif [ "$agent" != "claude" ]; then
        tab_cmds+=("$(tab_cmd "$agent" "$name")")
      elif [ "$rmode" = "compact-resume" ]; then
        # The MODE travels in the tab command, as --rotate-from does: the tab
        # is the process that launches, so it is the one that preflights. No
        # handoff is touched here, whatever sits in the store — none was asked
        # for this cycle (see compact_preflight).
        tab_cmds+=("$(tab_cmd "$agent" "$name") --restart-mode compact-resume $(printf '%q' "$rbid")")
        printf '⟳ %s will resume from its compaction\n' "$name"
      elif [ "$rmode" = "fresh" ]; then
        [ -n "$root" ] && [ -f "$(handoff_path "$root" "$name")" ] \
          && consume_handoff "$root" "$name" "this cycle was recorded as fresh" >/dev/null
        tab_cmds+=("$(tab_cmd "$agent" "$name") --restart-mode fresh")
        printf '✦ %s will start as a new session\n' "$name"
      elif [ "$ronly" = "true" ]; then
        [ -n "$root" ] && [ -f "$(handoff_path "$root" "$name")" ] \
          && consume_handoff "$root" "$name" "this cycle was recorded resume-only" >/dev/null
        tab_cmds+=("$(tab_cmd "$agent" "$name")")
      elif [ -n "$root" ] && handoff_is_complete "$(handoff_path "$root" "$name")"; then
        tab_cmds+=("$(tab_cmd "$agent" "$name") --rotate-from $(printf '%q' "$(handoff_path "$root" "$name")")")
        printf '↻ %s will start fresh from its handoff\n' "$name"
      else
        [ -n "$root" ] && [ -f "$(handoff_path "$root" "$name")" ] \
          && quarantine_handoff "$root" "$name" >/dev/null
        tab_cmds+=("$(tab_cmd "$agent" "$name")")
      fi
      kept="${kept}${agent}"$'\t'"${name}"$'\n'
      continue
    fi
    if tmux has-session -t "=${t}" 2>/dev/null; then
      # A fresh replacement whose launch was not yet verified is finished here
      # once it is: the row is then done with, like any started session.
      if [ "$agent" = "codex" ] && codex_fresh_settle "$name" "$sid"; then
        printf '✓ %s is running on its new Codex thread %s\n' "$name" "$sid"
        codex_coord_note "$name" "$sid"
        continue
      fi
      printf '● %s already live\n' "$name"
      kept="${kept}${agent}"$'\t'"${name}"$'\n'
      continue
    fi
    # tmux path: `tmux new-session -d` either creates the session or it does
    # not, and this process sees which — so the claim can be committed or
    # rolled back right here, against real acceptance.
    claim=""; rsid_env=""; cfresh=0; ccompact=0; cxfresh=0; cxclaim=0; osid="$sid"
    if [ "$agent" != "claude" ]; then
      # fresh: a NEW thread made, named and swapped in first (steps 1-3), then
      # resumed by id like any other, with a first prompt so its first turn
      # fires SessionStart. Any failure there has been undone, and this is the
      # plain resume of the old thread.
      if [ "$rmode" = "fresh" ] || codex_txn_pending "$name"; then
        # The whole swap runs under the per-name claim, so a second start
        # cannot run its own. Inside it the row is read again: while this one
        # waited, another start may have moved or consumed it.
        if ! codex_txn_claim "$name"; then
          kept="${kept}${agent}"$'\t'"${name}"$'\n'; continue
        fi
        cxclaim=1
        nsid=$(jq -r --arg n "$name" '[.[] | select((.agent // "claude") == "codex" and .name == $n)][0].sid // empty' "$STATE" 2>/dev/null)
        # Settled by the other start (mode no longer fresh, nothing pending):
        # the same outcome as a consumed row — that start owns this session.
        if [ -n "$nsid" ] && ! codex_txn_pending "$name" \
           && [ "$(jq -r --arg n "$name" '[.[] | select((.agent // "claude") == "codex" and .name == $n)][0].mode // empty' "$STATE" 2>/dev/null)" != "fresh" ]; then
          nsid=""
        fi
        if [ -z "$nsid" ]; then
          printf 'ℹ %s was started by another cl start meanwhile\n' "$name"
          codex_txn_release; continue
        fi
        sid="$nsid"; osid="$sid"
        nsid=$(codex_fresh_advance "$name" "$sid" "$cwd"); cxrc=$?
        case "$cxrc" in
          0) osid=$(_txn_get "$name" old_sid); sid="$nsid"; cxfresh=1
             cmd=$(resume_cmd "$agent" "$sid" "$name" "$(build_codex_fresh_prompt)") ;;
          1) sid="$nsid"; cmd=$(resume_cmd "$agent" "$sid" "$name"); codex_txn_release; cxclaim=0 ;;
          *) codex_txn_release; kept="${kept}${agent}"$'\t'"${name}"$'\n'; continue ;;
        esac
      else
        cmd=$(resume_cmd "$agent" "$sid" "$name")
      fi
      rsid_env="$sid"
    elif [ "$rmode" = "compact-resume" ]; then
      # Never a rotation, whatever the preflight says: no handoff was asked for
      # this cycle, so a handoff in the store predates it — the stale case
      # mark_resume_only guards against. A failed preflight resumes plainly.
      rsid_env="$sid"
      if compact_preflight "$sid" "$rbid"; then
        cmd=$(resume_cmd claude "$sid" "$name" "$(build_compact_resume_prompt)"); ccompact=1
      else
        printf '⚠ "%s" is not the session its stop compacted (transcript missing, or compacted again since) — resuming it plainly\n' "$name" >&2
        cmd=$(resume_cmd claude "$sid" "$name")
      fi
    elif [ "$rmode" = "fresh" ]; then
      # A NEW session under the name, with nothing to read: the fresh-start
      # machinery with an empty first prompt. A handoff left in the store is
      # filed, so it cannot rotate a later start.
      [ -n "$root" ] && [ -f "$(handoff_path "$root" "$name")" ] \
        && consume_handoff "$root" "$name" "this cycle was recorded as fresh" >/dev/null
      cmd=$(fresh_cmd "$name" ""); cfresh=1
    elif [ "$ronly" = "true" ]; then
      [ -n "$root" ] && [ -f "$(handoff_path "$root" "$name")" ] \
        && consume_handoff "$root" "$name" "this cycle was recorded resume-only" >/dev/null
      rsid_env="$sid"; cmd=$(resume_cmd claude "$sid" "$name")
    elif claim=$(claim_handoff "$root" "$name" "$sid"); then
      cmd=$(fresh_cmd "$name" "$(build_resume_prompt "$claim")")
    else
      claim=""; rsid_env="$sid"; cmd=$(resume_cmd claude "$sid" "$name")
    fi
    if tmux new-session -d -s "$t" -c "$cwd" "$(env_prefix "$name" "$rsid_env")$cmd"; then
      # Stamp it as cl's BEFORE anything else can look: a later `cl stop` kills
      # a Codex session only on this proof, and an unstamped one it created
      # itself would be left running forever.
      tmux_claim "$t" "$agent" "$sid"
      if [ -n "$claim" ]; then
        record_fresh_history "$name" "$sid" "$cwd"
        commit_claim "$root" "$name" "$claim" "rotating on start"
        printf '↻ prepared %s fresh from its handoff  (%s)\n' "$name" "$cwd"
      elif [ "$cfresh" = "1" ]; then
        record_fresh_history "$name" "$sid" "$cwd"
        printf '✦ prepared %s as a new session  (%s)\n' "$name" "$cwd"
      elif [ "$cxfresh" = "1" ]; then
        # Launched is not started: settled only once the pane holds codex on
        # the new id. Until then the transaction and the row both stay, and
        # the next start finishes (or relaunches) this same thread.
        _txn_put "$name" '{"phase":"launching"}' >/dev/null 2>&1
        _vw=0
        until codex_launch_verified "$name" "$sid" || [ "$_vw" -ge "$(( ${CL_RESUME_CHECK:-5} * 4 ))" ]; do sleep 0.25; _vw=$((_vw+1)); done
        if codex_launch_verified "$name" "$sid" && codex_fresh_finish "$name" "$sid"; then
          printf '✦ prepared %s as a new Codex thread %s; the old one is archived  (%s)\n' "$name" "$sid" "$cwd"
          codex_coord_note "$name" "$sid"
        elif codex_launch_verified "$name" "$sid"; then
          printf '⚠ %s: codex is running on its new thread %s, but the replacement could not be settled — kept for the next cl start\n' "$name" "$sid" >&2
          kept="${kept}${agent}"$'\t'"${name}"$'\n'
        else
          printf '⚠ %s: could not confirm codex is running on its new thread %s — kept for the next cl start\n' "$name" "$sid" >&2
          kept="${kept}${agent}"$'\t'"${name}"$'\n'
        fi
      elif [ "$ccompact" = "1" ]; then
        _cr_t+=("$t"); _cr_name+=("$name"); _cr_sid+=("$sid"); _cr_cwd+=("$cwd")
        printf '⟳ prepared %s from its compaction  (%s)\n' "$name" "$cwd"
      else
        printf '✓ prepared %s  (%s)\n' "$name" "$cwd"
      fi
      tab_cmds+=("$(tab_cmd "$agent" "$name")")
    else
      [ -n "$claim" ] && rollback_claim "$root" "$name" "$claim"
      # Steps 1-3 already happened: the old thread is archived (its way back
      # recorded then) and the row names the new one with the transaction
      # still pending, so a re-run resumes it rather than making a third.
      if [ "$cxfresh" = "1" ]; then
        printf '  (%s now names the new Codex thread %s; its old thread %s is archived — run: codex unarchive %s)\n' "$name" "$sid" "$osid" "$osid" >&2
      fi
      printf '✗ could not prepare %s — leaving it in the restart list\n' "$name" >&2
      kept="${kept}${agent}"$'\t'"${name}"$'\n'
    fi
    [ "$cxclaim" = "1" ] && codex_txn_release
  # mode and boundary use "-" for "none": tab is IFS whitespace to `read`, so an
  # empty field in the middle would shift the ones after it.
  done < <(jq -r '.[] | [.name, .sid, .cwd, (.agent // "claude"), (.resume_only // false),
                         (if (.mode // "") == "" then "-" else .mode end),
                         (if (.compact_boundary // "") == "" then "-" else .compact_boundary end)] | @tsv' "$STATE")

  # ── DID EACH RESUME-WITH-A-PROMPT STAY UP? ──────────────────────────────────
  # A first prompt is a new argument on a command that never carried one, so a
  # claude that refuses it must not cost the session. Polled once for all of
  # them, about CL_RESUME_CHECK seconds after launch; one that is gone is
  # resumed plainly and said so. Never rotated: no handoff was asked for.
  if [ "${#_cr_t[@]}" -gt 0 ]; then
    local _w=0 _j
    while [ "$_w" -lt "$(( ${CL_RESUME_CHECK:-5} * 4 ))" ]; do sleep 0.25; _w=$((_w+1)); done
    for (( _j=0; _j<${#_cr_t[@]}; _j++ )); do
      tmux has-session -t "=${_cr_t[$_j]}" 2>/dev/null && continue
      printf '⚠ "%s" did not stay up when resumed with its first prompt — resuming it plainly\n' "${_cr_name[$_j]}" >&2
      if tmux new-session -d -s "${_cr_t[$_j]}" -c "${_cr_cwd[$_j]}" \
           "$(env_prefix "${_cr_name[$_j]}" "${_cr_sid[$_j]}")$(resume_cmd claude "${_cr_sid[$_j]}" "${_cr_name[$_j]}")"; then
        tmux_claim "${_cr_t[$_j]}" claude "${_cr_sid[$_j]}"
        printf '✓ prepared %s (plain resume)\n' "${_cr_name[$_j]}"
      else
        printf '✗ could not prepare %s — leaving it in the restart list\n' "${_cr_name[$_j]}" >&2
        kept="${kept}claude"$'\t'"${_cr_name[$_j]}"$'\n'
      fi
    done
  fi

  # Snapshot consumed: archive a copy first (so a failed relaunch never loses
  # the list — restore from STATE_HISTORY_DIR), then keep exactly the rows this
  # start did NOT act on: the ones that looked live, and the ones whose launch
  # was refused. Everything else is really running and is done with.
  consume_state "$kept"

  # Open tabs only when THIS shell is iTerm-hosted (in_iterm). Inside a tmux
  # pane TERM_PROGRAM reads "tmux", so in_iterm is false there — cl start then
  # degrades to printing the commands instead of guessing a terminal to target.
  if [ "${#tab_cmds[@]}" -eq 0 ]; then
    printf '\nevery saved session is already live — nothing to open.\n'
    # STILL RE-ARMED. "Already live" describes the agent sessions, and says
    # nothing about the watcher that feeds their lanes — which is precisely the
    # state that looks healthiest and is not.
    rearm_coordination_lanes
    return 0
  fi

  local have_iterm=0
  in_iterm && have_iterm=1
  if [ "$have_iterm" = "1" ] && open_iterm_tabs "${tab_cmds[@]}"; then
    printf '\nopened %s iTerm tab(s).\n' "${#tab_cmds[@]}"
  else
    if [ "$have_iterm" = "1" ]; then
      printf '\n%s session(s) prepared, but the iTerm tab-open failed — run these manually:\n' "$i" >&2
    else
      printf '\n%s session(s) prepared. Not in iTerm (or no osascript) — open a tab and run:\n' "$i"
    fi
    for cmd in "${tab_cmds[@]}"; do printf '  %s\n' "$cmd"; done
  fi
  rearm_coordination_lanes
}

# consume_state <live-lines>: archive the snapshot, then keep only the rows
# start did NOT act on.
#
# Deleting the whole file treated "skipped because it looked live" as
# successfully handled. It is not: `agent_live` is deliberately optimistic, so a
# stale signal could drop a session from the restart set and the only way back
# was knowing to run `cl restore`. Rows that were skipped stay in the file, so
# the next `cl start` picks them up once they really are gone.
consume_state() {
  local kept line
  archive_state
  if [ -z "$1" ]; then rm -f "$STATE"; return 0; fi
  kept="$(printf '%s' "$1" | jq -R -s 'split("\n") | map(select(length > 0))
            | map(split("\t")) | map({agent: .[0], name: .[1]})' 2>/dev/null)" || kept=""
  if [ -z "$kept" ] \
     || ! jq --argjson keep "$kept" \
            '[ .[] | select( . as $r | $keep | any(.agent == ($r.agent // "claude") and .name == $r.name) ) ]' \
            "$STATE" > "$STATE.tmp.$$" 2>/dev/null; then
    # KEEP the state file. Deleting it here meant a disk-full, a permissions
    # problem or a jq failure erased the only restart list — and archive_state
    # is explicitly best-effort, so "there is a snapshot" is not a guarantee.
    # A stale list costs one duplicate skip on the next start; no list costs
    # the sessions.
    rm -f "$STATE.tmp.$$"
    echo "claude-session: could not work out which rows to keep — leaving $STATE as it was" >&2
    return 0
  fi
  if [ "$(jq 'length' "$STATE.tmp.$$" 2>/dev/null || echo 0)" = "0" ]; then
    rm -f "$STATE.tmp.$$" "$STATE"
  else
    mv "$STATE.tmp.$$" "$STATE"
    # Three reasons land a row here — it looked live, its launch was refused, or
    # its launch was handed to a tab this process cannot observe — and the
    # recovery is the same for all three, so the message does not guess which.
    printf '\n%s session(s) left in %s — re-run cl start if any did not come back.\n' \
      "$(printf '%s' "$1" | grep -c .)" "$STATE"
  fi
}

# record_fresh_history <name> <old_sid> <cwd> [agent]: append the retired session id to
# FRESH_HISTORY so a fresh start is never a dead end — the prior conversation
# is still resumable by id even though the name now points at the new session.
# Best-effort (a history-append failure must not block the fresh start); prints
# the recovery command either way so it's never ONLY in a file nobody opens.
# A Codex thread was archived on the way, so its recovery is an unarchive first.
record_fresh_history() {
  local name="$1" old_sid="$2" cwd="$3" agent="${4:-claude}" tmp
  if command -v jq >/dev/null 2>&1; then
    mkdir -p "$(dirname "$FRESH_HISTORY")" 2>/dev/null
    local prior="[]"; [ -r "$FRESH_HISTORY" ] && prior=$(jq -c '.' "$FRESH_HISTORY" 2>/dev/null || printf '[]')
    tmp="$FRESH_HISTORY.tmp.$$"
    if jq -nc --argjson prior "$prior" --arg name "$name" --arg sid "$old_sid" \
         --arg cwd "$cwd" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg agent "$agent" \
         '$prior + [{name:$name, old_sid:$sid, cwd:$cwd, at:$at} + (if $agent == "codex" then {agent:$agent} else {} end)]' > "$tmp" 2>/dev/null; then
      mv "$tmp" "$FRESH_HISTORY"
    else
      rm -f "$tmp"
    fi
  fi
  printf 'previous session of "%s" kept for recovery — resume it directly with:\n' "$name" >&2
  if [ "$agent" = "codex" ]; then
    printf '  codex unarchive %s && codex resume %s\n' "$(printf '%q' "$old_sid")" "$(printf '%q' "$old_sid")" >&2
  else
    printf '  claude --resume %s --dangerously-skip-permissions\n' "$(printf '%q' "$old_sid")" >&2
  fi
}

# do_fresh_start <name> [--dry-run]: the expensive-context problem this whole
# feature exists for. A resumed session reloads its ENTIRE transcript on every
# call — measured 2026-09-23 at 356k-896k tokens for the oldest working
# sessions, 6-15x a fresh session's 40-60k. `cl start --fresh <name>` retires
# the old conversation (with a handoff, same as `cl stop`) and launches a NEW
# claude process under the SAME name, in the same dir, through the same
# wrapper/teams selection — so cross-session SendMessage and `cl <name>` keep
# working — whose first message tells it to read that handoff and carry on.
# The old session id is never lost (see
# record_fresh_history): this trades context size for one deliberate re-read of
# the handoff + open items, not for the conversation itself.
#
# Plain `cl start` is UNCHANGED — it still means "resume everything", which is
# the safer default (a fresh start is a deliberate, one-name-at-a-time choice,
# not something to default into for a whole working set sight-unseen).
do_fresh_start() {
  local name="" dry_run="" arg
  for arg in "$@"; do
    case "$arg" in
      --dry-run) dry_run="--dry-run" ;;
      --*) echo "claude-session: start --fresh: unrecognised flag '$arg'" >&2; exit 1 ;;
      *)   name="$arg" ;;
    esac
  done
  [ -n "$name" ] || { echo 'usage: cl start --fresh "Session Name" [--dry-run]' >&2; exit 1; }

  local match sid cwd agent
  match=$(discover | awk -F'\t' -v n="$name" '$1==n && $5=="claude"')
  [ -n "$match" ] || { echo "claude-session: no claude session named '$name' (try: cl --list)" >&2; exit 1; }
  IFS=$'\t' read -r name sid cwd _ agent <<EOF
$match
EOF

  local t; t=$(tmux_name "$name" claude)

  # dry-run: preview only, via the read-only resolver — never touches handoff_root
  # (same rule as request_handoff's own dry-run branch) and never kills, records,
  # or launches anything.
  if [ -n "$dry_run" ]; then
    request_handoff "$name" "$sid" "$cwd" "$t" "$dry_run"
    printf '[dry-run] would retire "%s" (pid/session for sid %s)\n' "$name" "$sid" >&2
    printf '[dry-run] would record old session id %s for "%s" in %s\n' "$sid" "$name" "$FRESH_HISTORY" >&2
    local prompt
    prompt=$(build_resume_prompt "$(handoff_path_preview "$name")")
    printf '[dry-run] would launch fresh "%s" in %s with prompt:\n  %s\n' "$name" "$cwd" "$prompt" >&2
    return 0
  fi

  # 1. Ask the OLD session for a handoff — and, UNLIKE `cl stop`, fail
  #    closed if it doesn't land. `cl stop` degrades a missed handoff to a
  #    plain stop because the session is going away either way; `start
  #    --fresh` has a different contract, because the whole point is that the
  #    NEW session is told to read that file — retiring the old session and
  #    launching a replacement anyway means either pointing the replacement
  #    at a STALE handoff from some earlier rotation (actively worse than no
  #    handoff) or at nothing at all. (Found in Codex review round 2,
  #    2026-09-23: the round-1 fix checked retirement's return value but not
  #    request_handoff's, so a reachable-but-non-responding pane still led to
  #    a full retire-and-replace.)
  local hrc
  request_handoff "$name" "$sid" "$cwd" "$t" ""; hrc=$?
  case "$hrc" in
    0) : ;;
    1) echo "claude-session: could not reach \"$name\" to ask for a handoff — not starting fresh. Run \`cl handoff\` inside it and try again; if it is already stopped, plain \`cl start\` rotates it off any handoff it left." >&2; exit 1 ;;
    *) echo "claude-session: no handoff arrived for \"$name\" after $CL_HANDOFF_ATTEMPTS attempt(s) — not starting fresh (it is left running; run \`cl handoff\` inside it, or \`cl stop --no-handoff\` to stop it as-is)" >&2; exit 1 ;;
  esac
  # request_handoff resolved the handoff dir/fallback root exactly once, via a
  # direct (non-$()) call, and left it memoized here — reused below so the
  # launch prompt names the SAME root the handoff was actually confirmed in,
  # never a possible third resolution (Codex review round 2).
  local root="$_CL_HANDOFF_ROOT"

  # 1b. CLAIM the handoff before anything irreversible happens. Retiring first
  #     and consuming afterwards meant a consume that failed still left the old
  #     session dead and a replacement reading a file that was still active —
  #     so the next plain `cl start` rotated the replacement off it too, and
  #     kept doing so. Claiming first turns that into a clean refusal: nothing
  #     has been retired yet, so there is nothing to undo.
  local claim
  claim=$(claim_handoff "$root" "$name" "$sid"); local crc=$?
  if [ "$crc" -ne 0 ]; then
    echo "claude-session: the handoff for \"$name\" could not be claimed — not starting fresh, and nothing has been retired" >&2
    exit 1
  fi

  # 2. Retire it — the SAME safety-sensitive logic `cl stop` uses (tmux vs
  #    bare, the hidden-tmux ownership guard, busy-check prompts).
  #    A failed or declined RETIREMENT must also fail closed: launching a
  #    second claude under this name while the first is still alive
  #    (declined kill, still shutting down, or the kill itself failed) is
  #    exactly the double-agent-on-one-name hazard the launch registry exists
  #    to prevent. (Found in Codex review round 1, 2026-09-23.)
  local rc
  retire_session "$name" "$sid" "$t" 1 claude; rc=$?
  case "$rc" in
    0) : ;;
    1) rollback_claim "$root" "$name" "$claim"
       echo "claude-session: \"$name\" was left running — not starting fresh (re-run when it's idle)" >&2; exit 1 ;;
    *) rollback_claim "$root" "$name" "$claim"
       echo "claude-session: could not confirm \"$name\" was retired — not starting fresh (its ownership may still be held)" >&2; exit 1 ;;
  esac

  record_fresh_history "$name" "$sid" "$cwd"

  # The replacement reads the CLAIM. It is committed to consumed/ by
  # launch_fresh, at the point the launch is actually accepted — not here,
  # where "about to exec" is still not "running".
  local prompt
  prompt=$(build_resume_prompt "$claim")
  launch_fresh "$name" "$cwd" "$prompt" "$root" "$claim" "$sid"
}

# do_handoff [--path] [name]: write this session's handoff BY HAND, from
# inside it. The escape hatch for the case `cl stop` cannot solve on its own —
# a pane that text injection cannot reach, or a session too wedged to answer —
# and the reason `cl stop` can afford to fail closed: refusing to kill a
# session is only reasonable if there is a way to satisfy the requirement.
#
# The name comes from CL_SESSION_NAME, exported by every launch path, so inside
# a session this is just `cl handoff`. Sessions started before that existed
# (and anything scripted) can name it: `cl handoff "Some Name"`.
#
# Content comes from stdin when stdin is not a terminal, so an agent can pipe
# its handoff straight in and let cl own the atomic rename and the marker. Run
# interactively it prints where to write and what to include instead.
do_handoff() {
  local path_only=0 name="" arg
  for arg in "$@"; do
    case "$arg" in
      --path) path_only=1 ;;
      --*)    echo "claude-session: handoff: unrecognised flag '$arg'" >&2; exit 1 ;;
      *)      name="$arg" ;;
    esac
  done
  [ -n "$name" ] || name="${CL_SESSION_NAME:-}"
  if [ -z "$name" ]; then
    echo 'claude-session: handoff: no session name — run this inside a cl-started session, or pass one: cl handoff "Some Name"' >&2
    exit 1
  fi

  local root hp
  handoff_root >/dev/null || { echo "claude-session: handoff: no usable handoff store" >&2; exit 1; }
  root="$_CL_HANDOFF_ROOT"
  hp=$(handoff_path "$root" "$name")

  if [ "$path_only" = "1" ]; then printf '%s\n' "$hp"; exit 0; fi

  # At most one unconsumed handoff per session — so an earlier one is swept
  # before this one lands, exactly as `cl stop` sweeps before asking.
  [ -f "$hp" ] && consume_handoff "$root" "$name" "replaced by a hand-written handoff" >/dev/null

  if [ -t 0 ]; then
    printf 'Write this session'"'"'s handoff to:\n  %s\n\n' "$hp"
    printf 'Write a temp file and rename it into place, and end it with this line\n'
    printf 'so cl knows it was written by hand rather than left over:\n  %s%s -->\n\n' \
      "$MANUAL_MARKER_PREFIX" "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
    printf 'Or pipe it in and let cl do both:  cl handoff < your-file\n'
    exit 0
  fi

  local tmp
  tmp="$hp.partial.$$"
  if ! cat > "$tmp" 2>/dev/null; then
    rm -f "$tmp" 2>/dev/null
    echo "claude-session: handoff: could not write $tmp" >&2; exit 1
  fi
  if [ ! -s "$tmp" ]; then
    rm -f "$tmp" 2>/dev/null
    echo "claude-session: handoff: nothing on stdin — refusing to write an empty handoff" >&2; exit 1
  fi
  # Stamped with the id this session was LAUNCHED with, never one looked up by
  # name: after a rotation the newest row for a name is the replacement, so a
  # lookup would stamp the successor's id and make a stale handoff look current.
  # A fresh session has no id and stamps none — unstamped is honest.
  printf '\n%s%s%s -->\n' "$MANUAL_MARKER_PREFIX" \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)" \
    "${CL_SESSION_ID:+@$CL_SESSION_ID}" >> "$tmp"
  # Rename last, so a reader never sees a half-written handoff.
  if mv "$tmp" "$hp" 2>/dev/null; then
    printf '✓ handoff written for "%s" → %s\n' "$name" "$hp" >&2
    printf '  `cl stop` will now accept it, and the next `cl start` will rotate off it.\n' >&2
    exit 0
  fi
  rm -f "$tmp" 2>/dev/null
  echo "claude-session: handoff: could not move the handoff into place at $hp" >&2; exit 1
}

# do_restore: copy a snapshot from STATE_HISTORY_DIR back to STATE so the next
# `cl start` can bring the sessions back. No argument → newest snapshot; --list →
# print available snapshots (newest first) with session count + age; a path or
# bare filename → that specific snapshot. Any existing STATE is archived first, so
# restore is itself lossless. Corrupt snapshots are refused.
do_restore() {
  command -v jq >/dev/null 2>&1 || { echo "claude-session: restore needs jq (brew install jq)" >&2; exit 1; }

  if [ "${1:-}" = "--list" ]; then
    local any=0 f n age
    while IFS= read -r f; do
      any=1
      n=$(jq 'length' "$f" 2>/dev/null || echo '?')
      age=$(reltime "$(stat -f %m "$f" 2>/dev/null || echo 0)")
      printf '%-8s %3s session(s)   %s\n' "$age" "$n" "$f"
    done < <(ls -1t "$STATE_HISTORY_DIR"/state-*.json 2>/dev/null)
    [ "$any" = "1" ] || echo "claude-session: no snapshots in $STATE_HISTORY_DIR" >&2
    return 0
  fi

  # Choose the snapshot: explicit arg (full path or bare filename) or the newest.
  local snap
  if [ -n "${1:-}" ]; then
    if   [ -r "$1" ];                        then snap="$1"
    elif [ -r "$STATE_HISTORY_DIR/$1" ];     then snap="$STATE_HISTORY_DIR/$1"
    else echo "claude-session: no such snapshot '$1' (try: cl restore --list)" >&2; exit 1; fi
  else
    snap=$(ls -1t "$STATE_HISTORY_DIR"/state-*.json 2>/dev/null | head -1)
    [ -n "$snap" ] || { echo "claude-session: no snapshots to restore in $STATE_HISTORY_DIR" >&2; exit 1; }
  fi

  jq empty "$snap" 2>/dev/null || { echo "claude-session: snapshot is not valid JSON: $snap" >&2; exit 1; }

  archive_state   # preserve any current STATE before overwriting — restore is lossless
  mkdir -p "$(dirname "$STATE")" || { echo "claude-session: cannot create state dir" >&2; exit 1; }
  cp "$snap" "$STATE" || { echo "claude-session: failed to write $STATE" >&2; exit 1; }

  local count; count=$(jq 'length' "$STATE" 2>/dev/null || echo '?')
  printf 'restored %s session(s) from %s\n' "$count" "$snap"
  printf 'run cl start to bring them back.\n'
}

# context_size <sid> <agent>: approximate current context size in tokens —
# input + cache_read + cache_creation of the LAST assistant message that
# carried a usage block. That sum (not just input_tokens) is what actually
# gets billed and re-sent on every resumed call, which is the whole reason
# `cl start --fresh` exists (measured 2026-09-23: 356k-896k for the oldest
# working sessions vs ~40-60k fresh). Claude only — Codex's rollout format
# doesn't carry this MCP/Anthropic-shaped usage block, so it's left blank
# rather than guessed at (requirement: never break the Codex listing).
# One jq pass over the transcript, not per-line invocations — a 900k-context
# session's transcript is not small, and jq is the same dependency stop/start
# already require. Empty output (no usage block ever recorded, or file/jq
# missing) is treated as unknown by the caller, not zero.
context_size() { # sid agent
  [ "${2:-claude}" = "claude" ] || { printf ''; return 0; }
  command -v jq >/dev/null 2>&1 || { printf ''; return 0; }
  local f
  f=$(find "$PROJECTS" -mindepth 2 -maxdepth 2 -name "${1}.jsonl" 2>/dev/null | head -1)
  [ -n "$f" ] && [ -r "$f" ] || { printf ''; return 0; }
  jq -r 'select(.message.usage != null) | (.message.usage.input_tokens // 0) + (.message.usage.cache_read_input_tokens // 0) + (.message.usage.cache_creation_input_tokens // 0)' \
    "$f" 2>/dev/null | tail -1
}

# fmt_ctx <tokens>: human-scale rendering ("896k", "42k", "3821") for a list
# column; blank stays blank (unknown, not zero).
fmt_ctx() {
  case "${1:-}" in
    ''|*[!0-9]*) printf ''; return 0 ;;
  esac
  if [ "$1" -ge 1000 ]; then printf '%dk' $(( ($1 + 500) / 1000 ))
  else printf '%d' "$1"
  fi
}

# rotate_hint <tokens> <epoch> <agent>: "rotate" when context is over ~250k
# (the 6-15x-cost knee measured 2026-09-23) or the transcript is over 7 days
# old — either is a candidate for `cl start --fresh`. Blank otherwise,
# including when the context size is unknown (no evidence, no hint) OR the
# agent isn't claude: `start --fresh` is Claude-only (see context_size's own
# Claude-only note), so a blank-context Codex row hitting the AGE branch and
# getting flagged rotate anyway would recommend an action that doesn't exist
# for it. (Found in Codex review round 2, 2026-09-23.)
CL_ROTATE_CTX_THRESHOLD="${CL_ROTATE_CTX_THRESHOLD:-250000}"
CL_ROTATE_AGE_DAYS="${CL_ROTATE_AGE_DAYS:-7}"
rotate_hint() { # tokens epoch agent
  local tokens="$1" epoch="${2:-0}" agent="${3:-claude}" now age_days
  [ "$agent" = "claude" ] || { printf ''; return 0; }
  now=$(date +%s); age_days=$(( (now - epoch) / 86400 ))
  case "$tokens" in
    ''|*[!0-9]*) : ;;
    *) [ "$tokens" -ge "$CL_ROTATE_CTX_THRESHOLD" ] && { printf 'rotate'; return 0; } ;;
  esac
  [ "$age_days" -ge "$CL_ROTATE_AGE_DAYS" ] && { printf 'rotate'; return 0; }
  printf ''
}

# live_dot <name> <sid> <agent>: ● when a tmux session or a matching local
# process exists, ○ otherwise. For codex ● means "a local resume process
# matches", nothing stronger (see session_pid).
live_dot() {
  if tmux has-session -t "$(tmux_name "$1" "$3")" 2>/dev/null || [ -n "$(session_pid "$2" "$3" "$1")" ]; then printf '●'; else printf '○'; fi
}

# agent_tag <agent>: short marker shown beside non-default agents.
agent_tag() { [ "$1" = "claude" ] && printf '%-6s' '' || printf '%-6s' "$1"; }

# rotate_cell <name> <agent> [root]: the rotation column for a listing.
#
# POLICY and STATE in one narrow column, because they answer different questions
# and seeing only one of them is misleading:
#
#   compact   compacted at the next `cl stop`, then resumed
#   handoff   will be asked for a handoff at the next `cl stop`
#   handoff↻  …and a complete handoff is already waiting (next start rotates)
#   fresh     stopped with no handoff and restarted as a new session
#   resume    will not be asked; resumes as-is
#   resume↻   will not be asked, but a handoff IS waiting — someone wrote one by
#             hand, and the next stop will clear it. Worth seeing rather than
#             silently reconciling. (Any mode but handoff can show this.)
#
# A Codex row shows resume or fresh, the only two it can have, and never ↻: a
# Codex thread writes no handoff, so one waiting under its name is not its own.
#
# Short forms, because compact-resume (14 characters) would not fit the column.
#
# The root is passed in because resolving the handoff store per row would re-run
# its directory checks once per session.
rotate_cell() {
  local name="$1" agent="${2:-claude}" root="${3:-}" v="" pending=""
  [ "$agent" = "claude" ] || { printf '%s' "$(codex_mode_for "$name" 2>/dev/null)"; return 0; }
  v=$(rotate_for "$name" "$agent" 2>/dev/null)
  [ -n "$root" ] && handoff_is_complete "$(handoff_path "$root" "$name")" 2>/dev/null && pending='↻'
  printf '%s%s' "$(_mode_short "$v")" "$pending"
}

# fzf rows: "<display>\tNAME\tSID\tCWD\tAGENT"  (display shown; rest carried for the action)
rows() {
  printf '＋ new claude here  ·  %s\tNEW\t\t%s\tclaude\n' "$PWD" "$PWD"
  if command -v codex >/dev/null 2>&1; then
    printf '＋ new codex here   ·  %s\tNEW\t\t%s\tcodex\n' "$PWD" "$PWD"
  fi
  # Resolved once for the whole listing, and quietly: the picker is not the place
  # to complain about a handoff store, and a missing one just means nothing is
  # pending.
  local _root=""
  handoff_root >/dev/null 2>&1 && _root="$_CL_HANDOFF_ROOT"
  discover | while IFS=$'\t' read -r name sid cwd epoch agent; do
    printf '%s %-22s %s %-8s %-8s %s\t%s\t%s\t%s\t%s\n' "$(live_dot "$name" "$sid" "$agent")" "$name" "$(agent_tag "$agent")" "$(reltime "$epoch")" "$(rotate_cell "$name" "$agent" "$_root")" "$cwd" "$name" "$sid" "$cwd" "$agent"
  done
}

# print_stop_help / print_help: what `cl --help` and `cl stop --help` show. Kept
# short and one flag per line; the reasoning lives in the header comment above.
print_stop_help() {
  cat <<'EOF'
cl stop [flags]   prepare each Claude session by its mode (`cl mode`):
                  compact-resume compacts it first, handoff asks for a
                  handoff, fresh and resume ask nothing. Then save running
                  sessions and stop each one it can safely retire. Codex
                  sessions are never asked; they resume as they were, or,
                  in fresh mode, come back as a new thread under the name.
                  Anything cl manages that is left running is named and the
                  exit is non-zero; a Codex thread cl did not launch is
                  reported and left alone.

  --no-handoff        stop now: no compaction, no handoff; `cl start` resumes
                      each session as it was (and clears any pending handoff)
  --require-handoff   ask every Claude session for a handoff, and fail closed:
                      exit non-zero if one is left running without a handoff
                      (alias: --rotate)
  --keep-tabs         leave the iTerm tabs open
  --dry-run           show what would happen; change nothing
  -h, --help          this help

  Compaction wait: CL_COMPACT_TIMEOUT for all sessions at once (600s).
  Handoff wait: CL_HANDOFF_TIMEOUT per round (180s), CL_HANDOFF_BUDGET in
  total (300s). Asks before killing a session that is still mid-task.
EOF
}

print_help() {
  cat <<'EOF'
cl — pick, launch and resume named Claude Code and Codex sessions

  cl                          picker
  cl <name>                   launch or resume that session
  cl --codex|--claude <name>  same, when a name exists for both agents
  cl --list                   list sessions (--codex / --claude to filter)
  cl new [--codex] [--model <id>] "Name" [dir|-d]
                              start a new named session (dir defaults to here;
                              -d uses $CL_DEFAULT_DIR)

  cl stop [flags]             request configured handoffs, save running sessions,
                              and stop those it can safely retire
                              (`cl stop --help` for the flags, e.g. --no-handoff)
  cl start                    bring back the sessions from the last stop
  cl start --fresh "Name" [--dry-run]
                              rotate ONE session onto a fresh one via its handoff
  cl restore [--list]         restore the saved set from an earlier snapshot

  cl handoff [--path]         write THIS session's handoff by hand
  cl mode ["Name" [compact-resume|handoff|fresh|resume|clear]]
                              how each session is stopped and started again
                              (`cl mode --default <mode>` sets the default;
                              `cl mode --codex "Name" fresh|resume` for Codex)
  cl rotate [status|on|off|clear|stats] ["Name"]
                              the same setting: on = handoff, off = resume
  cl model [--codex|--claude] [<name> <model-id>|<name> -]
                              the model remembered per session

  In iTerm the agent runs as the tab's own process; elsewhere inside tmux when
  available. Details and reasoning: the header of this script.
EOF
}

# Optional agent filter for direct launch: `cl --codex <name>` / `cl --claude <name>`.
AGENT_FILTER=""
case "${1:-}" in
  --codex)  AGENT_FILTER="codex";  shift ;;
  --claude) AGENT_FILTER="claude"; shift ;;
esac

case "${1:-}" in
  new)     shift; do_new "$@"; exit 0 ;;
  # exit $? and not 0: a refused or failed set must be visible to the caller.
  model)   shift; do_model "$@"; exit $? ;;
  # do_stop's status is meaningful the same way (non-zero when a session was
  # left running), so it is propagated rather than flattened to 0.
  stop)    shift; do_stop "$@"; exit $? ;;
  start)
    shift
    if [ "${1:-}" = "--fresh" ]; then shift; do_fresh_start "$@"; else do_start; fi
    exit $? ;;
  handoff) shift; do_handoff "$@"; exit 0 ;;
  rotate)  shift; do_rotate "$@"; exit $? ;;
  mode)    shift; do_mode "$@"; exit $? ;;
  restore) do_restore "${2:-}"; exit 0 ;;
  --discover)  # raw TSV (name sid cwd epoch agent) — for scripts and tests
    discover; exit 0 ;;
  --list)
    # HANDOFF is the POLICY (plus ↻ when one is already waiting); HINT is ADVICE
    # from the context size. They were one unlabelled column before, which read as
    # if the advice were the setting — two different questions, two headings.
    printf '%-2s %-22s %-6s %-8s %-6s %-8s %-6s %s\n' '' NAME AGENT 'ACTIVE' CTX HANDOFF HINT DIR
    _lroot=""; handoff_root >/dev/null 2>&1 && _lroot="$_CL_HANDOFF_ROOT"
    discover | while IFS=$'\t' read -r name sid cwd epoch agent; do
      [ -z "$AGENT_FILTER" ] || [ "$agent" = "$AGENT_FILTER" ] || continue
      ctx=$(context_size "$sid" "$agent")
      printf '%-2s %-22s %s %-8s %-6s %-8s %-6s %s\n' "$(live_dot "$name" "$sid" "$agent")" "$name" "$(agent_tag "$agent")" "$(reltime "$epoch")" "$(fmt_ctx "$ctx")" "$(rotate_cell "$name" "$agent" "$_lroot")" "$(rotate_hint "$ctx" "$epoch" "$agent")" "$cwd"
    done
    exit 0 ;;
  -h|--help) print_help; exit 0 ;;
  '') : ;;  # fall through to picker
  *)
    # `cl <name> --rotate-from <path>`: internal, emitted by `cl start` for a
    # rotating session in the no-tmux shape, where nothing is pre-created and
    # this tab does the launch. The path names the session's ACTIVE handoff,
    # still unclaimed: the parent deliberately did not spend it, because it
    # could not know whether this process would ever run. Claiming happens here
    # and is committed by launch_fresh once the launch is accepted.
    if [ "${2:-}" = "--rotate-from" ]; then
      rotate_from="${3:-}"
      [ -n "$rotate_from" ] || { echo "claude-session: --rotate-from needs a path" >&2; exit 1; }
      rrow=$(discover | awk -F'\t' -v n="$1" '$1==n && $5=="claude" {print; exit}')
      rcwd=$(printf '%s' "$rrow" | cut -f3); rsid=$(printf '%s' "$rrow" | cut -f2)
      # REFUSE rather than relocate, and refuse BEFORE claiming. Substituting
      # $HOME here is what made the guard inside launch_fresh unreachable: by the
      # time it ran, the missing directory had already become $HOME, so a
      # rotation whose project directory had gone started the replacement in the
      # home directory and handed it a handoff about a different repository.
      #
      # An empty rcwd means the session was not discovered at all — `discover`
      # drops rows whose cwd no longer exists — which is the same situation and
      # must fail the same way.
      if [ -z "$rcwd" ] || [ ! -d "$rcwd" ]; then
        echo "claude-session: \"$1\" cannot be rotated: its directory ${rcwd:-(unknown)} no longer exists." >&2
        echo "  Not starting a replacement somewhere else — its handoff is about work in that directory." >&2
        echo "  The handoff is untouched; resume the session directly, or fix the path and retry." >&2
        exit 1
      fi
      if ! handoff_root >/dev/null; then
        echo "claude-session: no usable handoff store — resuming \"$1\" instead of rotating" >&2
        exec "$0" "$1"
      fi
      rroot="$_CL_HANDOFF_ROOT"
      # Another tab may have got here first, or the file may have gone: that is
      # not an error, it just means this one resumes.
      if ! rclaim=$(claim_handoff "$rroot" "$1" "$rsid"); then
        echo "claude-session: no claimable handoff for \"$1\" any more — resuming it instead" >&2
        exec "$0" "$1"
      fi
      # Recorded HERE, not by `cl start`: this is the process that retires the
      # old transcript, and a recovery pointer written for a rotation that
      # never happened would be a lie.
      [ -n "$rsid" ] && record_fresh_history "$1" "$rsid" "$rcwd"
      launch_fresh "$1" "$rcwd" "$(build_resume_prompt "$rclaim")" "$rroot" "$rclaim" "$rsid"
      exit 0
    fi
    # `cl <name> --restart-mode <mode> [<boundary>]`: internal, emitted by `cl
    # start` in the no-tmux shape for a Claude row whose stop recorded a mode,
    # the way --rotate-from is. This tab is the process that launches, so it is
    # the one that preflights (compact-resume) or retires the old id (fresh).
    # `cl --codex <name> --restart-mode fresh <old-id>`: the same, for a Codex
    # row. This tab carries the fresh transaction (codex_fresh_advance) under
    # the per-name claim and resumes the new thread by id; a rollback resumes
    # the old thread plainly. The row is settled by a later start, which can
    # see what this exec cannot.
    if [ "${2:-}" = "--restart-mode" ] && [ "$AGENT_FILTER" = "codex" ]; then
      rrow=$(discover | awk -F'\t' -v n="$1" '$1==n && $5=="codex" {print; exit}')
      [ -n "$rrow" ] || { echo "claude-session: no codex session named '$1' (try --list)" >&2; exit 1; }
      rcwd=$(printf '%s' "$rrow" | cut -f3); rsid=$(printf '%s' "$rrow" | cut -f2)
      case "${3:-}" in
        fresh)
          if [ -n "${4:-}" ] && [ "$4" != "$rsid" ] && ! codex_txn_pending "$1"; then
            # The name has moved on since the stop (a newer thread, or this
            # tab ran twice): that thread was never stopped, so it is resumed,
            # not replaced.
            printf 'ℹ "%s" no longer names thread %s — resuming %s as it is\n' "$1" "$4" "$rsid" >&2
            launch_session "$1" "$rsid" "$rcwd" codex
          else
            codex_txn_claim "$1" || exit 1
            rnew=$(codex_fresh_advance "$1" "${4:-$rsid}" "$rcwd"); rrc=$?
            case "$rrc" in
              0) _txn_put "$1" '{"phase":"launching"}' >/dev/null 2>&1
                 codex_txn_release
                 # The row is NOT acknowledged by this launch: exec ends this
                 # process, so it cannot see the agent start. The next start
                 # verifies it (codex_fresh_settle) and settles the row.
                 _CL_SKIP_ACK=1 launch_session "$1" "$rnew" "$rcwd" codex "$(build_codex_fresh_prompt)" ;;
              1) codex_txn_release; launch_session "$1" "$rnew" "$rcwd" codex ;;
              *) codex_txn_release; exit 1 ;;
            esac
          fi ;;
        *) echo "claude-session: --restart-mode: '${3:-}' is not a Codex restart mode (fresh)" >&2; exit 1 ;;
      esac
      exit 0
    fi
    if [ "${2:-}" = "--restart-mode" ]; then
      rrow=$(discover | awk -F'\t' -v n="$1" '$1==n && $5=="claude" {print; exit}')
      [ -n "$rrow" ] || { echo "claude-session: no claude session named '$1' (try --list)" >&2; exit 1; }
      rcwd=$(printf '%s' "$rrow" | cut -f3); rsid=$(printf '%s' "$rrow" | cut -f2)
      case "${3:-}" in
        compact-resume)
          # A failed preflight resumes PLAINLY and is reported; it never falls
          # through to a handoff, because none was requested this cycle.
          if compact_preflight "$rsid" "${4:--}"; then
            launch_session "$1" "$rsid" "$rcwd" claude "$(build_compact_resume_prompt)"
          else
            printf '⚠ "%s" is not the session its stop compacted (transcript missing, or compacted again since) — resuming it plainly\n' "$1" >&2
            launch_session "$1" "$rsid" "$rcwd" claude
          fi ;;
        fresh)
          record_fresh_history "$1" "$rsid" "$rcwd"
          launch_fresh "$1" "$rcwd" "" "" "" "$rsid" ;;
        *) echo "claude-session: --restart-mode: unknown mode '${3:-}'" >&2; exit 1 ;;
      esac
      exit 0
    fi
    # direct launch by name. A name held by BOTH agents is refused unless
    # --codex/--claude says which — never first-row-wins.
    match=$(discover | awk -F'\t' -v n="$1" -v a="$AGENT_FILTER" '$1==n && (a=="" || $5==a)')
    nmatch=$(printf '%s' "$match" | grep -c .)
    if [ "$nmatch" -gt 1 ]; then
      echo "claude-session: '$1' exists for more than one agent — say which: cl --claude \"$1\"  or  cl --codex \"$1\"" >&2
      exit 1
    elif [ -n "$match" ]; then
      IFS=$'\t' read -r name sid cwd _ agent <<EOF
$match
EOF
      launch_session "$name" "$sid" "$cwd" "$agent"
    elif command -v tmux >/dev/null 2>&1 && tmux has-session -t "=$(tmux_name "$1" "${AGENT_FILTER:-claude}")" 2>/dev/null; then
      # Live tmux session exists but its customTitle isn't in the transcript yet
      # (e.g. a fresh `cl new` before its first message) — attach it directly.
      t=$(tmux_name "$1" "${AGENT_FILTER:-claude}"); in_iterm && tag_iterm_session "$t"; tmux_setup
      exec tmux new-session -A -s "$t"
    else
      echo "claude-session: no session named '$1' (try --list)" >&2; exit 1
    fi
    ;;
esac

# ---- picker ----
if command -v fzf >/dev/null 2>&1; then
  picked=$(rows | fzf --ansi --delimiter='\t' --with-nth=1 --height=~100% --reverse \
            --prompt='session ❯ ' \
            --header='● live   ○ resume      enter: open') || exit 0
  [ -n "$picked" ] || exit 0
else
  echo "Pick a session:" >&2
  IFS=$'\n'; i=0; menu=$(rows)
  for line in $menu; do i=$((i+1)); printf '%2d) %s\n' "$i" "${line%%$'\t'*}" >&2; done
  printf 'number ❯ ' >&2; read -r choice
  picked=$(printf '%s\n' $menu | sed -n "${choice}p")
  [ -n "$picked" ] || exit 0
fi

name=$(printf '%s' "$picked" | cut -f2)
sid=$(printf '%s' "$picked" | cut -f3)
cwd=$(printf '%s' "$picked" | cut -f4)
agent=$(printf '%s' "$picked" | cut -f5)
if [ "$name" = "NEW" ]; then
  printf 'name for the new session (blank = unnamed) ❯ ' >&2
  read -r newname </dev/tty
  if [ -n "$newname" ]; then launch_named "$newname" "$cwd" "$agent"; else launch_new "$cwd" "$agent"; fi
else
  launch_session "$name" "$sid" "$cwd" "$agent"
fi
