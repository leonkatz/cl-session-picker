#!/usr/bin/env bash
# claude-session — interactive picker for resuming named Claude Code and
# Codex CLI sessions.
#
# Bound to `cl`. Auto-discovers every session you've /renamed (no registry to
# maintain — name a session and it shows up), marks which are live, and on
# select cd's into that session's dir and launches or resumes it. A "new … here"
# entry starts a fresh session in the current directory. Claude launches with
# --dangerously-skip-permissions; Codex launches with its own configured
# defaults (add flags via CL_CODEX_ARGS).
#
# Where the agent runs:
#   in iTerm2  — as the tab's own process, NOT inside tmux, so iTerm's Claude
#                Code integration (job-name triggers, status hooks) can see it.
#                Trade-off: no detach — closing the tab ends the session, and
#                Ctrl-Z suspends the agent (no tmux keybind to swallow it).
#                Recovery is `cl <name>`, which resumes by session id.
#                CL_TMUX=1 restores the old tmux wrapping instead.
#   in cmux    — as the pane's own process; cmux owns persistence/restore.
#   elsewhere  — inside tmux when available (detach/reattach is the only
#                persistence there), otherwise directly.
#
# Usage:
#   claude-session            # picker (fzf if available, numbered menu otherwise)
#   claude-session <name>     # launch that named session directly
#   claude-session --codex <name>   # same, when a name exists for both agents
#   claude-session new "Name" [dir|-d]  # create a fully-named session in one step
#                             #   (no /rename); dir = $PWD, -d uses $CL_DEFAULT_DIR
#   claude-session new --codex "Name" [dir|-d]  # fresh codex; the name labels
#                             #   the tab only until you /rename inside codex
#   claude-session --list     # print discovered sessions (--codex/--claude to filter)
#   claude-session stop       # ask each Claude session for a handoff (written to
#                             #   <handoff dir>/handoff/<Name>.md, or a local
#                             #   fallback if that is unreachable), then snapshot live
#                             #   sessions, kill them, and close their iTerm tabs.
#                             #   --keep-tabs leaves tabs open; --no-handoff skips
#                             #   the handoff step (plain stop); --dry-run prints
#                             #   what would happen. Asks before killing anything
#                             #   still mid-task after the handoff wait, leaving
#                             #   those open. Covers cmux-native sessions too.
#   claude-session start      # relaunch every session from the last stop
#                             #   (skips any already live, else resumes by id).
#                             #   In cmux: opens one workspace per session.
#   claude-session start --fresh "Name" [--dry-run]
#                             # hand off + retire ONE named session, then launch
#                             #   a NEW claude under the SAME name/dir whose first
#                             #   message tells it to read the handoff and
#                             #   continue. The old
#                             #   session id is kept (recovery command printed +
#                             #   logged) — nothing is lost, only re-read once.
#                             #   Claude only. Plain `cl start` is unaffected.
#   claude-session restore    # restore state.json from the newest history
#                             #   snapshot (add --list to pick; then run start)
#
# In cmux panes, sessions launch via `cmux claude-teams` so Agent Teams
# teammates appear as native cmux splits. Set CL_TEAMS=0 to launch plain
# `claude` instead. (Outside cmux this is always plain `claude`.)

PROJECTS="$HOME/.claude/projects"
# Codex CLI storage. Both files are private implementation details of the Codex
# CLI (observed at 0.150.0), not a supported API — discover_codex() is the one
# place that knows their shape, so a layout change breaks exactly one function.
CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
CODEX_INDEX="$CODEX_HOME/session_index.jsonl"
CODEX_SESSIONS="$CODEX_HOME/sessions"
STATE="$HOME/.config/claude-session/state.json"
# Rotating history of past state files — a safety net against a failed `cl start`
# (which deletes STATE) or a corrupted write. Newest STATE_HISTORY_KEEP kept.
STATE_HISTORY_DIR="$HOME/.config/claude-session/history"
STATE_HISTORY_KEEP=10

# --- handoff / fresh-start config --------------------------------------------
# Where handoffs are written. Local state by default, because that is the only
# location this tool can assume exists on someone else's machine. Point
# CL_HANDOFF_DIR at a synced folder (a notes vault, a shared drive) if you want
# handoffs to follow you between machines — that is exactly why the fallback
# below exists: a synced directory can be slow to appear, partially hydrated,
# or briefly absent, and every path is resolved through handoff_root(), which
# falls back and SAYS SO rather than silently writing nowhere durable.
CL_HANDOFF_DIR="${CL_HANDOFF_DIR:-$HOME/.local/state/claude-session/handoff}"
CL_HANDOFF_FALLBACK_BASE="${CL_HANDOFF_FALLBACK_BASE:-$HOME/.local/state/claude-session/handoff-fallback}"
# The instruction typed into the pane. The default below asks for a handoff and
# nothing else; anything beyond that — which notes to tidy, which task list,
# house rules about what may be archived — is YOUR workflow, not this tool's,
# so it belongs in a file you own rather than in a shared script.
CL_HANDOFF_PROMPT_FILE="${CL_HANDOFF_PROMPT_FILE:-$HOME/.config/claude-session/handoff-prompt.txt}"
# The first message a fresh session receives (cl start --fresh). Same reasoning.
CL_RESUME_PROMPT_FILE="${CL_RESUME_PROMPT_FILE:-$HOME/.config/claude-session/resume-prompt.txt}"
# How long `cl stop` waits for a requested handoff to land before falling back
# to a plain stop. Generous by default: writing a good handoff is real work.
CL_HANDOFF_TIMEOUT="${CL_HANDOFF_TIMEOUT:-90}"
# Record of session names started fresh, with the OLD session id, so a fresh
# start is never a dead end — the prior conversation stays resumable even
# though its name now points at the new session.
FRESH_HISTORY="$HOME/.config/claude-session/fresh-history.json"

# handoff_root: echoes the directory to write handoffs into for this
# run, preferring the configured handoff dir and falling back to a local one when
# that is not there (or is not writable — a File Provider dataless dir can
# stat fine and fail every open(), a failure mode seen in practice with more
# than one sync client). Prints a one-line notice on stderr when it falls
# back, so the fallback is never silent.
_CL_HANDOFF_ROOT=""
# Resolves to a Sessions dir that ALREADY HAS handoff/ and archive/ beneath
# it — round 2 of Codex review found that the handoff_root of round 1 only
# mkdir'd Sessions itself, so a freshly-selected fallback could pass the
# write-probe here and still fail on its first real write, since nothing had
# ever created `<root>/handoff` or `<root>/archive`. Both are created (and
# the probe still targets Sessions itself, the write-probe's original job:
# catching a File Provider dataless dir that `stat`s fine but fails `open()`).
# _ensure_session_dirs <base>: create <base>/handoff and <base>/archive and
# CONFIRM all three (base itself too) really are directories afterward —
# `mkdir -p`'s own exit status doesn't prove this: it can report success
# against a path component that's actually a plain FILE in some edge cases,
# and round 2 of this function discarded the status entirely. Round 3 of
# Codex review reproduced both: a regular file sitting at `Sessions/handoff`
# and a regular file sitting at the fallback base, both silently accepted as
# a usable root. Nothing here is accepted as usable without this check.
# Just the directory itself. Handoffs land directly in CL_HANDOFF_DIR so the
# variable means what its name says — an earlier layout added a `handoff/`
# subdirectory inside a directory already called handoff, and a separate
# `archive/` for one person's note-keeping convention. Point CL_HANDOFF_DIR at
# a subfolder if you are aiming it into a shared notes tree; a custom prompt
# that wants more structure can name any path under {{store}} and create it.
_ensure_session_dirs() {
  mkdir -p "$1" 2>/dev/null
  [ -d "$1" ]
}

# handoff_root: resolves to a Sessions dir with handoff/ and archive/ beneath
# it, preferring the configured dir and falling back to a local one. Returns
# NON-ZERO (and prints nothing to stdout) only in the — expected to be rare —
# case where NEITHER the handoff dir NOR the fallback can be made usable; callers
# (request_handoff) must check this rather than assume a root was resolved.
handoff_root() {
  [ -n "$_CL_HANDOFF_ROOT" ] && { printf '%s\n' "$_CL_HANDOFF_ROOT"; return 0; }
  local base="$CL_HANDOFF_DIR" probe ok=0
  if mkdir -p "$base" 2>/dev/null; then
    probe="$base/.cl-write-probe.$$"
    if ( printf '' > "$probe" ) 2>/dev/null; then
      rm -f "$probe" 2>/dev/null
      _ensure_session_dirs "$base" && ok=1
    fi
  fi
  if [ "$ok" = "1" ]; then
    _CL_HANDOFF_ROOT="$base"; printf '%s\n' "$base"; return 0
  fi
  echo "claude-session: handoff dir unusable at $CL_HANDOFF_DIR — using fallback $CL_HANDOFF_FALLBACK_BASE" >&2
  base="$CL_HANDOFF_FALLBACK_BASE"
  mkdir -p "$base" 2>/dev/null
  if _ensure_session_dirs "$base"; then
    _CL_HANDOFF_ROOT="$base"; printf '%s\n' "$base"; return 0
  fi
  echo "claude-session: fallback $base is also unusable — no durable handoff location available" >&2
  return 1
}

# Path helpers all take the RESOLVED ROOT as their first argument, not the
# display name alone — round 2 of Codex review found that round 1's fix
# (having each helper call `handoff_root` itself) was incomplete: every real
# call site still invoked a helper through `$(...)`, which is a SUBSHELL, so
# `handoff_root`'s memoization was set there and lost the instant that
# subshell exited. Two helpers called moments apart could each resolve a
# DIFFERENT root if reachability changed in between, so a write and its
# handoff could land in different trees, or a fresh replacement could be told
# to read a third resolution. The fix that actually holds: resolve the root
# EXACTLY ONCE per operation, in the CALLING function, via a direct
# (non-substitution) `handoff_root >/dev/null` call — then thread that one
# value through every path built for that operation. These helpers are now
# pure functions of (root, name); they never call handoff_root themselves.
handoff_path() { printf '%s/%s.md' "$1" "$(name_component "$2")"; }

# name_component <display-name> -> one safe, COLLISION-FREE path component.
#
# Round 1 stripped slashes and a leading dot; round 2 of Codex review found
# that lossy (found ".foo" and "_foo" both mapping to "_foo" — one session
# could then overwrite another's handoff) and found that it let raw
# control bytes (newline, CR, tab) straight through, which could re-open the
# cmux early-submit/key-injection risk documented above send_text_cmux if a
# name ever reached that path.
#
# Fixed with byte-wise percent-encoding, restricted to exactly the bytes that
# are unsafe here: '/' (path traversal), '%' (so the encoding is unambiguous
# to reverse), and C0 controls + DEL (0x00-0x1F, 0x7F — never let one of
# these reach a filesystem path or a downstream terminal/AppleScript/cmux
# argument as a raw byte). Every other byte, including multibyte UTF-8
# glyphs, passes through unchanged — handoff dir filenames tolerate those fine.
# This is injective (two different inputs can never encode to the same
# output): decoding is "scan for %XX, else literal", so nothing collides.
# A LITERAL leading dot in the encoded result can therefore only come from a
# literal leading dot in the input (encoding never manufactures one) — that
# case is still guarded (prefixed, not stripped, so ".foo" and "foo" stay
# distinct) to keep "." and ".." from reappearing as a bare component.
#
# Known, accepted residual gap: this does not defend against the handoff dir's
# filesystem applying Unicode normalization (e.g. APFS's HFS+-compatibility
# NFD folding) to two byte-distinct-but-canonically-equivalent names. Real
# session names come from a human typing `cl new "Name"`, where that
# collision is exceedingly unlikely; a fully normalization-safe scheme was
# judged not worth the complexity here.
name_component() {
  local n="$1" out="" c i hex
  for (( i=0; i<${#n}; i++ )); do
    c="${n:i:1}"
    case "$c" in
      /|%)
        printf -v c '%%%02X' "'$c"
        ;;
      *)
        # `'$c` (bash's char-to-ordinal syntax) is only meaningful for a
        # single-byte ASCII character; a multibyte UTF-8 glyph in `c` takes
        # this branch too but its ordinal value is always >= 0x80, so it
        # never matches the control-byte test below and passes through
        # unescaped, which is exactly what's wanted.
        printf -v hex '%d' "'$c" 2>/dev/null || hex=128
        if [ "$hex" -lt 32 ] || [ "$hex" -eq 127 ]; then
          printf -v c '%%%02X' "'$c"
        fi
        ;;
    esac
    out+="$c"
  done
  # A LEADING DOT must be ENCODED, not prefixed — prefixing broke
  # injectivity: ".foo" -> "_.foo" collided with a literal "_.foo" input
  # (found in Codex review round 3, 2026-09-23; round 2's fix collided
  # differently and was already fixed once). Encoding the dot itself keeps
  # the mapping reversible (a literal "%" is already escaped above, so
  # "%2E" cannot occur any other way) while still guaranteeing the output
  # never starts with "." — "." and ".." can't reappear as bare components.
  case "$out" in .*) out="%2E${out#.}" ;; esac
  [ -n "$out" ] || out="_"
  printf '%s' "$out"
}

# *_preview: read-only path resolution for --dry-run output ONLY. Real runs
# always go through handoff_root (which mkdir's + write-probes to catch a File
# Provider dataless directory) — a dry run must do neither (found in Codex
# review, 2026-09-23: the original request_handoff computed handoff_path,
# and therefore called handoff_root's mutating probe, before checking whether
# it was even a dry run). This never memoizes and never mkdir's; it only
# reports what a real run would most likely resolve to.
#
# Known gap, accepted: because it never mkdir's, a CL_HANDOFF_DIR that exists
# but whose `Sessions` subdirectory doesn't YET exist previews as unreachable
# even though a real run would happily create it and succeed. In practice
# this rarely bites — a handoff dir that has been used before already exists —
# but it means a --dry-run preview against a genuinely brand-new handoff dir
# path can undersell what a real run would do.
handoff_root_preview() {
  if [ -d "$CL_HANDOFF_DIR" ] 2>/dev/null && [ -w "$CL_HANDOFF_DIR" ] 2>/dev/null; then
    printf '%s\n' "$CL_HANDOFF_DIR"
  else
    # Announce the fallback here too — logging is not a mutation, and a dry
    # run silently disagreeing with what a real run would say (and log) is
    # its own kind of surprise.
    echo "claude-session: handoff dir unusable at $CL_HANDOFF_DIR — using fallback $CL_HANDOFF_FALLBACK_BASE" >&2
    printf '%s\n' "$CL_HANDOFF_FALLBACK_BASE"
  fi
}
handoff_path_preview() { printf '%s/%s.md' "$(handoff_root_preview)" "$(name_component "$1")"; }

# Every discover* function emits:  name<TAB>sid<TAB>cwd<TAB>epoch<TAB>agent
# agent is "claude" or "codex". Consumers must read all five fields.

# Session ids are DATA read from disk and later spliced into command strings
# (tmux pane commands, eval'd exec lines). They are never trusted: a Claude id
# must look like a transcript basename, a Codex id must be a UUID. Anything
# else is dropped at discovery, so no later consumer has to think about it.
valid_claude_sid() { case "$1" in ''|*[!A-Za-z0-9._-]*) return 1 ;; esac; return 0; }
# A Codex id is a UUID: 8-4-4-4-12 hex groups. Checked by layout, not just
# length and alphabet — 36 hyphens is not a session id.
valid_codex_sid() {
  local a b c d e rest
  IFS=- read -r a b c d e rest <<CLSID
$1
CLSID
  [ -z "$rest" ] || return 1
  [ "${#a}" -eq 8 ] && [ "${#b}" -eq 4 ] && [ "${#c}" -eq 4 ] && [ "${#d}" -eq 4 ] && [ "${#e}" -eq 12 ] || return 1
  case "$a$b$c$d$e" in *[!0-9a-fA-F]*) return 1 ;; esac
  return 0
}

# discover_claude — newest transcript per *current* name
discover_claude() {
  # custom-title is the record /rename writes; it covers every named session.
  # (The older agent-name record exists only for a subset, so grepping it
  # silently dropped half the sessions — including the most-used ones.)
  grep -rl '"customTitle"' "$PROJECTS"/*/*.jsonl 2>/dev/null \
    | xargs ls -t 2>/dev/null \
    | while IFS= read -r f; do
        name=$(grep -oE '"customTitle":"[^"]+"' "$f" 2>/dev/null | tail -1 | sed 's/.*"customTitle":"//; s/"$//')
        [ -n "$name" ] || continue
        sid=$(basename "$f" .jsonl)
        valid_claude_sid "$sid" || continue
        cwd=$(grep -m1 -oE '"cwd":"[^"]*"' "$f" 2>/dev/null | sed 's/.*"cwd":"//; s/"$//')
        [ -d "$cwd" ] || continue   # drop sessions whose working dir no longer exists
        epoch=$(stat -f %m "$f" 2>/dev/null || echo 0)
        printf '%s\t%s\t%s\t%s\tclaude\n' "$name" "$sid" "$cwd" "$epoch"
      done \
    | awk -F'\t' '!seen[$1]++'
}

# discover_codex — named Codex CLI sessions (`/rename` inside codex).
#
# Codex has no registry of names either. Its rename index is an append-only
# JSONL of {id, thread_name, updated_at}; the LAST line per id is the current
# name (a session renamed three times has three lines). The working dir lives
# in the rollout transcript's first line (session_meta.cwd), and the rollout's
# mtime is the recency signal. Rollouts are searched ONLY under sessions/ —
# never all of CODEX_HOME — so `codex archive`d sessions (moved to
# archived_sessions/) drop out of the picker instead of resurfacing.
#
# Fails soft: a malformed index line is skipped, an index entry with no active
# rollout is skipped (archived or deleted — not an error). Only a layout we
# don't recognise at all gets a diagnostic, so an empty list is never silent
# when Codex is clearly installed but its storage has moved on.
discover_codex() {
  [ -r "$CODEX_INDEX" ] || return 0
  if [ ! -d "$CODEX_SESSIONS" ]; then
    echo "claude-session: $CODEX_INDEX exists but $CODEX_SESSIONS does not — unsupported Codex storage layout, skipping Codex sessions" >&2
    return 0
  fi
  awk '
    match($0, /"id":"[^"]+"/) {
      id = substr($0, RSTART + 6, RLENGTH - 7)
      if (match($0, /"thread_name":"[^"]*"/)) {
        nm = substr($0, RSTART + 15, RLENGTH - 16)
        if (nm != "") name[id] = nm
      }
    }
    END { for (id in name) printf "%s\t%s\n", id, name[id] }
  ' "$CODEX_INDEX" 2>/dev/null \
    | while IFS=$'\t' read -r sid name; do
        valid_codex_sid "$sid" || continue
        f=$(find "$CODEX_SESSIONS" -type f -name "rollout-*-${sid}.jsonl" 2>/dev/null | head -1)
        [ -n "$f" ] || continue   # no active rollout: archived or deleted
        cwd=$(head -1 "$f" 2>/dev/null | grep -oE '"cwd":"[^"]*"' | head -1 | sed 's/.*"cwd":"//; s/"$//')
        [ -d "$cwd" ] || continue
        epoch=$(stat -f %m "$f" 2>/dev/null || echo 0)
        printf '%s\t%s\t%s\t%s\tcodex\n' "$name" "$sid" "$cwd" "$epoch"
      done \
    | sort -t "$(printf '\t')" -k4,4nr | awk -F'\t' '!seen[$1]++'
}

# discover — both agents, newest first. Names are unique per agent (each
# source dedupes its own), but the SAME name may exist in both; that is left
# in so the direct-launch path can refuse it explicitly rather than pick one.
discover() {
  { discover_claude; discover_codex; } | sort -t "$(printf '\t')" -k4,4nr
}

reltime() {
  local now diff; now=$(date +%s); diff=$(( now - ${1:-0} ))
  if   [ "$diff" -lt 3600 ];  then echo "$((diff/60))m ago"
  elif [ "$diff" -lt 86400 ]; then echo "$((diff/3600))h ago"
  else echo "$((diff/86400))d ago"; fi
}

# tmux_name <name> [agent]: the tmux/cmux session identity. Codex sessions are
# prefixed so a Claude and a Codex session sharing a display name never share
# a tmux session — `tmux new-session -A` would otherwise silently attach to
# whichever agent got there first and drop the launch command on the floor.
tmux_name() {
  local base; base=$(printf '%s' "$1" | tr ' .:/' '____')
  case "${2:-claude}" in codex) printf 'codex_%s' "$base" ;; *) printf '%s' "$base" ;; esac
}

# in_cmux: this shell is hosted by a cmux pane (cmux exports surface/workspace
# ids into every terminal it spawns). In cmux mode cl skips tmux entirely —
# cmux's Claude integration owns persistence/restore (quit cmux = save; relaunch
# = resume by session id), so wrapping claude in tmux would only hide it from
# cmux's lifecycle badges, Feed, and restore.
# in_cmux: is this shell really a live cmux pane?
#
# Neither the environment nor "a cmux is running somewhere" is enough. A tmux
# server started under cmux keeps CMUX_* in its GLOBAL environment and hands
# them to every pane opened later — including panes opened from another
# terminal long after that cmux context died. If cmux has since reopened, or a
# second instance is running, "an app exists" makes those stale ids look
# authoritative and routes an iTerm launch down the cmux branch: no tab tag, no
# claim, and commands aimed at a surface that no longer exists.
#
# So ask cmux to affirm THIS shell's identity — the workspace id must appear in
# the live instance's own workspace list. If it cannot be affirmed (cmux gone,
# cmux restarted, ids belonging to some other context) the environment is
# stale, and the normal host path is taken. The launch paths also strip CMUX_*
# before exec, so nothing downstream inherits the lie.
#
# Surfaces cannot be checked this way — cmux lists them by ref, not by uuid —
# so a pane carrying only CMUX_SURFACE_ID counts as unaffirmed, which is the
# safe direction.
#
# Memoised: it shells out, and it is consulted on every launch decision.
in_cmux() {
  case "${_CL_IN_CMUX:-}" in yes) return 0 ;; no) return 1 ;; esac
  _CL_IN_CMUX=no
  [ -n "${CMUX_WORKSPACE_ID:-}" ] || return 1
  command -v cmux >/dev/null 2>&1 || return 1
  # Structural, exact comparison against the `.workspaces[].id` field. A
  # substring test over the raw JSON is not affirmation: the id `workspace`
  # matches a live `a-real-live-workspace`, and an id can match a title,
  # directory or any other value in the document. jq is already this tool's
  # dependency for stop/start; if it or the command or the schema is missing,
  # the context is simply unaffirmed — the safe direction.
  command -v jq >/dev/null 2>&1 || return 1
  if cmux workspace list --json 2>/dev/null \
     | jq -e --arg id "$CMUX_WORKSPACE_ID" \
         'any((.workspaces // [])[]?; (.id // "") == $id)' >/dev/null 2>&1; then
    _CL_IN_CMUX=yes; return 0
  fi
  return 1
}

# drop_cmux_env: strip inherited CMUX_* before exec'ing an agent outside cmux.
# Otherwise the agent — and cmux's own Claude hooks, which fire on every tool
# call — believe they are inside cmux and dial a socket that is not there.
drop_cmux_env() {
  local v
  for v in $(env | sed -n 's/^\(CMUX_[A-Za-z0-9_]*\)=.*/\1/p'); do
    unset "$v" 2>/dev/null
  done
}

# in_iterm: this shell is hosted by iTerm2 itself. Distinct from iterm_running:
# "iTerm is open somewhere" is the wrong gate for OPENING tabs — with cmux in
# the picture it would open tabs in a terminal the user isn't looking at.
# (iterm_running stays correct for CLOSING previously-tagged iTerm tabs.)
in_iterm() { ! in_cmux && [ "${TERM_PROGRAM:-}" = "iTerm.app" ]; }

# use_tmux: should this launch be wrapped in tmux?
#
# NOT in iTerm, by default. iTerm2 ships a Claude Code integration whose
# profile triggers key on the tab's foreground job name, and whose status hooks
# locate the tab from the agent's tty. Wrapped in tmux the job is `tmux` and the
# tty is a tmux pty, so neither can find the tab — the integration silently does
# nothing. Running the agent as the tab's own process is what makes it work,
# which is the same reason the cmux path skips tmux (cmux owns persistence
# there). CL_TMUX=1 opts back in, trading the integration for detach/reattach.
#
# Outside iTerm (Terminal.app, ssh, other emulators) nothing changes: tmux when
# it is available, because there detach/reattach is the only persistence there is.
use_tmux() {
  command -v tmux >/dev/null 2>&1 || return 1
  in_cmux && return 1   # cmux owns persistence; never nest tmux inside it
  if in_iterm; then [ "${CL_TMUX:-0}" = "1" ]; else return 0; fi
}

# claude_cmd: the command used to start claude in a cmux pane. Defaults to
# `cmux claude-teams`, which deploys cmux's fake-tmux shim so Agent Teams
# teammates render as native cmux splits — the teams *feature* comes from
# CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS in ~/.claude/settings.json; without the
# shim teammates run headless. CL_TEAMS=0 opts out (e.g. a cmux build without
# the claude-teams subcommand). Outside cmux this is always plain `claude`:
# the shim must not be nested inside real tmux, where teams uses real panes.
claude_cmd() {
  if in_cmux && [ "${CL_TEAMS:-1}" != "0" ] && command -v cmux >/dev/null 2>&1; then
    printf 'cmux claude-teams'
  else
    printf 'claude'
  fi
}

# codex_cmd: the command used to start codex in a cmux pane. `cmux codex-teams`
# is cmux's Codex analog of claude-teams; it is probed (not assumed) because
# cmux builds differ. CL_TEAMS=0 opts out, same switch as for claude. Outside
# cmux, plain `codex`.
codex_cmd() {
  if in_cmux && [ "${CL_TEAMS:-1}" != "0" ] && command -v cmux >/dev/null 2>&1 \
     && cmux --help 2>/dev/null | grep -q 'codex-teams'; then
    printf 'cmux codex-teams'
  else
    printf 'codex'
  fi
}

# Codex launch policy. cl adds NO approval/sandbox flag of its own: codex's
# configured defaults apply, exactly as if the user had typed `codex resume`.
# CL_CODEX_ARGS is purely additive and is TRUSTED SHELL SYNTAX — it is spliced
# into the tmux/cmux command string verbatim, so quote it as you would on a
# command line (e.g. CL_CODEX_ARGS='-m gpt-5 --approve-for-me'). It is placed
# BEFORE the subcommand (`codex <args> resume <id>`): these are top-level
# options, and some Codex builds reject them after `resume` while every build
# accepts them before it. `--remote` is unsupported here: discovery reads
# local storage, so resuming a locally found id on a remote app server is
# meaningless.
# (Claude's path keeps --dangerously-skip-permissions: that predates this
# design and is documented in DECISIONS.md rather than silently changed.)
codex_args() { printf '%s' "${CL_CODEX_ARGS:-}"; }

# resume_cmd <agent> <sid>: the shell command string that resumes a session.
# Used verbatim as a tmux/cmux pane command; for exec paths the same words
# are re-split by the caller.
resume_cmd() {
  case "$1" in
    codex) printf '%s %s resume %s' "$(codex_cmd)" "$(codex_args)" "$(printf '%q' "$2")" ;;
    *)     printf '%s --resume %s --dangerously-skip-permissions' "$(claude_cmd)" "$(printf '%q' "$2")" ;;
  esac
}

# session_pid <sid> [agent]: pid of a local process that resumed this session,
# if any. Guards cmux mode against double --resume of one session (two
# processes on the same transcript) — the hazard tmux's attach-don't-duplicate
# used to prevent.
#
# For codex this is a "matching local resume process" marker, NOT proof the
# thread is live or idle: Codex also runs threads through a shared app-server
# daemon, the Desktop app, and --remote clients, none of which show a `resume
# <sid>` argv here — and the npm launcher is a node wrapper plus a native
# child that BOTH match. So: a hit is a conservative reason to refuse a second
# launch; a miss proves nothing; and the pid must never be used as a kill target.
# --- launch registry ---------------------------------------------------------
# A session created by `cl new` runs `claude --name <name>`: its argv carries no
# session id, so an id match cannot find it. `tmux has-session` used to cover
# that; without tmux nothing did, and `cl stop` skipped the newest session while
# reporting the fleet saved.
#
# Matching the NAME inside ps output is not a safe answer: ps renders the
# command as text, so `--name Solo` is a substring of `--name Solo Two` and the
# wrong agent gets killed. Instead, record the pid at launch. `exec` keeps both
# the pid AND the process start time, so a record written by this shell just
# before exec still describes the agent that replaces it — and the start time
# makes pid reuse detectable. No command-text parsing anywhere.
#
# Only sessions this tool launched outside tmux are registered; that is exactly
# the set nothing else can identify. A record judged stale is left in place for
# the claim holder to overwrite — read paths never mutate one.
PID_DIR="$HOME/.config/claude-session/pids"

# The key is a digest of agent + the EXACT name. It deliberately does NOT reuse
# tmux_name's sanitiser, which maps `A B` and `A.B` to one identity.
# Under tmux that collision was harmless —
# `new-session -A` made colliding names share one session, so two owners could
# not exist. Bare, both launch, the second record overwrites the first, and a
# kill path then reads someone else's pid. The record also carries the agent
# and name so a mismatch can be caught even if a digest ever collided.
reg_file() { # name [agent]
  local key
  key=$(printf '%s\037%s' "${2:-claude}" "$1" | shasum -a 256 2>/dev/null | cut -c1-40)
  [ -n "$key" ] || key=$(printf '%s\037%s' "${2:-claude}" "$1" | cksum | tr -d ' ')
  printf '%s/%s' "$PID_DIR" "$key"
}

# Remove a record ONLY if it still describes the exact owner being retired —
# pid AND start token AND agent AND name — and only while holding that name's
# claim. `cl stop` kills a pid and then cleans up; a new launcher can acquire
# and register in between, and a replacement can even REUSE the dead pid, which
# is exactly why the record carries a start token. Comparing the number alone
# would delete that replacement's registration. If the claim cannot be taken,
# the record is left alone — a stale record is inert, a deleted live one is not.
#
# The caller must capture the token BEFORE killing: it cannot be read back out
# of a dead process.
clear_launch() { # name agent expected-pid expected-token
  local f lock me rpid rtok ragent rname
  [ -n "${3:-}" ] && [ -n "${4:-}" ] || return 0
  f=$(reg_file "$1" "${2:-claude}"); lock="${f}.lock"
  [ -r "$f" ] || return 0
  # A real start token, not a placeholder: acquire_launch parses this target as
  # pid:token, so "cleanup" would make a LIVE cleanup holder look like a dead
  # one and tell the user to delete a perfectly valid lock.
  me=$(claim_token); case "$me" in *:) return 0 ;; esac
  ln -s "$me" "$lock" 2>/dev/null || return 0
  IFS=$(printf '\t') read -r rpid rtok ragent rname < "$f" 2>/dev/null
  if [ "$rpid" = "$3" ] && [ "$rtok" = "$4" ] \
     && [ "$ragent" = "${2:-claude}" ] && [ "$rname" = "$1" ]; then
    rm -f "$f" 2>/dev/null
  fi
  rm -f "$lock" 2>/dev/null
  return 0
}

# start_token <pid>: the process's start time as one whitespace-free word, so
# it can live in a record field or a symlink target. Empty if the process is
# gone — callers treat empty as "cannot prove anything about this pid".
start_token() { ps -o lstart= -p "${1:-$$}" 2>/dev/null | tr -s ' ' | tr ' ' '_'; }

# claim_token: the lock symlink's target — `<pid>:<start token>`. Both holders
# of a claim (a launcher and a cleanup) MUST use this, because acquire_launch
# parses the target back into pid and token to decide whether the holder is
# still alive. A hand-written placeholder here made a running cleanup read as a
# dead holder and told the user to delete a valid lock; one definition removes
# the chance of the two drifting apart again.
claim_token() { printf '%s:%s' "$$" "$(start_token $$)"; }


# READ-ONLY on purpose. It used to delete records it judged stale, which is the
# same validate-then-unlink-a-pathname race as the claim lock: a launcher
# holding the lock can write a fresh record between the read and the delete,
# and the cleanup would then remove the NEW owner's registration, leaving that
# agent untracked and duplicable. A stale record is harmless — every reader
# validates before trusting, and acquire_launch overwrites it while holding the
# lock — so nothing here mutates.
registered_pid() { # name [agent] -> live pid we launched, or nothing
  local f pid started ragent rname now
  f=$(reg_file "$1" "${2:-claude}")
  [ -r "$f" ] || return 0
  IFS=$(printf '\t') read -r pid started ragent rname < "$f" || return 0
  case "$pid" in ''|*[!0-9]*) return 0 ;; esac
  # A record must prove it is about THIS session before a kill path sees it.
  [ "$ragent" = "${2:-claude}" ] && [ "$rname" = "$1" ] || return 0
  now=$(start_token "$pid")
  # Gone, or the pid was recycled into a different process: the record is a
  # lie, so report nothing — but leave it for the lock holder to replace.
  [ -n "$now" ] && [ "$now" = "$started" ] && printf '%s\n' "$pid"
  return 0
}

# retire_process <pid> <token> <label>: signal EXACTLY the process identified
# by that pid+start-token pair, then wait for it to actually go.
#
# Revalidating at the destructive boundary is the point. `cl stop` may sit on a
# "kill it anyway?" prompt for as long as a person takes to answer; the original
# process can exit in that window and its pid be reused, and an unrevalidated
# `kill` would then signal a stranger. Prints nothing and returns 1 when the
# identity no longer matches — the caller reports it as "exited while deciding".
#
# Returns 0 when the process is confirmed gone, 2 when it was signalled but is
# still shutting down (SessionEnd hooks can take a moment). A caller must NOT
# retire the ownership record in that case: until the process is really gone,
# that record is the only thing stopping a second agent from launching.
retire_process() { # pid token [exit-wait-tries]
  local i=0 max="${3:-30}"
  [ -n "$1" ] && [ -n "$2" ] || return 1
  [ "$(start_token "$1")" = "$2" ] || return 1     # not the process we meant
  kill "$1" 2>/dev/null || return 1
  while [ "$(start_token "$1")" = "$2" ]; do
    i=$((i+1)); [ "$i" -gt "$max" ] && return 2
    sleep 0.1
  done
  return 0
}

# acquire_launch <name> <agent> [sid]: claim this session, or print the pid
# that already owns it and return 1.
#
# Atomic on purpose. A check followed by a write is not: two tabs running
# `cl <name>` together could both see nothing, both write, and both exec an
# agent on one transcript. `tmux new-session -A` used to be that arbiter; with
# no tmux we have to be it. mkdir is the atomic primitive — it either creates
# the directory or fails — so the check and the claim happen under it.
acquire_launch() {
  local f lock me holder hpid hstart tries=0 envfail=0 owner back
  me=$(start_token $$)
  # Without a start token the record could never be validated later, so there
  # is no safe way to own anything. Fail closed.
  [ -n "$me" ] || { echo "claude-session: cannot read this process's start time — refusing to launch unowned" >&2; return 2; }
  f=$(reg_file "$1" "${2:-claude}"); lock="${f}.lock"
  mkdir -p "$PID_DIR" 2>/dev/null || { echo "claude-session: cannot create $PID_DIR — refusing to launch a session the registry cannot track" >&2; return 2; }

  # The lock is a SYMLINK whose target names its owner. ln -s is atomic and
  # carries the identity in the same operation, so there is never a window
  # where the lock exists but its owner is unknown.
  # `ln -s target dir` creates the link INSIDE the directory and reports
  # success, so anything that is not a symlink sitting at the lock path would
  # hand us a lock we do not actually hold. Refuse rather than pretend.
  if [ -e "$lock" ] && [ ! -L "$lock" ]; then
    echo "claude-session: $lock exists and is not a claim lock — remove it, then retry" >&2
    return 2
  fi
  while ! ln -s "$(claim_token)" "$lock" 2>/dev/null; do
    holder=$(readlink "$lock" 2>/dev/null)
    if [ -z "$holder" ]; then
      # Either the lock vanished between our attempt and the read (retrying is
      # right), or links cannot be created here at all — in which case looping
      # would spin forever, so fail closed after a few tries.
      if [ ! -L "$lock" ] && [ ! -e "$lock" ]; then
        envfail=$((envfail+1))
        if [ "$envfail" -gt 5 ]; then
          echo "claude-session: cannot create the claim lock in $PID_DIR — refusing to launch untracked" >&2
          return 2
        fi
      fi
      sleep 0.1; continue
    fi
    hpid=${holder%%:*}; hstart=${holder#*:}
    # Reclaim ONLY on proof the holder is gone or its pid was recycled. Age is
    # not proof: a holder merely slow in ps/pgrep/IO would have its lock stolen
    # and two launchers would enter the critical section together.
    # A stale lock is NEVER unlinked automatically. Validating the symlink and
    # then `rm`-ing its pathname are two operations: between them another
    # waiter can reclaim and establish a live claim, and the delete would then
    # destroy THAT claim and let two launchers into the critical section. The
    # start-token proof authenticates the object read, not the object later
    # unlinked, and portable shell has no compare-and-swap to close that. So:
    # report it and let a person clear it. (A launcher has to die inside a
    # few-millisecond window to leave one, so this should be vanishingly rare.)
    case "$hpid" in
      ''|*[!0-9]*)
        echo "claude-session: $lock is malformed — clear it, then retry:" >&2
        echo "  rm -f $(printf '%q' "$lock")" >&2
        return 2 ;;
    esac
    if [ "$(start_token "$hpid")" != "$hstart" ]; then
      echo "claude-session: a previous launcher (pid $hpid) died holding the claim for \"$1\" — clear it, then retry:" >&2
      echo "  rm -f $(printf '%q' "$lock")" >&2
      return 2
    fi
    tries=$((tries+1))
    if [ "$tries" -gt "${CL_CLAIM_WAIT_TRIES:-100}" ]; then
      echo "claude-session: another launcher (pid $hpid) is still claiming \"$1\" — not launching; try again" >&2
      return 2
    fi
    sleep 0.1
  done

  owner=""
  [ -z "${3:-}" ] || owner=$(session_pid "$3" "${2:-claude}" "$1")
  [ -n "$owner" ] || owner=$(registered_pid "$1" "${2:-claude}")
  if [ -n "$owner" ]; then
    rm -f "$lock" 2>/dev/null
    printf '%s\n' "$owner"
    return 1
  fi
  # exec keeps this pid AND this start time, so the record describes the agent
  # that is about to replace this shell. Written, then read back: a record that
  # did not land means the session would be unidentifiable, which is the whole
  # failure this registry exists to prevent — so that fails closed too.
  if ! printf '%s\t%s\t%s\t%s\n' "$$" "$me" "${2:-claude}" "$1" > "$f" 2>/dev/null; then
    rm -f "$f" "$lock" 2>/dev/null
    echo "claude-session: cannot write the ownership record in $PID_DIR — refusing to launch untracked" >&2
    return 2
  fi
  back=$(registered_pid "$1" "${2:-claude}")
  rm -f "$lock" 2>/dev/null
  if [ "$back" != "$$" ]; then
    rm -f "$f" 2>/dev/null
    echo "claude-session: the ownership record did not verify — refusing to launch untracked" >&2
    return 2
  fi
  return 0
}

session_pid() { # sid [agent] [name]
  local pid
  case "${2:-claude}" in
    codex) pgrep -f "codex.* resume $1( |\$)" 2>/dev/null | head -1 ;;
    *)
      pid=$(pgrep -f "(-resume|-session-id) $1" 2>/dev/null | head -1)
      [ -n "$pid" ] || [ -z "${3:-}" ] || pid=$(registered_pid "$3" claude)
      printf '%s\n' "$pid"
      ;;
  esac
}

# Server-global tmux setup applied idempotently before each launch (exec
# replaces this process, so it can't run after): terminal titles track the
# session name, and Ctrl-Z is swallowed unless the pane runs a shell. Claude
# Code can't disable its Ctrl-Z suspend, and a suspended claude in a cl pane
# has no parent shell to `fg` from (recovery requires kill -CONT). Shells still
# get Ctrl-Z so job control works in normal panes. Applied here rather than
# ~/.tmux.conf so cl is self-contained on any machine.
tmux_setup() {
  command -v tmux >/dev/null 2>&1 || return 0
  tmux start-server 2>/dev/null
  tmux set -g set-titles on 2>/dev/null
  tmux set -g set-titles-string "#S" 2>/dev/null
  tmux bind-key -n C-z if-shell -F '#{m:*sh,#{pane_current_command}}' 'send-keys C-z' '' 2>/dev/null
  # Terminal features the agent needs and tmux withholds by default: OSC
  # passthrough (notifications, progress) and extended keys (Shift+Enter).
  # These do NOT make the iTerm integration work under tmux — job-name
  # detection still sees `tmux` — they just make the opt-in path less degraded.
  tmux set -g allow-passthrough on 2>/dev/null
  tmux set -s extended-keys on 2>/dev/null
  tmux set -as terminal-features 'xterm*:extkeys' 2>/dev/null
  # The server outlives the cmux session that started it and keeps CMUX_* in
  # its global environment, so every later pane inherits them. Clear them when
  # this launch is not in cmux, or those panes keep failing at a dead socket.
  if ! in_cmux; then
    local _v
    for _v in $(tmux show-environment -g 2>/dev/null | sed -n 's/^\(CMUX_[A-Za-z0-9_]*\)=.*/\1/p'); do
      tmux set-environment -gu "$_v" 2>/dev/null
    done
  fi
}

# iterm_running: true when iTerm2 is actually running. Env vars are unreliable
# (TERM_PROGRAM is clobbered to "tmux" inside a client), so ask the OS instead.
iterm_running() {
  command -v osascript >/dev/null 2>&1 || return 1
  osascript -e 'tell application "System Events" to (name of processes) contains "iTerm2"' \
    2>/dev/null | grep -q true
}

# tag_iterm_session <tmux_name>: mark the CURRENT iTerm session with a user
# variable (user.clSession) via the OSC 1337 SetUserVar escape, so `cl stop` can
# later find and close this exact tab. Emitted before tmux takes over the tty.
# Harmless in non-iTerm terminals — they ignore the unknown escape sequence.
tag_iterm_session() {
  local b64; b64=$(printf '%s' "$1" | base64 | tr -d '\n')
  printf '\033]1337;SetUserVar=clSession=%s\007' "$b64"
}

# close_iterm_tab <tmux_name>: close the iTerm tab tagged with
# user.clSession == <tmux_name>. Skips the session running this command so
# `cl stop` never yanks closed its own terminal. Best-effort; no-op if the tab
# isn't found or iTerm can't be scripted. Collects matches first, then closes,
# to avoid mutating the tab collection mid-iteration.
close_iterm_tab() {
  local esc="$1"
  esc="${esc//\\/\\\\}"; esc="${esc//\"/\\\"}"
  osascript >/dev/null 2>&1 <<OSA
tell application "iTerm"
  set curId to -1
  try
    set curId to id of current session of current tab of current window
  end try
  set toClose to {}
  repeat with w in windows
    repeat with tb in tabs of w
      repeat with s in sessions of tb
        try
          set varVal to ""
          tell s to set varVal to (variable named "user.clSession")
          if varVal is "${esc}" and (id of s) is not curId then set end of toClose to s
        end try
      end repeat
    end repeat
  end repeat
  repeat with s in toClose
    try
      close s
    end try
  end repeat
end tell
OSA
}

launch_session() { # name sid cwd [agent]
  local name="$1" sid="$2" cwd="$3" agent="${4:-claude}" t pid cmd
  t=$(tmux_name "$name" "$agent"); [ -d "$cwd" ] || cwd="$HOME"
  cmd=$(resume_cmd "$agent" "$sid")
  # `tmux new-session -A` attaches instead of duplicating; nothing does that
  # for us otherwise, so a second launch has to be refused here. cmux keeps the
  # plain check (it owns its own workspace lifecycle); the bare path below uses
  # the atomic claim, because there two tabs really can race.
  if in_cmux; then
    pid=$(session_pid "$sid" "$agent" "$name")
    if [ -n "$pid" ]; then
      echo "\"$name\" already has a local process resuming it (pid $pid) — switch to its tab instead of resuming it twice." >&2
      exit 1
    fi
    cmux rename-tab "$name" >/dev/null 2>&1
    cd "$cwd" || exit 1; eval "exec $cmd"
  fi
  # The iTerm tab is tagged in BOTH branches: `cl stop` closes tabs by that
  # user variable, and that has nothing to do with tmux.
  in_iterm && tag_iterm_session "$t"
  if use_tmux; then
    tmux_setup
    exec tmux new-session -A -s "$t" -c "$cwd" "$cmd"
  else
    pid=$(acquire_launch "$name" "$agent" "$sid"); local arc=$?
    if [ "$arc" -eq 1 ]; then
      echo "\"$name\" already has a local process resuming it (pid $pid) — switch to its tab instead of resuming it twice." >&2
      exit 1
    elif [ "$arc" -ne 0 ]; then
      exit 1   # acquire_launch already said exactly what went wrong
    fi
    drop_cmux_env; cd "$cwd" || exit 1; eval "exec $cmd"
  fi
}

launch_new() { # cwd [agent]
  local cwd="$1" agent="${2:-claude}" t cmd; [ -d "$cwd" ] || cwd="$PWD"
  case "$agent" in
    codex) cmd="$(codex_cmd) $(codex_args)" ;;
    *)     cmd="$(claude_cmd) --dangerously-skip-permissions" ;;
  esac
  if in_cmux; then
    cd "$cwd" || exit 1; eval "exec $cmd"
  fi
  t="$agent-$(basename "$cwd")"
  if use_tmux; then
    tmux_setup
    exec tmux new-session -A -s "$t" -c "$cwd" "$cmd"
  else
    drop_cmux_env; cd "$cwd" || exit 1; eval "exec $cmd"
  fi
}

# launch_named <name> <cwd> [agent]: create + attach a fully-named session.
# The interactive create path shared by `cl new` and the picker's "new" entry.
#   claude: `claude --name` sets the title at launch, so discovery finds it
#           immediately.
#   codex:  there is NO launch-time name flag. The name labels the tmux
#           session / cmux tab only; the thread is unnamed (and invisible to
#           `cl --list`) until the user runs /rename inside codex. Said so
#           on screen rather than pretended.
launch_named() { # name cwd [agent]
  local name="$1" cwd="$2" agent="${3:-claude}" t qname cmd
  [ -d "$cwd" ] || cwd="$HOME"
  qname=$(printf '%q' "$name")
  case "$agent" in
    codex)
      cmd="$(codex_cmd) $(codex_args)"
      printf 'note: codex cannot be named at launch — run /rename %s inside codex so cl can find it.\n' "$qname" >&2
      ;;
    *) cmd="$(claude_cmd) --name $qname --dangerously-skip-permissions" ;;
  esac
  if in_cmux; then
    cmux rename-tab "$name" >/dev/null 2>&1
    cd "$cwd" || exit 1; eval "exec $cmd"
  fi
  t=$(tmux_name "$name" "$agent")
  in_iterm && tag_iterm_session "$t"
  if use_tmux; then
    tmux_setup
    exec tmux new-session -A -s "$t" -c "$cwd" "$cmd"
  else
    local owner arc
    owner=$(acquire_launch "$name" "$agent"); arc=$?
    if [ "$arc" -eq 1 ]; then
      echo "\"$name\" is already running (pid $owner) — switch to its tab instead of starting it twice." >&2
      exit 1
    elif [ "$arc" -ne 0 ]; then
      exit 1
    fi
    drop_cmux_env; cd "$cwd" || exit 1; eval "exec $cmd"
  fi
}

# launch_fresh <name> <cwd> <initial_prompt>: like launch_named, but for
# `cl start --fresh` — a NEW claude process registers under the SAME name (so
# cross-session SendMessage and `cl <name>` keep working), in the same dir,
# through the same wrapper/teams selection (claude_cmd), with one difference:
# its first message is the initial prompt, passed as claude's trailing
# positional argument (claude sends it immediately on launch, then stays
# interactive) — that's what makes this "read your handoff and continue"
# instead of a blank session. Codex is out of scope: fresh-start is defined
# in terms of the handoff file, and only Claude sessions write one (see
# request_handoff).
launch_fresh() {
  local name="$1" cwd="$2" prompt="$3" t qname qprompt cmd
  [ -d "$cwd" ] || cwd="$HOME"
  qname=$(printf '%q' "$name"); qprompt=$(printf '%q' "$prompt")
  cmd="$(claude_cmd) --name $qname --dangerously-skip-permissions $qprompt"
  if in_cmux; then
    cmux rename-tab "$name" >/dev/null 2>&1
    cd "$cwd" || exit 1; eval "exec $cmd"
  fi
  t=$(tmux_name "$name" claude)
  in_iterm && tag_iterm_session "$t"
  if use_tmux; then
    tmux_setup
    exec tmux new-session -A -s "$t" -c "$cwd" "$cmd"
  else
    local owner arc
    owner=$(acquire_launch "$name" claude); arc=$?
    if [ "$arc" -eq 1 ]; then
      echo "\"$name\" is already running (pid $owner) — switch to its tab instead of starting it twice." >&2
      exit 1
    elif [ "$arc" -ne 0 ]; then
      exit 1
    fi
    drop_cmux_env; cd "$cwd" || exit 1; eval "exec $cmd"
  fi
}

# do_new: create a NEW, fully-named session in one step — no /rename → exit →
# re-pick dance. `claude --name` sets the session's customTitle AT LAUNCH, so
# discover(), the picker, and `cl start` all find it immediately.
#   cl new "Session Name"        → launch in $PWD (default: where you are)
#   cl new "Session Name" -d      → launch in $CL_DEFAULT_DIR (your main repo)
#   cl new "Session Name" <dir>   → launch in that explicit dir
# Interactive → create + attach. No TTY (script / a Claude Bash call) → create
# detached and print how to attach, so the caller isn't left hanging.
do_new() {
  local agent="claude"
  case "${1:-}" in
    --codex)  agent="codex";  shift ;;
    --claude) agent="claude"; shift ;;
  esac
  local name="${1:-}" arg="${2:-}" cwd
  [ -n "$name" ] || { echo 'usage: cl new [--codex] "Session Name" [dir | -d]' >&2; exit 1; }
  case "$arg" in
    -d|--default)
      cwd="${CL_DEFAULT_DIR:-}"
      [ -n "$cwd" ] || { echo "claude-session: -d given but CL_DEFAULT_DIR is not set (export it in your shell rc)" >&2; exit 1; }
      ;;
    "")  cwd="$PWD" ;;
    *)   cwd="$arg" ;;
  esac
  [ -d "$cwd" ] || { echo "claude-session: no such directory: $cwd" >&2; exit 1; }

  local t qname cmd
  t=$(tmux_name "$name" "$agent")
  qname=$(printf '%q' "$name")   # safe to embed in the tmux command string
  case "$agent" in
    codex) cmd="$(codex_cmd) $(codex_args)"
           echo "note: codex cannot be named at launch — run /rename $qname inside codex so cl can find it." >&2 ;;
    *)     cmd="$(claude_cmd) --name $qname --dangerously-skip-permissions" ;;
  esac

  if in_cmux; then
    if [ -t 1 ] && [ -t 0 ]; then
      launch_named "$name" "$cwd" "$agent"
    else
      # no TTY (script / Claude Bash call): open a fresh cmux workspace so the
      # caller isn't blocked, mirroring the detached-tmux path below.
      cmux new-workspace --name "$name" --cwd "$cwd" --command "$cmd" >/dev/null \
        && echo "created cmux workspace '$name' in $cwd"
    fi
    exit 0
  fi

  if [ -t 1 ] && [ -t 0 ]; then
    # interactive: create + attach, like the picker
    launch_named "$name" "$cwd" "$agent"
  elif ! use_tmux; then
    # No TTY and nothing to detach into. Say so rather than exec a TTY-less
    # agent that will exit immediately and look like a silent failure.
    echo "claude-session: no TTY and not using tmux — cannot create '$name' detached." >&2
    echo "  run cl new from a terminal, or set CL_TMUX=1 to create it in tmux." >&2
    exit 1
  else
    # no TTY (script / Claude Bash call): create detached so the caller isn't
    # blocked on an attach — attach later with `cl "<name>"`.
    tmux_setup
    if tmux has-session -t "=${t}" 2>/dev/null; then
      echo "session '$name' already exists — attach with: cl \"$name\""
    else
      tmux new-session -d -s "$t" -c "$cwd" "$cmd" \
        && echo "created '$name' in $cwd — attach with: cl \"$name\""
    fi
  fi
}

# --- start/stop support -----------------------------------------------------
# These mirror the picker's style ([ ] tests, exec-to-tmux) on purpose so the
# script reads as one piece. session_busy uses the `caffeinate` wake-lock that
# `claude` spawns while working: claude's TUI uses the alternate screen buffer,
# so `tmux capture-pane` returns nothing and process state is the only reliable
# external signal. The signal is conservative — caffeinate's timeout lingers a
# few minutes after work ends — so stop errs toward asking, never silent-killing.

# claude_busy <pid>: 0 (true) if that claude process looks mid-task — a
# caffeinate child, or CPU over ~15%. Works on any claude pid (tmux pane or
# cmux pane); the terminal doesn't matter, only the process tree does.
claude_busy() {
  local pid="$1" kid cmd cpu
  [ -n "$pid" ] || return 1
  for kid in $(pgrep -P "$pid" 2>/dev/null); do
    cmd=$(ps -o command= -p "$kid" 2>/dev/null)
    case "$cmd" in *caffeinate*) return 0 ;; esac
  done
  cpu=$(ps -o %cpu= -p "$pid" 2>/dev/null | tr -d ' ')
  # Integer compare on the whole-number part; >=15% CPU counts as working.
  [ "${cpu%%.*}" -ge 15 ] 2>/dev/null && return 0
  return 1
}

# session_busy <tmux_session_name>: tmux flavor of claude_busy — the pane's
# root process IS the claude (tmux runs it as the pane command).
session_busy() {
  local ppid
  ppid=$(tmux list-panes -t "=${1}" -F '#{pane_pid}' 2>/dev/null | head -1)
  claude_busy "$ppid"
}

# close_cmux_surface <sid> [display_name]: best-effort close of the cmux surface
# hosting this session, looked up in cmux's own session store. Called after the
# claude is dead, so the surface holds nothing but a bare shell.
#
# The gate is "is cmux installed", NOT in_cmux. `cl stop` is routinely run from
# iTerm or a plain terminal while cmux surfaces are alive elsewhere, and gating
# on in_cmux made this a no-op exactly then — leaving every cmux workspace
# holding an orphaned shell. Whether a surface exists is already answered by the
# session store, not by where the operator happens to be typing.
close_cmux_surface() {
  local sid="$1" name="${2:-$1}" sfc
  local store="$HOME/.cmuxterm/claude-hook-sessions.json"
  command -v cmux >/dev/null 2>&1 || return 0
  [ -r "$store" ] || return 0
  if ! command -v jq >/dev/null 2>&1; then
    printf '⚠ left cmux workspace for "%s" open — jq is needed to read the surface id\n' "$name" >&2
    return 0
  fi
  sfc=$(jq -r --arg sid "$sid" '.sessions[$sid].surfaceId // empty' "$store" 2>/dev/null)
  # No recorded surface means cmux never hosted this session: there is nothing to
  # close, and `--surface ""` would close the operator's OWN pane. Stay silent —
  # warning here would fire on every plain tmux session.
  [ -n "$sfc" ] || return 0
  if ! cmux close-surface --surface "$sfc" >/dev/null 2>&1; then
    printf '⚠ left cmux workspace for "%s" open — cmux close-surface %s failed\n' "$name" "$sfc" >&2
  fi
  return 0
}

# retire_claude_session <name> <sid> <tmux_name> <close_tabs>: kill the live
# Claude session identified by these — tmux-hosted, cmux-native, or bare — the
# ONE way, for every caller. Both `do_stop` and `do_fresh_start` need this
# exact logic; it used to be duplicated, and the duplicate in `do_fresh_start`
# had silently dropped the hidden-tmux ownership guard below (reintroducing
# the cross-socket kill hazard `do_stop` was specifically hardened against on
# 2026-07-31) and the iTerm-tab cleanup on a successfully retired bare
# process. Found in Codex review, 2026-09-23 — extracted to one
# return-code-bearing implementation instead of maintaining a second
# safety-sensitive copy.
#
# Returns:
#   0  retired — confirmed gone, or nothing was live to begin with
#   1  left running — the operator declined a "kill/retire anyway?" prompt
#   2  signalled but still shutting down, or the kill itself failed —
#      ownership must NOT be treated as free (a caller must not launch a
#      replacement under this name)
retire_claude_session() {
  local name="$1" sid="$2" t="$3" close_tabs="$4" ans pid ptok rrc _ppid _pcomm
  if tmux has-session -t "=${t}" 2>/dev/null; then
    if session_busy "$t"; then
      printf '⏳ "%s" looks mid-task. Kill it anyway? [y/N] ' "$name" >&2
      read -r ans </dev/tty
      case "$ans" in
        y|Y) : ;;
        *) printf '   left %s running — re-run later to retire it\n' "$name" >&2; return 1 ;;
      esac
    fi
    if tmux kill-session -t "=${t}" 2>/dev/null; then
      printf '✓ killed %s\n' "$name" >&2
      [ "$close_tabs" = "1" ] && close_iterm_tab "$t"
      close_cmux_surface "$sid" "$name"
      return 0
    fi
    printf '⚠ tmux kill-session failed for "%s" — leaving it registered\n' "$name" >&2
    return 2
  fi

  # No tmux session — a cmux-native (or bare) claude: kill the process
  # itself, the SAME way do_stop always has (SIGTERM, then close the now-bare
  # surface best-effort).
  pid=$(session_pid "$sid" claude "$name")
  [ -n "$pid" ] || return 0   # nothing live — already retired

  ptok=$(start_token "$pid")
  # Safety: a claude whose PARENT is a tmux server belongs to tmux — if we
  # can't see that server (different socket/user context), it is not ours to
  # process-kill. (Learned the hard way 2026-07-31: a hidden tmux server let
  # an earlier version of this branch sweep 10 live tmux-hosted sessions;
  # re-learned 2026-09-23 when a duplicated copy of this logic in
  # do_fresh_start had dropped the guard again.)
  _ppid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
  _pcomm=$(ps -o comm= -p "${_ppid:-0}" 2>/dev/null); _pcomm=${_pcomm##*/}
  case "$_pcomm" in
    tmux*) printf '⚠ skipping %s — owned by a tmux server not visible here\n' "$name" >&2; return 2 ;;
  esac

  if claude_busy "$pid"; then
    printf '⏳ "%s" (pid %s) looks mid-task. Kill it anyway? [y/N] ' "$name" "$pid" >&2
    read -r ans </dev/tty
    case "$ans" in
      y|Y) : ;;
      *) printf '   left %s running — re-run later to retire it\n' "$name" >&2; return 1 ;;
    esac
  fi

  retire_process "$pid" "$ptok"; rrc=$?
  case "$rrc" in
    0) printf '✓ killed %s\n' "$name" >&2
       clear_launch "$name" claude "$pid" "$ptok"
       [ "$close_tabs" = "1" ] && close_iterm_tab "$t"
       close_cmux_surface "$sid" "$name"
       return 0 ;;
    2) printf '✓ signalled %s — still shutting down, leaving it registered\n' "$name" >&2
       [ "$close_tabs" = "1" ] && close_iterm_tab "$t"
       close_cmux_surface "$sid" "$name"
       return 2 ;;
    *)
       # retire_process returns 1 for TWO different situations that must not
       # be treated alike: the identity no longer matching (the process is
       # already gone or was replaced — genuinely safe, nothing to kill), and
       # `kill` itself failing while the SAME process is still alive (not
       # safe at all — the original was never even signalled). Re-checking
       # identity here is what tells them apart; retire_process's own return
       # value alone doesn't. (Found in Codex review round 2, 2026-09-23: the
       # earlier version mapped every non-0/non-2 return to "exited, safe",
       # which reported a failed signal as a confirmed retirement and let
       # do_fresh_start launch a second agent under the same name.)
       if [ "$(start_token "$pid")" = "$ptok" ]; then
         printf '⚠ could not signal %s (pid %s) — it is still alive, leaving it registered\n' "$name" "$pid" >&2
         return 2
       fi
       printf '⚠ %s exited before it could be signalled\n' "$name" >&2
       return 0 ;;
  esac
}

# --- handoff (cl stop) -------------------------------------------------------
# Before a session is killed, ask IT to write its own handoff — it has the
# context; `cl` never does. The mechanism is "type into the
# pane", the same trust boundary `cl` already crosses for close_iterm_tab/
# open_iterm_tabs: a literal, single-line instruction (no embedded newlines, so
# there is no multi-line-paste/early-submit ambiguity across tmux/iTerm/cmux),
# sent as if a person typed it, then Enter. `cl` never reads the pane back
# (claude's TUI is on the alt-screen, same reason session_busy exists) — it
# polls for the handoff FILE to appear, which is the one observable outcome
# that matters.
#
# The prompt embeds no shell state, only the resolved path (handoff dir or
# fallback, already decided by handoff_root) — so what gets typed into the pane
# is exactly what a person would type.
#
# The handoff must be the LAST thing written, and the default prompt says so.
# `cl` has exactly one observable completion signal, so anything a custom
# prompt asks for in addition has to happen BEFORE the handoff lands, or a kill
# can arrive mid-edit. (An earlier version wrote the handoff first; its mtime
# then advanced before the rest of the work had started — which is also why
# completion is a per-request nonce rather than an mtime. See handoff_nonce.)
# build_resume_prompt <handoff-path>: the first message a fresh session gets.
#
# Overridable for the same reason the handoff prompt is — what a new session
# should read before continuing is a workflow, not a property of this tool.
# Placeholder: {{handoff}}. Newlines flattened; typed as claude's first message.
build_resume_prompt() {
  local hp="$1" custom
  if [ -r "$CL_RESUME_PROMPT_FILE" ]; then
    custom=$(tr '\n' ' ' < "$CL_RESUME_PROMPT_FILE" 2>/dev/null)
    if [ -n "${custom// /}" ]; then
      printf '%s' "${custom//\{\{handoff\}\}/$hp}"
      return 0
    fi
  fi
  printf 'Read your handoff at "%s", then continue.' "$hp"
}

build_handoff_prompt() { # root name nonce
  local root="$1" name="$2" nonce="$3" hp custom
  hp=$(handoff_path "$root" "$name")

  # A custom prompt is the supported way to ask for more than a handoff. The
  # default below asks for the handoff and nothing else, because that is the
  # only thing this tool can define for everyone: what else is worth tidying
  # before a session ends — a board, a task list, a journal — is a workflow,
  # and workflows belong to the person, not to a shared script. The original
  # version of this feature had one person's board rules typed into it.
  #
  # Placeholders, substituted literally (never eval'd): {{handoff}} {{nonce}}
  # {{name}} {{store}}. Newlines are flattened to spaces because this is typed
  # into a live TUI, where a newline submits.
  if [ -r "$CL_HANDOFF_PROMPT_FILE" ]; then
    custom=$(tr '\n' ' ' < "$CL_HANDOFF_PROMPT_FILE" 2>/dev/null)
    if [ -n "${custom// /}" ]; then
      custom=${custom//\{\{handoff\}\}/$hp}
      custom=${custom//\{\{nonce\}\}/$nonce}
      custom=${custom//\{\{name\}\}/$name}
      custom=${custom//\{\{store\}\}/$root}
      printf '%s' "$custom"
      return 0
    fi
    printf 'claude-session: %s is empty — using the default handoff prompt\n' \
      "$CL_HANDOFF_PROMPT_FILE" >&2
  fi

  # The nonce requirement is not decoration: it is the ONLY thing that tells
  # the caller this handoff is the one it just asked for, rather than a
  # byte-identical file left by an earlier rotation.
  printf 'Before you stop: write a handoff to "%s" — at most ~100 lines, covering in-flight work (branches, PRs, tickets), next steps, open decisions, gotchas and lessons, pointers to evidence, and today'"'"'s date. Write it atomically: write a temp file, then rename it into place. Include the token "%s" verbatim, exactly once, anywhere in the file (a trailing HTML comment like "<!-- cl:%s -->" works well) — the caller waits for that token to confirm THIS handoff rather than a stale one. Once the rename completes, stop: no summary, no further action. The file containing that token is the signal that you are done, so do not write it until everything else is finished.' \
    "$hp" "$nonce" "$nonce"
}

# send_text_tmux <tmux_session> <text>: type literal text into a live tmux pane
# and press Enter, exactly as a person would. -l sends the text with no key
# translation, so it is safe for arbitrary punctuation (quotes, backslashes).
#
# The target MUST be "=<session>:" (trailing colon), not "=<session>" alone.
# `has-session`/`kill-session` accept the bare session form, but `send-keys`
# resolves its target to a PANE and a bare session name is ambiguous — proven
# against a real tmux 3.7c: `send-keys -t "=name"` fails "can't find pane"
# every time, `send-keys -t "=name:"` (session's active window) succeeds.
# (Found in Codex review, 2026-09-23 — the fake-tmux fixture in earlier local
# testing accepted any target, which is exactly why it didn't catch this.)
send_text_tmux() {
  tmux send-keys -t "=$1:" -l -- "$2" 2>/dev/null || return 1
  tmux send-keys -t "=$1:" Enter 2>/dev/null
}

# send_text_iterm <tag> <text>: type literal text into the iTerm session
# tagged user.clSession == <tag> (the same tag launch_session/launch_named set
# via tag_iterm_session), via AppleScript `write text` — which types-and-Enters
# in one call, same as write_text does for any interactive shell. Best-effort:
# a session that was never tagged (started before this feature, or `cl new`'s
# detached-create path) cannot be reached this way and is reported as such by
# the caller, not here.
send_text_iterm() {
  local tag="$1" text="$2" etag etext found
  etag="${tag//\\/\\\\}"; etag="${etag//\"/\\\"}"
  etext="${text//\\/\\\\}"; etext="${etext//\"/\\\"}"
  found=$(osascript 2>/dev/null <<OSA
tell application "iTerm"
  set hit to missing value
  repeat with w in windows
    repeat with tb in tabs of w
      repeat with s in sessions of tb
        try
          if (variable named "user.clSession") of s is "${etag}" then set hit to s
        end try
      end repeat
    end repeat
  end repeat
  if hit is missing value then return "no"
  tell hit to write text "${etext}"
  return "yes"
end tell
OSA
)
  [ "$found" = "yes" ]
}

# send_text_cmux <surface_id> <text>: best-effort text injection into a cmux
# surface, via cmux's real `send`/`send-key` contract (confirmed against an
# installed cmux build, 2026-09-23 — an earlier version of this function
# probed for a nonexistent `send-text` subcommand and always fell back). `cmux
# send` treats a literal \n/\r/\t IN THE TEXT as Enter/Tab, which would let a
# path or name containing those bytes submit early or inject a stray
# keystroke — so Enter is sent as its own `send-key enter` afterward, never
# folded into the text. Still probed, not assumed: cmux builds differ, and a
# build without `send` at all falls back to "unsupported" rather than guessing.
send_text_cmux() {
  command -v cmux >/dev/null 2>&1 || return 1
  cmux --help 2>/dev/null | grep -qE '^\s*send\s' || return 1
  cmux send --surface "$1" -- "$2" >/dev/null 2>&1 \
    && cmux send-key --surface "$1" -- enter >/dev/null 2>&1
}

# request_handoff <name> <sid> <cwd> <tmux_name> [--dry-run]: try to get the
# live session to write its own handoff before it dies. Returns:
#   0  THIS request's handoff confirmed written (its nonce token was found
#      in the file — see handoff_nonce below)
#   1  could not even ask (no reachable pane, or no durable root at all —
#      logs why)
#   2  asked, but timed out waiting for the file (logs why)
#   3  dry run — nothing sent
# The caller's job either way is unchanged afterwards: proceed with the normal
# kill flow. A 1/2 here is a fallback to a PLAIN stop, never a lost stop.
#
# handoff_nonce: one fresh, unpredictable-enough token per request. A content
# hash (round 2's fix) is NOT a valid completion signal on its own — round 3
# of Codex review reproduced both directions of that: (a) a real, completed
# handoff whose content happens to be byte-identical to a stale one from an
# earlier rotation has an UNCHANGED hash, so a genuine success times out; (b)
# an unrelated write, or a File Provider reconciling mid-sync, changes the
# hash without this request's handoff having landed at all, so a false
# success is accepted while the agent may still be working. Requiring
# THIS run's nonce inside the file closes both: a real completion of THIS
# request always contains it, and nothing else ever could.
handoff_nonce() { printf 'clho:%s:%s:%s:%s' "$$" "$(date +%s 2>/dev/null || echo 0)" "$RANDOM" "$RANDOM"; }

request_handoff() {
  local name="$1" sid="$2" cwd="$3" t="$4" dry="${5:-}" prompt root hp nonce waited sfc store sent=0 vrc

  # Dry run: preview ONLY, via the read-only *_preview resolver — checked
  # before touching anything real. handoff_path (below) needs a resolved
  # root, and resolving it for real means mkdir + write-probe; a dry run must
  # do neither. (Found in Codex review, 2026-09-23 — the original order built
  # the real path first, so `cl stop --dry-run` could still create
  # handoff dir/fallback directories.)
  if [ "$dry" = "--dry-run" ]; then
    printf '[dry-run] would ask "%s" to write handoff to %s (via %s)\n' "$name" "$(handoff_path_preview "$name")" "$( [ -n "$t" ] && tmux has-session -t "=${t}" 2>/dev/null && echo tmux || echo 'iterm/cmux' )" >&2
    return 3
  fi

  # Resolve the root EXACTLY ONCE here, via a direct (non-$()) call, and
  # thread it through both path constructions below AND leave it in
  # `_CL_HANDOFF_ROOT` for the caller to reuse afterward (do_fresh_start does,
  # for the launch prompt it builds once this returns) — see the path-helper
  # comment above for why a per-helper `$(handoff_root)` call doesn't achieve
  # this (Codex review round 2). handoff_root can fail outright (neither handoff dir
  # nor fallback usable, round 3) — that is exactly a "could not even ask"
  # case, checked explicitly rather than assumed.
  handoff_root >/dev/null; vrc=$?; root="$_CL_HANDOFF_ROOT"
  if [ "$vrc" -ne 0 ] || [ -z "$root" ]; then
    printf 'ℹ no durable location available to hand off "%s" (handoff dir and fallback both unusable) — plain stop\n' "$name" >&2
    return 1
  fi
  hp=$(handoff_path "$root" "$name")
  nonce=$(handoff_nonce)
  prompt=$(build_handoff_prompt "$root" "$name" "$nonce")

  if [ -n "$t" ] && tmux has-session -t "=${t}" 2>/dev/null; then
    send_text_tmux "$t" "$prompt" && sent=1
  elif send_text_iterm "$t" "$prompt"; then
    sent=1
  else
    store="$HOME/.cmuxterm/claude-hook-sessions.json"
    if command -v jq >/dev/null 2>&1 && [ -r "$store" ]; then
      sfc=$(jq -r --arg sid "$sid" '.sessions[$sid].surfaceId // empty' "$store" 2>/dev/null)
      [ -n "$sfc" ] && send_text_cmux "$sfc" "$prompt" && sent=1
    fi
  fi

  if [ "$sent" != "1" ]; then
    printf 'ℹ no reachable pane to hand off "%s" (not tmux, not a tagged iTerm tab, no cmux text-injection) — plain stop\n' "$name" >&2
    return 1
  fi

  printf '⏳ asked "%s" to write its handoff — waiting up to %ss for %s\n' "$name" "$CL_HANDOFF_TIMEOUT" "$hp" >&2
  waited=0
  while [ "$waited" -lt "$CL_HANDOFF_TIMEOUT" ]; do
    sleep 1; waited=$((waited+1))
    # THIS request's nonce, not just "any change" — see handoff_nonce's
    # comment for the two races a plain content hash still missed.
    if [ -e "$hp" ] && grep -qF -- "$nonce" "$hp" 2>/dev/null; then
      sleep 1   # small settle grace — atomic rename may still be mid-flight
      printf '✓ handoff written for "%s"\n' "$name" >&2
      return 0
    fi
  done
  printf '⚠ handoff timed out for "%s" after %ss — proceeding with a plain stop\n' "$name" "$CL_HANDOFF_TIMEOUT" >&2
  return 2
}

# archive_state: bank a copy of the current STATE into STATE_HISTORY_DIR under a
# timestamped name, then prune to the newest STATE_HISTORY_KEEP. Only well-formed
# JSON is archived, so the history stays a set of known-good snapshots to restore
# from if the live STATE is lost (failed start) or corrupted. Best-effort: any
# failure here must never break stop/start, so it always returns 0.
archive_state() {
  [ -r "$STATE" ] || return 0
  command -v jq >/dev/null 2>&1 && ! jq empty "$STATE" 2>/dev/null && return 0
  mkdir -p "$STATE_HISTORY_DIR" 2>/dev/null || return 0
  local stamp dest n=1
  stamp=$(date +%Y%m%d-%H%M%S)
  dest="$STATE_HISTORY_DIR/state-$stamp.json"
  # Same-second archives (e.g. rapid stop/start) must not clobber each other.
  while [ -e "$dest" ]; do dest="$STATE_HISTORY_DIR/state-$stamp-$n.json"; n=$((n+1)); done
  cp "$STATE" "$dest" 2>/dev/null || return 0
  # Prune oldest beyond the keep count (newest-first, drop the tail).
  ls -1t "$STATE_HISTORY_DIR"/state-*.json 2>/dev/null \
    | tail -n +$((STATE_HISTORY_KEEP + 1)) \
    | while IFS= read -r old; do rm -f "$old"; done
  return 0
}

# save_state: record the currently-live sessions into STATE as JSON, UNIONed
# with whatever STATE already held (keyed by name; the fresh entry wins on a
# collision so session ids stay current). Union — not overwrite — because
# `cl stop` is meant to be re-run to catch sessions left running mid-task: by
# the second run those killed earlier are no longer live, and an overwrite
# would drop them from the saved set. `cl start` clears STATE once consumed,
# so a clean stop→start cycle never accumulates stale entries.
save_state() {
  mkdir -p "$(dirname "$STATE")" || { echo "claude-session: cannot create state dir" >&2; return 1; }

  # Build a JSON array of the sessions live in tmux right now.
  local live first=1
  live="$(
    printf '['
    # Claude only: the stop/start kill and relaunch logic is Claude-shaped, and a
    # codex "live" marker is not a kill-safe signal (see session_pid). The
    # agent field is recorded so a later reader can tell the two apart.
    discover | while IFS=$'\t' read -r name sid cwd epoch agent; do
      [ "$agent" = "claude" ] || continue
      tmux has-session -t "$(tmux_name "$name")" 2>/dev/null || [ -n "$(session_pid "$sid" claude "$name")" ] || continue
      [ "$first" -eq 1 ] && first=0 || printf ','
      jq -nc --arg name "$name" --arg sid "$sid" --arg cwd "$cwd" --arg agent "$agent" \
        '{name:$name, sid:$sid, cwd:$cwd, agent:$agent}'
    done
    printf ']'
  )"

  # Union with any prior STATE: concat, group by name, keep the last (fresh)
  # entry per name. Prior file is treated as empty if missing/unparseable.
  local prior="[]"
  [ -r "$STATE" ] && prior="$(jq -c '.' "$STATE" 2>/dev/null || printf '[]')"
  local tmp="$STATE.tmp.$$"
  if printf '%s\n%s\n' "$prior" "$live" \
      | jq -s 'add | group_by(.name) | map(.[-1])' > "$tmp" 2>/dev/null; then
    mv "$tmp" "$STATE"
    archive_state   # bank this known-good snapshot into the rotating history
  else
    rm -f "$tmp"
    echo "claude-session: failed to write state" >&2
    return 1
  fi
}

# do_stop: snapshot live sessions, then kill them — but ask before killing any
# that look mid-task, and leave those running. Re-run `cl stop` to catch them
# once they go idle.
do_stop() {
  command -v jq >/dev/null 2>&1 || { echo "claude-session: stop needs jq (brew install jq)" >&2; exit 1; }
  local keep_tabs=0 no_handoff=0 dry_run=""
  # Flags are order-independent — `cl stop --no-handoff --keep-tabs` and
  # `cl stop --keep-tabs --no-handoff` must do the same thing.
  local arg
  for arg in "$@"; do
    case "$arg" in
      --keep-tabs)  keep_tabs=1 ;;
      --no-handoff) no_handoff=1 ;;
      --dry-run)    dry_run="--dry-run" ;;
      *) echo "claude-session: stop: unrecognised flag '$arg'" >&2; exit 1 ;;
    esac
  done
  # No precondition here. "No tmux server" stopped meaning "nothing to stop"
  # the moment sessions began running without tmux, and every cheap substitute
  # (is any process named claude alive?) fails the same way: it cannot know
  # every launch shape, and its failure direction is the unsafe one — report
  # success having saved nothing and stopped nothing. Session discovery is the
  # only thing that actually knows, so let it decide.

  # Also close each killed session's iTerm tab, unless opted out or not in iTerm.
  local close_tabs=0
  [ "$keep_tabs" = "0" ] && iterm_running && close_tabs=1

  # A dry run must leave no trace — no state.json, no history snapshot — so a
  # real `cl stop` afterwards still behaves like the first one.
  if [ -n "$dry_run" ]; then
    printf '[dry-run] would snapshot live sessions to %s (not written)\n\n' "$STATE" >&2
  else
    save_state || exit 1
    local count; count=$(jq 'length' "$STATE" 2>/dev/null || echo 0)
    printf 'saved %s session(s) to %s\n\n' "$count" "$STATE"
  fi

  local name t rrc
  discover | while IFS=$'\t' read -r name sid cwd epoch agent; do
    [ "$agent" = "claude" ] || continue   # codex lifecycle is out of scope here
    t=$(tmux_name "$name")
    # --dry-run must short-circuit BEFORE the kill logic regardless of
    # --no-handoff — this check used to live only inside the `no_handoff=0`
    # branch below, so `cl stop --dry-run --no-handoff` fell straight through
    # to a REAL tmux kill-session / process kill while printing "[dry-run]".
    # (Found in Codex review, 2026-09-23, via a fake-tmux fixture that
    # recorded the real kill-session call.)
    if [ -n "$dry_run" ]; then
      [ "$no_handoff" = "0" ] && request_handoff "$name" "$sid" "$cwd" "$t" "$dry_run"
      printf '[dry-run] would evaluate and, if not left running, kill "%s"\n' "$name" >&2
      continue
    fi
    if [ "$no_handoff" = "0" ]; then
      # 0 = written. 1/2 fall through to the SAME kill logic below,
      # unchanged — a missed or timed-out handoff must never turn into a
      # lost stop.
      request_handoff "$name" "$sid" "$cwd" "$t" ""
    fi
    # retire_claude_session covers both branches (tmux-hosted and cmux/bare
    # process) with the busy-check-and-prompt, tab/surface cleanup, and the
    # hidden-tmux ownership guard — do_stop just runs it and moves on; its
    # return value changes nothing here (a lost race, a decline, or a slow
    # shutdown are all just "didn't get killed this time, re-run stop").
    retire_claude_session "$name" "$sid" "$t" "$close_tabs"; rrc=$?
  done
  printf '\nstate saved. Run cl start to bring these back.\n' >&2
}

# open_iterm_tabs <name>...: open one real iTerm tab per name, each running
# `cl <name>` (which attaches that session's tmux). Mirrors the manual flow —
# ⌘T, `cl`, pick the session — but creates ALL tabs in a SINGLE osascript
# invocation (one AppleScript session for the whole set) instead of one process
# per tab, which is markedly faster for a large working set. Returns non-zero if
# the AppleScript fails (not in iTerm, automation denied) so the caller can fall
# back to printing commands.
open_iterm_tabs() {
  local name esc script
  script='tell application "iTerm"
  tell current window
'
  for name in "$@"; do
    # Escape backslashes then double-quotes for embedding in the AppleScript string.
    esc="${name//\\/\\\\}"; esc="${esc//\"/\\\"}"
    script+='    create tab with default profile
    tell current session to write text "cl \"'"$esc"'\""
'
  done
  script+='  end tell
end tell'
  osascript >/dev/null 2>&1 <<OSA
$script
OSA
}

# do_start: bring back every session in STATE the way they were launched by
# hand — one real iTerm tab each, tmux-backed via `cl <name>`. First it ensures
# each session's tmux exists (detached), then opens a tab per session. Falls
# back to printing the `cl <name>` commands when not in iTerm or osascript fails.
do_start() {
  command -v jq >/dev/null 2>&1 || { echo "claude-session: start needs jq (brew install jq)" >&2; exit 1; }
  [ -r "$STATE" ] || { echo "claude-session: no saved state ($STATE) — run 'cl stop' first" >&2; exit 1; }

  local n; n=$(jq 'length' "$STATE" 2>/dev/null || echo 0)
  [ "$n" -gt 0 ] || { echo "claude-session: saved state is empty" >&2; exit 1; }

  if in_cmux; then
    # cmux mode: one workspace per saved session, claude resumed tmux-free so
    # cmux's integration owns it. --focus false so eight restores don't fight
    # over focus. Live sessions (either kind) are left alone.
    local name sid cwd i=0
    while IFS=$'\t' read -r name sid cwd; do
      if [ -n "$(session_pid "$sid")" ] \
         || { command -v tmux >/dev/null 2>&1 && tmux has-session -t "=$(tmux_name "$name")" 2>/dev/null; }; then
        printf '● %s already live\n' "$name"
      else
        [ -d "$cwd" ] || cwd="$HOME"
        cmux new-workspace --name "$name" --cwd "$cwd" --focus false \
            --command "$(claude_cmd) --resume $(printf '%q' "$sid") --dangerously-skip-permissions" >/dev/null \
          && { printf '✓ opened %s  (%s)\n' "$name" "$cwd"; i=$((i+1)); }
      fi
    done < <(jq -r '.[] | [.name, .sid, .cwd] | @tsv' "$STATE")
    archive_state
    rm -f "$STATE"
    printf '\nopened %s cmux workspace(s).\n' "$i"
    exit 0
  fi

  # 1. Ensure each session's tmux exists (detached). `cl <name>` in each tab
  #    then attaches it. Creating here (not relying on the tab) means a failed
  #    tab still leaves a recoverable session. launch_session execs, so we
  #    replicate its create-detached form (incl. tmux_setup).
  use_tmux && tmux_setup
  local name sid cwd t i=0 live_names=""
  while IFS=$'\t' read -r name sid cwd; do
    t=$(tmux_name "$name")
    [ -d "$cwd" ] || cwd="$HOME"
    if ! use_tmux; then
      # Without tmux there is nothing to pre-create: each tab's `cl <name>`
      # execs the agent itself. Record the live ones so no tab is opened for
      # them — `cl stop` leaves busy sessions running on purpose, and a tab
      # for one would start a SECOND agent on the same transcript.
      if [ -n "$(session_pid "$sid" claude "$name")" ]; then
        printf '● %s already live\n' "$name"
        live_names="${live_names}${name}"$'\n'
      fi
    elif tmux has-session -t "=${t}" 2>/dev/null; then
      printf '● %s already live\n' "$name"
      live_names="${live_names}${name}"$'\n'
    else
      tmux new-session -d -s "$t" -c "$cwd" "claude --resume $(printf '%q' "$sid") --dangerously-skip-permissions" \
        && printf '✓ prepared %s  (%s)\n' "$name" "$cwd"
    fi
    i=$((i+1))
  done < <(jq -r '.[] | [.name, .sid, .cwd] | @tsv' "$STATE")

  # 2. Open a real iTerm tab per session (or fall back to printing commands).
  #    Read names into an array first so the STATE file can be cleared safely.
  local -a names=()
  while IFS= read -r name; do
    # Skip the ones reported live above: opening a tab for them duplicates.
    printf '%s' "$live_names" | grep -qxF -- "$name" && continue
    names+=("$name")
  done < <(jq -r '.[].name' "$STATE")

  # Snapshot consumed: archive a copy first (so a failed relaunch never loses the
  # list — restore from STATE_HISTORY_DIR), then clear for the next clean cycle.
  archive_state
  rm -f "$STATE"

  # Open tabs only when THIS shell is iTerm-hosted (in_iterm). Inside a tmux
  # pane TERM_PROGRAM reads "tmux", so in_iterm is false there — cl start then
  # degrades to printing the commands instead of guessing a terminal to target.
  if [ "${#names[@]}" -eq 0 ]; then
    printf '\nevery saved session is already live — nothing to open.\n'
    return 0
  fi

  local have_iterm=0
  in_iterm && have_iterm=1
  if [ "$have_iterm" = "1" ] && open_iterm_tabs "${names[@]}"; then
    printf '\nopened %s iTerm tab(s).\n' "${#names[@]}"
  else
    if [ "$have_iterm" = "1" ]; then
      printf '\n%s session(s) prepared, but the iTerm tab-open failed — run these manually:\n' "$i" >&2
    else
      printf '\n%s session(s) prepared. Not in iTerm (or no osascript) — open a tab and run:\n' "$i"
    fi
    for name in "${names[@]}"; do printf '  cl "%s"\n' "$name"; done
  fi
}

# record_fresh_history <name> <old_sid> <cwd>: append the retired session id to
# FRESH_HISTORY so a fresh start is never a dead end — the prior conversation
# is still resumable by id even though the name now points at the new session.
# Best-effort (a history-append failure must not block the fresh start); prints
# the recovery command either way so it's never ONLY in a file nobody opens.
record_fresh_history() {
  local name="$1" old_sid="$2" cwd="$3" tmp
  if command -v jq >/dev/null 2>&1; then
    mkdir -p "$(dirname "$FRESH_HISTORY")" 2>/dev/null
    local prior="[]"; [ -r "$FRESH_HISTORY" ] && prior=$(jq -c '.' "$FRESH_HISTORY" 2>/dev/null || printf '[]')
    tmp="$FRESH_HISTORY.tmp.$$"
    if jq -nc --argjson prior "$prior" --arg name "$name" --arg sid "$old_sid" \
         --arg cwd "$cwd" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
         '$prior + [{name:$name, old_sid:$sid, cwd:$cwd, at:$at}]' > "$tmp" 2>/dev/null; then
      mv "$tmp" "$FRESH_HISTORY"
    else
      rm -f "$tmp"
    fi
  fi
  printf 'previous session of "%s" kept for recovery — resume it directly with:\n' "$name" >&2
  printf '  claude --resume %s --dangerously-skip-permissions\n' "$(printf '%q' "$old_sid")" >&2
}

# do_fresh_start <name> [--dry-run]: the expensive-context problem this whole
# feature exists for. A resumed session reloads its ENTIRE transcript on every
# call — measured 2026-09-23 at 356k-896k tokens for the oldest working
# sessions, 6-15x a fresh session's 40-60k. `cl start --fresh <name>` retires
# the old conversation (with a handoff, same as `cl stop`) and launches a NEW
# claude process under the SAME name, in the same dir, through the same
# wrapper/teams selection — so cross-session SendMessage and `cl <name>` keep
# working — whose first message tells it to read that handoff and carry on.
# The old session id is never lost (see
# record_fresh_history): this trades context size for one deliberate re-read of
# the handoff + open items, not for the conversation itself.
#
# Plain `cl start` is UNCHANGED — it still means "resume everything", which is
# the safer default (a fresh start is a deliberate, one-name-at-a-time choice,
# not something to default into for a whole working set sight-unseen).
do_fresh_start() {
  local name="" dry_run="" arg
  for arg in "$@"; do
    case "$arg" in
      --dry-run) dry_run="--dry-run" ;;
      --*) echo "claude-session: start --fresh: unrecognised flag '$arg'" >&2; exit 1 ;;
      *)   name="$arg" ;;
    esac
  done
  [ -n "$name" ] || { echo 'usage: cl start --fresh "Session Name" [--dry-run]' >&2; exit 1; }

  local match sid cwd agent
  match=$(discover | awk -F'\t' -v n="$name" '$1==n && $5=="claude"')
  [ -n "$match" ] || { echo "claude-session: no claude session named '$name' (try: cl --list)" >&2; exit 1; }
  IFS=$'\t' read -r name sid cwd _ agent <<EOF
$match
EOF

  local t; t=$(tmux_name "$name" claude)

  # dry-run: preview only, via the read-only resolver — never touches handoff_root
  # (same rule as request_handoff's own dry-run branch) and never kills, records,
  # or launches anything.
  if [ -n "$dry_run" ]; then
    request_handoff "$name" "$sid" "$cwd" "$t" "$dry_run"
    printf '[dry-run] would retire "%s" (pid/session for sid %s)\n' "$name" "$sid" >&2
    printf '[dry-run] would record old session id %s for "%s" in %s\n' "$sid" "$name" "$FRESH_HISTORY" >&2
    local prompt
    prompt=$(build_resume_prompt "$(handoff_path_preview "$name")")
    printf '[dry-run] would launch fresh "%s" in %s with prompt:\n  %s\n' "$name" "$cwd" "$prompt" >&2
    return 0
  fi

  # 1. Ask the OLD session for a handoff — and, UNLIKE `cl stop`, fail
  #    closed if it doesn't land. `cl stop` degrades a missed handoff to a
  #    plain stop because the session is going away either way; `start
  #    --fresh` has a different contract, because the whole point is that the
  #    NEW session is told to read that file — retiring the old session and
  #    launching a replacement anyway means either pointing the replacement
  #    at a STALE handoff from some earlier rotation (actively worse than no
  #    handoff) or at nothing at all. (Found in Codex review round 2,
  #    2026-09-23: the round-1 fix checked retirement's return value but not
  #    request_handoff's, so a reachable-but-non-responding pane still led to
  #    a full retire-and-replace.)
  local hrc
  request_handoff "$name" "$sid" "$cwd" "$t" ""; hrc=$?
  case "$hrc" in
    0) : ;;
    *) echo "claude-session: no handoff arrived for \"$name\" — not starting fresh (it is still running; re-run once it responds, or use plain \`cl stop\`/\`cl <name>\`)" >&2; exit 1 ;;
  esac
  # request_handoff resolved the handoff dir/fallback root exactly once, via a
  # direct (non-$()) call, and left it memoized here — reused below so the
  # launch prompt names the SAME root the handoff was actually confirmed in,
  # never a possible third resolution (Codex review round 2).
  local root="$_CL_HANDOFF_ROOT"

  # 2. Retire it — the SAME safety-sensitive logic `cl stop` uses (tmux vs
  #    cmux/bare, the hidden-tmux ownership guard, busy-check prompts).
  #    A failed or declined RETIREMENT must also fail closed: launching a
  #    second claude under this name while the first is still alive
  #    (declined kill, still shutting down, or the kill itself failed) is
  #    exactly the double-agent-on-one-name hazard the launch registry exists
  #    to prevent. (Found in Codex review round 1, 2026-09-23.)
  local rc
  retire_claude_session "$name" "$sid" "$t" 1; rc=$?
  case "$rc" in
    0) : ;;
    1) echo "claude-session: \"$name\" was left running — not starting fresh (re-run when it's idle)" >&2; exit 1 ;;
    *) echo "claude-session: could not confirm \"$name\" was retired — not starting fresh (its ownership may still be held)" >&2; exit 1 ;;
  esac

  record_fresh_history "$name" "$sid" "$cwd"

  local hp prompt
  hp=$(handoff_path "$root" "$name")
  prompt=$(build_resume_prompt "$hp")

  launch_fresh "$name" "$cwd" "$prompt"
}

# do_restore: copy a snapshot from STATE_HISTORY_DIR back to STATE so the next
# `cl start` can bring the sessions back. No argument → newest snapshot; --list →
# print available snapshots (newest first) with session count + age; a path or
# bare filename → that specific snapshot. Any existing STATE is archived first, so
# restore is itself lossless. Corrupt snapshots are refused.
do_restore() {
  command -v jq >/dev/null 2>&1 || { echo "claude-session: restore needs jq (brew install jq)" >&2; exit 1; }

  if [ "${1:-}" = "--list" ]; then
    local any=0 f n age
    while IFS= read -r f; do
      any=1
      n=$(jq 'length' "$f" 2>/dev/null || echo '?')
      age=$(reltime "$(stat -f %m "$f" 2>/dev/null || echo 0)")
      printf '%-8s %3s session(s)   %s\n' "$age" "$n" "$f"
    done < <(ls -1t "$STATE_HISTORY_DIR"/state-*.json 2>/dev/null)
    [ "$any" = "1" ] || echo "claude-session: no snapshots in $STATE_HISTORY_DIR" >&2
    return 0
  fi

  # Choose the snapshot: explicit arg (full path or bare filename) or the newest.
  local snap
  if [ -n "${1:-}" ]; then
    if   [ -r "$1" ];                        then snap="$1"
    elif [ -r "$STATE_HISTORY_DIR/$1" ];     then snap="$STATE_HISTORY_DIR/$1"
    else echo "claude-session: no such snapshot '$1' (try: cl restore --list)" >&2; exit 1; fi
  else
    snap=$(ls -1t "$STATE_HISTORY_DIR"/state-*.json 2>/dev/null | head -1)
    [ -n "$snap" ] || { echo "claude-session: no snapshots to restore in $STATE_HISTORY_DIR" >&2; exit 1; }
  fi

  jq empty "$snap" 2>/dev/null || { echo "claude-session: snapshot is not valid JSON: $snap" >&2; exit 1; }

  archive_state   # preserve any current STATE before overwriting — restore is lossless
  mkdir -p "$(dirname "$STATE")" || { echo "claude-session: cannot create state dir" >&2; exit 1; }
  cp "$snap" "$STATE" || { echo "claude-session: failed to write $STATE" >&2; exit 1; }

  local count; count=$(jq 'length' "$STATE" 2>/dev/null || echo '?')
  printf 'restored %s session(s) from %s\n' "$count" "$snap"
  printf 'run cl start to bring them back.\n'
}

# context_size <sid> <agent>: approximate current context size in tokens —
# input + cache_read + cache_creation of the LAST assistant message that
# carried a usage block. That sum (not just input_tokens) is what actually
# gets billed and re-sent on every resumed call, which is the whole reason
# `cl start --fresh` exists (measured 2026-09-23: 356k-896k for the oldest
# working sessions vs ~40-60k fresh). Claude only — Codex's rollout format
# doesn't carry this MCP/Anthropic-shaped usage block, so it's left blank
# rather than guessed at (requirement: never break the Codex listing).
# One jq pass over the transcript, not per-line invocations — a 900k-context
# session's transcript is not small, and jq is the same dependency stop/start
# already require. Empty output (no usage block ever recorded, or file/jq
# missing) is treated as unknown by the caller, not zero.
context_size() { # sid agent
  [ "${2:-claude}" = "claude" ] || { printf ''; return 0; }
  command -v jq >/dev/null 2>&1 || { printf ''; return 0; }
  local f
  f=$(find "$PROJECTS" -mindepth 2 -maxdepth 2 -name "${1}.jsonl" 2>/dev/null | head -1)
  [ -n "$f" ] && [ -r "$f" ] || { printf ''; return 0; }
  jq -r 'select(.message.usage != null) | (.message.usage.input_tokens // 0) + (.message.usage.cache_read_input_tokens // 0) + (.message.usage.cache_creation_input_tokens // 0)' \
    "$f" 2>/dev/null | tail -1
}

# fmt_ctx <tokens>: human-scale rendering ("896k", "42k", "3821") for a list
# column; blank stays blank (unknown, not zero).
fmt_ctx() {
  case "${1:-}" in
    ''|*[!0-9]*) printf ''; return 0 ;;
  esac
  if [ "$1" -ge 1000 ]; then printf '%dk' $(( ($1 + 500) / 1000 ))
  else printf '%d' "$1"
  fi
}

# rotate_hint <tokens> <epoch> <agent>: "rotate" when context is over ~250k
# (the 6-15x-cost knee measured 2026-09-23) or the transcript is over 7 days
# old — either is a candidate for `cl start --fresh`. Blank otherwise,
# including when the context size is unknown (no evidence, no hint) OR the
# agent isn't claude: `start --fresh` is Claude-only (see context_size's own
# Claude-only note), so a blank-context Codex row hitting the AGE branch and
# getting flagged rotate anyway would recommend an action that doesn't exist
# for it. (Found in Codex review round 2, 2026-09-23.)
CL_ROTATE_CTX_THRESHOLD="${CL_ROTATE_CTX_THRESHOLD:-250000}"
CL_ROTATE_AGE_DAYS="${CL_ROTATE_AGE_DAYS:-7}"
rotate_hint() { # tokens epoch agent
  local tokens="$1" epoch="${2:-0}" agent="${3:-claude}" now age_days
  [ "$agent" = "claude" ] || { printf ''; return 0; }
  now=$(date +%s); age_days=$(( (now - epoch) / 86400 ))
  case "$tokens" in
    ''|*[!0-9]*) : ;;
    *) [ "$tokens" -ge "$CL_ROTATE_CTX_THRESHOLD" ] && { printf 'rotate'; return 0; } ;;
  esac
  [ "$age_days" -ge "$CL_ROTATE_AGE_DAYS" ] && { printf 'rotate'; return 0; }
  printf ''
}

# live_dot <name> <sid> <agent>: ● when a tmux session or a matching local
# process exists, ○ otherwise. For codex ● means "a local resume process
# matches", nothing stronger (see session_pid).
live_dot() {
  if tmux has-session -t "$(tmux_name "$1" "$3")" 2>/dev/null || [ -n "$(session_pid "$2" "$3" "$1")" ]; then printf '●'; else printf '○'; fi
}

# agent_tag <agent>: short marker shown beside non-default agents.
agent_tag() { [ "$1" = "claude" ] && printf '%-6s' '' || printf '%-6s' "$1"; }

# fzf rows: "<display>\tNAME\tSID\tCWD\tAGENT"  (display shown; rest carried for the action)
rows() {
  printf '＋ new claude here  ·  %s\tNEW\t\t%s\tclaude\n' "$PWD" "$PWD"
  if command -v codex >/dev/null 2>&1; then
    printf '＋ new codex here   ·  %s\tNEW\t\t%s\tcodex\n' "$PWD" "$PWD"
  fi
  discover | while IFS=$'\t' read -r name sid cwd epoch agent; do
    printf '%s %-22s %s %-8s %s\t%s\t%s\t%s\t%s\n' "$(live_dot "$name" "$sid" "$agent")" "$name" "$(agent_tag "$agent")" "$(reltime "$epoch")" "$cwd" "$name" "$sid" "$cwd" "$agent"
  done
}

# Optional agent filter for direct launch: `cl --codex <name>` / `cl --claude <name>`.
AGENT_FILTER=""
case "${1:-}" in
  --codex)  AGENT_FILTER="codex";  shift ;;
  --claude) AGENT_FILTER="claude"; shift ;;
esac

case "${1:-}" in
  new)     shift; do_new "$@"; exit 0 ;;
  stop)    shift; do_stop "$@"; exit 0 ;;
  start)
    shift
    if [ "${1:-}" = "--fresh" ]; then shift; do_fresh_start "$@"; else do_start; fi
    exit 0 ;;
  restore) do_restore "${2:-}"; exit 0 ;;
  --discover)  # raw TSV (name sid cwd epoch agent) — for scripts and tests
    discover; exit 0 ;;
  --list)
    printf '%-2s %-22s %-6s %-8s %-6s %-6s %s\n' '' NAME AGENT 'ACTIVE' CTX '' DIR
    discover | while IFS=$'\t' read -r name sid cwd epoch agent; do
      [ -z "$AGENT_FILTER" ] || [ "$agent" = "$AGENT_FILTER" ] || continue
      ctx=$(context_size "$sid" "$agent")
      printf '%-2s %-22s %s %-8s %-6s %-6s %s\n' "$(live_dot "$name" "$sid" "$agent")" "$name" "$(agent_tag "$agent")" "$(reltime "$epoch")" "$(fmt_ctx "$ctx")" "$(rotate_hint "$ctx" "$epoch" "$agent")" "$cwd"
    done
    exit 0 ;;
  -h|--help) awk 'NR>1 && !/^#/{exit} NR>1{print}' "$0"; exit 0 ;;
  '') : ;;  # fall through to picker
  *)
    # direct launch by name. A name held by BOTH agents is refused unless
    # --codex/--claude says which — never first-row-wins.
    match=$(discover | awk -F'\t' -v n="$1" -v a="$AGENT_FILTER" '$1==n && (a=="" || $5==a)')
    nmatch=$(printf '%s' "$match" | grep -c .)
    if [ "$nmatch" -gt 1 ]; then
      echo "claude-session: '$1' exists for more than one agent — say which: cl --claude \"$1\"  or  cl --codex \"$1\"" >&2
      exit 1
    elif [ -n "$match" ]; then
      IFS=$'\t' read -r name sid cwd _ agent <<EOF
$match
EOF
      launch_session "$name" "$sid" "$cwd" "$agent"
    elif command -v tmux >/dev/null 2>&1 && tmux has-session -t "=$(tmux_name "$1" "${AGENT_FILTER:-claude}")" 2>/dev/null; then
      # Live tmux session exists but its customTitle isn't in the transcript yet
      # (e.g. a fresh `cl new` before its first message) — attach it directly.
      t=$(tmux_name "$1" "${AGENT_FILTER:-claude}"); in_iterm && tag_iterm_session "$t"; tmux_setup
      exec tmux new-session -A -s "$t"
    else
      echo "claude-session: no session named '$1' (try --list)" >&2; exit 1
    fi
    ;;
esac

# ---- picker ----
if command -v fzf >/dev/null 2>&1; then
  picked=$(rows | fzf --ansi --delimiter='\t' --with-nth=1 --height=~100% --reverse \
            --prompt='session ❯ ' \
            --header='● live   ○ resume      enter: open') || exit 0
  [ -n "$picked" ] || exit 0
else
  echo "Pick a session:" >&2
  IFS=$'\n'; i=0; menu=$(rows)
  for line in $menu; do i=$((i+1)); printf '%2d) %s\n' "$i" "${line%%$'\t'*}" >&2; done
  printf 'number ❯ ' >&2; read -r choice
  picked=$(printf '%s\n' $menu | sed -n "${choice}p")
  [ -n "$picked" ] || exit 0
fi

name=$(printf '%s' "$picked" | cut -f2)
sid=$(printf '%s' "$picked" | cut -f3)
cwd=$(printf '%s' "$picked" | cut -f4)
agent=$(printf '%s' "$picked" | cut -f5)
if [ "$name" = "NEW" ]; then
  printf 'name for the new session (blank = unnamed) ❯ ' >&2
  read -r newname </dev/tty
  if [ -n "$newname" ]; then launch_named "$newname" "$cwd" "$agent"; else launch_new "$cwd" "$agent"; fi
else
  launch_session "$name" "$sid" "$cwd" "$agent"
fi
